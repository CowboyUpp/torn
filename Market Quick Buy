// ==UserScript==
// @name         Market Quick Buy
// @namespace    https://greasyfork.org/en/users/1608691-cowboyup
// @version      1.4.14
// @description  Moves TornW3B bazaar listings below Torn's native Item Market seller row. Does not click Buy, Yes, or cart. Hub-aware. Includes visible native toggle.
// @author       cowboyup
// @match        https://www.torn.com/page.php?sid=ItemMarket*
// @match        https://*.torn.com/page.php?sid=ItemMarket*
// @icon         https://www.google.com/s2/favicons?sz=64&domain=torn.com
// @run-at       document-idle
// @grant        none
// @license      MIT
// @homepageURL  https://greasyfork.org/en/scripts/596397-market-quick-buy
// @supportURL   https://greasyfork.org/en/scripts/596397-market-quick-buy/feedback
// @downloadURL  https://update.greasyfork.org/scripts/596397/Market%20Quick%20Buy.user.js
// @updateURL    https://update.greasyfork.org/scripts/596397/Market%20Quick%20Buy.meta.js
// ==/UserScript==

(() => {
  "use strict";

  const VERSION = "1.4.14";
  const HUB_ID = "market-quick-buy";
  const STORAGE_KEY = "torn-market-quick-buy-settings-v1";
  const SETTLE_WAIT_MS = 1000;
  const PROCESS_DELAY_MS = 150;

  const CONFIG = {
    enabled: true,
  };

  const BAZAAR_SELECTOR = ".bazaar-info-container";
  const SELLER_LIST_SELECTOR =
    '[class^="sellerList___"], [class*=" sellerList___"]';
  const SELLER_WRAPPER_SELECTOR =
    '[class^="sellerListWrapper___"], [class*=" sellerListWrapper___"]';

  const seenAt = new WeakMap();
  let toggleElement = null;

  function loadConfig() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const parsed = JSON.parse(raw);
      if (typeof parsed.enabled === "boolean") CONFIG.enabled = parsed.enabled;
    } catch (_) {}
  }

  function saveConfig() {
    try {
      localStorage.setItem(
        STORAGE_KEY,
        JSON.stringify({ enabled: CONFIG.enabled })
      );
    } catch (_) {}
  }

  function isAllowedPage() {
    try {
      const url = new URL(location.href);
      if (
        url.hostname !== "www.torn.com" &&
        !url.hostname.endsWith(".torn.com")
      ) {
        return false;
      }
      const sid = (url.searchParams.get("sid") || "").toLowerCase();
      return sid === "itemmarket" || sid.startsWith("itemmarket");
    } catch (_) {
      return false;
    }
  }

  function isMarketPage() {
    const hash = window.location.hash;
    return hash === '' || hash === '#/market' || hash.startsWith('#/market/');
  }

  function findNativeSellerRow(parent) {
    return Array.from(parent.children).find((element) =>
      element.matches(SELLER_LIST_SELECTOR)
    );
  }

  function tornW3bHasSettled(bazaar, nativeSellerList) {
    const parent = bazaar.parentElement;
    if (!parent) return false;
    if (parent.hasAttribute("data-has-bazaar-info")) return true;
    if (nativeSellerList.hasAttribute("data-has-bazaar-container")) return true;
    if (parent.hasAttribute("data-bazaar-processed")) return true;
    return false;
  }

  function fixBazaarOrder(bazaar) {
    if (!(bazaar instanceof HTMLElement)) return;
    if (!CONFIG.enabled) return;

    const parent = bazaar.parentElement;
    if (!parent) return;

    const nativeSellerList = findNativeSellerRow(parent);
    if (!nativeSellerList) return;

    if (nativeSellerList.nextElementSibling === bazaar) return;

    if (!tornW3bHasSettled(bazaar, nativeSellerList)) {
      const firstSeen = seenAt.get(bazaar) || Date.now();
      seenAt.set(bazaar, firstSeen);
      if (Date.now() - firstSeen < SETTLE_WAIT_MS) {
        scheduleProcess(PROCESS_DELAY_MS);
        return;
      }
    }

    nativeSellerList.insertAdjacentElement("afterend", bazaar);
  }

  function process() {
    if (!isAllowedPage()) return;
    if (!CONFIG.enabled) return;
    document.querySelectorAll(BAZAAR_SELECTOR).forEach(fixBazaarOrder);
  }

  let timer = null;
  function scheduleProcess(delay = PROCESS_DELAY_MS) {
    if (timer !== null) clearTimeout(timer);
    timer = setTimeout(() => {
      timer = null;
      process();
    }, delay);
  }

  function nodeLooksRelevant(node) {
    if (!(node instanceof Element)) return false;
    return (
      node.matches(BAZAAR_SELECTOR) ||
      node.matches(SELLER_LIST_SELECTOR) ||
      node.matches(SELLER_WRAPPER_SELECTOR) ||
      Boolean(node.querySelector(BAZAAR_SELECTOR)) ||
      Boolean(node.querySelector(SELLER_LIST_SELECTOR))
    );
  }

  const observer = new MutationObserver((mutations) => {
    if (!CONFIG.enabled || !isAllowedPage()) return;
    for (const mutation of mutations) {
      for (const node of mutation.addedNodes) {
        if (nodeLooksRelevant(node)) {
          scheduleProcess(PROCESS_DELAY_MS);
          return;
        }
      }
      for (const node of mutation.removedNodes) {
        if (nodeLooksRelevant(node)) {
          scheduleProcess(PROCESS_DELAY_MS);
          return;
        }
      }
    }
  });

  function showToast(msg) {
    const toast = document.createElement("div");
    toast.textContent = msg;
    toast.style.cssText = [
      "position:fixed",
      "bottom:60px",
      "left:50%",
      "transform:translateX(-50%)",
      "padding:10px 18px",
      "background:rgba(0,0,0,.85)",
      "color:#fff",
      "border-radius:8px",
      "font-size:13px",
      "z-index:99999",
      "pointer-events:none",
    ].join(";");
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2500);
  }

  function injectStyles() {
    if (document.getElementById('mqb-styles')) return;
    const style = document.createElement('style');
    style.id = 'mqb-styles';
    style.textContent = `
      #mqb-market-fixed-toggle {
        display: inline-flex;
        align-items: center;
        margin-left: 12px;
        padding: 0;
        background: transparent;
        border: none;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 13px;
        font-weight: normal;
        color: #555;
        cursor: pointer;
        user-select: none;
        vertical-align: middle;
      }

      #mqb-market-fixed-toggle:hover {
        color: #222;
      }

      .mqb-switch {
        position: relative;
        display: inline-block;
        width: 34px;
        height: 18px;
        margin-right: 8px;
        vertical-align: middle;
      }

      .mqb-switch input {
        opacity: 0;
        width: 0;
        height: 0;
      }

      .mqb-slider {
        position: absolute;
        cursor: pointer;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: #ccc;
        transition: .2s;
        border-radius: 20px;
      }

      .mqb-slider:before {
        position: absolute;
        content: "";
        height: 12px;
        width: 12px;
        left: 3px;
        bottom: 3px;
        background-color: #fff;
        transition: .2s;
        border-radius: 50%;
      }

      #mqb-toggle-checkbox:checked + .mqb-slider {
        background-color: #4e97d9;
      }

      #mqb-toggle-checkbox:checked + .mqb-slider:before {
        transform: translateX(16px);
      }

      .mqb-version {
        margin-left: 6px;
        font-size: 11px;
        color: #888;
        font-weight: normal;
      }
    `;
    document.head.appendChild(style);
  }

  function createToggleElement() {
    if (toggleElement) return toggleElement;
    
    toggleElement = document.createElement('div');
    toggleElement.id = 'mqb-market-fixed-toggle';
    toggleElement.innerHTML = `
      <label class="mqb-switch">
        <input type="checkbox" id="mqb-toggle-checkbox" ${CONFIG.enabled ? 'checked' : ''}>
        <span class="mqb-slider"></span>
      </label>
      <span>Market Quick Buy</span>
      <span class="mqb-version">v${VERSION}</span>
    `;

    const checkbox = toggleElement.querySelector('#mqb-toggle-checkbox');
    checkbox.addEventListener('change', function () {
      CONFIG.enabled = this.checked;
      saveConfig();
      process();
      showToast(`Market Quick Buy turned ${CONFIG.enabled ? 'ON' : 'OFF'}`);
    });
    
    return toggleElement;
  }

  function insertToggleIntoHeader() {
    if (!isMarketPage()) return;
    
    const headerContainers = document.querySelectorAll('[class*="containerHeader___"]');
    
    for (const container of headerContainers) {
      const title = container.querySelector('[class*="title___"]');
      if (title && title.textContent.trim() !== 'Most Popular') {
        if (container.contains(toggleElement)) return;
        
        title.insertAdjacentElement('afterend', toggleElement);
        return;
      }
    }
  }

  function setupHeaderWatcher() {
    const headerObserver = new MutationObserver(() => {
      if (isMarketPage() && toggleElement) {
        setTimeout(() => {
          insertToggleIntoHeader();
        }, 50);
      }
    });
    
    headerObserver.observe(document.body, {
      childList: true,
      subtree: true
    });
    
    insertToggleIntoHeader();
    setInterval(() => {
      if (isMarketPage()) {
        insertToggleIntoHeader();
      }
    }, 2000);
  }

  function registerWithHub() {
    document.dispatchEvent(
      new CustomEvent("torn-script-hub:register", {
        detail: {
          id: HUB_ID,
          name: "Market Quick Buy",
          version: VERSION,
          order: 90,
          open: () => {
            if (!isAllowedPage()) {
              showToast("Only active on Item Market");
              return;
            }
            const status = CONFIG.enabled ? "ON" : "OFF";
            showToast(
              `Market Quick Buy is ${status} (layout only — no purchase clicks)`
            );
          },
          status: () => {
            if (!isAllowedPage()) return "Idle — Item Market only";
            return CONFIG.enabled
              ? "Bazaar below sellers ON"
              : "Bazaar below sellers OFF";
          },
          prefs: {
            fields: [
              {
                key: "enabled",
                type: "toggle",
                label: "Put TornW3B bazaar listings below native sellers",
                default: true,
                hint: "Item Market only. Does not click Buy or confirm. Pair with No Confirm Market & Bazaar for one-click purchases.",
              },
            ],
            values: {
              enabled: CONFIG.enabled,
            },
            onSave: (values) => {
              if (typeof values.enabled === "boolean") {
                CONFIG.enabled = values.enabled;
              }
              saveConfig();
              process();
              console.info("[Market Quick Buy] Settings updated:", CONFIG);
              
              const checkbox = document.getElementById('mqb-toggle-checkbox');
              if (checkbox) {
                checkbox.checked = CONFIG.enabled;
              }
            },
          },
        },
      })
    );
  }

  function init() {
    loadConfig();
    injectStyles();
    createToggleElement();
    setupHeaderWatcher();
    scheduleProcess(250);
    const root = document.documentElement || document.body;
    if (root) {
      observer.observe(root, {
        childList: true,
        subtree: true,
      });
    }
    registerWithHub();
    console.info(
      "[Market Quick Buy]",
      VERSION,
      "— Item Market layout only (no purchase clicks)"
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }

  window.addEventListener('hashchange', () => {
    if (isMarketPage()) {
      setTimeout(insertToggleIntoHeader, 100);
    }
  });
  
  document.addEventListener("torn-script-hub:ready", registerWithHub);
})();
