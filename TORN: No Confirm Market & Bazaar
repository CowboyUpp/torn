// ==UserScript==
// @name         TORN: No Confirm Market & Bazaar
// @namespace    cowboyup.torn.userscripts
// @version      1.1.1
// @description  Enables one-click purchases in the Torn Item Market and individual Bazaars only. Does not run on Auction House, missions, jobs, or other pages. Hub-aware.
// @author       cowboyup
// @match        https://www.torn.com/page.php?sid=ItemMarket*
// @match        https://*.torn.com/page.php?sid=ItemMarket*
// @match        https://www.torn.com/bazaar.php*
// @match        https://*.torn.com/bazaar.php*
// @icon         https://www.google.com/s2/favicons?sz=64&domain=torn.com
// @run-at       document-idle
// @grant        none
// @license      MIT
// @homepageURL  https://greasyfork.org/en/scripts/587751-torn-no-confirm-market-bazaar
// @supportURL   https://greasyfork.org/en/scripts/587751-torn-no-confirm-market-bazaar/feedback
// @downloadURL  https://update.greasyfork.org/scripts/587751/TORN%3A%20No%20Confirm%20Market%20%20Bazaar.user.js
// @updateURL    https://update.greasyfork.org/scripts/587751/TORN%3A%20No%20Confirm%20Market%20%20Bazaar.meta.js
// ==/UserScript==

(() => {
  'use strict';

  const VERSION = '1.1.1';
  const HUB_ID = 'no-confirm-market';
  const STORAGE_KEY = 'torn-no-confirm-market-settings-v1';

  // --- Config (mutable by hub / localStorage) ---
  const CONFIG = {
    enabled: true,
    confirmTimeout: 5000,
  };

  const CONTROL_SELECTOR = [
    'button',
    'a',
    'input[type="button"]',
    'input[type="submit"]',
    '[role="button"]',
  ].join(',');

  let armed = false;

  function loadConfig() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const parsed = JSON.parse(raw);
      if (typeof parsed.enabled === 'boolean') CONFIG.enabled = parsed.enabled;
      if (Number.isFinite(parsed.confirmTimeout)) {
        CONFIG.confirmTimeout = Math.min(30000, Math.max(1000, parsed.confirmTimeout));
      }
    } catch (_) {}
  }

  function saveConfig() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        enabled: CONFIG.enabled,
        confirmTimeout: CONFIG.confirmTimeout,
      }));
    } catch (_) {}
  }

  /** Strict page gate — Item Market or Bazaar only. Never Auction / missions / jobs. */
  function isAllowedPage() {
    try {
      const url = new URL(location.href);
      if (url.hostname !== 'www.torn.com' && !url.hostname.endsWith('.torn.com')) return false;
      const path = url.pathname.toLowerCase();
      const sid = (url.searchParams.get('sid') || '').toLowerCase();

      // Explicit exclusions
      if (sid.includes('auction') || path.includes('auction')) return false;
      if (sid === 'missions' || path.includes('missions')) return false;
      if (path.includes('companies.php') || sid.includes('company')) return false;

      // Item Market
      if (sid === 'itemmarket' || sid.startsWith('itemmarket')) return true;
      // Personal / view bazaars
      if (path.includes('bazaar.php')) return true;

      return false;
    } catch (_) {
      return false;
    }
  }

  function normalize(value) {
    return String(value || '')
      .replace(/\s+/g, ' ')
      .trim()
      .toLowerCase();
  }

  function isVisible(element) {
    return (
      element instanceof HTMLElement &&
      element.getClientRects().length > 0 &&
      getComputedStyle(element).visibility !== 'hidden' &&
      getComputedStyle(element).display !== 'none' &&
      !element.disabled
    );
  }

  function getLabel(element) {
    return normalize(
      element.getAttribute('aria-label') ||
      element.textContent ||
      element.value ||
      element.title
    );
  }

  function isPurchaseTrigger(control) {
    if (!(control instanceof Element)) return false;

    // Never arm from unrelated actions
    const signal = normalize([
      control.getAttribute('aria-label'),
      control.textContent,
      control.value,
      control.title,
      control.dataset?.action,
      control.className,
    ].join(' '));

    // Reject decline / job / mission / accept-style noise
    if (/\b(decline|reject|cancel|job points?|mission|accept mission|auction)\b/.test(signal)) {
      return false;
    }

    // Must look like a buy/purchase control
    return /\b(buy|purchase)\b/.test(signal);
  }

  function isYesControl(control) {
    const label = getLabel(control);
    const classes = normalize(control.className);

    return (
      isVisible(control) &&
      (label === 'yes' ||
        label === 'confirm purchase' ||
        label === 'confirm' ||
        classes.includes('yes-buy'))
    );
  }

  function isNoControl(control) {
    const label = getLabel(control);
    const classes = normalize(control.className);

    return (
      isVisible(control) &&
      (label === 'no' ||
        label === 'cancel' ||
        classes.includes('no-buy'))
    );
  }

  function dialogLooksLikePurchase(container) {
    if (!container) return false;
    const text = normalize(container.textContent);
    // Require buy/purchase language near the Yes/No pair so mission/job confirms are ignored
    return /\b(buy|purchase|bazaar|market|\$|€|£)\b/.test(text);
  }

  function findYesControl() {
    const controls = [...document.querySelectorAll(CONTROL_SELECTOR)];

    for (const yesControl of controls) {
      if (!isYesControl(yesControl)) continue;

      let container = yesControl.parentElement;

      for (let depth = 0; container && depth < 6; depth += 1) {
        const noControl = [...container.querySelectorAll(CONTROL_SELECTOR)]
          .find(isNoControl);

        if (noControl && dialogLooksLikePurchase(container)) {
          return yesControl;
        }
        container = container.parentElement;
      }
    }

    return null;
  }

  function armConfirmation() {
    if (armed || !CONFIG.enabled || !isAllowedPage()) return;
    armed = true;

    let observer;
    let timeout;

    function finish() {
      observer?.disconnect();
      clearTimeout(timeout);
      armed = false;
    }

    function confirmPurchase() {
      if (!isAllowedPage() || !CONFIG.enabled) {
        finish();
        return;
      }
      const yesControl = findYesControl();
      if (!yesControl) return;

      finish();
      yesControl.click();
      console.info('[No Confirm] Purchase confirmed');
    }

    observer = new MutationObserver(confirmPurchase);
    observer.observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: [
        'class',
        'style',
        'hidden',
        'aria-hidden',
        'disabled',
      ],
    });

    timeout = setTimeout(finish, CONFIG.confirmTimeout);
    queueMicrotask(confirmPurchase);
  }

  // --- Core listener ---
  document.addEventListener(
    'click',
    (event) => {
      if (!CONFIG.enabled) return;
      if (!isAllowedPage()) return;
      if (!event.isTrusted || !(event.target instanceof Element)) return;

      const control = event.target.closest(CONTROL_SELECTOR);
      if (control && isPurchaseTrigger(control)) {
        armConfirmation();
      }
    },
    true
  );

  loadConfig();
  console.info('[No Confirm]', VERSION, '— Item Market & Bazaars only');

  // --- Hub Integration ---
  function showToast(msg) {
    const toast = document.createElement('div');
    toast.textContent = msg;
    toast.style.cssText = 'position:fixed;bottom:60px;left:50%;transform:translateX(-50%);padding:10px 18px;background:rgba(0,0,0,.85);color:#fff;border-radius:8px;font-size:13px;z-index:99999;pointer-events:none;';
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 2500);
  }

  function registerWithHub() {
    document.dispatchEvent(new CustomEvent('torn-script-hub:register', {
      detail: {
        id: HUB_ID,
        name: 'No Confirm Market & Bazaar',
        version: VERSION,
        order: 100,
        open: () => {
          if (!isAllowedPage()) {
            showToast('Only active on Item Market & Bazaar pages');
            return;
          }
          const status = CONFIG.enabled ? 'ON' : 'OFF';
          showToast(`No Confirm is ${status} (Market & Bazaar only)`);
        },
        status: () => {
          if (!isAllowedPage()) return 'Idle — Market & Bazaar only';
          return CONFIG.enabled ? 'Auto-confirm ON' : 'Auto-confirm OFF';
        },
        prefs: {
          fields: [
            {
              key: 'enabled',
              type: 'toggle',
              label: 'Auto-confirm purchases',
              default: true,
              hint: 'Item Market and Bazaars only. Never Auction House, missions, or jobs.'
            },
            {
              key: 'confirmTimeout',
              type: 'number',
              label: 'Confirmation timeout (ms)',
              default: 5000,
              min: 1000,
              max: 30000,
              hint: 'How long to watch for a purchase confirmation dialog before giving up.'
            }
          ],
          values: {
            enabled: CONFIG.enabled,
            confirmTimeout: CONFIG.confirmTimeout,
          },
          onSave: (values) => {
            if (typeof values.enabled === 'boolean') CONFIG.enabled = values.enabled;
            if (Number.isFinite(Number(values.confirmTimeout))) {
              CONFIG.confirmTimeout = Math.min(30000, Math.max(1000, Number(values.confirmTimeout)));
            }
            saveConfig();
            console.info('[No Confirm] Settings updated:', CONFIG);
          }
        }
      }
    }));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', registerWithHub);
  } else {
    registerWithHub();
  }
  document.addEventListener('torn-script-hub:ready', registerWithHub);
})();
