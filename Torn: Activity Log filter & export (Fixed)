    function findNativeSearch(root) {
        return [...root.querySelectorAll('input[type="search"],input[type="text"]')].find((input) => {
            if (input.id === SEARCH_ID || input.closest('#' + UI_ID)) return false;
            const hint = (input.placeholder || input.getAttribute('aria-label') || '').toLowerCase();
            return hint.includes('search') || hint.includes('filter');
        });
    }

    function concealNativeSearch(root) {
        findNativeSearch(root)?.classList.add('alf-native-search-hidden');
    }

    function findRows(root) {
        const preferred = [...root.querySelectorAll('tr,[class*="logRow___"]')];
        const candidates = preferred.length ? preferred : [...root.querySelectorAll('[class*="row___"]')];
        return [...new Set(candidates)].filter((row) =>
            !row.closest('#' + UI_ID) &&
            !String(row.className || '').toLowerCase().includes('title') &&
            row.querySelector('span.log-text,[id^="text-"],[class*="text___"]')
        );
    }

    function rowInfo(row) {
        const textElement = row.querySelector('span.log-text,[id^="text-"],[class*="text___"]');
        const timeElement = row.querySelector('td[class^="time"],[class*="time___"],time');
        const categoryElement = row.querySelector('[class*="category"],[class*="type___"],.category');
        const text = textElement?.textContent?.trim() || '';
        const timeText = timeElement?.textContent?.trim() || '';
        const categoryText = categoryElement?.textContent?.trim() || '';
        return {
            row,
            textElement,
            text,
            timeText,
            date: findSemanticDate(row, timeElement) || parseDisplayedDate(timeText),
            category: categoryText || 'Other'
        };
    }

    function parseQuery(query) {
        const result = { includes: [], excludes: [], has: [], notHas: [] };
        const matcher = /"([^"]+)"|(\S+)/g;
        let match;
        while ((match = matcher.exec(query))) {
            let token = match[1] ?? match[2];
            const quoted = match[1] != null;
            let negated = false;
            if (!quoted && token.startsWith('-') && token.length > 1) {
                negated = true;
                token = token.slice(1);
            }
            const operator = !quoted && token.match(/^([a-z]+):(.*)$/i);
            if (operator?.[1].toLowerCase() === 'has' && operator[2]) {
                (negated ? result.notHas : result.has).push(operator[2].toLowerCase());
            } else if (negated) {
                result.excludes.push(token.toLowerCase());
            } else {
                result.includes.push(token.toLowerCase());
            }
        }
        return result;
    }

    function matchesHas(info, filter) {
        const text = info.text.toLowerCase();
        const category = info.category.toLowerCase();
        if (filter === 'money') return /[$£€]\s*[\d,.]+/.test(info.text) || category.includes('money');
        if (filter === 'item') return category.includes('item') || /\bused\b|\bbought\b|\bpurchased\b|\breceived\b/.test(text);
        if (filter === 'link') return Boolean(info.row.querySelector('a[href]'));
        return text.includes(filter) || category.includes(filter);
    }

    // FIX: category matching. The old check was `info.category.toLowerCase().includes(state.category.toLowerCase())`,
    // which silently returns zero rows whenever Torn's actual label and the CATEGORIES list disagree on
    // plural/singular form (e.g. actual "Item" vs selector option "Items" -> "item".includes("items") is false).
    // normalizeCategory() strips a trailing 's' before lowercasing, and the comparison checks substring
    // containment in both directions so either form matches the other.
    function normalizeCategory(text) {
        return String(text || '').trim().toLowerCase().replace(/s$/, '');
    }

    function categoryMatches(actualCategory, selectedCategory) {
        if (selectedCategory === 'All') return true;
        const actual = normalizeCategory(actualCategory);
        const selected = normalizeCategory(selectedCategory);
        if (!actual || !selected) return false;
        return actual.includes(selected) || selected.includes(actual);
    }

    function rowMatches(info, query) {
        const haystack = (info.text + ' ' + info.category + ' ' + info.timeText).toLowerCase();
        if (!categoryMatches(info.category, state.category)) return false;
        if (query.includes.some((term) => !haystack.includes(term))) return false;
        if (query.excludes.some((term) => haystack.includes(term))) return false;
        if (query.has.some((filter) => !matchesHas(info, filter))) return false;
        if (query.notHas.some((filter) => matchesHas(info, filter))) return false;

        const from = parseDateValue(state.from);
        const to = parseDateValue(state.to, true);
        if ((from || to) && !info.date) return false;
        if (from && info.date < from) return false;
        if (to && info.date > to) return false;
        return true;
    }

    function sortRows(infos, direction = state.sort) {
        const groups = new Map();
        for (const info of infos) {
            const parent = info.row.parentElement;
            if (!parent) continue;
            if (!groups.has(parent)) groups.set(parent, []);
            groups.get(parent).push(info);
        }
        for (const [container, group] of groups) {
            const dated = group.filter((info) => info.date);
            if (dated.length < 2) continue;
            const desired = dated.map((info, index) => ({ info, index })).sort((a, b) =>
                (direction === 'oldest' ? a.info.date - b.info.date : b.info.date - a.info.date)
                    || a.index - b.index
            ).map((entry) => entry.info);
            if (desired.every((info, index) => info.row === dated[index].row)) continue;
            const children = [...container.children];
            const indexes = dated.map((info) => children.indexOf(info.row));
            if (indexes.some((index) => index < 0)) continue;
            indexes.forEach((childIndex, index) => { children[childIndex] = desired[index].row; });
            container.replaceChildren(...children);
        }
    }

    // FIX: highlighting used to run for every visible row on every render (search input,
    // category change, date change, sort toggle - anything that calls scheduleRender), tearing
    // down and rebuilding <mark> spans even when the query text hadn't changed at all. That's
    // real DOM churn multiplied by row count on every interaction.
    // Now each text element remembers (via a data attribute) which query string it was last
    // highlighted for, and highlightText() is a no-op if that hasn't changed. This also
    // correctly re-highlights a row the first time it becomes visible (e.g. after a date-range
    // change reveals a previously-hidden row that matches the current search), since that row's
    // data attribute won't yet match the current query.
    function highlightText(element, query) {
        if (!element) return;
        if (element.dataset.alfHighlightQuery === query) return;

        element.querySelectorAll('.alf-highlight').forEach(m => {
            m.parentNode.replaceChild(document.createTextNode(m.textContent), m);
        });
        element.normalize();

        if (query) {
            const terms = query.toLowerCase().split(/\s+/).filter(t => t.length > 2 && !t.startsWith('-') && !t.includes(':'));
            if (terms.length > 0) {
                const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
                const textNodes = [];
                while (walker.nextNode()) textNodes.push(walker.currentNode);

                const regex = new RegExp(`(${terms.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi');

                textNodes.forEach(node => {
                    if (!regex.test(node.textContent)) return;
                    regex.lastIndex = 0;
                    const span = document.createElement('span');
                    const parts = node.textContent.split(regex);
                    parts.forEach(part => {
                        if (terms.includes(part.toLowerCase())) {
                            const mark = document.createElement('mark');
                            mark.className = 'alf-highlight';
                            mark.textContent = part;
                            span.appendChild(mark);
                        } else {
                            span.appendChild(document.createTextNode(part));
                        }
                    });
                    node.parentNode.replaceChild(span, node);
                });
            }
        }

        element.dataset.alfHighlightQuery = query || '';
    }

    function injectCopyButtons(infos) {
        infos.forEach(info => {
            let btn = info.row.querySelector('.alf-copy-btn');
            if (!btn) {
                btn = document.createElement('button');
                btn.className = 'alf-copy-btn';
                btn.textContent = '📋';
                btn.title = 'Copy to clipboard';
                btn.type = 'button';
                btn.addEventListener('click', (e) => {
                    // FIX: the button can end up nested inside an <a> (the row's trailing cell
                    // may contain a profile/item link). stopPropagation() alone only stops the
                    // click from bubbling to other listeners - it does not stop the browser's
                    // native anchor navigation, which isn't bubble-triggered. Without
                    // preventDefault() clicking "copy" both copies the text AND navigates away.
                    e.preventDefault();
                    e.stopPropagation();
                    navigator.clipboard.writeText(info.text).then(() => {
                        btn.textContent = '✓';
                        setTimeout(() => btn.textContent = '📋', 1500);
                    });
                });
                // Append to the end of the row or a suitable container
                const lastCell = info.row.lastElementChild;
                if (lastCell) lastCell.appendChild(btn);
                else info.row.appendChild(btn);
            }
            btn.style.display = info.row.classList.contains('alf-hidden') ? 'none' : '';
        });
    }

    function renderChips(ui) {
        const chips = ui.querySelector('.alf-chips');
        const entries = [];
        if (state.query) entries.push({ type: 'query', value: '', label: 'Search: ' + state.query });
        if (state.category !== 'All') entries.push({ type: 'category', value: '', label: 'Category: ' + state.category });
        if (state.dateLabel !== 'All time') entries.push({ type: 'date', value: '', label: state.dateLabel });
        const signature = JSON.stringify(entries);
        if (chips.dataset.signature === signature) {
            ui.querySelector('.alf-clear-all').hidden = entries.length === 0;
            return;
        }
        chips.dataset.signature = signature;
        chips.replaceChildren();
        for (const entry of entries) {
            const button = document.createElement('button');
            button.type = 'button';
            button.className = 'alf-chip';
            button.dataset.chipType = entry.type;
            button.dataset.chipValue = entry.value;
            button.textContent = entry.label + ' ×';
            chips.append(button);
        }
        ui.querySelector('.alf-clear-all').hidden = entries.length === 0;
    }

    function applyFilters() {
        renderScheduled = false;
        if (!state.enabled) return;
        const root = document.querySelector(ROOT_SELECTOR);
        const ui = document.getElementById(UI_ID);
        if (!root || !ui) return;

        applyTheme(ui);
        syncTornControlStyle(ui, root);
        concealNativeSearch(root);
        const search = ui.querySelector('#' + SEARCH_ID);
        if (search.value !== state.query) search.value = state.query;
        ui.querySelector('.alf-category-select').value = state.category;
        ui.querySelector('.alf-date-label').textContent = state.dateLabel;
        const datePopover = ui.querySelector('.alf-date-popover');
        const editingRange = datePopover.classList.contains('alf-open')
            && ui.querySelector('.alf-tab.alf-active')?.dataset.tab === 'range';
        if (!editingRange) {
            ui.querySelector('.alf-from').value = state.from;
            ui.querySelector('.alf-to').value = state.to;
        }
        ui.querySelector('.alf-reverse-button').textContent = state.sort === 'oldest' ? '↕ Restore View' : '↕ Reverse View';
        if (!ui.querySelector('.alf-month').value) ui.querySelector('.alf-month').value = localDateValue(new Date()).slice(0, 7);
        if (!ui.querySelector('.alf-year').value) ui.querySelector('.alf-year').value = String(new Date().getUTCFullYear());
        if (!ui.querySelector('.alf-day').value) {
            ui.querySelector('.alf-day').value = state.from && state.from === state.to
                ? state.from
                : localDateValue(new Date());
        }

        const query = parseQuery(state.query);
        const infos = findRows(root).map(rowInfo);
        let visible = 0;
        for (const info of infos) {
            const matches = rowMatches(info, query);
            info.row.classList.toggle('alf-hidden', !matches);
            if (matches) {
                visible += 1;
                highlightText(info.textElement, state.query);
            } else {
                highlightText(info.textElement, '');
            }
        }
        sortRows(infos);
        renderChips(ui);
        injectCopyButtons(infos);
        ui.querySelector('.alf-meta').textContent = visible + ' of ' + infos.length + ' currently loaded';
    }

    function scheduleRender() {
        if (renderScheduled) return;
        renderScheduled = true;
        requestAnimationFrame(applyFilters);
    }

    function commitFilters() {
        saveState();
        closePopovers();
        scheduleRender();
    }

    function clearAll() {
        state.query = '';
        state.from = '';
        state.to = '';
        state.dateLabel = 'All time';
        state.category = 'All';
        commitFilters();
    }

    function closePopovers(except) {
        const ui = document.getElementById(UI_ID);
        if (!ui) return;
        ui.querySelectorAll('.alf-popover').forEach((popover) => {
            if (popover !== except) popover.classList.remove('alf-open');
        });
        ui.querySelectorAll('[aria-expanded="true"]').forEach((button) => {
            if (!except?.classList.contains('alf-date-popover')) button.setAttribute('aria-expanded', 'false');
        });
    }

    function togglePopover(button, popover) {
        const opening = !popover.classList.contains('alf-open');
        closePopovers(opening ? popover : null);
        popover.classList.toggle('alf-open', opening);
        button.setAttribute('aria-expanded', String(opening));
        if (opening && popover.classList.contains('alf-presets-popover')) {
            renderPresetsList(popover);
        }
    }

    // FIX: preset names came straight from a user-editable text field and were spliced into
    // innerHTML unescaped, so a preset named e.g. "<img src=x onerror=alert(1)>" would execute
    // as script the next time the presets popover rendered. Rebuilt with createElement/
    // textContent so the name is always treated as plain text.
    function renderPresetsList(popover) {
        const list = popover.querySelector('.alf-presets-list');
        list.innerHTML = '';
        if (presets.length === 0) {
            const empty = document.createElement('div');
            empty.style.cssText = 'padding:10px;color:var(--alf-muted);font-size:12px;';
            empty.textContent = 'No saved presets.';
            list.append(empty);
            return;
        }
        presets.forEach((preset, index) => {
            const item = document.createElement('div');
            item.style.cssText = 'display:flex;justify-content:space-between;align-items:center;padding:8px 10px;border-bottom:1px solid var(--alf-soft);cursor:pointer;';

            const nameSpan = document.createElement('span');
            nameSpan.style.cssText = 'flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;';
            nameSpan.textContent = preset.name;

            const loadButton = document.createElement('button');
            loadButton.type = 'button';
            loadButton.className = 'alf-btn';
            loadButton.style.cssText = 'height:24px;padding:0 8px;font-size:11px;margin-left:8px;';
            loadButton.textContent = 'Load';

            const deleteButton = document.createElement('button');
            deleteButton.type = 'button';
            deleteButton.className = 'alf-btn';
            deleteButton.style.cssText = 'height:24px;padding:0 8px;font-size:11px;margin-left:4px;color:var(--alf-red);';
            deleteButton.textContent = 'Del';

            item.append(nameSpan, loadButton, deleteButton);

            loadButton.addEventListener('click', (e) => {
                e.stopPropagation();
                loadPreset(index);
            });
            deleteButton.addEventListener('click', (e) => {
                e.stopPropagation();
                deletePreset(index);
                renderPresetsList(popover);
            });
            item.addEventListener('click', () => loadPreset(index));
            list.appendChild(item);
        });
    }

    function savePreset(name) {
        if (!name) return;
        presets.push({
            name,
            query: state.query,
            from: state.from,
            to: state.to,
            dateLabel: state.dateLabel,
            category: state.category
        });
        savePresets();
    }

    function loadPreset(index) {
        const preset = presets[index];
        if (!preset) return;
        state.query = preset.query;
        state.from = preset.from;
        state.to = preset.to;
        state.dateLabel = preset.dateLabel;
        state.category = preset.category;
        commitFilters();
    }

    function deletePreset(index) {
        presets.splice(index, 1);
        savePresets();
    }

    function setQuickRange(range) {
        const now = new Date();
        let from = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
        let to = new Date(from);
        let label = 'All time';
        if (range === 'all') {
            state.from = '';
            state.to = '';
            state.dateLabel = label;
            commitFilters();
            return;
        }
        if (range === 'yesterday') {
            from.setUTCDate(from.getUTCDate() - 1);
            to = new Date(from);
            label = 'Yesterday';
        } else if (/^\d+days$/.test(range)) {
            const days = Number(range.replace('days', ''));
            from.setUTCDate(from.getUTCDate() - days + 1);
            label = 'Last ' + days + ' days';
        } else if (range === 'thismonth') {
            from = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 1));
            to = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + 1, 0));
            label = 'This month';
        } else if (range === 'lastmonth') {
            from = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() - 1, 1));
            to = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), 0));
            label = 'Last month';
        } else if (range === 'thisyear') {
            from = new Date(Date.UTC(now.getUTCFullYear(), 0, 1));
            to = new Date(Date.UTC(now.getUTCFullYear(), 11, 31));
            label = 'This year';
        } else {
            label = 'Today';
        }
        state.from = localDateValue(from);
        state.to = localDateValue(to);
        state.dateLabel = label;
        commitFilters();
    }

    function applyDatePanel(ui) {
        const mode = ui.querySelector('.alf-tab.alf-active')?.dataset.tab || 'day';
        if (mode === 'day') {
            const value = ui.querySelector('.alf-day').value;
            if (!value) return;
            const date = parseDateValue(value);
            state.from = value;
            state.to = value;
            state.dateLabel = date.toLocaleDateString(undefined, {
                day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC'
            });
        } else if (mode === 'month') {
            const value = ui.querySelector('.alf-month').value;
            if (!value) return;
            const parts = value.split('-').map(Number);
            const from = new Date(Date.UTC(parts[0], parts[1] - 1, 1));
            const to = new Date(Date.UTC(parts[0], parts[1], 0));
            state.from = localDateValue(from);
            state.to = localDateValue(to);
            state.dateLabel = from.toLocaleDateString(undefined, { month: 'long', year: 'numeric', timeZone: 'UTC' });
        } else if (mode === 'year') {
            const year = Number(ui.querySelector('.alf-year').value);
            if (!year || year < 2004 || year > 2100) return;
            state.from = year + '-01-01';
            state.to = year + '-12-31';
            state.dateLabel = String(year);
        } else {
            state.from = ui.querySelector('.alf-from').value;
            state.to = ui.querySelector('.alf-to').value;
            state.dateLabel = formatRangeLabel(state.from, state.to);
        }
        commitFilters();
    }

    function csvCell(value) {
        let text = value == null ? '' : String(value).replace(/\r?\n/g, ' ');
        if (/^[=+\-@\t\r]/.test(text)) text = "'" + text;
        return '"' + text.replace(/"/g, '""') + '"';
    }

    function extractCsvData(info) {
        let player = '', item = '', amount = '';
        const profileLink = info.row.querySelector('a[href*="XID="]');
        if (profileLink) player = profileLink.textContent.trim();

        const itemLinks = info.row.querySelectorAll('a[href*="item.php"], a[href*="page.php?sid=itemMarket"]');
        if (itemLinks.length > 0) item = itemLinks[0].textContent.trim();

        const moneyMatch = info.text.match(/[\$£€]\s*([\d,]+)/);
        if (moneyMatch) amount = moneyMatch[1];

        return [info.timeText || 'N/A', info.category, info.text, player, item, amount];
    }

    function exportCsv() {
        const root = document.querySelector(ROOT_SELECTOR);
        if (!root) return;
        const rows = findRows(root)
            .filter((row) => !row.classList.contains('alf-hidden') && getComputedStyle(row).display !== 'none')
            .map(rowInfo);
        if (!rows.length) {
            alert('No currently visible activity-log entries are available to export.');
            return;
        }
        const csv = '\uFEFF' + [
            ['time', 'category', 'text', 'player', 'item', 'amount'],
            ...rows.map((row) => extractCsvData(row))
        ].map((line) => line.map(csvCell).join(',')).join('\r\n') + '\r\n';
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const anchor = document.createElement('a');
        anchor.href = url;
        anchor.download = 'filtered_activity_log.csv';
        anchor.hidden = true;
        document.documentElement.append(anchor);
        anchor.click();
        anchor.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    function bindUi(ui) {
        const search = ui.querySelector('#' + SEARCH_ID);
        search.value = state.query;
        search.addEventListener('input', () => {
            state.query = search.value;
            saveState();
            scheduleRender();
        });
        ui.querySelector('.alf-clear-search').addEventListener('click', () => {
            state.query = '';
            commitFilters();
            search.focus();
        });

        const categorySelect = ui.querySelector('.alf-category-select');
        categorySelect.addEventListener('change', (e) => {
            state.category = e.target.value;
            commitFilters();
        });

        ui.querySelector('.alf-clear-all').addEventListener('click', clearAll);
        ui.querySelector('.alf-reverse-button').addEventListener('click', () => {
            state.sort = state.sort === 'oldest' ? 'newest' : 'oldest';
            saveState();
            scheduleRender();
        });
        ui.querySelector('.alf-export-button').addEventListener('click', exportCsv);
        ui.querySelector('.alf-theme-button').addEventListener('click', () => {
            state.theme = state.theme === 'dark' ? 'light' : 'dark';
            saveState();
            applyTheme(ui);
            const root = document.querySelector(ROOT_SELECTOR);
            if (root) syncTornControlStyle(ui, root, true);
        });

        const dateButton = ui.querySelector('.alf-date-button');
        const datePopover = ui.querySelector('.alf-date-popover');
        dateButton.addEventListener('click', () => togglePopover(dateButton, datePopover));

        const presetsButton = ui.querySelector('.alf-presets-button');
        const presetsPopover = ui.querySelector('.alf-presets-popover');
        presetsButton.addEventListener('click', () => togglePopover(presetsButton, presetsPopover));

        ui.querySelector('.alf-save-preset').addEventListener('click', () => {
            const name = ui.querySelector('.alf-preset-name').value.trim();
            if (name) {
                savePreset(name);
                ui.querySelector('.alf-preset-name').value = '';
                renderPresetsList(presetsPopover);
            }
        });

        ui.querySelectorAll('.alf-tab').forEach((tab) => {
            tab.addEventListener('click', () => {
                ui.querySelectorAll('.alf-tab').forEach((item) => item.classList.toggle('alf-active', item === tab));
                ui.querySelectorAll('.alf-date-panel').forEach((panel) => panel.classList.toggle('alf-active', panel.dataset.panel === tab.dataset.tab));
                if (tab.dataset.tab === 'range') {
                    const fromInput = ui.querySelector('.alf-from');
                    const toInput = ui.querySelector('.alf-to');
                    fromInput.value = state.from;
                    toInput.value = state.from && state.from === state.to ? '' : state.to;
                }
            });
        });
        ui.querySelector('.alf-date-apply').addEventListener('click', () => applyDatePanel(ui));
        ui.querySelector('.alf-date-clear').addEventListener('click', () => setQuickRange('all'));
        ui.querySelector('.alf-day').addEventListener('change', (event) => {
            if (!event.target.value) return;
            const date = parseDateValue(event.target.value);
            state.from = event.target.value;
            state.to = event.target.value;
            state.dateLabel = date.toLocaleDateString(undefined, {
                day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC'
            });
            commitFilters();
        });
        ui.addEventListener('click', (event) => {
            const quick = event.target.closest('[data-range]');
            if (quick) setQuickRange(quick.dataset.range);
            const chip = event.target.closest('[data-chip-type]');
            if (!chip) return;
            if (chip.dataset.chipType === 'query') state.query = '';
            else if (chip.dataset.chipType === 'category') state.category = 'All';
            else if (chip.dataset.chipType === 'date') {
                state.from = '';
                state.to = '';
                state.dateLabel = 'All time';
            }
            commitFilters();
        });
    }

    function ensureUi() {
        if (!isLogPage() || !state.enabled) return;
        if (document.getElementById(UI_ID)) {
            uiMounted = true;
            return;
        }
        const root = document.querySelector(ROOT_SELECTOR);
        if (!root) return;
        if (!state.theme) state.theme = detectedTornTheme(root);
        installStyles();
        const ui = document.createElement('section');
        ui.id = UI_ID;
        ui.setAttribute('aria-label', 'Activity log filters');
        ui.innerHTML = markup();
        applyTheme(ui);
        const nativeToolbar = root.querySelector('[class*="filterWrapper"],[class*="buttonsWrapper"]');
        if (nativeToolbar) nativeToolbar.insertAdjacentElement('afterend', ui);
        else root.prepend(ui);
        uiMounted = true;
        bindUi(ui);
        concealNativeSearch(root);
        scheduleRender();
    }

    function onDocumentClick(event) {
        const ui = document.getElementById(UI_ID);
        if (ui && !ui.contains(event.target)) closePopovers();
    }

    function onDocumentKeydown(event) {
        if (event.key === 'Escape') closePopovers();
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
            const search = document.getElementById(SEARCH_ID);
            if (search) {
                event.preventDefault();
                search.focus();
            }
        }
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'e') {
            event.preventDefault();
            exportCsv();
        }
    }

    function bindInteractions() {
        if (interactionsBound) return;
        interactionsBound = true;
        document.addEventListener('click', onDocumentClick);
        document.addEventListener('keydown', onDocumentKeydown);
    }

    function unbindInteractions() {
        if (!interactionsBound) return;
        interactionsBound = false;
        document.removeEventListener('click', onDocumentClick);
        document.removeEventListener('keydown', onDocumentKeydown);
    }

    function teardownUi() {
        if (!uiMounted) return;
        const root = document.querySelector(ROOT_SELECTOR);
        if (root) {
            const infos = findRows(root).map(rowInfo);
            infos.forEach((info) => {
                info.row.classList.remove('alf-hidden');
                highlightText(info.textElement, '');
                info.row.querySelector('.alf-copy-btn')?.remove();
            });
            sortRows(infos, 'newest');
        }
        document.querySelectorAll('.alf-native-search-hidden').forEach((element) => {
            element.classList.remove('alf-native-search-hidden');
        });
        document.getElementById(UI_ID)?.remove();
        document.getElementById(STYLE_ID)?.remove();
        controlStyleCache = null;
        renderScheduled = false;
        uiMounted = false;
    }

    // FIX: this used to call pageObserver.disconnect() whenever the page became inactive
    // (navigated off sid=log, or the toolbar was disabled) and nothing ever re-observed
    // afterwards. That permanently killed the one mechanism that (a) detects returning to the
    // log page via client-side/SPA navigation, since popstate/hashchange don't reliably fire for
    // pushState-based routing, and (b) detects new rows Torn appends via "load more" pagination,
    // so search/filter/highlight/copy-button injection would silently stop tracking new content
    // for the rest of the session after the very first page-leave. The observer now stays
    // connected to document.body for the lifetime of the script; only the UI and its listeners
    // are torn down/rebuilt as the page state changes.
    function updatePageLifecycle() {
        if (!isLogPage() || !state.enabled) {
            teardownUi();
            unbindInteractions();
            return;
        }
        bindInteractions();
        ensureUi();
        scheduleRender();
    }

    function getStatusText() {
        if (!state.enabled) return 'Disabled';
        const meta = document.querySelector('#' + UI_ID + ' .alf-meta');
        if (meta && meta.textContent) return meta.textContent;
        const parts = [];
        if (state.query) parts.push('search: ' + state.query);
        if (state.category !== 'All') parts.push('cat: ' + state.category);
        if (state.dateLabel && state.dateLabel !== 'All time') parts.push(state.dateLabel);
        if (state.sort === 'oldest') parts.push('oldest first');
        return parts.length ? parts.join(' · ') : 'Ready on Activity Log';
    }

    function registerWithHub() {
        document.dispatchEvent(new CustomEvent('torn-script-hub:register', {
            detail: {
                id: HUB_ID,
                name: 'Activity Log Filter & CSV',
                version: SCRIPT_VERSION,
                order: 320,
                open: () => {
                    if (!isLogPage()) {
                        window.location.href = 'https://www.torn.com/page.php?sid=log';
                        return;
                    }
                    ensureUi();
                    document.getElementById(SEARCH_ID)?.focus();
                },
                close: () => {
                    state.enabled = false;
                    saveSettings();
                    updatePageLifecycle();
                },
                status: getStatusText,
                prefs: {
                    fields: [
                        {
                            key: 'enabled',
                            type: 'toggle',
                            label: 'Show filter toolbar',
                            default: true,
                            hint: 'Display the search, date, reverse, and CSV controls on the Activity Log page (desktop and PDA)'
                        }
                    ],
                    values: {
                        enabled: state.enabled
                    },
                    onSave: (values) => {
                        state.enabled = !!values.enabled;
                        saveSettings();
                        updatePageLifecycle();
                    }
                }
            }
        }));
    }

    function onViewportChange() {
        updatePageLifecycle();
        const ui = document.getElementById(UI_ID);
        const root = document.querySelector(ROOT_SELECTOR);
        if (ui && root) syncTornControlStyle(ui, root, true);
    }

    function init() {
        loadState();
        registerWithHub();
        document.addEventListener('torn-script-hub:ready', registerWithHub);

        try {
            GM_registerMenuCommand('Focus Activity Log Search', () => {
                ensureUi();
                document.getElementById(SEARCH_ID)?.focus();
            });
            GM_registerMenuCommand('Export Visible Logs as CSV', exportCsv);
            GM_registerMenuCommand('Clear Activity Log Filters', clearAll);
        } catch (_) {}

        pageObserver = new MutationObserver((mutations) => {
            if (!isLogPage() || !state.enabled) {
                updatePageLifecycle();
                return;
            }
            const externalMutation = mutations.some((mutation) =>
                !mutation.target.closest?.('#' + UI_ID)
            );
            if (!externalMutation) return;
            updatePageLifecycle();
            if (!controlStyleCache?.sample) {
                const ui = document.getElementById(UI_ID);
                const root = document.querySelector(ROOT_SELECTOR);
                if (ui && root) syncTornControlStyle(ui, root, true);
            }
        });
        if (document.body) {
            pageObserver.observe(document.body, { childList: true, subtree: true });
        } else {
            document.addEventListener('DOMContentLoaded', () => {
                pageObserver.observe(document.body, { childList: true, subtree: true });
            }, { once: true });
        }
        desktopMedia.addEventListener('change', onViewportChange);
        window.addEventListener('popstate', updatePageLifecycle);
        window.addEventListener('hashchange', updatePageLifecycle);
        updatePageLifecycle();
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
    else init();
})();
