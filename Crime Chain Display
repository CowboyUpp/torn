    // 122 bits of entropy, no external dependency — this token is the only
    // thing gating access to a KV partition on the shared Worker, so it must
    // never be predictable. Treated like the log API key everywhere in the
    // UI: password-masked input, never written to the diagnostics log.
    function generateSyncToken() {
        if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
            return crypto.randomUUID().replace(/-/g, '');
        }
        // Fallback for older engines: still crypto-sourced, just assembled by hand.
        const bytes = new Uint8Array(16);
        (crypto.getRandomValues ? crypto : window.crypto).getRandomValues(bytes);
        return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
    }

    // Thin Promise wrapper around GM_xmlhttpRequest, used instead of page fetch()
    // specifically because it's a brand-new cross-origin destination outside
    // Torn's own API — GM_xmlhttpRequest runs outside the page's CSP, whereas
    // window.fetch to a new host could silently be blocked by it. Declared via
    // @connect in the userscript header, which is what triggers Tampermonkey's
    // one-time cross-origin permission prompt on first use.
    function gmRequest(details) {
        return new Promise((resolve, reject) => {
            if (typeof GM_xmlhttpRequest !== 'function') {
                reject(new Error('GM_xmlhttpRequest not granted'));
                return;
            }
            GM_xmlhttpRequest({
                ...details,
                onload: (res) => resolve(res),
                onerror: (err) => reject(err || new Error('network error')),
                ontimeout: () => reject(new Error('timeout')),
                timeout: 15000,
            });
        });
    }

    function syncStatusEl() {
