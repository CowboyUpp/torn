    let outsideClickWired = false;

    // Pure CSS (max-width + right:0/left:0) can bound a popover's *size* to the
    // viewport, but it can't know where the widget itself actually sits on
    // screen — on Torn's mobile/PDA layout the widget can be near the left
    // edge, which left a right-anchored popover mostly off-canvas to the left
    // with nothing to scroll or drag it into view. This measures the popover's
    // real on-screen position after CSS has placed it, and nudges it back
    // in-bounds with an inline left offset (converted into rootEl's own
    // coordinate space, since the popover is absolutely positioned relative
    // to rootEl, not the viewport).
    function clampPopoverToViewport(popover, rootEl) {
        const margin = 8;
        const viewportWidth = window.innerWidth;
        const rootRect = rootEl.getBoundingClientRect();
        const rect = popover.getBoundingClientRect();

        let desiredLeft = rect.left;
        if (rect.right > viewportWidth - margin) desiredLeft = viewportWidth - margin - rect.width;
        if (desiredLeft < margin) desiredLeft = margin;

        popover.style.left = `${desiredLeft - rootRect.left}px`;
        popover.style.right = 'auto';
    }

    let viewportClampWired = false;

    function wireViewportClampOnce() {
        if (viewportClampWired) return;
        viewportClampWired = true;

        // Re-clamp whichever popover is currently open on resize/rotation —
        // covers switching a phone between portrait and landscape, or a
        // desktop window being resized, while a popover is sitting open.
        const reclamp = () => {
            const root = document.querySelector('#cct-root');
            if (!root) return;
            const settingsPopover = document.querySelector('#cct-settings-popover');
            const profitPopover = document.querySelector('#cct-profit-popover');
            if (settingsPopover && settingsPopover.classList.contains('cct-open')) {
                clampPopoverToViewport(settingsPopover, root);
            }
            if (profitPopover && profitPopover.classList.contains('cct-open')) {
                clampPopoverToViewport(profitPopover, root);
            }
        };
        window.addEventListener('resize', reclamp);
        window.addEventListener('orientationchange', reclamp);
    }

    function wireOutsideClickOnce() {
        if (outsideClickWired) return;
        outsideClickWired = true;

        // Single delegated listener for the lifetime of the page. Looks up the
        // *current* #cct-root and #cct-settings-popover at click time instead of
        // closing over a specific widget instance, so rebuilding the widget
        // after SPA navigation never accumulates extra document listeners.
        document.addEventListener('click', (e) => {
            const root = document.querySelector('#cct-root');
            const popover = document.querySelector('#cct-settings-popover');
            const profitPopover = document.querySelector('#cct-profit-popover');
