// ==UserScript==
// @name         Torn Script Hub
// @namespace    https://greasyfork.org/users/cowboyup
// @version      2.0.1
// @description  The central command center for your Torn scripts. Desktop: native sidebar item. Mobile/PDA: native Swiper slide. Dashboard for launch, prefs, and help.
// @author       cowboyup
// @match        https://www.torn.com/*
// @run-at       document-start
// @grant        none
// @license      MIT
// ==/UserScript==

(function () {
    'use strict';

    const HUB_VERSION = '2.0.1';
    const EVENTS = Object.freeze({
        REGISTER:   'torn-script-hub:register',
        UNREGISTER: 'torn-script-hub:unregister',
        READY:      'torn-script-hub:ready'
    });
    const IDS = Object.freeze({
        ROW:       'tsh-sidebar-row',
        MENU:      'tsh-menu',
        STYLE:     'tsh-style',
        DASHBOARD: 'tsh-dashboard'
    });
    const STORAGE_KEY = 'tsh-onboarded';

    const registry = new Map();
    let readyFired = false;
    let mountMode = 'row';
    let dashboardOpen = false;

    // =========================================================================
    // QUEUE
    // =========================================================================
    const QUEUE_PROPERTY = '__tornScriptHubQueue';

    function ensureQueue(target) {
        if (!target[QUEUE_PROPERTY] || !Array.isArray(target[QUEUE_PROPERTY])) {
            target[QUEUE_PROPERTY] = [];
        }
        const q = target[QUEUE_PROPERTY];
        if (!q.__tshPatched) {
            const originalPush = q.push.bind(q);
            q.push = function (...items) {
                const result = originalPush(...items);
                items.forEach(item => registerScript(item));
                return result;
            };
            q.__tshPatched = true;
        }
        return q;
    }

    function getQueues() {
        const queues = [];
        if (typeof window !== 'undefined') queues.push(ensureQueue(window));
        if (document.documentElement) queues.push(ensureQueue(document.documentElement));
        return queues;
    }

    function drainQueue() {
        getQueues().forEach(queue => {
            if (!queue.length) return;
            const pending = queue.splice(0, queue.length);
            pending.forEach(registerScript);
        });
    }

    // =========================================================================
    // REGISTRATION
    // =========================================================================
    function normalizeRegistration(detail) {
        if (!detail || typeof detail !== 'object') return null;
        const id   = String(detail.id   || '').trim();
        const name = String(detail.name || '').trim();
        if (!id || !name) return null;
        if (typeof detail.open !== 'function') return null;

        const entry = {
            id, name,
            version: detail.version ? String(detail.version) : '',
            icon:    detail.icon || null,
            order:   Number.isFinite(detail.order) ? detail.order : 1000,
            open:    detail.open,
            active:  detail.active !== false,
            prefs:   null
        };

        if (detail.prefs && typeof detail.prefs === 'object') {
            entry.prefs = {
                fields: Array.isArray(detail.prefs.fields) ? detail.prefs.fields : [],
                onSave: typeof detail.prefs.onSave === 'function' ? detail.prefs.onSave : null,
                values: detail.prefs.values || {}
            };
            entry.prefs.fields.forEach(f => {
                if (!(f.key in entry.prefs.values)) {
                    entry.prefs.values[f.key] = f.default !== undefined ? f.default : null;
                }
            });
        }

        return entry;
    }

    function registerScript(detail) {
        const script = normalizeRegistration(detail);
        if (!script) return;
        registry.set(script.id, script);
        renderMenu();
        if (dashboardOpen) renderDashboard();
    }

    function unregisterScript(detail) {
        if (!detail) return;
        const id = typeof detail === 'string' ? detail : String(detail.id || '').trim();
        if (!id) return;
        registry.delete(id);
        renderMenu();
        if (dashboardOpen) renderDashboard();
    }

    document.addEventListener(EVENTS.REGISTER, e => { if (e?.detail) registerScript(e.detail); });
    document.addEventListener(EVENTS.UNREGISTER, e => { if (e?.detail) unregisterScript(e.detail); });

    // =========================================================================
    // HUB ICON
    // =========================================================================
    function createHubIcon() {
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('viewBox', '0 0 128 128');
        svg.setAttribute('class', 'tsh-svg');
        svg.setAttribute('aria-hidden', 'true');
        svg.setAttribute('width', '18');
        svg.setAttribute('height', '18');
        svg.innerHTML = [
            '<path d="M34 14h60l20 20v60l-20 20H34L14 94V34z" fill="none" stroke="currentColor" stroke-width="8" stroke-linejoin="round" opacity="0.35"/>',
            '<circle cx="64" cy="64" r="22" fill="none" stroke="currentColor" stroke-width="10" stroke-dasharray="8 4"/>',
            '<circle cx="64" cy="64" r="8" fill="currentColor"/>',
            '<path d="M26 40V26h14M102 40V26H88M26 88v14h14M102 88v14H88" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>'
        ].join('');
        return svg;
    }

    // =========================================================================
    // DESKTOP ROW
    // =========================================================================
    function createNativeRow(template) {
        const row = template.cloneNode(true);
        row.id = IDS.ROW;
        row.classList.remove('active___xlAlO');

        const link = row.querySelector('a');
        if (link) {
            link.removeAttribute('href');
            link.addEventListener('click', e => {
                e.preventDefault();
                e.stopPropagation();
                toggleMenu();
            });
        }

        const iconWrap = row.querySelector('[class*="svgIconWrap"], [class*="defaultIcon"], svg, img');
        if (iconWrap) {
            if (iconWrap.tagName === 'SVG' || iconWrap.tagName === 'IMG') {
                iconWrap.replaceWith(createHubIcon());
            } else {
                iconWrap.innerHTML = '';
                iconWrap.appendChild(createHubIcon());
            }
        }

        const nameEl = row.querySelector('[class*="linkName"]');
        if (nameEl) {
            nameEl.textContent = `Script Hub v${HUB_VERSION}`;
        } else {
            const spans = row.querySelectorAll('span');
            for (const s of spans) {
                if (s.textContent && s.textContent.trim() && !s.querySelector('svg')) {
                    s.textContent = `Script Hub v${HUB_VERSION}`;
                    break;
                }
            }
        }

        row.querySelectorAll('[class*="amount"], [class*="badge"], [class*="count"], [class*="notification"], [class*="pill"]').forEach(el => el.remove());

        row.setAttribute('role', 'button');
        row.setAttribute('tabindex', '0');
        row.setAttribute('aria-haspopup', 'menu');
        row.setAttribute('aria-expanded', 'false');
        row.title = 'Torn Script Hub';
        row.style.cursor = 'pointer';

        // FIX #2: Removed redundant row-level click listener.
        // The <a> tag inside the cloned row spans the full clickable area,
        // so the link's click handler (with stopPropagation) is sufficient.
        // Keeping only keyboard handler on the row for a11y.
        row.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                toggleMenu();
            }
            if (e.key === 'Escape') {
                closeMenu();
                closeDashboard();
            }
        });

        return row;
    }

    // =========================================================================
    // MOBILE/PDA SWIPER SLIDE
    // =========================================================================
    function createSwiperSlide(templateSlide) {
        const slide = templateSlide.cloneNode(true);
        slide.id = IDS.ROW;
        slide.classList.remove('active___xlAlO');

        const link = slide.querySelector('a');
        if (link) {
            link.removeAttribute('href');
            link.addEventListener('click', e => {
                e.preventDefault();
                e.stopPropagation();
                toggleMenu();
            });
        }

        const iconWrap = slide.querySelector('[class*="svgIconWrap"], [class*="defaultIcon"], svg, img');
        if (iconWrap) {
            if (iconWrap.tagName === 'SVG' || iconWrap.tagName === 'IMG') {
                iconWrap.replaceWith(createHubIcon());
            } else {
                iconWrap.innerHTML = '';
                iconWrap.appendChild(createHubIcon());
            }
        }

        const nameEl = slide.querySelector('[class*="linkName"]');
        if (nameEl) {
            nameEl.textContent = 'Scripts';
        } else {
            const spans = slide.querySelectorAll('span');
            for (const s of spans) {
                if (s.textContent && s.textContent.trim() && !s.querySelector('svg')) {
                    s.textContent = 'Scripts';
                    break;
                }
            }
        }

        slide.querySelectorAll('[class*="amount"], [class*="badge"], [class*="count"], [class*="notification"], [class*="pill"]').forEach(el => el.remove());

        slide.setAttribute('role', 'button');
        slide.setAttribute('tabindex', '0');
        slide.setAttribute('aria-haspopup', 'menu');
        slide.setAttribute('aria-expanded', 'false');
        slide.title = 'Torn Script Hub';
        slide.style.cursor = 'pointer';

        // FIX #2: Same here — only keyboard handler on the slide itself.
        // The <a> tag handles the tap/click.
        slide.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                toggleMenu();
            }
            if (e.key === 'Escape') {
                closeMenu();
                closeDashboard();
            }
        });

        return slide;
    }

    // =========================================================================
    // DROPDOWN MENU
    // =========================================================================
    function getSortedScripts() {
        return Array.from(registry.values())
            .filter(s => s.active)
            .sort((a, b) => {
                if (a.order !== b.order) return a.order - b.order;
                return a.name.localeCompare(b.name);
            });
    }

    function createMenu() {
        const menu = document.createElement('div');
        menu.id = IDS.MENU;
        menu.className = 'tsh-menu';
        menu.setAttribute('role', 'menu');
        return menu;
    }

    function renderMenu() {
        const menu = document.getElementById(IDS.MENU);
        if (!menu) return;
        menu.innerHTML = '';
        const scripts = getSortedScripts();

        if (scripts.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'tsh-empty';
            empty.textContent = 'No active scripts';
            menu.appendChild(empty);
        } else {
            scripts.forEach(script => {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'tsh-item';
                item.setAttribute('role', 'menuitem');

                const icon = document.createElement('span');
                icon.className = 'tsh-item-icon';
                icon.textContent = script.icon || '›';
                item.appendChild(icon);

                const text = document.createElement('span');
                text.className = 'tsh-item-text';
                text.textContent = script.name;
                item.appendChild(text);

                if (script.version) {
                    const ver = document.createElement('span');
                    ver.className = 'tsh-item-version';
                    ver.textContent = 'v' + script.version;
                    item.appendChild(ver);
                }

                item.addEventListener('click', e => {
                    e.preventDefault();
                    e.stopPropagation();
                    closeMenu();
                    try { script.open(); }
                    catch (err) { console.error('[TSH] Failed to open "' + script.name + '"', err); }
                });
                menu.appendChild(item);
            });
        }

        const hr = document.createElement('div');
        hr.className = 'tsh-divider';
        menu.appendChild(hr);

        const manage = document.createElement('button');
        manage.type = 'button';
        manage.className = 'tsh-item tsh-item-manage';
        manage.innerHTML = '<span class="tsh-item-icon">🎛️</span><span class="tsh-item-text">Open Dashboard</span>';
        manage.addEventListener('click', e => {
            e.preventDefault();
            e.stopPropagation();
            closeMenu();
            openDashboard();
        });
        menu.appendChild(manage);
    }

    function positionMenu() {
        const row  = document.getElementById(IDS.ROW);
        const menu = document.getElementById(IDS.MENU);
        if (!row || !menu) return;

        const rect = row.getBoundingClientRect();
        if (rect.width === 0 && rect.height === 0) {
            closeMenu();
            return;
        }

        const menuWidth = menu.offsetWidth || 260;
        const menuHeight = menu.offsetHeight || 200;

        let left, top;
        if (mountMode === 'swiper') {
            left = rect.left;
            if (left + menuWidth > window.innerWidth - 10) {
                left = rect.right - menuWidth;
            }
            left = Math.max(8, left);

            top = rect.top - menuHeight - 8;
            if (top < 8) top = rect.bottom + 8;
        } else {
            left = rect.right + 8;
            if (left + menuWidth > window.innerWidth - 10) {
                left = rect.left - menuWidth - 8;
            }
            left = Math.max(8, left);

            top = rect.top;
            if (top + 280 > window.innerHeight) {
                top = Math.max(8, window.innerHeight - 300);
            }
        }

        menu.style.left = Math.round(left) + 'px';
        menu.style.top  = Math.round(top) + 'px';
    }

    function openMenu() {
        const row  = document.getElementById(IDS.ROW);
        const menu = document.getElementById(IDS.MENU);
        if (!row || !menu) return;
        renderMenu();
        positionMenu();
        menu.classList.add('tsh-open');
        row.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
        const row  = document.getElementById(IDS.ROW);
        const menu = document.getElementById(IDS.MENU);
        if (!row || !menu) return;
        menu.classList.remove('tsh-open');
        row.setAttribute('aria-expanded', 'false');
    }

    function toggleMenu() {
        const menu = document.getElementById(IDS.MENU);
        if (!menu) return;
        menu.classList.contains('tsh-open') ? closeMenu() : openMenu();
    }

    // =========================================================================
    // DASHBOARD
    // =========================================================================
    function openDashboard() {
        closeMenu();
        let dash = document.getElementById(IDS.DASHBOARD);
        if (dash) {
            dash.classList.add('tsh-dash-open');
            dashboardOpen = true;
            renderDashboard();
            return;
        }

        dash = document.createElement('div');
        dash.id = IDS.DASHBOARD;
        dash.className = 'tsh-dashboard';
        dash.innerHTML = `
            <div class="tsh-dash-backdrop"></div>
            <div class="tsh-dash-panel">
                <div class="tsh-dash-header">
                    <h2>🎯 Script Hub <span class="tsh-dash-ver">v${escapeHtml(HUB_VERSION)}</span></h2>
                    <button class="tsh-dash-close" aria-label="Close dashboard">✕</button>
                </div>
                <div class="tsh-dash-tabs">
                    <button data-tab="launch" class="tsh-dash-tab active">Launchpad</button>
                    <button data-tab="prefs" class="tsh-dash-tab">Preferences</button>
                    <button data-tab="help" class="tsh-dash-tab">Help</button>
                </div>
                <div class="tsh-dash-body">
                    <div data-panel="launch" class="tsh-dash-panel-content active"></div>
                    <div data-panel="prefs" class="tsh-dash-panel-content"></div>
                    <div data-panel="help" class="tsh-dash-panel-content"></div>
                </div>
            </div>
        `;
        document.body.appendChild(dash);
        dashboardOpen = true;

        dash.querySelector('.tsh-dash-close').addEventListener('click', closeDashboard);
        dash.querySelector('.tsh-dash-backdrop').addEventListener('click', closeDashboard);

        dash.querySelectorAll('.tsh-dash-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                dash.querySelectorAll('.tsh-dash-tab').forEach(t => t.classList.remove('active'));
                dash.querySelectorAll('.tsh-dash-panel-content').forEach(p => p.classList.remove('active'));
                tab.classList.add('active');
                dash.querySelector(`[data-panel="${tab.dataset.tab}"]`).classList.add('active');
            });
        });

        renderDashboard();
    }

    function closeDashboard() {
        const dash = document.getElementById(IDS.DASHBOARD);
        if (dash) dash.classList.remove('tsh-dash-open');
        dashboardOpen = false;
    }

    function renderDashboard() {
        const dash = document.getElementById(IDS.DASHBOARD);
        if (!dash) return;
        renderLaunchPanel(dash.querySelector('[data-panel="launch"]'));
        renderPrefsPanel(dash.querySelector('[data-panel="prefs"]'));
        renderHelpPanel(dash.querySelector('[data-panel="help"]'));
    }

    // ----- Launchpad -----
    function renderLaunchPanel(container) {
        container.innerHTML = '';
        const scripts = Array.from(registry.values()).sort((a, b) => {
            if (a.order !== b.order) return a.order - b.order;
            return a.name.localeCompare(b.name);
        });

        if (!scripts.length) {
            container.innerHTML = `
                <div class="tsh-dash-empty">
                    <div style="font-size:32px;margin-bottom:8px;">📭</div>
                    <strong>No scripts registered yet.</strong><br>
                    Install a satellite script that supports the Hub, or add one manually below.
                </div>
            `;
        } else {
            const grid = document.createElement('div');
            grid.className = 'tsh-dash-grid';
            scripts.forEach(script => {
                const card = document.createElement('div');
                card.className = 'tsh-dash-card' + (script.active ? '' : ' tsh-dash-card-off');
                card.title = script.active ? 'Click to run' : 'Turned off — enable below';
                card.innerHTML = `
                    <div class="tsh-dash-card-icon">${script.icon || '⚡'}</div>
                    <div class="tsh-dash-card-name">${escapeHtml(script.name)}</div>
                    ${script.version ? `<div class="tsh-dash-card-ver">v${escapeHtml(script.version)}</div>` : ''}
                `;
                if (script.active) {
                    card.addEventListener('click', () => {
                        try { script.open(); } catch (e) { console.error(e); }
                    });
                }

                const toggle = document.createElement('button');
                toggle.type = 'button';
                toggle.className = 'tsh-dash-toggle' + (script.active ? ' active' : '');
                toggle.textContent = script.active ? 'ON' : 'OFF';
                toggle.title = script.active ? 'Click to disable' : 'Click to enable';
                toggle.addEventListener('click', e => {
                    e.stopPropagation();
                    script.active = !script.active;
                    renderDashboard();
                    renderMenu();
                });
                card.appendChild(toggle);

                grid.appendChild(card);
            });
            container.appendChild(grid);
        }

        const manual = document.createElement('div');
        manual.className = 'tsh-manual-box';
        manual.innerHTML = '<h3 class="tsh-dash-subtitle">➕ Add a Script Manually</h3>';
        const form = document.createElement('div');
        form.className = 'tsh-manual-form';
        form.innerHTML = `
            <input type="text" class="tsh-pref-input" placeholder="Script name" id="tsh-manual-name">
            <input type="text" class="tsh-pref-input" placeholder="Icon (emoji)" id="tsh-manual-icon" value="⚡" maxlength="4">
            <input type="text" class="tsh-pref-input" placeholder="CSS selector to click (optional)" id="tsh-manual-sel" title="If the script left a button on the page, paste its selector here. The Hub will click it for you.">
            <button class="tsh-discover-btn" id="tsh-manual-add">Add to Hub</button>
        `;
        manual.appendChild(form);
        container.appendChild(manual);

        form.querySelector('#tsh-manual-add').addEventListener('click', () => {
            const name = form.querySelector('#tsh-manual-name').value.trim();
            const icon = form.querySelector('#tsh-manual-icon').value.trim() || '⚡';
            const sel  = form.querySelector('#tsh-manual-sel').value.trim();
            if (!name) {
                shakeElement(form.querySelector('#tsh-manual-name'));
                return;
            }
            const id = 'tsh-manual-' + Math.random().toString(36).slice(2, 7);
            registerScript({
                id, name, icon, order: 3000, active: true,
                open: () => {
                    if (sel) {
                        const el = document.querySelector(sel);
                        if (el) el.click();
                        else console.warn('[TSH] Manual selector not found:', sel);
                    }
                }
            });
            form.querySelector('#tsh-manual-name').value = '';
            form.querySelector('#tsh-manual-sel').value = '';
            renderDashboard();
        });
    }

    // ----- Preferences -----
    function renderPrefsPanel(container) {
        container.innerHTML = '';
        const scripts = Array.from(registry.values())
            .filter(s => s.prefs && s.active)
            .sort((a, b) => a.name.localeCompare(b.name));

        if (!scripts.length) {
            container.innerHTML = `
                <div class="tsh-dash-empty">
                    <div style="font-size:32px;margin-bottom:8px;">⚙️</div>
                    <strong>No settings available.</strong><br>
                    Scripts that support inline preferences will appear here automatically.
                </div>
            `;
            return;
        }

        scripts.forEach(script => {
            const section = document.createElement('div');
            section.className = 'tsh-pref-section';
            const header = document.createElement('div');
            header.className = 'tsh-pref-header';
            header.innerHTML = `<span>${script.icon || '⚙️'} ${escapeHtml(script.name)}</span>`;
            section.appendChild(header);

            const body = document.createElement('div');
            body.className = 'tsh-pref-body';

            script.prefs.fields.forEach(field => {
                const wrap = document.createElement('label');
                wrap.className = 'tsh-pref-field';

                const label = document.createElement('span');
                label.className = 'tsh-pref-label';
                label.textContent = field.label || field.key;
                if (field.hint) label.title = field.hint;
                wrap.appendChild(label);

                let input;
                if (field.type === 'toggle' || field.type === 'checkbox') {
                    input = document.createElement('button');
                    input.type = 'button';
                    input.className = 'tsh-pref-toggle' + (script.prefs.values[field.key] ? ' active' : '');
                    input.textContent = script.prefs.values[field.key] ? 'ON' : 'OFF';
                    input.addEventListener('click', () => {
                        script.prefs.values[field.key] = !script.prefs.values[field.key];
                        input.textContent = script.prefs.values[field.key] ? 'ON' : 'OFF';
                        input.classList.toggle('active', script.prefs.values[field.key]);
                        if (script.prefs.onSave) script.prefs.onSave(script.prefs.values);
                    });
                } else if (field.type === 'select' && Array.isArray(field.options)) {
                    input = document.createElement('select');
                    input.className = 'tsh-pref-select';
                    field.options.forEach(opt => {
                        const o = document.createElement('option');
                        o.value = opt.value !== undefined ? opt.value : opt;
                        o.textContent = opt.label !== undefined ? opt.label : opt;
                        if (script.prefs.values[field.key] == o.value) o.selected = true;
                        input.appendChild(o);
                    });
                    input.addEventListener('change', () => {
                        script.prefs.values[field.key] = input.value;
                        if (script.prefs.onSave) script.prefs.onSave(script.prefs.values);
                    });
                } else {
                    input = document.createElement('input');
                    input.className = 'tsh-pref-input';
                    input.type = field.type === 'number' ? 'number' : 'text';
                    if (field.min !== undefined) input.min = field.min;
                    if (field.max !== undefined) input.max = field.max;
                    input.value = script.prefs.values[field.key] || '';
                    input.addEventListener('change', () => {
                        script.prefs.values[field.key] = field.type === 'number' ? Number(input.value) : input.value;
                        if (script.prefs.onSave) script.prefs.onSave(script.prefs.values);
                    });
                }

                wrap.appendChild(input);
                body.appendChild(wrap);
            });

            section.appendChild(body);
            container.appendChild(section);
        });
    }

    // ----- Help -----
    function renderHelpPanel(container) {
        container.innerHTML = `
            <div class="tsh-help-wrap">
                <details class="tsh-help-section" open>
                    <summary>🎮 For Players — What is this?</summary>
                    <div class="tsh-help-body">
                        <p><strong>Script Hub</strong> is a control center for Torn userscripts. Instead of every script adding its own random button to the page, they can register here for one clean launchpad.</p>
                        <ul>
                            <li><strong>Launchpad:</strong> See all your scripts as cards. Click to run. Toggle ON/OFF to hide without uninstalling.</li>
                            <li><strong>Preferences:</strong> If a script supports it, change its settings right here instead of hunting for a gear icon.</li>
                            <li><strong>Adding scripts:</strong> Most "satellite" scripts auto-appear when installed. If one doesn't, use the <em>Add a Script Manually</em> form in the Launchpad tab.</li>
                        </ul>
                    </div>
                </details>

                <details class="tsh-help-section">
                    <summary>🛠️ For Script Authors — How do I register?</summary>
                    <div class="tsh-help-body">
                        <p>Fire a single event from your script. The Hub handles the rest.</p>
                        <pre class="tsh-help-code">document.dispatchEvent(new CustomEvent('torn-script-hub:register', {
  detail: {
    id: 'my-script',
    name: 'My Script',
    version: '1.0',
    icon: '🚀',
    order: 100,
    open: () => { /* your main UI function */ },
