// ==UserScript==
// @name         Torn Script Hub
// @namespace    https://greasyfork.org/users/cowboyup
// @version      2.0.0
// @description  The central nervous system for your Torn scripts. Auto-discovers scattered UI, adopts them into one clean dashboard, and hosts every script's preferences.
// @author       cowboyup
// @match        https://www.torn.com/*
// @run-at       document-start
// @grant        none
// @license      MIT
// ==/UserScript==

(function () {
    'use strict';

    const HUB_VERSION = '2.0.0';
    const EVENTS = Object.freeze({
        REGISTER:   'torn-script-hub:register',
        UNREGISTER: 'torn-script-hub:unregister',
        READY:      'torn-script-hub:ready'
    });
    const IDS = Object.freeze({
        ROW:       'tsh-sidebar-row',
        MENU:      'tsh-menu',
        STYLE:     'tsh-style',
        DASHBOARD: 'tsh-dashboard',
        DASHBOARD_STYLE: 'tsh-dashboard-style'
    });

    const registry = new Map();      // { id -> script object }
    const adoptedCSS = new Set();    // selectors we hid
    let readyFired = false;
    let mountMode = 'row';
    let dashboardOpen = false;

    // =========================================================================
    // QUEUE
    // =========================================================================
    const QUEUE_PROPERTY = '__tornScriptHubQueue';
    function ensureQueue(target) {
        if (!target[QUEUE_PROPERTY] || !Array.isArray(target[QUEUE_PROPERTY])) {
            target[QUEUE_PROPERTY] = [];
        }
        const q = target[QUEUE_PROPERTY];
        if (!q.__tshPatched) {
            const originalPush = q.push.bind(q);
            q.push = function (...items) {
                const result = originalPush(...items);
                items.forEach(item => registerScript(item));
                return result;
            };
            q.__tshPatched = true;
        }
        return q;
    }
    function getQueues() {
        const queues = [];
        if (typeof window !== 'undefined') queues.push(ensureQueue(window));
        if (document.documentElement) queues.push(ensureQueue(document.documentElement));
        return queues;
    }
    function drainQueue() {
        getQueues().forEach(queue => {
            if (!queue.length) return;
            const pending = queue.splice(0, queue.length);
            pending.forEach(registerScript);
        });
    }

    // =========================================================================
    // REGISTRATION (enhanced with prefs & detection meta)
    // =========================================================================
    function normalizeRegistration(detail) {
        if (!detail || typeof detail !== 'object') return null;
        const id   = String(detail.id   || '').trim();
        const name = String(detail.name || '').trim();
        if (!id || !name) return null;
        if (typeof detail.open !== 'function') return null;

        const entry = {
            id, name,
            version: detail.version ? String(detail.version) : '',
            icon:    detail.icon || null,
            order:   Number.isFinite(detail.order) ? detail.order : 1000,
            open:    detail.open,
            source:  detail.source || 'registered',
            active:  detail.active !== false,
            prefs:   null,
            detection: detail.detection || null
        };

        if (detail.prefs && typeof detail.prefs === 'object') {
            entry.prefs = {
                fields: Array.isArray(detail.prefs.fields) ? detail.prefs.fields : [],
                onSave: typeof detail.prefs.onSave === 'function' ? detail.prefs.onSave : null,
                values: detail.prefs.values || {}
            };
            // Seed defaults
            entry.prefs.fields.forEach(f => {
                if (!(f.key in entry.prefs.values)) {
                    entry.prefs.values[f.key] = f.default !== undefined ? f.default : null;
                }
            });
        }

        return entry;
    }

    function registerScript(detail) {
        const script = normalizeRegistration(detail);
        if (!script) return;
        registry.set(script.id, script);
        renderMenu();
        if (dashboardOpen) renderDashboard();
    }

    function unregisterScript(detail) {
        if (!detail) return;
        const id = typeof detail === 'string' ? detail : String(detail.id || '').trim();
        if (!id) return;
        registry.delete(id);
        renderMenu();
        if (dashboardOpen) renderDashboard();
    }

    document.addEventListener(EVENTS.REGISTER, e => { if (e?.detail) registerScript(e.detail); });
    document.addEventListener(EVENTS.UNREGISTER, e => { if (e?.detail) unregisterScript(e.detail); });

    // =========================================================================
    // AUTO-DISCOVERY ENGINE
    // =========================================================================
    function isNativeTornElement(el) {
        if (el.id && /^nav-/.test(el.id)) return true;
        if (el.closest('#sidebarroot, #react-root, .d, .wrapper, .content-wrapper, #header, .chat-box')) return false; // actually we want to be conservative
        const nativeMarkers = ['swiper', 'torn', 'react', 'angular', 'vue'];
        const cls = (el.className || '').toString().toLowerCase();
        if (nativeMarkers.some(m => cls.includes(m))) return true;
        return false;
    }

    function generateSelector(el) {
        if (el.id) return '#' + el.id;
        let path = '';
        let curr = el;
        for (let i = 0; i < 4 && curr && curr !== document.body; i++) {
            let tag = curr.tagName.toLowerCase();
            if (curr.className) {
                const c = curr.className.toString().split(/\s+/).filter(x => x && !x.match(/^active/)).slice(0, 2).join('.');
                if (c) tag += '.' + c;
            }
            path = tag + (path ? ' > ' + path : '');
            curr = curr.parentElement;
        }
        return path;
    }

    function inferName(el) {
        const text = (el.textContent || el.title || el.getAttribute('aria-label') || '').trim();
        if (text && text.length < 40) return text;
        if (el.id) return el.id.replace(/-/g, ' ').replace(/_/g, ' ');
        return 'Unknown Script';
    }

    function scanForScripts() {
        const detected = [];
        const seen = new Set();

        // Heuristic 1: fixed / sticky positioned elements that look like buttons or panels
        document.querySelectorAll('button, a, div').forEach(el => {
            const style = window.getComputedStyle(el);
            if (style.position !== 'fixed' && style.position !== 'sticky') return;
            if (el.closest('#' + IDS.ROW + ', .' + IDS.MENU + ', #' + IDS.DASHBOARD)) return;
            if (el.offsetWidth < 24 || el.offsetHeight < 24) return;
            if (el.offsetWidth > 600 || el.offsetHeight > 400) return; // likely a modal container, skip
            if (isNativeTornElement(el)) return;

            const sel = generateSelector(el);
            if (seen.has(sel)) return;
            seen.add(sel);

            detected.push({
                id: 'tsh-detected-' + Math.random().toString(36).slice(2, 9),
                name: inferName(el),
                selector: sel,
                element: el,
                source: 'detected'
            });
        });

        // Heuristic 2: elements with explicit script-like IDs or classes
        document.querySelectorAll('[id*="script"], [class*="script"], [id*="helper"], [class*="helper"]').forEach(el => {
            if (el.closest('#' + IDS.ROW + ', .' + IDS.MENU + ', #' + IDS.DASHBOARD)) return;
            const sel = generateSelector(el);
            if (seen.has(sel)) return;
            seen.add(sel);
            detected.push({
                id: 'tsh-detected-' + Math.random().toString(36).slice(2, 9),
                name: inferName(el),
                selector: sel,
                element: el,
                source: 'detected'
            });
        });

        return detected;
    }

    function adoptDetection(detection) {
        if (!detection || !detection.selector) return;
        const id = detection.id;
        if (registry.has(id)) return;

        // Hide original element via injected CSS
        const cssId = 'tsh-hide-' + id.replace(/[^a-z0-9]/gi, '');
        if (!adoptedCSS.has(cssId)) {
            const sheet = document.getElementById(IDS.STYLE);
            if (sheet) {
                sheet.textContent += `\n/* Adopted by TSH */\n${detection.selector} { display: none !important; }`;
                adoptedCSS.add(cssId);
            }
        }

        // Register as a hub-managed script
        registerScript({
            id: id,
            name: detection.name,
            icon: '🔌',
            order: 2000,
            source: 'detected',
            active: true,
            detection: detection,
            open: () => {
                // Trigger original element click if possible, else unhide briefly
                const el = document.querySelector(detection.selector);
                if (el) {
                    el.style.setProperty('display', '', 'important');
                    el.click();
                    setTimeout(() => {
                        el.style.setProperty('display', 'none', 'important');
                    }, 100);
                }
            }
        });
    }

    // =========================================================================
    // ICON
    // =========================================================================
    function createHubIcon() {
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('viewBox', '0 0 128 128');
        svg.setAttribute('class', 'tsh-svg');
        svg.setAttribute('aria-hidden', 'true');
        svg.setAttribute('width', '18');
        svg.setAttribute('height', '18');
        svg.innerHTML = [
            '<path d="M34 14h60l20 20v60l-20 20H34L14 94V34z" fill="none" stroke="currentColor" stroke-width="8" stroke-linejoin="round" opacity="0.35"/>',
            '<circle cx="64" cy="64" r="22" fill="none" stroke="currentColor" stroke-width="10" stroke-dasharray="8 4"/>',
            '<circle cx="64" cy="64" r="8" fill="currentColor"/>',
            '<path d="M26 40V26h14M102 40V26H88M26 88v14h14M102 88v14H88" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>'
        ].join('');
        return svg;
    }

    // =========================================================================
    // DROPDOWN MENU (quick launch)
    // =========================================================================
    function getSortedScripts() {
        return Array.from(registry.values())
            .filter(s => s.active)
            .sort((a, b) => {
                if (a.order !== b.order) return a.order - b.order;
                return a.name.localeCompare(b.name);
            });
    }

    function createMenu() {
        const menu = document.createElement('div');
        menu.id = IDS.MENU;
        menu.className = 'tsh-menu';
        menu.setAttribute('role', 'menu');
        return menu;
    }

    function renderMenu() {
        const menu = document.getElementById(IDS.MENU);
        if (!menu) return;
        menu.innerHTML = '';
        const scripts = getSortedScripts();

        if (scripts.length === 0) {
            const empty = document.createElement('div');
            empty.className = 'tsh-empty';
            empty.textContent = 'No active scripts';
            menu.appendChild(empty);
        } else {
            scripts.forEach(script => {
                const item = document.createElement('button');
                item.type = 'button';
                item.className = 'tsh-item';
                item.setAttribute('role', 'menuitem');

                const icon = document.createElement('span');
                icon.className = 'tsh-item-icon';
                icon.textContent = script.icon || '›';
                item.appendChild(icon);

                const text = document.createElement('span');
                text.className = 'tsh-item-text';
                text.textContent = script.name;
                item.appendChild(text);

                if (script.version) {
                    const ver = document.createElement('span');
                    ver.className = 'tsh-item-version';
                    ver.textContent = 'v' + script.version;
                    item.appendChild(ver);
                }

                item.addEventListener('click', e => {
                    e.preventDefault();
                    e.stopPropagation();
                    closeMenu();
                    try { script.open(); } catch (err) {
                        console.error('[TSH] Failed to open "' + script.name + '"', err);
                    }
                });
                menu.appendChild(item);
            });
        }

        // Divider
        const hr = document.createElement('div');
        hr.className = 'tsh-divider';
        menu.appendChild(hr);

        // Dashboard link
        const manage = document.createElement('button');
        manage.type = 'button';
        manage.className = 'tsh-item tsh-item-manage';
        manage.innerHTML = '<span class="tsh-item-icon">🎛️</span><span class="tsh-item-text">Open Dashboard</span>';
        manage.addEventListener('click', e => {
            e.preventDefault();
            e.stopPropagation();
            closeMenu();
            openDashboard();
        });
        menu.appendChild(manage);
    }

    function positionMenu() {
        const row  = document.getElementById(IDS.ROW);
        const menu = document.getElementById(IDS.MENU);
        if (!row || !menu) return;
        const rect = row.getBoundingClientRect();
        const menuWidth = menu.offsetWidth || 260;
        const menuHeight = menu.offsetHeight || 200;

        let left, top;
        if (mountMode === 'swiper') {
            left = rect.left;
            if (left + menuWidth > window.innerWidth - 10) left = rect.right - menuWidth;
            left = Math.max(8, left);
            top = rect.top - menuHeight - 8;
            if (top < 8) top = rect.bottom + 8;
        } else {
            left = rect.right + 8;
            if (left + menuWidth > window.innerWidth - 10) left = rect.left - menuWidth - 8;
            left = Math.max(8, left);
            top = rect.top;
            if (top + 280 > window.innerHeight) top = Math.max(8, window.innerHeight - 300);
        }
        menu.style.left = Math.round(left) + 'px';
        menu.style.top  = Math.round(top) + 'px';
    }

    function openMenu() {
        const row  = document.getElementById(IDS.ROW);
        const menu = document.getElementById(IDS.MENU);
        if (!row || !menu) return;
        renderMenu();
        positionMenu();
        menu.classList.add('tsh-open');
        row.setAttribute('aria-expanded', 'true');
    }
    function closeMenu() {
        const row  = document.getElementById(IDS.ROW);
        const menu = document.getElementById(IDS.MENU);
        if (!row || !menu) return;
        menu.classList.remove('tsh-open');
        row.setAttribute('aria-expanded', 'false');
    }
    function toggleMenu() {
        const menu = document.getElementById(IDS.MENU);
        if (!menu) return;
        menu.classList.contains('tsh-open') ? closeMenu() : openMenu();
    }

    // =========================================================================
    // DASHBOARD (Mission Control)
    // =========================================================================
    function openDashboard() {
        closeMenu();
        let dash = document.getElementById(IDS.DASHBOARD);
        if (dash) {
            dash.classList.add('tsh-dash-open');
            dashboardOpen = true;
            renderDashboard();
            return;
        }
        dash = document.createElement('div');
        dash.id = IDS.DASHBOARD;
        dash.className = 'tsh-dashboard';
        dash.innerHTML = `
            <div class="tsh-dash-backdrop"></div>
            <div class="tsh-dash-panel">
                <div class="tsh-dash-header">
                    <h2>🎯 Script Hub <span class="tsh-dash-ver">v${HUB_VERSION}</span></h2>
                    <button class="tsh-dash-close" aria-label="Close">✕</button>
                </div>
                <div class="tsh-dash-tabs">
                    <button data-tab="launch" class="tsh-dash-tab active">Launchpad</button>
                    <button data-tab="prefs" class="tsh-dash-tab">Preferences</button>
                    <button data-tab="discover" class="tsh-dash-tab">Discovery</button>
                </div>
                <div class="tsh-dash-body">
                    <div data-panel="launch" class="tsh-dash-panel-content active"></div>
                    <div data-panel="prefs" class="tsh-dash-panel-content"></div>
                    <div data-panel="discover" class="tsh-dash-panel-content"></div>
                </div>
            </div>
        `;
        document.body.appendChild(dash);
        dashboardOpen = true;

        // Close handlers
        dash.querySelector('.tsh-dash-close').addEventListener('click', closeDashboard);
        dash.querySelector('.tsh-dash-backdrop').addEventListener('click', closeDashboard);
        dash.addEventListener('click', e => { if (e.target === dash) closeDashboard(); });

        // Tabs
        dash.querySelectorAll('.tsh-dash-tab').forEach(tab => {
            tab.addEventListener('click', () => {
                dash.querySelectorAll('.tsh-dash-tab').forEach(t => t.classList.remove('active'));
                dash.querySelectorAll('.tsh-dash-panel-content').forEach(p => p.classList.remove('active'));
                tab.classList.add('active');
                dash.querySelector(`[data-panel="${tab.dataset.tab}"]`).classList.add('active');
                if (tab.dataset.tab === 'discover') refreshDiscovery();
            });
        });

        renderDashboard();
    }

    function closeDashboard() {
        const dash = document.getElementById(IDS.DASHBOARD);
        if (dash) dash.classList.remove('tsh-dash-open');
        dashboardOpen = false;
    }

    function renderDashboard() {
        const dash = document.getElementById(IDS.DASHBOARD);
        if (!dash) return;
        renderLaunchPanel(dash.querySelector('[data-panel="launch"]'));
        renderPrefsPanel(dash.querySelector('[data-panel="prefs"]'));
        // Discovery panel renders on-demand
    }

    // ----- Launchpad Tab -----
    function renderLaunchPanel(container) {
        container.innerHTML = '';
        const scripts = getSortedScripts();
        const grid = document.createElement('div');
        grid.className = 'tsh-dash-grid';

        if (!scripts.length) {
            container.innerHTML = '<div class="tsh-dash-empty">No scripts registered yet.<br>Use the Discovery tab to find and adopt scripts.</div>';
            return;
        }

        scripts.forEach(script => {
            const card = document.createElement('div');
            card.className = 'tsh-dash-card';
            card.innerHTML = `
                <div class="tsh-dash-card-icon">${script.icon || '⚡'}</div>
                <div class="tsh-dash-card-name">${escapeHtml(script.name)}</div>
                ${script.version ? `<div class="tsh-dash-card-ver">v${escapeHtml(script.version)}</div>` : ''}
                <div class="tsh-dash-card-source" title="Source">${script.source === 'detected' ? '🔌 Auto' : script.source === 'manual' ? '✋ Manual' : '🔗 Native'}</div>
            `;
            card.addEventListener('click', () => {
                try { script.open(); } catch (e) { console.error(e); }
            });

            // Toggle active
            const toggle = document.createElement('button');
            toggle.className = 'tsh-dash-toggle' + (script.active ? ' active' : '');
            toggle.textContent = script.active ? 'ON' : 'OFF';
            toggle.addEventListener('click', e => {
                e.stopPropagation();
                script.active = !script.active;
                renderDashboard();
                renderMenu();
                // If deactivating a detected script, unhide its original UI
                if (!script.active && script.detection) {
                    unhideOriginal(script.detection.selector);
                }
                // If reactivating, re-hide
                if (script.active && script.detection) {
                    hideOriginal(script.detection.selector);
                }
            });
            card.appendChild(toggle);

            grid.appendChild(card);
        });
        container.appendChild(grid);
    }

    // ----- Preferences Tab -----
    function renderPrefsPanel(container) {
        container.innerHTML = '';
        const scripts = Array.from(registry.values()).filter(s => s.prefs && s.active).sort((a,b) => a.name.localeCompare(b.name));

        if (!scripts.length) {
            container.innerHTML = '<div class="tsh-dash-empty">No scripts have registered preferences yet.<br>Scripts using the TSH API will appear here automatically.</div>';
            return;
        }

        scripts.forEach(script => {
            const section = document.createElement('div');
            section.className = 'tsh-pref-section';
            const header = document.createElement('div');
            header.className = 'tsh-pref-header';
            header.innerHTML = `<span>${script.icon || '⚙️'} ${escapeHtml(script.name)}</span>`;
            section.appendChild(header);

            const body = document.createElement('div');
            body.className = 'tsh-pref-body';

            script.prefs.fields.forEach(field => {
                const wrap = document.createElement('label');
                wrap.className = 'tsh-pref-field';
                const label = document.createElement('span');
                label.className = 'tsh-pref-label';
                label.textContent = field.label || field.key;
                wrap.appendChild(label);

                let input;
                if (field.type === 'toggle' || field.type === 'checkbox') {
                    input = document.createElement('button');
                    input.type = 'button';
                    input.className = 'tsh-pref-toggle' + (script.prefs.values[field.key] ? ' active' : '');
                    input.textContent = script.prefs.values[field.key] ? 'ON' : 'OFF';
                    input.addEventListener('click', () => {
                        script.prefs.values[field.key] = !script.prefs.values[field.key];
                        input.textContent = script.prefs.values[field.key] ? 'ON' : 'OFF';
                        input.classList.toggle('active', script.prefs.values[field.key]);
                        if (script.prefs.onSave) script.prefs.onSave(script.prefs.values);
                    });
                } else if (field.type === 'select' && Array.isArray(field.options)) {
                    input = document.createElement('select');
                    input.className = 'tsh-pref-select';
                    field.options.forEach(opt => {
                        const o = document.createElement('option');
                        o.value = opt.value !== undefined ? opt.value : opt;
                        o.textContent = opt.label !== undefined ? opt.label : opt;
                        if (script.prefs.values[field.key] == o.value) o.selected = true;
                        input.appendChild(o);
                    });
                    input.addEventListener('change', () => {
                        script.prefs.values[field.key] = input.value;
                        if (script.prefs.onSave) script.prefs.onSave(script.prefs.values);
                    });
                } else {
                    input = document.createElement('input');
                    input.className = 'tsh-pref-input';
                    input.type = field.type === 'number' ? 'number' : 'text';
                    if (field.min !== undefined) input.min = field.min;
                    if (field.max !== undefined) input.max = field.max;
                    input.value = script.prefs.values[field.key] || '';
                    input.addEventListener('change', () => {
                        script.prefs.values[field.key] = field.type === 'number' ? Number(input.value) : input.value;
                        if (script.prefs.onSave) script.prefs.onSave(script.prefs.values);
                    });
                }

                wrap.appendChild(input);
                body.appendChild(wrap);
            });

            section.appendChild(body);
            container.appendChild(section);
        });
    }

    // ----- Discovery Tab -----
    function refreshDiscovery() {
        const container = document.querySelector('#' + IDS.DASHBOARD + ' [data-panel="discover"]');
        if (!container) return;
        container.innerHTML = '';

        const detected = scanForScripts().filter(d => !registry.has(d.id));

        // Detected list
        if (detected.length) {
            const title = document.createElement('h3');
            title.className = 'tsh-dash-subtitle';
            title.textContent = `🔍 Detected ${detected.length} scattered UI element${detected.length===1?'':'s'}`;
            container.appendChild(title);

            const list = document.createElement('div');
            list.className = 'tsh-discover-list';
            detected.forEach(d => {
                const row = document.createElement('div');
                row.className = 'tsh-discover-row';
                row.innerHTML = `
                    <span class="tsh-discover-name">${escapeHtml(d.name)}</span>
                    <code class="tsh-discover-sel">${escapeHtml(d.selector)}</code>
                `;
                const btn = document.createElement('button');
                btn.className = 'tsh-discover-btn';
                btn.textContent = 'Adopt';
                btn.title = 'Hide original button and control from hub';
                btn.addEventListener('click', () => {
                    adoptDetection(d);
                    refreshDiscovery();
                });
                row.appendChild(btn);
                list.appendChild(row);
            });
            container.appendChild(list);
        } else {
            const empty = document.createElement('div');
            empty.className = 'tsh-dash-empty';
            empty.textContent = 'No scattered script UI detected on this page. All clean!';
            container.appendChild(empty);
        }

        // Manual add
        const manualBox = document.createElement('div');
        manualBox.className = 'tsh-manual-box';
        manualBox.innerHTML = '<h3 class="tsh-dash-subtitle">➕ Add Script Manually</h3>';
        const form = document.createElement('div');
        form.className = 'tsh-manual-form';
        form.innerHTML = `
            <input type="text" class="tsh-pref-input" placeholder="Script Name" id="tsh-manual-name">
            <input type="text" class="tsh-pref-input" placeholder="Icon (emoji)" id="tsh-manual-icon" value="⚡">
            <input type="text" class="tsh-pref-input" placeholder="CSS Selector to trigger (optional)" id="tsh-manual-sel">
            <button class="tsh-discover-btn" id="tsh-manual-add">Add to Hub</button>
        `;
        manualBox.appendChild(form);
        container.appendChild(manualBox);

        form.querySelector('#tsh-manual-add').addEventListener('click', () => {
            const name = form.querySelector('#tsh-manual-name').value.trim();
            const icon = form.querySelector('#tsh-manual-icon').value.trim() || '⚡';
            const sel  = form.querySelector('#tsh-manual-sel').value.trim();
            if (!name) return alert('Name is required');
            const id = 'tsh-manual-' + Math.random().toString(36).slice(2, 7);
            const entry = {
                id, name, icon, source: 'manual', order: 3000,
                open: () => {
                    if (sel) {
                        const el = document.querySelector(sel);
                        if (el) el.click();
                    }
                }
            };
            if (sel) {
                entry.detection = { selector: sel };
                hideOriginal(sel);
            }
            registerScript(entry);
            refreshDiscovery();
            form.querySelector('#tsh-manual-name').value = '';
            form.querySelector('#tsh-manual-sel').value = '';
        });
    }

    function hideOriginal(selector) {
        const sheet = document.getElementById(IDS.STYLE);
        if (sheet && selector) {
