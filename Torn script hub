// ==UserScript==
// @name        Torn Script Hub
// @namespace   https://greasyfork.org/users/cowboyup
// @version     1.0.0
// @description Standalone launcher hub for registered Torn userscripts.
// @author      cowboyup
// @match       https://www.torn.com/*
// @run-at      document-start
// @grant       none
// @license     MIT
// ==/UserScript==

(function () {
    'use strict';

    // =========================================================================
    // TORN SCRIPT HUB
    //
    // Deliberately independent of any particular userscript.
    //
    // Communication:
    //    document.dispatchEvent(new CustomEvent('torn-script-hub:register', {
    //        detail: {
    //            id: 'my-script',
    //            name: 'My Script',
    //            version: '1.0.0',
    //            open: function () { ... }
    //        }
    //    }));
    //
    // No shared window object is used.
    // =========================================================================

    const HUB_VERSION = '1.0.0';

    const EVENTS = Object.freeze({
        REGISTER: 'torn-script-hub:register',
        UNREGISTER: 'torn-script-hub:unregister',
        READY: 'torn-script-hub:ready'
    });

    const IDS = Object.freeze({
        ROW: 'tsh-sidebar-row',
        MENU: 'tsh-menu',
        STYLE: 'tsh-style'
    });

    // =========================================================================
    // REGISTRY
    // =========================================================================

    const registry = new Map();

    // =========================================================================
    // LOAD-ORDER-SAFE DOM QUEUE
    //
    // CustomEvents are the communication protocol.
    //
    // The queue is attached to a DOM node rather than window so that the
    // registration mechanism remains usable across Tampermonkey sandboxes.
    //
    // A script registering before this hub starts places its registration
    // object here. The hub drains it immediately when initialized.
    // =========================================================================

    const QUEUE_PROPERTY = '__tornScriptHubQueue';

    function getQueue() {
        const root = document.documentElement;

        if (!root) {
            return [];
        }

        if (!root[QUEUE_PROPERTY]) {
            root[QUEUE_PROPERTY] = [];
        }

        return root[QUEUE_PROPERTY];
    }

    function queueRegistration(detail) {
        if (!detail || typeof detail !== 'object') {
            return;
        }

        const queue = getQueue();
        queue.push(detail);
    }

    function drainQueue() {
        const queue = getQueue();

        if (!Array.isArray(queue) || queue.length === 0) {
            return;
        }

        // Empty first so registrations made while processing the queue
        // don't get accidentally processed twice.
        const pending = queue.splice(0, queue.length);

        pending.forEach(registerScript);
    }

    // =========================================================================
    // REGISTRATION
    // =========================================================================

    function normalizeRegistration(detail) {
        if (!detail || typeof detail !== 'object') {
            return null;
        }

        const id = String(detail.id || '').trim();
        const name = String(detail.name || '').trim();

        if (!id || !name) {
            return null;
        }

        if (typeof detail.open !== 'function') {
            return null;
        }

        return {
            id,
            name,
            version: detail.version ? String(detail.version) : '',
            icon: detail.icon || null,
            order: Number.isFinite(detail.order)
                ? detail.order
                : 1000,
            open: detail.open
        };
    }

    function registerScript(detail) {
        const script = normalizeRegistration(detail);

        if (!script) {
            return;
        }

        registry.set(script.id, script);

        renderMenu();
    }

    function unregisterScript(detail) {
        if (!detail) {
            return;
        }

        const id = typeof detail === 'string'
            ? detail
            : String(detail.id || '').trim();

        if (!id) {
            return;
        }

        registry.delete(id);
        renderMenu();
    }

    // =========================================================================
    // EVENT BRIDGE
    // =========================================================================

    document.addEventListener(EVENTS.REGISTER, function (event) {
        if (!event || !event.detail) {
            return;
        }

        registerScript(event.detail);
    });

    document.addEventListener(EVENTS.UNREGISTER, function (event) {
        if (!event || !event.detail) {
            return;
        }

        unregisterScript(event.detail);
    });

    // =========================================================================
    // SIDEBAR DETECTION
    // =========================================================================

    function findTornToolsSettings() {
        return document.querySelector('.tt-settings.pill');
    }

    function findSidebarInsertionPoint() {
        /*
         * TornTools' injected settings row is deliberately preferred.
         *
         * Observed structure:
         *
         *    <div class="tt-settings pill">
         *        <svg class="tt-svg">...</svg>
         *        <span>TornTools Settings</span>
         *    </div>
         *
         * This gives us a third-party-injected anchor rather than depending
         * on Torn's React-generated hashed component classes.
         */

        const ttSettings = findTornToolsSettings();

        if (ttSettings && ttSettings.parentNode) {
            return {
                parent: ttSettings.parentNode,
                reference: ttSettings
            };
        }

        /*
         * Fallback:
         *
         * Locate the desktop navigation area and append our row there.
         * The selector intentionally uses structural information rather
         * than React component internals.
         */

        const desktopNav = document.querySelector(
            '[id^="nav-"]'
        );

        if (desktopNav && desktopNav.parentNode) {
            return {
                parent: desktopNav.parentNode,
                reference: desktopNav
            };
        }

        return null;
    }

    // =========================================================================
    // SVG ICON (Original Detailed Hub Design)
    // =========================================================================

    function createIcon() {
        const svg = document.createElementNS(
            'http://www.w3.org/2000/svg',
            'svg'
        );

        svg.setAttribute('viewBox', '0 0 128 128');
        svg.setAttribute('class', 'tsh-svg');
        svg.setAttribute('aria-hidden', 'true');

        svg.innerHTML = [
            '<path d="M34 14h60l20 20v60l-20 20H34L14 94V34z" fill="none" stroke="currentColor" stroke-width="8" stroke-linejoin="round" opacity="0.3"/>',
            '<circle cx="64" cy="64" r="22" fill="none" stroke="currentColor" stroke-width="10" stroke-dasharray="8 4"/>',
            '<circle cx="64" cy="64" r="8" fill="currentColor"/>',
            '<path d="M26 40V26h14M102 40V26H88M26 88v14h14M102 88v14H88" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round"/>'
        ].join('');

        return svg;
    }

    // =========================================================================
    // ROW
    // =========================================================================

    function createRow() {
        const row = document.createElement('div');

        /*
         * "tt-settings pill" is intentionally imitated rather than modifying
         * Torn's own sidebar React components.
         */
        row.className = 'tt-settings pill tsh-row';
        row.id = IDS.ROW;
        row.setAttribute('role', 'button');
        row.setAttribute('tabindex', '0');
        row.setAttribute('aria-haspopup', 'menu');
        row.setAttribute('aria-expanded', 'false');

        row.appendChild(createIcon());

        const label = document.createElement('span');
        label.textContent = 'Scripts';

        row.appendChild(label);

        row.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();

            toggleMenu();
        });

        row.addEventListener('keydown', function (event) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                toggleMenu();
            }

            if (event.key === 'Escape') {
                closeMenu();
            }
        });

        return row;
    }

    // =========================================================================
    // MENU
    // =========================================================================

    function getSortedScripts() {
        return Array.from(registry.values()).sort(function (a, b) {
            if (a.order !== b.order) {
                return a.order - b.order;
            }

            return a.name.localeCompare(b.name);
        });
    }

    function createMenu() {
        const menu = document.createElement('div');

        menu.id = IDS.MENU;
        menu.className = 'tsh-menu';
        menu.setAttribute('role', 'menu');

        return menu;
    }

    function renderMenu() {
        const menu = document.getElementById(IDS.MENU);

        if (!menu) {
            return;
        }

        menu.textContent = '';

        const scripts = getSortedScripts();

        if (scripts.length === 0) {
            const empty = document.createElement('div');

            empty.className = 'tsh-empty';
            empty.textContent = 'No registered scripts';

            menu.appendChild(empty);
            return;
        }

        scripts.forEach(function (script) {
            const item = document.createElement('button');

            item.type = 'button';
            item.className = 'tsh-item';
            item.setAttribute('role', 'menuitem');

            const icon = document.createElement('span');
            icon.className = 'tsh-item-icon';

            if (typeof script.icon === 'string' && script.icon.trim()) {
                icon.textContent = script.icon;
            } else {
                icon.textContent = '›';
            }

            item.appendChild(icon);

            const text = document.createElement('span');
            text.className = 'tsh-item-text';
            text.textContent = script.name;

            item.appendChild(text);

            if (script.version) {
                const version = document.createElement('span');

                version.className = 'tsh-item-version';
                version.textContent = 'v' + script.version;

                item.appendChild(version);
            }

            item.addEventListener('click', function (event) {
                event.preventDefault();
                event.stopPropagation();

                closeMenu();

                try {
                    script.open();
                } catch (error) {
                    console.error(
                        '[Torn Script Hub] Failed to open "' +
                        script.name +
                        '"',
                        error
                    );
                }
            });

            menu.appendChild(item);
        });
    }

    function positionMenu() {
        const row = document.getElementById(IDS.ROW);
        const menu = document.getElementById(IDS.MENU);

        if (!row || !menu) {
            return;
        }

        const rect = row.getBoundingClientRect();

        menu.style.left = Math.round(rect.right + 6) + 'px';
        menu.style.top = Math.round(rect.top) + 'px';
    }

    function openMenu() {
        const row = document.getElementById(IDS.ROW);
        const menu = document.getElementById(IDS.MENU);

        if (!row || !menu) {
            return;
        }

        renderMenu();
        positionMenu();

        menu.classList.add('tsh-open');

        row.setAttribute('aria-expanded', 'true');
    }

    function closeMenu() {
        const row = document.getElementById(IDS.ROW);
        const menu = document.getElementById(IDS.MENU);

        if (!row || !menu) {
            return;
        }

        menu.classList.remove('tsh-open');

        row.setAttribute('aria-expanded', 'false');
    }

    function toggleMenu() {
        const menu = document.getElementById(IDS.MENU);

        if (!menu) {
            return;
        }

        if (menu.classList.contains('tsh-open')) {
            closeMenu();
        } else {
            openMenu();
        }
    }

    // =========================================================================
    // OUTSIDE CLICK / ESCAPE
    // =========================================================================

    document.addEventListener('click', function (event) {
        const row = document.getElementById(IDS.ROW);
        const menu = document.getElementById(IDS.MENU);

        if (!row || !menu) {
            return;
        }

        if (
            event.target !== row &&
            !row.contains(event.target) &&
            !menu.contains(event.target)
        ) {
            closeMenu();
        }
    }, true);

    document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape') {
            closeMenu();
        }
    });

    window.addEventListener('resize', function () {
        const menu = document.getElementById(IDS.MENU);

        if (menu && menu.classList.contains('tsh-open')) {
            positionMenu();
        }
    });

    // =========================================================================
    // STYLES
    // =========================================================================

    function installStyles() {
        if (document.getElementById(IDS.STYLE)) {
            return;
        }

        const style = document.createElement('style');

        style.id = IDS.STYLE;

        style.textContent = `
            /* =============================================================
             * Torn Script Hub
             * ============================================================= */

            .tsh-row {
                cursor: pointer !important;
                user-select: none;
                display: flex !important;
                align-items: center !important;
                box-sizing: border-box !important;
                height: 21px !important;
                min-height: 21px !important;
                max-height: 21px !important;
                padding: 0 8px !important;
                margin-bottom: 2px !important;
                font-size: 12px !important;
            }

            .tsh-row .tsh-svg {
                width: 12px !important;
                height: 12px !important;
                min-width: 12px !important;
                min-height: 12px !important;
                margin-right: 6px !important;
                fill: currentColor;
                flex: 0 0 auto;
                display: block !important;
            }

            .tsh-row > span {
                white-space: nowrap;
                line-height: 1 !important;
                display: inline-block !important;
            }

            .tsh-menu {
                position: fixed;
                z-index: 2147483000;
                min-width: 230px;
                max-width: 330px;
                padding: 5px;
                display: none;

                background: var(--tsh-bg);
                color: var(--tsh-text);

                border: 1px solid var(--tsh-border);
                border-radius: 6px;

                box-shadow:
                    0 4px 16px rgba(0, 0, 0, .35),
                    0 1px 3px rgba(0, 0, 0, .25);

                font-family:
                    Arial,
                    Helvetica,
                    sans-serif;
            }

            .tsh-menu.tsh-open {
                display: block;
            }

            .tsh-item {
                width: 100%;
                min-height: 34px;

                display: flex;
                align-items: center;

                padding: 6px 9px;
                margin: 0;

                border: 0;
                border-radius: 4px;

                background: transparent;
                color: inherit;

                font: inherit;
                font-size: 13px;
                text-align: left;

                cursor: pointer;
            }

            .tsh-item:hover,
            .tsh-item:focus {
                background: var(--tsh-hover);
                outline: none;
            }

            .tsh-item-icon {
                width: 20px;
                margin-right: 7px;

                text-align: center;
                opacity: .75;
            }

            .tsh-item-text {
                flex: 1;
                overflow: hidden;

                white-space: nowrap;
                text-overflow: ellipsis;
            }

            .tsh-item-version {
                margin-left: 8px;
                opacity: .5;
                font-size: 10px;
            }

            .tsh-empty {
                padding: 9px 11px;
                opacity: .55;
                font-size: 12px;
            }

            /*
             * Torn's dark-mode body class is used only for choosing our
             * independent menu palette. We do not depend on Torn's React CSS.
             */

            :root {
                --tsh-bg: #f5f5f5;
                --tsh-text: #222;
                --tsh-border: #bbb;
                --tsh-hover: rgba(0, 0, 0, .09);
            }

            body.dark-mode {
                --tsh-bg: #252525;
                --tsh-text: #eee;
                --tsh-border: #4a4a4a;
                --tsh-hover: rgba(255, 255, 255, .10);
            }
        `;

        (document.head || document.documentElement).appendChild(style);
    }

    // =========================================================================
    // MOUNT
    // =========================================================================

    let mounted = false;

    function mount() {
        if (mounted) {
            return true;
        }

        if (!document.body) {
            return false;
        }

        if (document.getElementById(IDS.ROW)) {
            mounted = true;
            return true;
        }

        const insertion = findSidebarInsertionPoint();

        if (!insertion) {
            return false;
        }

        installStyles();

        const row = createRow();
        const menu = createMenu();

        insertion.parent.insertBefore(row, insertion.reference.nextSibling);

        document.body.appendChild(menu);

        mounted = true;

        renderMenu();

        document.dispatchEvent(
            new CustomEvent(EVENTS.READY, {
                detail: {
                    version: HUB_VERSION
                }
            })
        );

        return true;
    }

    // =========================================================================
    // SIDEBAR WAIT
    // =========================================================================

    function startSidebarWatcher() {
        if (mount()) {
            return;
        }

        const observer = new MutationObserver(function () {
            if (mount()) {
                observer.disconnect();
            }
        });

        observer.observe(document.documentElement, {
            childList: true,
            subtree: true
        });

        /*
         * Defensive retry in case Torn replaces the sidebar after the first
         * React render.
         */
        let attempts = 0;

        const timer = window.setInterval(function () {
            if (mounted || attempts++ > 60) {
                window.clearInterval(timer);
                return;
            }

            mount();
        }, 500);
    }

    // =========================================================================
    // START
    // =========================================================================

    /*
     * Drain anything that was registered before the hub initialized.
     */
    drainQueue();

    /*
     * document-start can occur before <head>/<body> exists.
     */
    if (document.readyState === 'loading') {
        document.addEventListener(
            'DOMContentLoaded',
            startSidebarWatcher,
            { once: true }
        );
    } else {
        startSidebarWatcher();
    }

})();
