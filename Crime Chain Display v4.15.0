        style.textContent = `
            #cct-root {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                margin-left: 12px;
                vertical-align: middle;
                font-family: inherit;
                position: relative;
                z-index: 20;
            }
            #cct-widget {
                display: inline-flex;
                align-items: center;
                gap: 9px;
                padding: 4px 10px 4px 5px;
                border-radius: 20px;
                cursor: default;
                user-select: none;
            }
            #cct-ring-wrap {
                position: relative;
                width: 28px;
                height: 28px;
