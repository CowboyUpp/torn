                border: 1px solid rgba(255,60,60,0.35);
                color: #ff5555;
                transition: opacity 0.15s, background 0.15s;
            }
            #cct-profit-reset:hover { opacity: 1; background: rgba(255,60,60,0.12); }
            #cct-profit-reset:disabled { opacity: 0.25; cursor: default; background: transparent; }
            #cct-onedrive-section {
                margin-top: 10px;
                padding-top: 8px;
                border-top: 1px solid rgba(128,128,128,0.18);
            }
            #cct-onedrive-section summary {
                cursor: pointer;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.02em;
                opacity: 0.75;
                outline: none;
                user-select: none;
            }
            #cct-onedrive-section summary:hover { opacity: 1; }
            #cct-onedrive-section[open] summary { margin-bottom: 8px; }
            #cct-onedrive-actions {
                display: grid;
                grid-template-columns: repeat(3, max-content);
