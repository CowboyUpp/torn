                cursor: pointer;
                opacity: 0.9;
            }
            .cct-sync-toggle-label input { cursor: pointer; }
            #cct-sync-token-row {
                display: flex;
                align-items: center;
                gap: 6px;
                margin-bottom: 6px;
            }
            #cct-sync-token-input {
                flex: 1;
                min-width: 0;
                padding: 4px 7px;
                font-size: 12px;
                border-radius: 5px;
                outline: none;
            }
            #cct-sync-token-generate,
            #cct-sync-token-save,
            #cct-sync-now {
                padding: 4px 9px;
                font-size: 11px;
                border-radius: 5px;
                cursor: pointer;
                transition: background 0.15s;
                white-space: nowrap;
            }
            #cct-sync-action-row {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-top: 2px;
            }
            #cct-sync-status {
                font-size: 10px;
                opacity: 0.65;
                white-space: normal;
                line-height: 1.4;
            }
            #cct-sync-hint {
                display: block;
                margin-top: 6px;
                font-size: 10px;
                opacity: 0.55;
                white-space: normal;
                line-height: 1.4;
            }
            .cct-version-footer {
                white-space: normal;
                font-size: 10px;
                opacity: 0.4;
                text-align: right;
                margin-top: 4px;
            }
            #cct-profit-popover {
                display: none;
                position: absolute;
                top: calc(100% + 6px);
                right: 0;
                z-index: 9999;
                width: 400px;
                max-width: calc(100vw - 16px);
                box-sizing: border-box;
                max-height: min(68vh, 620px);
                overflow: hidden;
                padding: 10px 12px;
                border-radius: 8px;
                box-shadow: 0 6px 20px rgba(0,0,0,0.5);
                font-size: 12px;
                flex-direction: column;
            }
            #cct-profit-popover.cct-open { display: flex; }
            #cct-profit-scroll-area {
                overflow-y: auto;
                overflow-x: hidden; /* Prevents horizontal window break */
                flex: 1;
                min-height: 0;
            }
            /* Hide scrollbar only when the graph is active */
            #cct-profit-scroll-area.cct-hide-scrollbar::-webkit-scrollbar {
                display: none;
            }
            #cct-profit-scroll-area.cct-hide-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
            #cct-profit-title { font-size: 13px; font-weight: 700; display: flex; align-items: center; gap: 4px; }
            #cct-debug-toggle { padding: 2px 4px; }
            #cct-profit-popover.cct-debug-open #cct-debug-toggle { opacity: 1 !important; }
            #cct-profit-popover.cct-debug-open #cct-profit-periods,
            #cct-profit-popover.cct-debug-open #cct-profit-scroll-area,
            #cct-profit-popover.cct-debug-open #cct-profit-reset-row,
            #cct-profit-popover.cct-debug-open #cct-sync-section { display: none; }
            #cct-debug-panel { display: none; flex-direction: column; gap: 6px; margin-top: 8px; flex: 1; min-height: 0; }
            #cct-profit-popover.cct-debug-open #cct-debug-panel { display: flex; }
            #cct-debug-actions { display: flex; gap: 6px; }
            #cct-debug-refresh, #cct-debug-copy, #cct-debug-clear {
                padding: 4px 9px; font-size: 11px; border-radius: 5px; cursor: pointer;
                transition: background 0.15s; white-space: nowrap;
            }
            #cct-debug-output {
                margin: 0; padding: 8px; border-radius: 5px;
                font-family: ui-monospace, Consolas, monospace; font-size: 10px; line-height: 1.4;
                white-space: pre-wrap; word-break: break-all;
                overflow: auto; flex: 1; min-height: 0; max-height: 46vh; user-select: text;
            }
            #cct-profit-periods { display: flex; gap: 5px; margin: 9px 0; align-items: center; }
            .cct-profit-period { border: 0; background: transparent; color: inherit; cursor: pointer; padding: 2px 0; font-size: 11px; opacity: 0.6; }
            .cct-profit-period:not(:last-child)::after { content: '·'; margin-left: 5px; }
            .cct-profit-period.cct-profit-active { font-weight: 700; opacity: 1; }
            #cct-profit-summary { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
            #cct-profit-summary > div { padding: 7px 5px; border-radius: 5px; }
            #cct-profit-summary small { display: block; opacity: 0.55; font-size: 9px; white-space: nowrap; }
            #cct-profit-summary strong { font-size: 11px; white-space: nowrap; }
            #cct-profit-rows { display: grid; gap: 2px; margin-top: 8px; }
            #cct-profit-graph {
                display: none;
                margin-top: 10px;
                width: 100%;
                box-sizing: border-box;
                flex: 1;
                min-height: 0;
            }
            #cct-profit-graph.cct-open { display: flex; flex-direction: column; }
            #cct-profit-graph svg {
                width: 100%;
                flex: 1;
                min-height: 0;
                max-width: 100%;
                display: block;
                overflow: visible;
            }
            .cct-graph-axis { stroke: rgba(128,128,128,0.3); stroke-width: 1; }
            .cct-graph-grid { stroke: rgba(128,128,128,0.1); stroke-width: 1; stroke-dasharray: 2 2; }
            .cct-graph-label { font-size: 9px; fill: inherit; opacity: 0.6; }
            .cct-graph-line { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
            .cct-graph-dot { stroke: #1e1e1e; stroke-width: 1.5; transition: r 0.15s; }
            .cct-graph-dot:hover { r: 4; }
            .cct-graph-legend { display: flex; justify-content: center; gap: 10px; margin-top: 5px; font-size: 10px; opacity: 0.8; }
            .cct-graph-legend span { display: flex; align-items: center; gap: 4px; cursor: pointer; transition: opacity 0.2s; user-select: none; }
            .cct-graph-legend span:hover { opacity: 1; }
            .cct-graph-legend span.cct-graph-legend-off { opacity: 0.3; text-decoration: line-through; }
            .cct-graph-legend .dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; }
            .cct-profit-row {
                display: grid;
                grid-template-columns: 1fr 1fr 1fr 0.8fr 0.8fr;
                align-items: baseline;
                gap: 4px 10px;
                font-size: 10px;
                padding: 4px 5px;
                border-radius: 5px;
            }
            .cct-profit-row-header {
                padding-top: 0;
                padding-bottom: 2px;
                opacity: 0.5;
                font-size: 9px;
                text-transform: uppercase;
                letter-spacing: 0.04em;
            }
            .cct-profit-col-date { text-align: left; font-weight: 600; }
            .cct-profit-row-header .cct-profit-col-date { font-weight: 600; }
            .cct-profit-col-val { text-align: right; opacity: 0.85; font-variant-numeric: tabular-nums; white-space: nowrap; }
            .cct-profit-col-tag { grid-column: 1 / -1; text-align: right; font-size: 9px; opacity: 0.75; }
            .cct-profit-warn { opacity: 1 !important; color: #ff9a3c; cursor: help; }
            .cct-profit-empty { font-size: 11px; opacity: 0.65; padding: 8px 0; }
        `;
        document.head.appendChild(style);
    }

    function applyTheme() {
        const th = t();
        const widget = document.querySelector('#cct-widget');
        if (widget) {
            widget.style.background = th.widgetBg;
            widget.style.border = `1px solid ${th.widgetBorder}`;
        }

        const ringBg = document.querySelector('#cct-ring-bg');
        if (ringBg) ringBg.style.stroke = th.ringTrack;

        const ringLabel = document.querySelector('#cct-ring-label');
        if (ringLabel) {
            ringLabel.style.background = th.ringInnerBg;
            ringLabel.style.border = `1px solid ${th.ringInnerBorder}`;
            ringLabel.style.boxShadow = th.ringInnerShadow;
            ringLabel.style.color = th.ringText;
        }

        const lbl = document.querySelector('#cct-label');
        if (lbl) lbl.style.opacity = th.labelOpacity;

        const status = document.querySelector('#cct-status');
        if (status) status.style.opacity = th.statusOpacity;

        const popover = document.querySelector('#cct-settings-popover');
        if (popover) {
            popover.style.background = th.popoverBg;
            popover.style.border = `1px solid ${th.popoverBorder}`;
            popover.style.color = th.popoverColor;
        }

        const profitPopover = document.querySelector('#cct-profit-popover');
        if (profitPopover) {
            profitPopover.style.background = th.popoverBg;
            profitPopover.style.border = `1px solid ${th.popoverBorder}`;
            profitPopover.style.color = th.popoverColor;
            profitPopover.querySelectorAll('#cct-profit-summary > div,.cct-profit-row:not(.cct-profit-row-header)').forEach((el) => {
                el.style.background = th.saveBg;
                el.style.border = `1px solid ${th.saveBorder}`;
            });
            const dbgOut = profitPopover.querySelector('#cct-debug-output');
            if (dbgOut) {
                dbgOut.style.background = th.saveBg;
                dbgOut.style.border = `1px solid ${th.saveBorder}`;
            }
        }

        document.querySelectorAll('#cct-chain-input,#cct-log-key-input,#cct-sync-token-input').forEach((input) => {
            input.style.background = th.inputBg;
            input.style.border = `1px solid ${th.inputBorder}`;
            input.style.color = th.popoverColor;
            input.onfocus = () => { input.style.borderColor = th.inputFocus; };
            input.onblur = () => { input.style.borderColor = th.inputBorder; };
        });

        document.querySelectorAll('#cct-chain-save,#cct-log-clear,#cct-log-key-save,#cct-log-sync-now,#cct-create-log-key-btn,#cct-sync-token-generate,#cct-sync-token-save,#cct-sync-now,#cct-debug-refresh,#cct-debug-copy,#cct-debug-clear').forEach((btn) => {
            btn.style.background = th.saveBg;
            btn.style.border = `1px solid ${th.saveBorder}`;
            btn.style.color = th.popoverColor;
            btn.onmouseenter = () => { btn.style.background = th.saveBgHover; };
            btn.onmouseleave = () => { btn.style.background = th.saveBg; };
        });

        document.querySelectorAll('.cct-icon-btn').forEach((btn) => {
            btn.style.opacity = th.gearOpacity;
            btn.onmouseenter = () => { btn.style.opacity = th.gearHover; };
            btn.onmouseleave = () => { btn.style.opacity = th.gearOpacity; };
        });

        const toggle = document.querySelector('#cct-theme-toggle');
        if (toggle) toggle.innerHTML = isDark ? SUN_ICON : MOON_ICON;

        render(false);
    }

    function renderWidget() {
        if (document.querySelector('#cct-root')) return;

        const root = findCrimesApp();
        if (!root) return;

        const anchor = findWidgetAnchor(root);
        if (!anchor) return;

        const logKey = getLogApiKey();
        const el = document.createElement('span');
        el.id = 'cct-root';
        el.innerHTML = `
            <div id="cct-widget">
                <div id="cct-ring-wrap">
                    <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
                        <circle id="cct-ring-bg" cx="14" cy="14" r="${RADIUS}"></circle>
                        <circle id="cct-ring-arc" cx="14" cy="14" r="${RADIUS}"
                            stroke-dasharray="${CIRC}"
                            stroke-dashoffset="${CIRC}"
                            stroke="#00ff66"></circle>
                    </svg>
                    <div id="cct-ring-label">0</div>
                </div>
                <div id="cct-text">
                    <div id="cct-label">Crime Chain</div>
                    <div id="cct-status">No active chain</div>
                </div>
            </div>
            <button id="cct-theme-toggle" class="cct-icon-btn" type="button" title="Toggle light/dark mode">${isDark ? SUN_ICON : MOON_ICON}</button>
            <button id="cct-profit-toggle" class="cct-icon-btn" type="button" title="Crime Profit">$</button>
            <button id="cct-gear" class="cct-icon-btn" type="button" title="Settings">${GEAR_ICON}</button>
            <div id="cct-settings-popover">
                <div class="cct-manual-label-row"><label>Manual correction</label><span class="cct-info-icon" tabindex="0"><span class="cct-info-glyph">ⓘ</span><span class="cct-tooltip">Use this only if the displayed chain is wrong.</span></span></div>
                <div id="cct-manual-row">
                    <input id="cct-chain-input" type="number" min="0" step="1" value="${chain}">
                    <button id="cct-chain-save" type="button">Set Chain</button>
                </div>
                <div id="cct-sync-row">
                    <label>API Key</label>
                    <div id="cct-log-key-row">
                        <input id="cct-log-key-input" type="password" placeholder="log key"
                            value="${escapeHTML(logKey)}" spellcheck="false" autocomplete="off">
                        <button id="cct-log-key-save" type="button">Save</button>
                    </div>
                    <div id="cct-log-sync-btn-row">
                        <button id="cct-log-sync-now" type="button">Verify from Logs</button>
                        <a id="cct-create-log-key-btn" href="https://www.torn.com/preferences.php#tab=api?step=addNewKey&title=CrimeChainTracker&user=log&torn=items" target="_blank" rel="noopener">Create Key</a>
                    </div>
                    <span id="cct-log-sync-hint">Also used to verify/repair the chain from crime logs, and to price items for Crime Profit. Needs both "log" (User) and "items" (Torn) selections — the button below requests both.</span>
                </div>
                <details id="cct-log-details">
                    <summary>🛠️ Chain update log</summary>
                    <ul id="cct-log-list"></ul>
                    <button id="cct-log-clear" type="button">Clear log</button>
                </details>
                <div class="cct-version-footer">Version ${VERSION}</div>
            </div>
            <div id="cct-profit-popover" data-period="day" data-view="table">
                <div id="cct-profit-title">Crime Profit <span style="font-size: 9px; opacity: 0.5; font-weight: normal; margin-left: 4px;">v${VERSION}</span><button id="cct-debug-toggle" class="cct-icon-btn" type="button" title="Debug nerve tracking">${BUG_ICON}</button></div>
                <div id="cct-profit-periods">
                    <button class="cct-profit-period" data-profit-period="day" type="button">Day</button>
                    <button class="cct-profit-period" data-profit-period="week" type="button">Week</button>
                    <button class="cct-profit-period" data-profit-period="month" type="button">Month</button>
                    <button class="cct-profit-period" data-profit-period="year" type="button">Year</button>
                    <button id="cct-profit-view-toggle" class="cct-icon-btn" type="button" title="Toggle Graph View" style="margin-left: auto; opacity: 0.6;">${CHART_ICON}</button>
                </div>
                <div id="cct-profit-scroll-area">
                    <div id="cct-profit-summary"></div>
                    <div id="cct-profit-rows"></div>
                    <div id="cct-profit-graph"></div>
                </div>
                <div id="cct-debug-panel">
                    <div id="cct-debug-actions">
                        <button id="cct-debug-refresh" type="button">Refresh</button>
                        <button id="cct-debug-copy" type="button">Copy report</button>
                        <button id="cct-debug-clear" type="button">Reset trace</button>
                    </div>
                    <pre id="cct-debug-output"></pre>
                </div>
                <div id="cct-profit-reset-row">
                    <button id="cct-profit-reset" type="button">Reset profit history</button>
                </div>
                <details id="cct-onedrive-section">
                    <summary>☁ OneDrive backup <span id="cct-onedrive-success-dot" class="cct-sync-on-dot" title="OneDrive upload succeeded within the last 24 hours" style="display:${odRecentSuccess() ? 'inline-block' : 'none'};"></span> <span class="cct-info-icon" tabindex="0"><span class="cct-info-glyph">ⓘ</span><span class="cct-tooltip">Optional. OneDrive backup stores your Crime Profit history in your own Microsoft OneDrive account. Connect only if you want cloud backups.</span></span></summary>
                    <div id="cct-onedrive-actions">
                        <button id="cct-onedrive-connect" type="button">Connect OneDrive</button>
                        <button id="cct-onedrive-backup" type="button">Back up now</button>
                        <button id="cct-onedrive-restore" type="button">Restore latest</button>
                        <button id="cct-onedrive-export" type="button">Export JSON</button>
                        <button id="cct-onedrive-import" type="button">Import JSON</button>
                        <input id="cct-onedrive-file" type="file" accept="application/json,.json" style="display:none">
                    </div>
                    <div id="cct-onedrive-status" style="font-size:10px;opacity:.75;line-height:1.4;">${odRefresh ? (odLastBackup ? 'Last backup: ' + escapeHTML(odLastBackup) + ' (TCT/UTC)' : 'Connected · backup pending') : 'Not connected. Daily backup at midnight TCT; missed midnight is caught up on next Torn session.'}</div>
                    <span style="display:block;margin-top:5px;font-size:10px;opacity:.55;line-height:1.4;">Backs up complete profit records and item-price cache to “Crime Profit Monitor” in your OneDrive. Keeps latest.json and one dated snapshot per day. Cloudflare sync remains separate.</span>
                </details>
                <details id="cct-sync-section">
                    <summary>🔗 Cross-device sync${syncEnabled ? ' <span class="cct-sync-on-dot" title="Sync is on"></span>' : ''} <span class="cct-info-icon" tabindex="0"><span class="cct-info-glyph">ⓘ</span><span class="cct-tooltip">Optional. Syncs only your Crime Profit history between your own devices via a token only you have. Off by default.</span></span></summary>
                    <div id="cct-sync-toggle-row">
                        <label class="cct-sync-toggle-label">
                            <input id="cct-sync-toggle" type="checkbox" ${syncEnabled ? 'checked' : ''}>
                            <span>Enable sync (beta)</span>
                        </label>
                    </div>
                    <div id="cct-sync-token-row">
                        <input id="cct-sync-token-input" type="password" placeholder="sync token" value="${escapeHTML(syncToken)}" spellcheck="false" autocomplete="off">
                        <button id="cct-sync-token-generate" type="button" title="Generate a new random token">Generate</button>
                        <button id="cct-sync-token-save" type="button">Save</button>
                    </div>
                    <div id="cct-sync-action-row">
                        <button id="cct-sync-now" type="button">Sync now</button>
                        <span id="cct-sync-status">${escapeHTML(crossSyncLastStatus)}</span>
                    </div>
                    <span id="cct-sync-hint">Same token on both devices links them. Keep it private — it works like a password. Only Crime Profit history syncs; your chain and settings stay local.</span>
                </details>
                <div class="cct-version-footer">Version ${VERSION}</div>
            </div>
        `;

        anchor.appendChild(el);
        widgetRecoveryLogged = false;
        logDiagnostic('widget-inserted', {
            anchor: anchor.id || (typeof anchor.className === 'string' ? anchor.className : anchor.tagName),
            route: location.pathname + location.search,
        });
        console.log(`[CCT v${VERSION}] Widget inserted into Crimes interface.`);

        el.querySelector('#cct-theme-toggle').addEventListener('click', (e) => {
            e.stopPropagation();
            isDark = !isDark;
            saveTheme();
            applyTheme();
        });

        wireSettings(el);
        wireProfitPopover(el);
        applyTheme();
        renderCorrectionLog();
        renderProfitPopover();
    }

    let infoIconWired = false;

    function wireInfoIconOnce() {
        if (infoIconWired) return;
        infoIconWired = true;

        document.addEventListener('click', (e) => {
            const icon = e.target.closest('.cct-info-icon');
            if (icon && icon.closest('#cct-root')) {
                e.preventDefault();
                e.stopPropagation();
                const wasOpen = icon.classList.contains('cct-info-open');
                document.querySelectorAll('.cct-info-icon.cct-info-open').forEach((el) => el.classList.remove('cct-info-open'));
                if (!wasOpen) icon.classList.add('cct-info-open');
                return;
            }
            document.querySelectorAll('.cct-info-icon.cct-info-open').forEach((el) => el.classList.remove('cct-info-open'));
        });
    }

    let outsideClickWired = false;

    function clampPopoverToViewport(popover, rootEl) {
        const margin = 8;
        const viewportWidth = window.innerWidth;
        const rootRect = rootEl.getBoundingClientRect();
        const rect = popover.getBoundingClientRect();

        let desiredLeft = rect.left;
        if (rect.right > viewportWidth - margin) desiredLeft = viewportWidth - margin - rect.width;
        if (desiredLeft < margin) desiredLeft = margin;

        popover.style.left = `${desiredLeft - rootRect.left}px`;
        popover.style.right = 'auto';
    }

    let viewportClampWired = false;

    function wireViewportClampOnce() {
        if (viewportClampWired) return;
        viewportClampWired = true;

        const reclamp = () => {
            const root = document.querySelector('#cct-root');
            if (!root) return;
            const settingsPopover = document.querySelector('#cct-settings-popover');
            const profitPopover = document.querySelector('#cct-profit-popover');
            if (settingsPopover && settingsPopover.classList.contains('cct-open')) {
                clampPopoverToViewport(settingsPopover, root);
            }
            if (profitPopover && profitPopover.classList.contains('cct-open')) {
                clampPopoverToViewport(profitPopover, root);
            }
        };
        window.addEventListener('resize', reclamp);
        window.addEventListener('orientationchange', reclamp);
    }

    function wireOutsideClickOnce() {
        if (outsideClickWired) return;
        outsideClickWired = true;

        document.addEventListener('click', (e) => {
            const root = document.querySelector('#cct-root');
            const popover = document.querySelector('#cct-settings-popover');
            const profitPopover = document.querySelector('#cct-profit-popover');
            if (!root) return;
            if (!root.contains(e.target)) {
                if (popover) popover.classList.remove('cct-open');
                if (profitPopover) profitPopover.classList.remove('cct-open');
            }
        });
    }

    function wireProfitPopover(el) {
        const toggle = el.querySelector('#cct-profit-toggle');
        const popover = el.querySelector('#cct-profit-popover');
        toggle.addEventListener('click', (e) => {
            e.stopPropagation();
            el.querySelector('#cct-settings-popover').classList.remove('cct-open');
            popover.classList.toggle('cct-open');
            if (popover.classList.contains('cct-open')) {
                renderProfitPopover();
                clampPopoverToViewport(popover, el);
            }
        });

        popover.querySelector('#cct-profit-view-toggle').addEventListener('click', (e) => {
            e.stopPropagation();
            popover.dataset.view = popover.dataset.view === 'graph' ? 'table' : 'graph';
            renderProfitPopover();
        });

        popover.querySelectorAll('[data-profit-period]').forEach((button) => {
            button.addEventListener('click', () => {
                popover.dataset.period = button.dataset.profitPeriod;
                renderProfitPopover();
            });
        });
        popover.querySelector('#cct-profit-reset').addEventListener('click', (e) => {
            e.stopPropagation();
            resetProfitData();
        });

        wireViewportClampOnce();
        wireInfoIconOnce();
        wireSyncUI(popover);
        wireOneDriveUI(popover);
        odUpdateDot();
        wireDebugUI(popover);
    }

    function wireOneDriveUI(popover) {
        const q = id => popover.querySelector(id);
        q('#cct-onedrive-connect').addEventListener('click', async () => { try { if (odPoll) clearTimeout(odPoll); await odAuthorize(); } catch (e) { odStatus('Connect failed: ' + e.message); } });
        q('#cct-onedrive-backup').addEventListener('click', () => odBackup());
        q('#cct-onedrive-restore').addEventListener('click', () => odRestore());
        q('#cct-onedrive-export').addEventListener('click', odExport);
        q('#cct-onedrive-import').addEventListener('click', () => q('#cct-onedrive-file').click());
        q('#cct-onedrive-file').addEventListener('change', e => { odImport(e.target.files && e.target.files[0]); e.target.value = ''; });
    }
    function wireSyncUI(popover) {
        const toggleInput = popover.querySelector('#cct-sync-toggle');
        const tokenInput = popover.querySelector('#cct-sync-token-input');
        const generateBtn = popover.querySelector('#cct-sync-token-generate');
        const saveBtn = popover.querySelector('#cct-sync-token-save');
        const syncNowBtn = popover.querySelector('#cct-sync-now');

        toggleInput.addEventListener('change', () => {
            saveSyncEnabled(toggleInput.checked);
            if (syncEnabled && !syncToken) {
                setSyncStatus('Add or generate a token to start syncing');
                startCrossDeviceSync(); // no-op until a token exists, but arms the timers
            } else if (syncEnabled) {
                setSyncStatus('Enabling…');
                startCrossDeviceSync();
            } else {
                stopCrossDeviceSync();
                setSyncStatus('Sync disabled');
            }
        });

        generateBtn.addEventListener('click', () => {
            const token = generateSyncToken();
            tokenInput.type = 'text'; // briefly reveal so it's easy to copy to the other device
            tokenInput.value = token;
            saveSyncToken(token);
            setSyncStatus('New token generated — copy it to your other device, then paste + Save there');
            if (syncEnabled) startCrossDeviceSync();
        });

        saveBtn.addEventListener('click', () => {
            const trimmed = String(tokenInput.value || '').trim();
            if (trimmed && !SYNC_TOKEN_RE.test(trimmed)) {
                setSyncStatus('Token must be 16\u201364 letters/numbers/-/_ \u2014 try Generate instead');
                return;
            }
            saveSyncToken(trimmed);
            tokenInput.type = 'password';
            if (!syncToken) {
                setSyncStatus('Token cleared — sync paused');
                stopCrossDeviceSync();
                return;
            }
            setSyncStatus(syncEnabled ? 'Token saved — syncing…' : 'Token saved — enable sync to start');
            if (syncEnabled) startCrossDeviceSync();
        });

        syncNowBtn.addEventListener('click', () => {
            if (!syncEnabled) {
                setSyncStatus('Enable sync first');
                return;
            }
            if (!syncToken) {
                setSyncStatus('Add a token first');
                return;
            }
            runCrossDeviceSync();
        });
    }

    function wireSettings(el) {
        const gear = el.querySelector('#cct-gear');
        const popover = el.querySelector('#cct-settings-popover');

        gear.addEventListener('click', (e) => {
            e.stopPropagation();
            el.querySelector('#cct-profit-popover').classList.remove('cct-open');
            popover.classList.toggle('cct-open');
            if (popover.classList.contains('cct-open')) {
                renderCorrectionLog();
                clampPopoverToViewport(popover, el);
            }
        });

        wireOutsideClickOnce();
        wireViewportClampOnce();
        wireInfoIconOnce();

        el.querySelector('#cct-chain-save').addEventListener('click', () => {
            const input = el.querySelector('#cct-chain-input');
            const oldChain = chain;
            chain = clampChain(input.value);
            input.value = chain;
            commitChainAlways('manual', oldChain, null, 'Set manually in Settings');
        });

        el.querySelector('#cct-log-clear').addEventListener('click', () => {
            saveCorrectionLog([]);
            renderCorrectionLog();
        });

        el.querySelector('#cct-log-key-save').addEventListener('click', () => {
            const input = el.querySelector('#cct-log-key-input');
            const hint = el.querySelector('#cct-log-sync-hint');
            const cleanKey = saveLogApiKey(input.value);
            logSyncPageBefore = null; // fresh key, don't carry over old pagination state
            hint.textContent = cleanKey ? 'Log key saved — verification available' : 'Save a log key first';
        });

        el.querySelector('#cct-log-sync-now').addEventListener('click', async () => {
            const hint = el.querySelector('#cct-log-sync-hint');
            const key = getLogApiKey();
            if (!key) {
                hint.textContent = 'Save a log key first';
                return;
            }
            hint.textContent = 'Verifying from logs...';
            const result = await syncFromLogs('manual');
            if (result.ok) {
                hint.textContent = `Verified from logs — chain is ${result.chain}`;
            } else if (result.reason === 'no-reset-found') {
                hint.textContent = 'Need older logs — click again to search further back';
            } else if (result.error && result.error.code === 16) {
                hint.textContent = `Key needs the 'log' selection — use the button above to create one`;
            } else if (result.reason === 'empty') {
                hint.textContent = 'No crime log entries found for this key';
            } else {
                hint.textContent = `Sync failed: ${result.error ? result.error.message : 'unknown error'}`;
            }
        });
    }

    function render(animate) {
        const arc = document.querySelector('#cct-ring-arc');
        const label = document.querySelector('#cct-ring-label');
        const status = document.querySelector('#cct-status');
        const manual = document.querySelector('#cct-chain-input');
        if (!arc || !label || !status) return;

        const pct = Math.min(chain / CHAIN_CAP_DISPLAY, 1);
        const offset = CIRC * (1 - pct);
        const color = chainColor(chain);

        arc.style.strokeDashoffset = offset;
        arc.style.stroke = color;
        label.textContent = String(chain);
        status.textContent = statusText(chain);
        if (manual && document.activeElement !== manual) manual.value = chain;

        if (animate) {
            status.classList.remove('cct-flash');
            void status.offsetWidth;
            status.classList.add('cct-flash');
        }
    }

    function isVisibleElement(el) {
        if (!el || el.closest('#cct-root')) return false;
        if (el.hidden || el.getAttribute('aria-hidden') === 'true') return false;
        return Boolean(el.offsetParent || el.getClientRects().length);
    }

    function inspectPossibleOutcomeNode(node) {
        const element = node.nodeType === Node.TEXT_NODE ? node.parentElement : node;
        if (!element || element.nodeType !== Node.ELEMENT_NODE) return;

        const candidates = [];
        if (element.matches && element.matches(OUTCOME_CONTAINER_SELECTOR)) candidates.push(element);
        if (element.closest) {
            const closest = element.closest(OUTCOME_CONTAINER_SELECTOR);
            if (closest) candidates.push(closest);
        }
        if (element.querySelectorAll) candidates.push(...element.querySelectorAll(OUTCOME_CONTAINER_SELECTOR));

        for (const candidate of new Set(candidates)) {
            if (!isVisibleElement(candidate)) continue;
            if (candidate.dataset && candidate.dataset.cctSeen === '1') continue;

            const text = normalizeText(candidate.textContent);
            const outcome = classifyOutcome(text);
            if (!outcome) continue;

            if (candidate.dataset) candidate.dataset.cctSeen = '1';
            applyOutcomeFromText(text);
            break;
        }
    }

    function startDOMObserver() {
        if (observer) observer.disconnect();

        const root = findCrimesApp();
        if (!root) return;

        observer = new MutationObserver((mutations) => {
            if (!document.querySelector('#cct-root')) renderWidget();

            pollNerve('mutation');

            const synced = syncFromNativeBadge();

            if (!synced && !applyResultCountDeltaFallback({ source: 'mutation-observer', mutations })) {
                for (const mutation of mutations) {
                    for (const node of mutation.addedNodes) inspectPossibleOutcomeNode(node);
                }
            }
        });

        observer.observe(root, { childList: true, subtree: true });
    }

    async function fetchCrimeLogPage(key, to) {
        const idsParam = LOG_IDS_ALL.join(',');
        let url = `https://api.torn.com/user/?selections=log&log=${idsParam}&key=${encodeURIComponent(key)}`;
        if (to) url += `&to=${to}`;
        const res = await fetchWithTimeout(url);
        const data = await res.json();
        if (data.error) {
            const err = new Error(data.error.error || 'Torn API error');
            err.code = data.error.code;
            throw err;
        }
        const raw = data.log || {};
        return Object.values(raw).map((e) => ({ log: e.log, timestamp: e.timestamp }));
    }

    function replayChainFromEntries(entries) {
        const sorted = entries.slice().sort((a, b) => a.timestamp - b.timestamp);
        let lastCritIndex = -1;
        sorted.forEach((e, i) => { if (LOG_IDS_CRITICAL.includes(e.log)) lastCritIndex = i; });
        if (lastCritIndex === -1) return null;

        let result = 0;
        let successCount = 0;
        let failCount = 0;
        for (let i = lastCritIndex + 1; i < sorted.length; i++) {
            const e = sorted[i];
            if (e.log === LOG_ID_SUCCESS) { result += 1; successCount++; }
            else if (e.log === LOG_ID_FAIL) { result = Math.floor(result / 2); failCount++; }
        }
        return { chain: result, successCount, failCount, resetTimestamp: sorted[lastCritIndex].timestamp, oldestTimestamp: sorted[0].timestamp };
    }

    let logSyncPageBefore = null;

    async function syncFromLogs(trigger) {
        const key = getLogApiKey();
        if (!key) return { ok: false, reason: 'no-key' };

        try {
            const entries = await fetchCrimeLogPage(key, logSyncPageBefore);
            if (!entries.length) return { ok: false, reason: 'empty' };

            const result = replayChainFromEntries(entries);
            if (!result) {
                const oldest = entries.slice().sort((a, b) => a.timestamp - b.timestamp)[0].timestamp;
                logSyncPageBefore = oldest - 1;
                return { ok: false, reason: 'no-reset-found' };
            }

            logSyncPageBefore = null;
            const oldChain = chain;
            chain = clampChain(result.chain);

            pendingCriticalConfirm = null;
            resetResultCounterTracking();

            const reason = `${result.successCount} success${result.successCount === 1 ? '' : 'es'}, ${result.failCount} fail${result.failCount === 1 ? '' : 's'} since last reset${trigger ? ` (${trigger})` : ''}`;
            commitChainIfChanged('log', oldChain, result, reason);
            return { ok: true, chain };
        } catch (e) {
            console.log(`[CCT v${VERSION}] log sync failed:`, e.message, e.code || '');
            return { ok: false, reason: 'error', error: e };
        }
    }

    function runSyncLoop() {
        clearTimeout(syncTimer);
        syncTimer = setTimeout(() => {
            const route = currentCrimesRoute();
            if (route !== lastCrimesRoute) {
                lastCrimesRoute = route;
                cachedNativeChainValueEl = null;
                resetResultCounterTracking();
            }
            renderWidget();
            startDOMObserver();
            pollNerve('sync-loop');
            if (!syncFromNativeBadge()) applyResultCountDeltaFallback({ source: 'sync-loop' });
            render(false);
        }, 100);
    }

    function startAppRuntime(source) {
        if (appRuntimeStarted) return;
        appRuntimeStarted = true;
        appWaitLogged = false;

        const detectedApp = findCrimesApp();
        logDiagnostic('crimes-interface-detected', {
            source,
            app: describeElement(detectedApp),
            route: location.pathname + location.search,
        });
        console.log(`[CCT v${VERSION}] Crimes interface detected (${source}); initializing tracker.`);
        runSyncLoop();
        pollNerve('init');
        setInterval(() => pollNerve('interval'), 1500);
        resolveUnknownItemPrices();
        startCrossDeviceSync();
        logDiagnostic('tracker-initialized', {
            source,
            widgetPresent: !!document.querySelector('#cct-root'),
            fetchAvailable: typeof window.fetch === 'function',
        });
        console.log(`[CCT v${VERSION}] Tracker initialized successfully.`);
    }

    function checkForCrimesApp(source) {
        const app = findCrimesApp();
        if (!app) return false;

        if (!appRuntimeStarted) {
            startAppRuntime(source || 'watcher');
            return true;
        }

        // Torn PDA can replace the Crimes subtree after initial startup.
        // If that happens, let the normal sync loop reattach the widget/observer.
        if (!document.querySelector('#cct-root')) {
            if (!widgetRecoveryLogged) {
                widgetRecoveryLogged = true;
                logDiagnostic('widget-missing-recovery-started', {
                    source,
                    app: describeElement(app),
                    route: location.pathname + location.search,
                });
            }
            runSyncLoop();
        }
        return true;
    }

    function startAppWatcher() {
        if (appWatcherStarted) return;
        appWatcherStarted = true;

        // Observe the whole document because Torn PDA may mount the Crimes app
        // after document-idle or replace it during an internal navigation.
        const watchTarget = document.documentElement || document;
        if (watchTarget && typeof MutationObserver !== 'undefined') {
            appWatchObserver = new MutationObserver(() => checkForCrimesApp('DOM observer'));
            appWatchObserver.observe(watchTarget, { childList: true, subtree: true });
        }

        // Mutation observers are the primary trigger; this low-frequency check
        // is a fallback for PDA builds that update the view without useful DOM
        // mutations reaching the observer.
        appWatchInterval = setInterval(() => {
            const wasStarted = appRuntimeStarted;
            const found = checkForCrimesApp('retry');
            if (found && !wasStarted) {
                logDiagnostic('crimes-interface-found-on-retry', {
                    route: location.pathname + location.search,
                });
            }
        }, 1500);

        const foundInitially = checkForCrimesApp('initial check');
        if (!foundInitially && !appWaitLogged) {
            appWaitLogged = true;
            logDiagnostic('waiting-for-crimes-interface', {
                message: 'Crimes interface was not present at initial check; watcher remains active.',
                route: location.pathname + location.search,
            });
        }
    }

    function watchSpaNavigation() {
        const originalPushState = history.pushState;
        const originalReplaceState = history.replaceState;

        history.pushState = function (...args) {
            const result = originalPushState.apply(this, args);
            runSyncLoop();
            return result;
        };

        history.replaceState = function (...args) {
            const result = originalReplaceState.apply(this, args);
            runSyncLoop();
            return result;
        };

        window.addEventListener('popstate', runSyncLoop);
        window.addEventListener('hashchange', runSyncLoop);
    }

    // =========================================================================
    // HUB INTEGRATION
    // =========================================================================
    function openCCT() {
        const root = document.getElementById('cct-root');
        if (root) {
            root.scrollIntoView({ behavior: 'smooth', block: 'center' });
            const widget = root.querySelector('#cct-widget');
            if (widget) {
                widget.style.transition = 'box-shadow 0.3s';
                widget.style.boxShadow = '0 0 0 3px rgba(78,138,199,0.5)';
                setTimeout(() => { widget.style.boxShadow = ''; }, 1000);
            }
        } else {
            renderWidget();
            const newRoot = document.getElementById('cct-root');
            if (newRoot) {
                newRoot.scrollIntoView({ behavior: 'smooth', block: 'center' });
                const widget = newRoot.querySelector('#cct-widget');
                if (widget) {
                    widget.style.transition = 'box-shadow 0.3s';
                    widget.style.boxShadow = '0 0 0 3px rgba(78,138,199,0.5)';
                    setTimeout(() => { widget.style.boxShadow = ''; }, 1000);
                }
            }
        }
    }

    function registerWithHub() {
        document.dispatchEvent(new CustomEvent('torn-script-hub:register', {
            detail: {
                id: 'crime-chain-tracker',
                name: 'Crime Chain Tracker',
                version: VERSION,
                order: 100,
                open: openCCT,
                status: () => `Chain ${chain}` + (statusText(chain) ? ` · ${statusText(chain)}` : ''),
                prefs: {
                    fields: [
                        { key: 'apiKey', type: 'password', label: 'API Key', hint: 'Torn API key with log and items selections' },
                        { key: 'theme', type: 'select', label: 'Theme', options: [
                            { value: 'dark', label: 'Dark' },
                            { value: 'light', label: 'Light' }
                        ], default: 'dark' },
                        { key: 'syncEnabled', type: 'toggle', label: 'Cross-device sync', default: false }
                    ],
                    values: {
                        apiKey: getLogApiKey(),
                        theme: isDark ? 'dark' : 'light',
                        syncEnabled: syncEnabled
                    },
                    onSave: (values) => {
                        if (values.apiKey !== undefined) {
                            saveLogApiKey(values.apiKey);
                        }
                        if (values.theme !== undefined) {
                            isDark = values.theme === 'dark';
                            saveTheme();
                            applyTheme();
                        }
                        if (values.syncEnabled !== undefined) {
                            saveSyncEnabled(values.syncEnabled);
                            if (syncEnabled) startCrossDeviceSync();
                            else stopCrossDeviceSync();
                        }
                    }
                }
            }
        }));
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', registerWithHub);
    } else {
        registerWithHub();
    }
    document.addEventListener('torn-script-hub:ready', registerWithHub);

    function init() {
        injectCSS();
        watchSpaNavigation();
        logDiagnostic('script-started', {
            readyState: document.readyState,
            visibilityState: document.visibilityState,
            route: location.pathname + location.search,
            userAgent: navigator.userAgent.slice(0, 160),
        });
        const interceptorWindow = typeof unsafeWindow !== 'undefined' ? unsafeWindow : window;
        logDiagnostic('fetch-interceptor-status', {
            installed: !!interceptorWindow.__cctFetchWrapped,
            fetchAvailable: typeof interceptorWindow.fetch === 'function',
            realm: typeof unsafeWindow !== 'undefined' ? 'unsafeWindow' : 'window',
        });
        startAppWatcher();
        odSchedule();
        console.log(`[CCT v${VERSION}] Script started; waiting for Crimes interface if it is not mounted yet.`);
    }

    init();
})();
