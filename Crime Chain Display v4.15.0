            #cct-ring-arc {
                fill: none;
                stroke-width: 2;
            }
            #cct-ring-arc {
                stroke-linecap: round;
                opacity: 0.82;
                transition: stroke-dashoffset 0.4s ease, stroke 0.4s ease;
            }
            #cct-ring-label {
                position: absolute;
                inset: 3px;
                display: flex;
                align-items: center;
                justify-content: center;
                min-width: 22px;
                min-height: 22px;
                border-radius: 50%;
                font-size: 11px;
                font-weight: 500;
                pointer-events: none;
                line-height: 1;
                box-sizing: border-box;
                font-variant-numeric: tabular-nums;
                text-shadow: none;
            }
            #cct-text {
                display: flex;
                flex-direction: column;
                line-height: 1.15;
            }
            #cct-label {
                font-size: 9px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.07em;
                color: inherit;
            }
            #cct-status {
                font-size: 11px;
                font-weight: 600;
                color: inherit;
                min-width: 74px;
            }
            @keyframes cct-flash {
                0% { opacity: 1; }
                40% { opacity: 0.25; }
                100% { opacity: 1; }
            }
            #cct-status.cct-flash { animation: cct-flash 0.35s ease; }
            .cct-icon-btn {
                font-size: 11px;
                cursor: pointer;
                line-height: 1;
                transition: opacity 0.15s, background 0.15s;
                background: none;
                border: none;
                color: inherit;
                padding: 3px 5px;
                border-radius: 4px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }
            .cct-icon-btn svg { display: block; }
            @media (max-width: 480px) {
                #cct-root { margin-left: 8px; gap: 4px; }
                #cct-widget { gap: 6px; padding: 3px 8px 3px 4px; }
                #cct-ring-wrap { width: 22px; height: 22px; }
                #cct-ring-wrap svg { width: 22px; height: 22px; }
                #cct-ring-label { font-size: 9px; min-width: 17px; min-height: 17px; inset: 2px; }
                #cct-label { font-size: 8px; }
                #cct-status { font-size: 10px; min-width: 58px; }
                .cct-icon-btn { font-size: 10px; padding: 2px 4px; }
            }
            #cct-settings-popover {
                display: none;
                position: absolute;
                top: calc(100% + 6px);
                left: 0;
                z-index: 9999;
                width: 380px;
                max-width: calc(100vw - 24px);
                box-sizing: border-box;
                padding: 10px 12px;
                border-radius: 8px;
                box-shadow: 0 6px 20px rgba(0,0,0,0.5);
                flex-direction: column;
                gap: 8px;
                font-size: 12px;
            }
            #cct-settings-popover.cct-open { display: flex; }
            #cct-settings-popover label {
                font-size: 10px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.07em;
                opacity: 0.5;
                color: inherit;
            }
            #cct-manual-row {
                display: flex;
                align-items: center;
                gap: 6px;
            }
            #cct-chain-input {
                padding: 4px 7px;
                font-size: 12px;
                border-radius: 5px;
                outline: none;
            }
            #cct-chain-input { width: 54px; }
            #cct-chain-save {
                padding: 4px 9px;
                font-size: 11px;
                border-radius: 5px;
                cursor: pointer;
                transition: background 0.15s;
                white-space: nowrap;
            }
            #cct-sync-row {
                margin-top: 2px;
            }
            #cct-sync-row label {
                display: block;
                margin-bottom: 6px;
            }
            #cct-log-key-row {
                display: flex;
                align-items: center;
                gap: 6px;
                margin-bottom: 6px;
            }
            #cct-log-key-input {
                flex: 1;
                min-width: 0;
                padding: 4px 7px;
