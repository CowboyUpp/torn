// ==UserScript==
// @name         Crime Chain Tracker
// @namespace    https://greasyfork.org/users/cowboyup
// @version      4.15.0
// @description  Tracks your Crime 2.0 chain and local crime-profit statistics, including $/nerve efficiency and opt-in cross-device sync.
// @author       cowboyup
// @match        https://www.torn.com/page.php?sid=crimes*
// @run-at       document-idle
// @license      MIT; https://opensource.org/licenses/MIT
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_xmlhttpRequest
// @connect      cct-sync.selbaer.workers.dev
// @connect      login.microsoftonline.com
// @connect      graph.microsoft.com
// @downloadURL https://update.greasyfork.org/scripts/581948/Crime%20Chain%20Tracker.user.js
// @updateURL https://update.greasyfork.org/scripts/581948/Crime%20Chain%20Tracker.meta.js
// ==/UserScript==

(function () {
    'use strict';

    const VERSION = '4.15.0';
    const SYNC_WORKER_URL = 'https://cct-sync.selbaer.workers.dev';
    installCrimeAttemptInterceptor();
    const STORAGE_KEY_CHAIN = 'cct_chain_v4';
    const STORAGE_KEY_LOG_APIKEY = 'cct_log_apikey_v4';
    const STORAGE_KEY_THEME = 'cct_theme_v4';
    const STORAGE_KEY_LAST_EVENT = 'cct_last_event_v4';
    const STORAGE_KEY_CORRECTION_LOG = 'cct_correction_log_v4';
    const STORAGE_KEY_DIAGNOSTICS = 'cct_diagnostics_v4';
    const STORAGE_KEY_PROFIT_RECORDS = 'cct_profit_records_v1';
    const STORAGE_KEY_ITEM_PRICES = 'cct_profit_prices_v1';
    const STORAGE_KEY_SYNC_ENABLED = 'cct_sync_enabled_v1';
    const STORAGE_KEY_SYNC_TOKEN = 'cct_sync_token_v1';
    const STORAGE_KEY_SYNC_PUSH_CURSOR = 'cct_sync_push_cursor_v1';
    const OD_REFRESH_KEY = 'cct_onedrive_refresh_v1';
    const OD_LAST_KEY = 'cct_onedrive_last_backup_v1';
    const OD_LAST_SUCCESS_AT_KEY = 'cct_onedrive_last_success_at_v1';
    const OD_CLIENT = 'dfcdc5e1-3623-4721-a08e-b740c075c4d2';
    const OD_FOLDER = 'Crime Profit Monitor';
    const STORAGE_KEY_NERVE_USED = 'cct_nerve_used_by_type_v1';
    const NERVE_MAX_SPEND_PER_RESPONSE = 25;
    const CORRECTION_LOG_MAX = 15;
    const DIAGNOSTIC_LOG_MAX = 10;
    const CHAIN_CAP_DISPLAY = 100;
    const OUTCOME_DEDUPE_MS = 3500;
    const MAX_REASONABLE_COUNTER_DELTA = 10;
    const ITEM_PRICE_CACHE_MS = 24 * 60 * 60 * 1000;
    const SYNC_PUSH_INTERVAL_MS = 10 * 60 * 1000;
    const SYNC_PULL_INTERVAL_MS = 150 * 1000;
    const SYNC_PUSH_BATCH_MAX = 300;
    const SYNC_TOKEN_RE = /^[a-zA-Z0-9_-]{16,64}$/;
    const FETCH_TIMEOUT_MS = 15000;
    const LOG_ID_SUCCESS = 9010;
    const LOG_ID_FAIL = 9150;
    const LOG_IDS_CRITICAL = [9154, 9155, 9158, 9160, 9163, 9165, 9190, 9191];
    const LOG_IDS_ALL = [LOG_ID_SUCCESS, LOG_ID_FAIL, ...LOG_IDS_CRITICAL];

    let chain = clampChain(parseInt(safeGet(STORAGE_KEY_CHAIN, '0'), 10) || 0);
    let isDark = safeGet(STORAGE_KEY_THEME, 'dark') !== 'light';
    let observer = null;
    let appWatchObserver = null;
    let appWatchInterval = null;
    let appRuntimeStarted = false;
    let appWatcherStarted = false;
    let appWaitLogged = false;
    let widgetRecoveryLogged = false;
    let lastEvent = readLastEvent();
    let syncTimer = null;
    let lastResultCounts = null;
    let pendingResultCountReseed = null;
    let cachedNativeChainValueEl = null;
    let lastCrimesRoute = null;
    let pendingCriticalConfirm = null;
    let confirmedCriticalFails = null;
    let profitRecords = readProfitRecords();
    let itemPriceCache = readItemPriceCache();
    let syncEnabled = safeGet(STORAGE_KEY_SYNC_ENABLED, '0') === '1';
    let syncToken = safeGet(STORAGE_KEY_SYNC_TOKEN, '');
    let syncPushCursor = Number(safeGet(STORAGE_KEY_SYNC_PUSH_CURSOR, '0')) || 0;
    let crossSyncPushTimer = null;
    let crossSyncPullTimer = null;
    let crossSyncInFlight = false;
    let crossSyncLastStatus = '';
    let odRefresh = safeGet(OD_REFRESH_KEY, '');
    let odLastBackup = safeGet(OD_LAST_KEY, '');
    let odLastSuccessAt = Number(safeGet(OD_LAST_SUCCESS_AT_KEY, '0')) || 0;
    let odAccess = '';
    let odFolderId = '';
    let odBusy = false;
    let odTimer = null;
    let odPoll = null;
    let graphVisibility = { cash: true, items: true, total: true };
    let nerveTracker = { last: null, pendingSpend: null, pendingAt: 0, warnedMissing: false, totalDrops: 0, totalRegen: 0, totalConsumed: 0, totalExpired: 0 };
    const TRACE_MAX = 150;
    // Torn's lifetime nerve counter (DB.currentUserStats.nerveUsed) is PER CRIME TYPE (typeID in the request URL).
    // The delta between two consecutive responses of the same type is the exact nerve the later attempt cost, fails included.
    let nerveUsedByType = (() => {
        try {
            const v = JSON.parse(safeGet(STORAGE_KEY_NERVE_USED, '{}'));
            return v && typeof v === 'object' && !Array.isArray(v) ? v : {};
        } catch (_) { return {}; }
    })();
    let lastUserNerveSeen = null; // { value, at } from DB.user.nerve of the previous response (bootstrap fallback)
    const nerveTrace = [];

    const NERVE_PENDING_WINDOW_MS = 15000;
    const itemPriceFetchAttempted = new Set();
    const itemPriceFetchFailureReason = new Map();

    const THEME = {
        dark: {
            widgetBg: 'rgba(255,255,255,0.07)',
            widgetBorder: 'rgba(255,255,255,0.12)',
            ringTrack: 'rgba(255,255,255,0.10)',
            popoverBg: '#1e1e1e',
            popoverBorder: 'rgba(255,255,255,0.15)',
            popoverColor: '#ccc',
            inputBg: 'rgba(255,255,255,0.06)',
            inputBorder: 'rgba(255,255,255,0.15)',
            inputFocus: 'rgba(255,255,255,0.4)',
            saveBg: 'rgba(255,255,255,0.08)',
            saveBorder: 'rgba(255,255,255,0.18)',
            saveBgHover: 'rgba(255,255,255,0.16)',
            labelOpacity: '0.4',
            statusOpacity: '0.8',
            gearOpacity: '0.45',
            gearHover: '0.8',
            ringInnerBg: 'rgba(255,255,255,0.08)',
            ringInnerBorder: 'rgba(255,255,255,0.14)',
            ringInnerShadow: 'inset 0 1px 1px rgba(255,255,255,0.10), inset 0 -1px 2px rgba(0,0,0,0.55), 0 1px 1px rgba(0,0,0,0.35)',
            ringText: 'rgba(255,255,255,0.86)',
            chainLow: '#00ff66',
            chainMid: '#ffaa00',
            chainHigh: '#ff3344',
        },
        light: {
            widgetBg: 'rgba(0,0,0,0.05)',
            widgetBorder: 'rgba(0,0,0,0.14)',
            ringTrack: 'rgba(0,0,0,0.12)',
            popoverBg: '#ffffff',
            popoverBorder: 'rgba(0,0,0,0.15)',
            popoverColor: '#222',
            inputBg: 'rgba(0,0,0,0.04)',
            inputBorder: 'rgba(0,0,0,0.18)',
            inputFocus: 'rgba(0,0,0,0.45)',
            saveBg: 'rgba(0,0,0,0.06)',
            saveBorder: 'rgba(0,0,0,0.18)',
            saveBgHover: 'rgba(0,0,0,0.13)',
            labelOpacity: '0.45',
            statusOpacity: '1',
            gearOpacity: '0.55',
            gearHover: '0.85',
            ringInnerBg: 'rgba(0,0,0,0.06)',
            ringInnerBorder: 'rgba(0,0,0,0.16)',
            ringInnerShadow: 'inset 0 1px 1px rgba(255,255,255,0.75), inset 0 -1px 2px rgba(0,0,0,0.18), 0 1px 1px rgba(255,255,255,0.45)',
            ringText: 'rgba(32,33,36,0.82)',
            chainLow: '#16a34a',
            chainMid: '#d97706',
            chainHigh: '#dc2626',
        },
    };

    const OUTCOME_RULES = [
        { type: 'critical', re: /\bcritical(?:ly)?\b|critical\s+failure|crit\s+fail/i },
        { type: 'fail', re: /\bfail(?:ed|ure)?\b|unsuccessful/i },
        { type: 'success', re: /\bsuccess(?:ful|fully)?\b|\bcompleted\b|you\s+managed\s+to/i },
    ];

    const OUTCOME_CONTAINER_SELECTOR = [
        '[class*="crime" i][class*="result" i]',
        '[class*="crime" i][class*="outcome" i]',
        '[class*="crime" i][class*="message" i]',
        '[class*="crime" i][class*="notification" i]',
        '[class*="crime" i][class*="toast" i]',
        '[class*="crime" i][class*="success" i]',
        '[class*="crime" i][class*="fail" i]',
        '[class*="result" i][class*="success" i]',
        '[class*="result" i][class*="fail" i]',
        '[class*="outcome" i][class*="success" i]',
        '[class*="outcome" i][class*="fail" i]',
    ].join(',');

    const RADIUS = 10;
    const CIRC = 2 * Math.PI * RADIUS;

    const MOON_ICON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.64 13a1 1 0 0 0-1.05-.14 8.05 8.05 0 0 1-3.37.73 8.15 8.15 0 0 1-8.14-8.1 8.59 8.59 0 0 1 .35-2.43A1 1 0 0 0 8.1 2.3a10.14 10.14 0 1 0 13.5 13.27 1 1 0 0 0-.04-2.57z"/></svg>';
    const SUN_ICON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>';
    const GEAR_ICON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>';
    const CHART_ICON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>';
    const BUG_ICON = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="6" width="8" height="14" rx="4"/><path d="M19 7l-3 2M5 7l3 2M19 19l-3-2M5 19l3-2M20 13h-4M4 13h4M10 2l1 2M14 2l-1 2"/></svg>';

    function clampChain(value) {
        const n = Number(value);
        if (!Number.isFinite(n)) return 0;
        return Math.max(0, Math.floor(n));
    }

    function safeGet(key, fallback) {
        return typeof GM_getValue === 'function' ? GM_getValue(key, fallback) : fallback;
    }

    function safeSet(key, value) {
        if (typeof GM_setValue === 'function') GM_setValue(key, value);
    }

    function readLastEvent() {
        try {
            return JSON.parse(safeGet(STORAGE_KEY_LAST_EVENT, '{}')) || {};
        } catch (_) {
            return {};
        }
    }

    function saveChain() {
        safeSet(STORAGE_KEY_CHAIN, String(chain));
    }

    function getLogApiKey() {
        return safeGet(STORAGE_KEY_LOG_APIKEY, '');
    }

    function saveLogApiKey(key) {
        const sanitized = String(key || '').replace(/\s+/g, '');
        safeSet(STORAGE_KEY_LOG_APIKEY, sanitized);
        return sanitized;
    }

    function saveTheme() {
        safeSet(STORAGE_KEY_THEME, isDark ? 'dark' : 'light');
    }

    function saveLastEvent(event) {
        lastEvent = event;
        safeSet(STORAGE_KEY_LAST_EVENT, JSON.stringify(event));
    }

    function currentCrimesRoute() {
        return `${location.pathname}${location.search}${location.hash}`;
    }

    function resetResultCounterTracking() {
        lastResultCounts = null;
        confirmedCriticalFails = null;
        pendingCriticalConfirm = null;
        pendingResultCountReseed = null;
    }

    const CORRECTION_SOURCE_LABELS = {
        native: 'Native badge sync',
        counts: 'Result counter delta',
        text: 'Toast text fallback',
        manual: 'Manual correction',
        log: 'Log-based sync',
    };

    function readCorrectionLog() {
        try {
            const parsed = JSON.parse(safeGet(STORAGE_KEY_CORRECTION_LOG, '[]'));
            return Array.isArray(parsed) ? parsed : [];
        } catch (_) {
            return [];
        }
    }

    function saveCorrectionLog(entries) {
        safeSet(STORAGE_KEY_CORRECTION_LOG, JSON.stringify(entries));
    }

    function readDiagnostics() {
        try {
            const parsed = JSON.parse(safeGet(STORAGE_KEY_DIAGNOSTICS, '[]'));
            return Array.isArray(parsed) ? parsed : [];
        } catch (_) {
            return [];
        }
    }

    function saveDiagnostics(entries) {
        safeSet(STORAGE_KEY_DIAGNOSTICS, JSON.stringify(entries));
        try {
            localStorage.setItem(STORAGE_KEY_DIAGNOSTICS, JSON.stringify(entries));
        } catch (_) {
            // Best-effort console-readable mirror; GM storage above is canonical.
        }
    }

    function logDiagnostic(type, detail) {
        const entry = {
            time: Date.now(),
            type,
            url: location.href,
            visibilityState: document.visibilityState,
            readyState: document.readyState,
            detail,
        };
        const entries = readDiagnostics();
        entries.unshift(entry);
        while (entries.length > DIAGNOSTIC_LOG_MAX) entries.pop();
        saveDiagnostics(entries);
        console.log(`[CCT v${VERSION}] diagnostic: ${type}`, entry);
        refreshDebugIfOpen();
    }

    function logCorrection(source, oldChain, newChain, detail, reason) {
        console.log(`[CCT v${VERSION}] ${source}: ${oldChain} -> ${newChain}`, reason || '', detail || '');

        const entries = readCorrectionLog();
        entries.unshift({
            time: Date.now(),
            source,
            oldChain,
            newChain,
            reason: reason || '',
        });
        while (entries.length > CORRECTION_LOG_MAX) entries.pop();
        saveCorrectionLog(entries);

        renderCorrectionLog();
    }

    function commitChainIfChanged(source, oldChain, detail, reason) {
        if (chain === oldChain) return false;
        logCorrection(source, oldChain, chain, detail, reason);
        saveChain();
        render(true);
        return true;
    }

    function commitChainAlways(source, oldChain, detail, reason) {
        const changed = chain !== oldChain;
        if (changed) logCorrection(source, oldChain, chain, detail, reason);
        saveChain();
        render(true);
        return changed;
    }

    function relativeTime(ts) {
        const diffSec = Math.max(0, Math.floor((Date.now() - ts) / 1000));
        if (diffSec < 5) return 'just now';
        if (diffSec < 60) return `${diffSec}s ago`;
        const diffMin = Math.floor(diffSec / 60);
        if (diffMin < 60) return `${diffMin}m ago`;
        const diffHr = Math.floor(diffMin / 60);
        if (diffHr < 24) return `${diffHr}h ago`;
        return `${Math.floor(diffHr / 24)}d ago`;
    }

    function renderCorrectionLog() {
        const list = document.querySelector('#cct-log-list');
        if (!list) return;

        const entries = readCorrectionLog();
        if (!entries.length) {
            list.innerHTML = '<li id="cct-log-empty">No corrections yet — nice and steady 🤠</li>';
            return;
        }

        list.innerHTML = entries.map((entry) => {
            const label = CORRECTION_SOURCE_LABELS[entry.source] || entry.source;
            const arrow = entry.newChain > entry.oldChain ? '📈' : entry.newChain < entry.oldChain ? '📉' : '↔️';
            const reasonLine = entry.reason ? `<div class="cct-log-reason">${escapeHTML(entry.reason)}</div>` : '';
            return `<li>
                <span class="cct-log-arrow">${arrow}</span>
                <span class="cct-log-detail">${escapeHTML(label)}: <strong>${entry.oldChain} → ${entry.newChain}</strong>${reasonLine}</span>
                <span class="cct-log-time">${relativeTime(entry.time)}</span>
            </li>`;
        }).join('');
    }

    function escapeHTML(value) {
        return String(value || '').replace(/[&<>"]/g, (ch) => ({
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
        }[ch]));
    }

    function normalizeText(text) {
        return String(text || '')
            .replace(/\s+/g, ' ')
            .trim()
            .slice(0, 500);
    }

    function readProfitRecords() {
        try {
            const value = JSON.parse(safeGet(STORAGE_KEY_PROFIT_RECORDS, '[]'));
            return Array.isArray(value) ? value : [];
        } catch (_) { return []; }
    }

    function readItemPriceCache() {
        try {
            const value = JSON.parse(safeGet(STORAGE_KEY_ITEM_PRICES, '{}'));
            return value && typeof value === 'object' ? value : {};
        } catch (_) { return {}; }
    }

    function saveProfitData() {
        safeSet(STORAGE_KEY_PROFIT_RECORDS, JSON.stringify(profitRecords));
        safeSet(STORAGE_KEY_ITEM_PRICES, JSON.stringify(itemPriceCache));
    }

    function odStatus(t) { const e = document.querySelector('#cct-onedrive-status'); if (e) e.textContent = t; }
    function odRecentSuccess() { return odLastSuccessAt > 0 && (Date.now() - odLastSuccessAt) <= 24 * 60 * 60 * 1000; }
    function odUpdateDot() { const e = document.querySelector('#cct-onedrive-success-dot'); if (e) { e.style.display = odRecentSuccess() ? 'inline-block' : 'none'; e.title = odRecentSuccess() ? 'OneDrive upload succeeded within the last 24 hours' : 'No successful OneDrive upload within the last 24 hours'; } }
    function odRequest(method, url, token, data, headers = {}) { return gmRequest({ method, url, data, headers: { ...(token ? { Authorization: 'Bearer ' + token } : {}), ...headers } }); }
    async function odForm(url, params) { return odRequest('POST', url, '', new URLSearchParams(params).toString(), { 'Content-Type': 'application/x-www-form-urlencoded' }); }
    async function odAuthorize() {
        const base = 'https://login.microsoftonline.com/consumers/oauth2/v2.0/';
        const r = await odForm(base + 'devicecode', { client_id: OD_CLIENT, scope: 'Files.ReadWrite offline_access User.Read' });
        if (r.status < 200 || r.status >= 300) throw Error('Device sign-in failed: HTTP ' + r.status);
        const d = JSON.parse(r.responseText); odStatus('Visit ' + d.verification_uri + ' and enter code: ' + d.user_code);
        const poll = async () => { try {
            const t = await odForm(base + 'token', { grant_type: 'urn:ietf:params:oauth:grant-type:device_code', client_id: OD_CLIENT, device_code: d.device_code });
            const p = JSON.parse(t.responseText || '{}');
            if (t.status >= 200 && t.status < 300 && p.access_token) { odAccess = p.access_token; odRefresh = p.refresh_token || ''; safeSet(OD_REFRESH_KEY, odRefresh); odStatus('Connected. Starting backup…'); await odBackup(); return; }
            if (p.error === 'authorization_pending' || p.error === 'slow_down') { odPoll = setTimeout(poll, ((d.interval || 5) + (p.error === 'slow_down' ? 5 : 0)) * 1000); return; }
            odStatus(p.error_description || p.error || 'Sign-in expired; connect again.');
        } catch (e) { odStatus('Sign-in error: ' + e.message); } };
        odPoll = setTimeout(poll, (d.interval || 5) * 1000);
    }
    async function odToken() {
        if (odAccess) return odAccess; if (!odRefresh) throw Error('Connect OneDrive first');
        const r = await odForm('https://login.microsoftonline.com/consumers/oauth2/v2.0/token', { client_id: OD_CLIENT, grant_type: 'refresh_token', refresh_token: odRefresh, scope: 'Files.ReadWrite offline_access User.Read' });
        const p = JSON.parse(r.responseText || '{}'); if (r.status < 200 || r.status >= 300 || !p.access_token) { if (p.error === 'invalid_grant') { odRefresh = ''; safeSet(OD_REFRESH_KEY, ''); } throw Error(p.error_description || 'Reconnect OneDrive'); }
        odAccess = p.access_token; if (p.refresh_token) { odRefresh = p.refresh_token; safeSet(OD_REFRESH_KEY, odRefresh); } return odAccess;
    }
    async function odFolder(token) {
        if (odFolderId) return odFolderId;
        const r = await odRequest('GET', 'https://graph.microsoft.com/v1.0/me/drive/root/children?$select=id,name,folder&$top=200', token);
        if (r.status < 200 || r.status >= 300) throw Error('OneDrive folder lookup failed: HTTP ' + r.status);
        const x = (JSON.parse(r.responseText).value || []).find(v => v.name === OD_FOLDER && v.folder); if (x) return odFolderId = x.id;
        const c = await odRequest('POST', 'https://graph.microsoft.com/v1.0/me/drive/root/children', token, JSON.stringify({ name: OD_FOLDER, folder: {}, '@microsoft.graph.conflictBehavior': 'fail' }), { 'Content-Type': 'application/json' });
        if (c.status < 200 || c.status >= 300) throw Error('OneDrive folder creation failed: HTTP ' + c.status); return odFolderId = JSON.parse(c.responseText).id;
    }
    async function odUpload(token, folder, name, body) {
        const url = 'https://graph.microsoft.com/v1.0/me/drive/items/' + encodeURIComponent(folder) + ':/' + encodeURIComponent(name) + ':/content';
        const r = await odRequest('PUT', url, token, body, { 'Content-Type': 'application/json' }); if (r.status < 200 || r.status >= 300) throw Error('Upload failed: HTTP ' + r.status);
    }
    function odPayload() { return JSON.stringify({ schema: 'cct-crime-profit-backup', schemaVersion: 1, scriptVersion: VERSION, exportedAt: new Date().toISOString(), timezone: 'Torn City Time (UTC)', profitRecords, itemPriceCache }, null, 2); }
    async function odBackup(opts = {}) {
        if (odBusy) return; odBusy = true;
        try { const token = await odToken(); const folder = await odFolder(token); const day = new Date().toISOString().slice(0,10); const body = odPayload(); odStatus('Uploading backup…');
            await odUpload(token, folder, 'Crime-Profit-' + day + '.json', body); await odUpload(token, folder, 'latest.json', body); odLastBackup = day; safeSet(OD_LAST_KEY, day); odLastSuccessAt = Date.now(); safeSet(OD_LAST_SUCCESS_AT_KEY, String(odLastSuccessAt)); odUpdateDot(); odStatus('Last backup: ' + day + ' (TCT/UTC) · ' + profitRecords.length.toLocaleString('en-US') + ' records');
        } catch (e) { odStatus('Backup failed: ' + e.message); if (opts.automatic) logDiagnostic('onedrive-backup-failed', { message: String(e.message || e).slice(0,250) }); } finally { odBusy = false; }
    }
    function odSchedule() {
        const today = new Date().toISOString().slice(0,10); if (odRefresh && odLastBackup !== today) odBackup({ automatic: true });
        if (!odTimer) { const n = new Date(); n.setUTCHours(24,0,5,0); odTimer = setTimeout(() => { odTimer = null; odSchedule(); }, Math.max(1000, n.getTime() - Date.now())); }
    }
    async function odRestore() {
        if (!window.confirm('Restore from OneDrive latest.json? This replaces local Crime Profit records and item-price cache.')) return;
        try { const token = await odToken(); const folder = await odFolder(token); const url = 'https://graph.microsoft.com/v1.0/me/drive/items/' + encodeURIComponent(folder) + ':/latest.json:/content'; const r = await odRequest('GET', url, token);
            if (r.status < 200 || r.status >= 300) throw Error('Download failed: HTTP ' + r.status); const d = JSON.parse(r.responseText);
            if (d.schema !== 'cct-crime-profit-backup' || d.schemaVersion !== 1 || !Array.isArray(d.profitRecords) || !d.itemPriceCache || typeof d.itemPriceCache !== 'object') throw Error('Invalid backup file');
            profitRecords = d.profitRecords; itemPriceCache = d.itemPriceCache; saveProfitData(); renderProfitPopover(); odStatus('Restored ' + profitRecords.length.toLocaleString('en-US') + ' records');
        } catch (e) { odStatus('Restore failed: ' + e.message); }
    }
    function odExport() { const b = new Blob([odPayload()], { type: 'application/json' }); const u = URL.createObjectURL(b); const a = document.createElement('a'); a.href = u; a.download = 'Crime-Profit-Backup-' + new Date().toISOString().slice(0,10) + '.json'; document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(u), 1000); }
    function odImport(file) { if (!file) return; const reader = new FileReader(); reader.onload = () => { try { const d = JSON.parse(String(reader.result || '{}')); if (d.schema !== 'cct-crime-profit-backup' || d.schemaVersion !== 1 || !Array.isArray(d.profitRecords) || !d.itemPriceCache || typeof d.itemPriceCache !== 'object') throw Error('Invalid backup file'); if (!window.confirm('Import this backup and replace local records and item-price cache?')) return; profitRecords = d.profitRecords; itemPriceCache = d.itemPriceCache; saveProfitData(); renderProfitPopover(); odStatus('Imported ' + profitRecords.length.toLocaleString('en-US') + ' records'); } catch (e) { odStatus('Import failed: ' + e.message); } }; reader.readAsText(file); }
    function resetProfitData() {
        const count = profitRecords.length;
        if (!count) return;
        const noun = count === 1 ? 'payout' : 'payouts';
        const confirmed = window.confirm(
            `Wipe your Crime Profit history?\n\nThis permanently deletes all ${count.toLocaleString('en-US')} tracked ${noun} — every $ and item you've captured — and can't be undone.\n\nYour crime chain and settings are not affected.`
        );
        if (!confirmed) return;
        profitRecords = [];
        saveProfitData();
        renderProfitPopover();
    }

    function saveSyncEnabled(enabled) {
        syncEnabled = Boolean(enabled);
        safeSet(STORAGE_KEY_SYNC_ENABLED, syncEnabled ? '1' : '0');
    }

    function saveSyncToken(token) {
        syncToken = String(token || '').trim();
        safeSet(STORAGE_KEY_SYNC_TOKEN, syncToken);
    }

    function saveSyncPushCursor(ts) {
        syncPushCursor = ts;
        safeSet(STORAGE_KEY_SYNC_PUSH_CURSOR, String(ts));
    }

    function generateSyncToken() {
        if (typeof crypto !== 'undefined' && typeof crypto.randomUUID === 'function') {
            return crypto.randomUUID().replace(/-/g, '');
        }

        const bytes = new Uint8Array(16);
        (crypto.getRandomValues ? crypto : window.crypto).getRandomValues(bytes);
        return Array.from(bytes, (b) => b.toString(16).padStart(2, '0')).join('');
    }

    function gmRequest(details) {
        return new Promise((resolve, reject) => {
            if (typeof GM_xmlhttpRequest !== 'function') {
                reject(new Error('GM_xmlhttpRequest not granted'));
                return;
            }
            GM_xmlhttpRequest({
                ...details,
                onload: (res) => resolve(res),
                onerror: (err) => reject(err || new Error('network error')),
                ontimeout: () => reject(new Error('timeout')),
                timeout: 15000,
            });
        });
    }

    function fetchWithTimeout(url, options = {}, timeoutMs = FETCH_TIMEOUT_MS) {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), timeoutMs);
        return fetch(url, { ...options, signal: controller.signal }).finally(() => clearTimeout(timer));
    }

    function syncStatusEl() {
        return document.querySelector('#cct-sync-status');
    }

    function setSyncStatus(text) {
        crossSyncLastStatus = text;
        const el = syncStatusEl();
        if (el) el.textContent = text;
    }

    function describeSyncError(status, responseText) {
        let body = null;
        try { body = JSON.parse(responseText); } catch (_) { /* not JSON, ignore */ }
        const code = body && body.error;
        if (code === 'invalid-token') return 'Token isn\'t valid (16\u201364 letters/numbers/-/_ only) — use Generate for a safe one';
        if (code === 'invalid-record-shape' || code === 'invalid-json') return 'Sync data was rejected as malformed — please report this';
        if (code === 'batch-too-large') return 'Too many records to sync in one go — will retry in smaller batches next cycle';
        if (code === 'unauthorized') return 'Not authorized';
        return `HTTP ${status}`;
    }

    async function syncRequest(method, endpoint, { data, failLabel, diagKey, retryStatus, diagErrKey } = {}) {
        try {
            const res = await gmRequest({
                method,
                url: `${SYNC_WORKER_URL}${endpoint}`,
                headers: data ? { 'Content-Type': 'application/json' } : undefined,
                data,
            });
            if (res.status >= 200 && res.status < 300) return { ok: true, res };
            setSyncStatus(`${failLabel} failed: ${describeSyncError(res.status, res.responseText)}`);
            logDiagnostic(diagKey, { status: res.status, body: String(res.responseText || '').slice(0, 300) });
            return { ok: false };
        } catch (err) {
            setSyncStatus(retryStatus);
            let errText;
            try { errText = err && err.message ? String(err.message) : JSON.stringify(err, Object.getOwnPropertyNames(Object(err))); } catch (_) { errText = String(err); }
            logDiagnostic(diagErrKey, errText);
            return { ok: false };
        }
    }

    async function pushProfitRecords() {
        if (!syncEnabled || !syncToken || !profitRecords.length) return;

        const pending = profitRecords            .filter((r) => new Date(r.ts).getTime() > syncPushCursor)
            .sort((a, b) => new Date(a.ts) - new Date(b.ts))
            .slice(0, SYNC_PUSH_BATCH_MAX);
        if (!pending.length) return;

        const result = await syncRequest('POST', '/records', {
            data: JSON.stringify({ token: syncToken, records: pending }),
            failLabel: 'Push',
            diagKey: 'sync-push-failed',
            retryStatus: 'Push failed — will retry',
            diagErrKey: 'sync-push-error',
        });
        if (!result.ok) return;

        const newest = Math.max(...pending.map((r) => new Date(r.ts).getTime()));
        saveSyncPushCursor(newest);
        setSyncStatus(`Synced ✓ ${relativeTime(Date.now())}`);
    }

    async function pullProfitRecords() {
        if (!syncEnabled || !syncToken) return;

        const result = await syncRequest('GET', `/records?token=${encodeURIComponent(syncToken)}`, {
            failLabel: 'Pull',
            diagKey: 'sync-pull-failed',
            retryStatus: 'Pull failed — will retry',
            diagErrKey: 'sync-pull-error',
        });
        if (!result.ok) return;

        let body;
        try { body = JSON.parse(result.res.responseText); } catch (_) { body = null; }
        const incoming = (body && Array.isArray(body.records)) ? body.records : [];
        if (!incoming.length) {
            setSyncStatus(`Synced ✓ ${relativeTime(Date.now())}`);
            return;
        }

        const existingIds = new Set(profitRecords.map((r) => r.id));
        let mergedCount = 0;
        for (const r of incoming) {
            if (existingIds.has(r.id)) continue;
            profitRecords.push(r);
            existingIds.add(r.id);
            mergedCount++;
        }

        if (mergedCount > 0) {
            profitRecords.sort((a, b) => new Date(b.ts) - new Date(a.ts));
            saveProfitData();
            renderProfitPopover();
        }
        setSyncStatus(mergedCount
            ? `Synced ✓ pulled ${mergedCount} from other device${mergedCount === 1 ? '' : 's'}`
            : `Synced ✓ ${relativeTime(Date.now())}`);
    }

    async function runCrossDeviceSync() {
        if (!syncEnabled || !syncToken || crossSyncInFlight) return;
        crossSyncInFlight = true;
        setSyncStatus('Syncing…');
        try {
            await pushProfitRecords();
            await pullProfitRecords();
        } finally {
            crossSyncInFlight = false;
        }
    }

    function stopCrossDeviceSync() {
        clearInterval(crossSyncPushTimer);
        clearInterval(crossSyncPullTimer);
        crossSyncPushTimer = null;
        crossSyncPullTimer = null;
    }

    function startCrossDeviceSync() {
        stopCrossDeviceSync();
        if (!syncEnabled || !syncToken) return;
        crossSyncPushTimer = setInterval(pushProfitRecords, SYNC_PUSH_INTERVAL_MS);
        crossSyncPullTimer = setInterval(pullProfitRecords, SYNC_PULL_INTERVAL_MS);
        runCrossDeviceSync();
    }

    function parseCurrency(text) {
        const found = String(text || '').replace(/,/g, '').match(/\$(\d+(?:\.\d{1,2})?)/);
        return found ? Number(found[1]) : null;
    }

    function profitPeriodKey(timestamp, period) {
        const d = new Date(timestamp);
        const day = d.toISOString().slice(0, 10);
        if (period === 'year') return day.slice(0, 4);
        if (period === 'month') return day.slice(0, 7);
        if (period === 'week') {
            const x = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate()));
            const n = x.getUTCDay() || 7;
            x.setUTCDate(x.getUTCDate() + 4 - n);
            const first = new Date(Date.UTC(x.getUTCFullYear(), 0, 1));
            const week = Math.ceil((((x - first) / 86400000) + 1) / 7);
            return `${x.getUTCFullYear()}-W${String(week).padStart(2, '0')}`;
        }
        return day;
    }

    function money(value) {
        return Number(value || 0).toLocaleString('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
    }

    function ratioText(totalWithNerve, nerve) {
        if (!nerve) return '—';
        return `$${Math.round(totalWithNerve / nerve).toLocaleString('en-US')}`;
    }

    const NERVE_SELECTORS = [
        '[class*="nerve" i] [class*="bar-value" i]',
        '[class*="nerve" i][title*="/"]',
        '[class*="nerve" i][aria-label*="/"]',
        '.bar-nerve[title]',
        '[data-bar="nerve" i]',
        '[class*="nerveBar" i]',
        '[class*="nerve" i]',
    ];

    function parseNerveText(raw) {
        const text = normalizeText(raw);
        const match = text.match(/(\d+)\s*\/\s*\d+/) || text.match(/^(\d+)$/);
        if (!match) return null;
        const value = Number(match[1]);
        return Number.isFinite(value) && value >= 0 ? value : null;
    }

    function nerveRawText(el) {
        return el.getAttribute('title') || el.getAttribute('aria-label') || el.textContent || '';
    }

    // Returns the first element that actually carries a "N/MAX" nerve reading. The broad class*="nerve" fallback also
    // matches <html> (TornTools adds tt-highlight-nerve-refill there), so unparseable/oversized hits are skipped.
    function findNerveElement() {
        for (const sel of NERVE_SELECTORS) {
            let list;
            try { list = document.querySelectorAll(sel); } catch (_) { continue; }
            const limit = Math.min(list.length, 60);
            for (let i = 0; i < limit; i++) {
                const el = list[i];
                if (el === document.documentElement || el === document.body) continue;
                if (el.closest && el.closest('#cct-root')) continue;
                const raw = nerveRawText(el);
                if (raw.length > 80) continue;
                if (parseNerveText(raw) !== null) return el;
            }
        }
        return null;
    }

    function readNerveValue() {
        const el = findNerveElement();
        if (!el) return null;
        return parseNerveText(nerveRawText(el));
    }

    function pollNerve(source) {
        const value = readNerveValue();
        if (value === null) {
            if (!nerveTracker.warnedMissing) {
                nerveTracker.warnedMissing = true;
                logDiagnostic('nerve-element-not-found', 'Could not locate a nerve bar element on the page — $/nerve will show "—" until this selector is fixed.');
                traceEvent('nerve-missing', 'no nerve element/value found');
            }
            return;
        }
        if (nerveTracker.last === null) {
            traceEvent('nerve-init', { value });
        } else if (value !== nerveTracker.last) {
            const diff = value - nerveTracker.last;
            if (diff < 0) {
                nerveTracker.pendingSpend = (nerveTracker.pendingSpend || 0) - diff;
                nerveTracker.pendingAt = Date.now();
                nerveTracker.totalDrops += -diff;
            } else {
                nerveTracker.totalRegen += diff;
            }
            traceEvent('nerve', { from: nerveTracker.last, to: value, diff, src: source || 'poll', pending: nerveTracker.pendingSpend });
        }
        nerveTracker.last = value;
    }

    function consumeNerveSpend() {
        if (nerveTracker.pendingSpend === null) return null;
        const age = Date.now() - nerveTracker.pendingAt;
        if (age > NERVE_PENDING_WINDOW_MS) {
            nerveTracker.totalExpired += nerveTracker.pendingSpend;
            traceEvent('nerve-expired', { spend: nerveTracker.pendingSpend, ageMs: age });
            nerveTracker.pendingSpend = null;
            return null;
        }
        const spend = nerveTracker.pendingSpend;
        nerveTracker.totalConsumed += spend;
        nerveTracker.pendingSpend = null;
        return spend;
    }

    // =========================================================================
    // DEBUG PANEL
    // =========================================================================
    function traceEvent(kind, detail) {
        nerveTrace.unshift({ t: Date.now(), kind, detail });
        while (nerveTrace.length > TRACE_MAX) nerveTrace.pop();
        refreshDebugIfOpen();
    }

    function resolveServerNerveSpend(data, requestUrl) {
        const used = Number(data && data.DB && data.DB.currentUserStats && data.DB.currentUserStats.nerveUsed);
        const userNerve = Number(data && data.DB && data.DB.user && data.DB.user.nerve);
        const typeMatch = String(requestUrl || '').match(/[?&]typeID=(\d+)/i);
        const typeKey = typeMatch ? typeMatch[1] : 'unknown';
        let spent = null;

        if (Number.isFinite(used) && used >= 0) {
            const prev = Number.isFinite(Number(nerveUsedByType[typeKey])) ? Number(nerveUsedByType[typeKey]) : null;
            if (prev !== null) {
                const delta = used - prev;
                if (delta >= 0 && delta <= NERVE_MAX_SPEND_PER_RESPONSE) {
                    spent = delta;
                } else {
                    // Crimes done elsewhere (other device/tab) or responses arriving out of order: don't guess from this counter.
                    traceEvent('nerve-baseline-skip', { type: typeKey, prev, used, delta });
                }
            }
            if (prev === null || used > prev) {
                nerveUsedByType[typeKey] = used;
                safeSet(STORAGE_KEY_NERVE_USED, JSON.stringify(nerveUsedByType));
            }
        }

        // Bootstrap: first attempt of a crime type (no baseline yet). Use the drop in the user's nerve since the last response.
        if (spent === null && Number.isFinite(userNerve) && lastUserNerveSeen && Date.now() - lastUserNerveSeen.at < 5 * 60 * 1000) {
            const d = lastUserNerveSeen.value - userNerve;
            if (d > 0 && d <= NERVE_MAX_SPEND_PER_RESPONSE) {
                spent = d;
                traceEvent('nerve-bootstrap', { type: typeKey, from: lastUserNerveSeen.value, to: userNerve, spent: d });
            }
        }
        if (Number.isFinite(userNerve)) lastUserNerveSeen = { value: userNerve, at: Date.now() };
        return spent;
    }

    // Server delta is authoritative; if the DOM saw a smaller drop, the extra was spent elsewhere, so trust the DOM.
    function reconcileNerve(serverSpend, domSpend) {
        if (typeof serverSpend !== 'number') return typeof domSpend === 'number' ? domSpend : null;
        if (typeof domSpend === 'number' && domSpend > 0 && domSpend < serverSpend) return domSpend;
        return serverSpend;
    }

    // Attempts that paid nothing but cost nerve (fails, critical fails, steps with no outcome object).
    function recordNerveOnlyRecord(serverSpend, label) {
        pollNerve('nerve-only');
        const dom = consumeNerveSpend();
        const nerve = reconcileNerve(serverSpend, dom);
        traceEvent('nerve-only', { label, serverSpend, dom, nerve });
        const id = `profit-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
        const record = { id, ts: new Date().toISOString(), cash: 0, itemValue: 0, total: 0, items: [], nerve };
        profitRecords.unshift(record);
        saveProfitData();
        renderProfitPopover();
    }

    function findNerveFields(obj, path = '', depth = 0, out = []) {
        if (!obj || typeof obj !== 'object' || depth > 4 || out.length >= 8) return out;
        for (const [k, v] of Object.entries(obj)) {
            const p = path ? `${path}.${k}` : k;
            if (/nerve/i.test(k) && out.length < 8) {
                out.push(`${p}=${v && typeof v === 'object' ? JSON.stringify(v).slice(0, 80) : v}`);
            }
            if (v && typeof v === 'object' && !Array.isArray(v)) findNerveFields(v, p, depth + 1, out);
        }
        return out;
    }

    function buildDebugReport() {
        const pad = (n, w = 2) => String(n).padStart(w, '0');
        const fmtT = (ts) => {
            const d = new Date(ts);
            return `${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}:${pad(d.getUTCSeconds())}.${pad(d.getUTCMilliseconds(), 3)}`;
        };
        const L = [];
        L.push(`CCT v${VERSION} debug — ${new Date().toISOString()} (times are TCT/UTC)`);
        L.push(`URL: ${location.href}`);
        L.push('');
        L.push('== Nerve bar ==');
        const el = findNerveElement();
        if (el) {
            const d = describeElement(el);
            L.push(`Element: ${d.path}`);
            L.push(`  title="${el.getAttribute('title') || ''}" aria-label="${el.getAttribute('aria-label') || ''}"`);
            L.push(`  text="${normalizeText(el.textContent).slice(0, 80)}"`);
        } else {
            L.push('Element: NOT FOUND');
        }
        L.push(`Parsed value now: ${readNerveValue()}`);
        L.push('Selector hits:');
        NERVE_SELECTORS.forEach((sel, i) => {
            let n = 0;
            try { n = document.querySelectorAll(sel).length; } catch (_) { /* ignore */ }
            L.push(`  ${i + 1}. ${n}x  ${sel}`);
        });
        L.push('');
        L.push('== Tracker (since page load / last reset) ==');
        const age = nerveTracker.pendingSpend !== null ? `${Math.round((Date.now() - nerveTracker.pendingAt) / 1000)}s ago` : '-';
        L.push(`last bar value: ${nerveTracker.last}   pending spend: ${nerveTracker.pendingSpend} (${age})`);
        L.push(`drops observed: ${nerveTracker.totalDrops}   regen observed: ${nerveTracker.totalRegen}`);
        L.push(`nerveUsed baselines by crime type: ${JSON.stringify(nerveUsedByType)}`);
        L.push(`credited to records: ${nerveTracker.totalConsumed}   expired/discarded: ${nerveTracker.totalExpired}   still pending: ${nerveTracker.pendingSpend || 0}`);
        L.push('');
        const today = new Date().toISOString().slice(0, 10);
        const yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);
        for (const day of [today, yesterday]) {
            const recs = profitRecords.filter((r) => String(r.ts).slice(0, 10) === day);
            const withNerve = recs.filter((r) => typeof r.nerve === 'number' && r.nerve > 0);
            const nerveSum = withNerve.reduce((s, r) => s + r.nerve, 0);
            const nullCount = recs.filter((r) => typeof r.nerve !== 'number').length;
            L.push(`== ${day}: ${recs.length} records | nerve sum ${nerveSum} | records w/ nerve ${withNerve.length} | null ${nullCount} ==`);
        }
        L.push('');
        L.push('== Last 12 records (newest first) ==');
        profitRecords.slice(0, 12).forEach((r) => {
            L.push(`${String(r.ts).slice(5, 19).replace('T', ' ')}  cash ${r.cash}  items ${r.itemValue}  nerve ${r.nerve}  (${r.items.length} item stacks)`);
        });
        L.push('');
        L.push(`== Trace (newest first, max ${TRACE_MAX}) ==`);
        if (!nerveTrace.length) L.push('(empty — do a crime with this panel open)');
        nerveTrace.slice(0, 60).forEach((e) => {
            const detail = typeof e.detail === 'string' ? e.detail : JSON.stringify(e.detail);
            L.push(`${fmtT(e.t)}  ${String(e.kind).padEnd(13)} ${detail}`);
        });
        L.push('');
        L.push('== Diagnostics (latest 5) ==');
        const diags = readDiagnostics().slice(0, 5);
        if (!diags.length) L.push('(none)');
        diags.forEach((d) => L.push(`${fmtT(d.time)}  ${d.type}  ${JSON.stringify(d.detail).slice(0, 160)}`));
        return L.join('\n');
    }

    function renderDebugPanel() {
        const out = document.querySelector('#cct-debug-output');
        if (out) out.textContent = buildDebugReport();
    }

    function refreshDebugIfOpen() {
        const p = document.querySelector('#cct-profit-popover');
        if (!p || !p.classList.contains('cct-debug-open')) return;
        try {
            const sel = window.getSelection && window.getSelection().toString();
            if (sel) return; // don't clobber text the user is selecting
        } catch (_) { /* ignore */ }
        renderDebugPanel();
    }

    async function copyDebugReport(btn) {
        const text = buildDebugReport();
        let ok = false;
        try {
            await navigator.clipboard.writeText(text);
            ok = true;
        } catch (_) {
            try {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.cssText = 'position:fixed;top:0;left:0;opacity:0;';
                document.body.appendChild(ta);
                ta.select();
                ok = document.execCommand('copy');
                ta.remove();
            } catch (__) { /* ignore */ }
        }
        const old = btn.textContent;
        btn.textContent = ok ? 'Copied ✓' : 'Copy failed';
        setTimeout(() => { btn.textContent = old; }, 1500);
    }

    function wireDebugUI(popover) {
        popover.querySelector('#cct-debug-toggle').addEventListener('click', (e) => {
            e.stopPropagation();
            popover.classList.toggle('cct-debug-open');
            if (popover.classList.contains('cct-debug-open')) renderDebugPanel();
        });
        popover.querySelector('#cct-debug-refresh').addEventListener('click', (e) => {
            e.stopPropagation();
            renderDebugPanel();
        });
        popover.querySelector('#cct-debug-copy').addEventListener('click', (e) => {
            e.stopPropagation();
            copyDebugReport(e.currentTarget);
        });
        popover.querySelector('#cct-debug-clear').addEventListener('click', (e) => {
            e.stopPropagation();
            nerveTrace.length = 0;
            nerveTracker.totalDrops = 0;
            nerveTracker.totalRegen = 0;
            nerveTracker.totalConsumed = 0;
            nerveTracker.totalExpired = 0;
            renderDebugPanel();
        });
    }

    function installCrimeAttemptInterceptor() {
        const isSandboxed = typeof unsafeWindow !== 'undefined';
        const win = isSandboxed ? unsafeWindow : window;
        if (win.__cctFetchWrapped) return;
        win.__cctFetchWrapped = true;
        const originalFetch = win.fetch;
        win.fetch = function (...args) {
            return originalFetch.apply(this, args).then((response) => {
                try {
                    const resource = args[0];
                    const url = typeof resource === 'string' ? resource : (resource && resource.url) || '';
                    if (url.includes('sid=crimesData') && (url.includes('step=attempt') || url.includes('step=collect') || url.includes('step=claim'))) {
                        response.clone().text()
                            .then((body) => handleCrimeAttemptResponseBody(body, url))
                            .catch((err) => {
                                logDiagnostic('crime-attempt-clone-failed', {
                                    url: String(url).slice(0, 300),
                                    error: String(err && err.message || err),
                                });
                            });
                    }
                } catch (err) {
                    try {
                        logDiagnostic('crime-attempt-intercept-error', String(err && err.message || err));
                    } catch (_) { /* diagnostics themselves must never throw */ }
                }
                return response;
            });
        };
    }

    let lastCrimeOutcomeSignature = null;
    let lastCrimeOutcomeTime = 0;
    const CRIME_OUTCOME_DEDUPE_MS = 2000;

    function extractOutcomesFromResponse(data) {
        const found = [];
        if (!data || typeof data !== 'object') return found;

        const db = data.DB;
        if (db && typeof db === 'object') {
            if (db.outcome && typeof db.outcome === 'object' && db.outcome.result !== undefined) {
                found.push(db.outcome);
            }
            for (const key of ['outcomes', 'results', 'claims', 'rewards']) {
                const arr = db[key];
                if (Array.isArray(arr)) {
                    for (const item of arr) {
                        if (item && typeof item === 'object' && item.result !== undefined) {
                            found.push(item);
                        } else if (item && typeof item === 'object' && item.outcome && item.outcome.result !== undefined) {
                            found.push(item.outcome);
                        }
                    }
                }
            }
        }

        if (data.outcome && typeof data.outcome === 'object' && data.outcome.result !== undefined) {
            found.push(data.outcome);
        }
        if (Array.isArray(data.outcomes)) {
            for (const item of data.outcomes) {
                if (item && typeof item === 'object' && item.result !== undefined) found.push(item);
            }
        }

        return found;
    }

    function handleCrimeAttemptResponseBody(body, requestUrl) {
        if (!body || /<!doctype|<html[\s>]|<head[\s>]|<body[\s>]/i.test(body)) {
            logDiagnostic('crime-attempt-non-json', {
                url: String(requestUrl || '').slice(0, 300),
                bodyPreview: String(body || '').slice(0, 120),
            });
            return;
        }
        let data;
        try {
            data = JSON.parse(body);
        } catch (err) {
            logDiagnostic('crime-attempt-parse-failed', {
                url: String(requestUrl || '').slice(0, 300),
                error: String(err && err.message || err),
                bodyPreview: String(body).slice(0, 200),
            });
            return;
        }

        const outcomes = extractOutcomesFromResponse(data);
        const successOutcomes = outcomes.filter((o) => o && o.result === 'success');
        const serverSpend = resolveServerNerveSpend(data, requestUrl);
        traceEvent('fetch', {
            req: String(requestUrl || '').replace(/^.*?page\.php\?/, '').slice(0, 90),
            results: outcomes.map((o) => o && o.result),
            serverSpend,
            nerveUsed: data && data.DB && data.DB.currentUserStats ? data.DB.currentUserStats.nerveUsed : undefined,
        });

        if (!successOutcomes.length) {
            if (serverSpend > 0) {
                recordNerveOnlyRecord(serverSpend, outcomes.map((o) => o && o.result).join(',') || 'no-outcome');
            }
            if (outcomes.length === 0) {
                const dbKeys = (data && data.DB && typeof data.DB === 'object')
                    ? Object.keys(data.DB).slice(0, 20)
                    : [];
                const topKeys = data && typeof data === 'object' ? Object.keys(data).slice(0, 15) : [];
                logDiagnostic('crime-attempt-no-outcome-found', {
                    url: String(requestUrl || '').slice(0, 300),
                    topKeys,
                    dbKeys,
                });
            }
            return;
        }

        let spendLeft = serverSpend;
        for (const outcome of successOutcomes) {
            const signature = hashText(JSON.stringify(outcome));
            // A real new attempt always moves Torn's nerveUsed counter; only dedupe when it didn't (or is unknown).
            const nerveProvesNewAttempt = typeof serverSpend === 'number' && serverSpend > 0;
            if (!nerveProvesNewAttempt && signature === lastCrimeOutcomeSignature && Date.now() - lastCrimeOutcomeTime < CRIME_OUTCOME_DEDUPE_MS) {
                continue;
            }
            lastCrimeOutcomeSignature = signature;
            lastCrimeOutcomeTime = Date.now();
            recordProfitFromOutcomeJSON(outcome, spendLeft);
            if (typeof spendLeft === 'number') spendLeft = 0; // one response = one nerve charge; don't repeat it per outcome
        }
        if (typeof spendLeft === 'number' && spendLeft > 0) {
            // every success was a duplicate-skip but nerve was still spent
            recordNerveOnlyRecord(spendLeft, 'dup-skip');
        }
    }

    function recomputeRecordTotals(record) {
        record.itemValue = record.items.reduce((total, item) => total + (typeof item.unitValue === 'number' ? item.unitValue * item.quantity : 0), 0);
        record.total = record.cash + record.itemValue;
    }

    function recordProfitFromOutcomeJSON(outcome, serverSpend) {
        for (const [id, cached] of Object.entries(itemPriceCache)) {
            if (!cached || Date.now() - Number(cached.at || 0) > ITEM_PRICE_CACHE_MS) delete itemPriceCache[id];
        }

        const rewards = Array.isArray(outcome.rewards) ? outcome.rewards : [];
        const items = [];
        let cash = 0;
        for (const entry of rewards) {
            if (entry && entry.type === 'money') {
                const value = Number(entry.value);
                if (Number.isFinite(value)) cash += value;
                continue;
            }
            if (entry && entry.type === 'items' && Array.isArray(entry.value)) {
                for (const it of entry.value) {
                    const id = it && it.id !== undefined && it.id !== null ? String(it.id) : '';
                    const quantity = Number(it && it.amount);
                    const name = normalizeText(it && it.name);
                    if (!id || !name || !Number.isInteger(quantity) || quantity < 1) continue;
                    const unitValue = (itemPriceCache[id] && typeof itemPriceCache[id].value === 'number') ? itemPriceCache[id].value : null;
                    items.push({ id, name, quantity, unitValue });
                }
            }
        }

        pollNerve('outcome');
        const domNerve = consumeNerveSpend();
        const nerve = reconcileNerve(serverSpend, domNerve);
        traceEvent('outcome', { cash, items: items.length, nerve, server: serverSpend, dom: domNerve, barNow: nerveTracker.last });
        if (!rewards.length) {
            console.log(`[CCT v${VERSION}] captured a zero-reward success (e.g. Cracking brute-force step) — nerve counted, $0 payout.`);
        }
        const id = `profit-${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;
        const record = { id, ts: new Date().toISOString(), cash, itemValue: 0, total: 0, items, nerve };
        recomputeRecordTotals(record);
        profitRecords.unshift(record);
        saveProfitData();
        renderProfitPopover();

        if (items.some((item) => typeof item.unitValue !== 'number')) {
            requestAnimationFrame(() => requestAnimationFrame(() => {
                tryEnrichItemPricesFromDOM(record);
                if (record.items.some((item) => typeof item.unitValue !== 'number')) resolveUnknownItemPrices();
            }));
        }
    }

    function tryEnrichItemPricesFromDOM(record) {
        const app = findCrimesApp();
        if (!app) return;
        const panels = app.querySelectorAll('.outcome-content.crimes-outcome-success');
        if (panels.length !== 1) return;
        const panel = panels[0];
        let changed = false;
        for (const item of record.items) {
            if (typeof item.unitValue === 'number') continue;
            const image = panel.querySelector(`img[src*="/images/items/${item.id}/"]`);
            if (!image) continue;
            const rewardEl = image.closest('[class*="reward"]') || image.parentElement;
            const displayedTotal = parseCurrency(rewardEl?.querySelector('.tt-crime-value-text')?.textContent);
            if (displayedTotal === null) continue;
            const unitValue = displayedTotal / item.quantity;
            item.unitValue = unitValue;
            itemPriceCache[item.id] = { name: item.name, value: unitValue, at: Date.now(), source: 'displayed' };
            changed = true;
        }
        if (changed) {
            recomputeRecordTotals(record);
            saveProfitData();
            renderProfitPopover();
        }
    }

    async function fetchOfficialItemPrice(id) {
        const key = getLogApiKey();
        if (!key) {
            itemPriceFetchFailureReason.set(id, 'no-key');
            return null;
        }
        try {
            const res = await fetchWithTimeout(`https://api.torn.com/torn/${encodeURIComponent(id)}?selections=items&key=${encodeURIComponent(key)}`);
            const data = await res.json();
            if (data?.error) {
                itemPriceFetchFailureReason.set(id, data.error.code === 16 ? 'permissions' : 'api-error');
                logDiagnostic('item-price-fetch-error', `Item ${id}: ${data.error.error || 'API error'}`);
                return null;
            }
            itemPriceFetchFailureReason.delete(id);
            const item = data?.items?.[id];
            const marketValue = Number(item?.market_value);
            if (Number.isFinite(marketValue) && marketValue > 0) return marketValue;
            const sellPrice = Number(item?.sell_price);
            if (Number.isFinite(sellPrice) && sellPrice > 0) return sellPrice;
            return Number.isFinite(marketValue) && marketValue >= 0 ? marketValue : null;
        } catch (err) {
            itemPriceFetchFailureReason.set(id, 'api-error');
            logDiagnostic('item-price-fetch-error', `Item ${id}: ${String(err)}`);
            return null;
        }
    }

    async function resolveUnknownItemPrices() {
        const unresolvedIds = [...new Set(
            profitRecords.flatMap((rec) => rec.items.filter((it) => typeof it.unitValue !== 'number').map((it) => it.id))
        )].filter((itemId) => !itemPriceFetchAttempted.has(itemId));
        if (!unresolvedIds.length) return;
        for (const itemId of unresolvedIds) {
            itemPriceFetchAttempted.add(itemId);
            const price = await fetchOfficialItemPrice(itemId);
            if (price === null) {
                const reason = itemPriceFetchFailureReason.get(itemId);
                const reasonText = reason === 'permissions'
                    ? 'this key is missing the "Items" selection under the Torn category — the log selection alone isn\'t enough. Edit the key in Preferences > API Keys and check Torn > Items.'
                    : reason === 'no-key'
                        ? 'no log-scoped API key is set.'
                        : 'either the item has no listed Torn price, or the request failed.';
                logDiagnostic('item-price-unresolved', `Could not resolve a price for item ${itemId} — it will show as unpriced. Reason: ${reasonText}`);
                continue;
            }
            const name = profitRecords.flatMap((rec) => rec.items).find((it) => it.id === itemId)?.name || `item ${itemId}`;
            itemPriceCache[itemId] = { name, value: price, at: Date.now(), source: 'api' };
        }
        let changed = false;
        for (const rec of profitRecords) {
            let recItemValue = 0;
            for (const it of rec.items) {
                if (typeof it.unitValue !== 'number' && itemPriceCache[it.id]) {
                    it.unitValue = itemPriceCache[it.id].value;
                    changed = true;
                }
                if (typeof it.unitValue === 'number') recItemValue += it.unitValue * it.quantity;
            }
            const newTotal = rec.cash + recItemValue;
            if (rec.itemValue !== recItemValue || rec.total !== newTotal) {
                rec.itemValue = recItemValue;
                rec.total = newTotal;
                changed = true;
            }
        }
        if (changed) {
            saveProfitData();
            renderProfitPopover();
        }
    }

    function profitRows(period) {
        const grouped = new Map();
        for (const record of profitRecords) {
            const key = profitPeriodKey(record.ts, period);
            const row = grouped.get(key) || { key, cash: 0, itemValue: 0, total: 0, count: 0, nerve: 0, totalWithNerve: 0, nerveSpent: 0, unresolvedCount: 0, permissionsBlocked: false };
            row.cash += record.cash; row.itemValue += record.itemValue; row.total += record.total; row.count += 1;
            if (typeof record.nerve === 'number' && record.nerve > 0) {
                row.nerve += record.nerve;
                row.totalWithNerve += record.total;
                row.nerveSpent += record.nerve;
            }
            for (const it of record.items) {
                if (typeof it.unitValue !== 'number') {
                    row.unresolvedCount += 1;
                    if (itemPriceFetchFailureReason.get(it.id) === 'permissions') row.permissionsBlocked = true;
                }
            }
            grouped.set(key, row);
        }
        return [...grouped.values()].sort((a, b) => b.key.localeCompare(a.key));
    }

    function buildGraphSVG(rows) {
        const sorted = [...rows].sort((a, b) => a.key.localeCompare(b.key));

        const width = 460;
        const height = 220;
        const padding = { top: 15, right: 25, bottom: 30, left: 50 };

        const innerWidth = width - padding.left - padding.right;
        const innerHeight = height - padding.top - padding.bottom;

        const visibleMaxima = [];

        if (graphVisibility.cash) {
            visibleMaxima.push(...sorted.map(r => r.cash));
        }
        if (graphVisibility.items) {
            visibleMaxima.push(...sorted.map(r => r.itemValue));
        }
        if (graphVisibility.total) {
            visibleMaxima.push(...sorted.map(r => r.total));
        }

        const maxVal = Math.max(1, ...visibleMaxima);

        const getX = (i) => padding.left + (i / (sorted.length - 1)) * innerWidth;
        const getY = (val) => padding.top + innerHeight - (val / maxVal) * innerHeight;

        const cashPath = sorted.map((r, i) => `${i === 0 ? 'M' : 'L'} ${getX(i)} ${getY(r.cash)}`).join(' ');
        const itemsPath = sorted.map((r, i) => `${i === 0 ? 'M' : 'L'} ${getX(i)} ${getY(r.itemValue)}`).join(' ');
        const totalPath = sorted.map((r, i) => `${i === 0 ? 'M' : 'L'} ${getX(i)} ${getY(r.total)}`).join(' ');

        const yTicks = 4;
        let gridLines = '';
        for (let i = 0; i <= yTicks; i++) {
            const val = (maxVal / yTicks) * i;
            const y = getY(val);
            gridLines += `<line x1="${padding.left}" y1="${y}" x2="${width - padding.right}" y2="${y}" class="cct-graph-grid" />`;
            gridLines += `<text x="${padding.left - 5}" y="${y + 3}" text-anchor="end" class="cct-graph-label">${money(val)}</text>`;
        }

        const step = Math.ceil(sorted.length / 6);
        let xLabels = '';
        sorted.forEach((r, i) => {
            if (i % step === 0 || i === sorted.length - 1) {
                const anchor = (i === sorted.length - 1) ? 'end' : 'middle';
                xLabels += `<text x="${getX(i)}" y="${height - 5}" text-anchor="${anchor}" class="cct-graph-label">${r.key}</text>`;
            }
        });

        let dots = '';
        sorted.forEach((r, i) => {
            const x = getX(i);
            if (graphVisibility.cash) dots += `<circle cx="${x}" cy="${getY(r.cash)}" r="3" fill="#00ff66" class="cct-graph-dot"><title>${r.key} Cash: ${money(r.cash)}</title></circle>`;
            if (graphVisibility.items) dots += `<circle cx="${x}" cy="${getY(r.itemValue)}" r="3" fill="#4ea8de" class="cct-graph-dot"><title>${r.key} Items: ${money(r.itemValue)}</title></circle>`;
            if (graphVisibility.total) dots += `<circle cx="${x}" cy="${getY(r.total)}" r="3" fill="#ffaa00" class="cct-graph-dot"><title>${r.key} Total: ${money(r.total)}</title></circle>`;
        });

        return `
            <svg viewBox="0 0 ${width} ${height}" preserveAspectRatio="none">
                <!-- Axes -->
                <line x1="${padding.left}" y1="${padding.top}" x2="${padding.left}" y2="${height - padding.bottom}" class="cct-graph-axis" />
                <line x1="${padding.left}" y1="${height - padding.bottom}" x2="${width - padding.right}" y2="${height - padding.bottom}" class="cct-graph-axis" />

                <!-- Grid & Labels -->
                ${gridLines}
                ${xLabels}

                <!-- Data Lines -->
                ${graphVisibility.total ? `<path d="${totalPath}" stroke="#ffaa00" class="cct-graph-line" />` : ''}
                ${graphVisibility.items ? `<path d="${itemsPath}" stroke="#4ea8de" class="cct-graph-line" />` : ''}
                ${graphVisibility.cash ? `<path d="${cashPath}" stroke="#00ff66" class="cct-graph-line" />` : ''}

                <!-- Dots -->
                ${dots}
            </svg>
            <div class="cct-graph-legend">
                <span data-graph-toggle="cash" class="${graphVisibility.cash ? '' : 'cct-graph-legend-off'}"><span class="dot" style="background:#00ff66"></span> Cash</span>
                <span data-graph-toggle="items" class="${graphVisibility.items ? '' : 'cct-graph-legend-off'}"><span class="dot" style="background:#4ea8de"></span> Items</span>
                <span data-graph-toggle="total" class="${graphVisibility.total ? '' : 'cct-graph-legend-off'}"><span class="dot" style="background:#ffaa00"></span> Total</span>
            </div>
        `;
    }

    function renderProfitPopover() {
        const popover = document.querySelector('#cct-profit-popover');
        if (!popover) return;
        const period = popover.dataset.period || 'day';
        const rows = profitRows(period);

        // Totals for the summary block (stays the same regardless of view)
        const totals = rows.reduce((sum, row) => ({
            cash: sum.cash + row.cash,
            itemValue: sum.itemValue + row.itemValue,
            total: sum.total + row.total,
            count: sum.count + row.count,
            nerve: sum.nerve + row.nerve,
            totalWithNerve: sum.totalWithNerve + row.totalWithNerve,
            nerveSpent: sum.nerveSpent + row.nerveSpent,
        }), { cash: 0, itemValue: 0, total: 0, count: 0, nerve: 0, totalWithNerve: 0, nerveSpent: 0 });

        popover.querySelector('#cct-profit-summary').innerHTML = `<div><small>Cash</small><strong>${money(totals.cash)}</strong></div><div><small>Items</small><strong>${money(totals.itemValue)}</strong></div><div><small>Total</small><strong>${money(totals.total)}</strong></div><div><small>Nerve</small><strong>${totals.nerveSpent.toLocaleString('en-US')}</strong></div><div><small>$ / Nerve</small><strong>${ratioText(totals.totalWithNerve, totals.nerve)}</strong></div>`;

        const tableEl = popover.querySelector('#cct-profit-rows');
        const graphEl = popover.querySelector('#cct-profit-graph');
        const scrollArea = popover.querySelector('#cct-profit-scroll-area');
        const toggleBtn = popover.querySelector('#cct-profit-view-toggle');
        const isGraphView = popover.dataset.view === 'graph';

        if (isGraphView) {
            tableEl.style.display = 'none';
            graphEl.classList.add('cct-open');
            scrollArea.classList.add('cct-hide-scrollbar'); // Hide scrollbar only in graph view
            toggleBtn.innerHTML = CHART_ICON;
            toggleBtn.style.opacity = '1';
        } else {
            tableEl.style.display = 'grid';
            graphEl.classList.remove('cct-open');
            scrollArea.classList.remove('cct-hide-scrollbar'); // Restore scrollbar in table view
            toggleBtn.innerHTML = CHART_ICON;
            toggleBtn.style.opacity = '0.6';
        }

        tableEl.innerHTML = rows.length ? `<div class="cct-profit-row cct-profit-row-header">
                <span class="cct-profit-col-date"></span>
                <span class="cct-profit-col-val">Cash</span>
                <span class="cct-profit-col-val">Items</span>
                <span class="cct-profit-col-val">Nerve</span>
                <span class="cct-profit-col-val">$/N</span>
            </div>` + rows.map((row) => {
            const pendingTag = row.permissionsBlocked
                ? `<span class="cct-profit-warn" title="Your API key is missing the &quot;Items&quot; selection under the Torn category. Edit it in Preferences &gt; API Keys, check Torn &gt; Items, then reopen this panel.">⚠️ key missing Items access</span>`
                : row.unresolvedCount ? `<span class="cct-profit-pending">⏳ ${row.unresolvedCount} pending price</span>` : '';
            return `<div class="cct-profit-row">
                <span class="cct-profit-col-date">${escapeHTML(row.key)}</span>
                <span class="cct-profit-col-val">${money(row.cash)}</span>
                <span class="cct-profit-col-val">${money(row.itemValue)}</span>
                <span class="cct-profit-col-val">${(row.nerveSpent || 0).toLocaleString('en-US')}</span>
                <span class="cct-profit-col-val">${ratioText(row.totalWithNerve, row.nerve)}/N</span>
                ${pendingTag ? `<span class="cct-profit-col-tag">${pendingTag}</span>` : ''}
            </div>`;
        }).join('') : '<div class="cct-profit-empty">No successful outcomes captured yet.</div>';

        if (isGraphView && rows.length > 1) {
            graphEl.innerHTML = buildGraphSVG(rows);
            // Wire up the legend toggles
            graphEl.querySelectorAll('[data-graph-toggle]').forEach(span => {
                span.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const key = span.dataset.graphToggle;
                    graphVisibility[key] = !graphVisibility[key];
                    renderProfitPopover();
                });
            });
        } else if (isGraphView) {
            graphEl.innerHTML = '<div class="cct-profit-empty" style="text-align:center;">Not enough data to graph yet.</div>';
        }

        popover.querySelectorAll('[data-profit-period]').forEach((button) => button.classList.toggle('cct-profit-active', button.dataset.profitPeriod === period));
        const resetBtn = popover.querySelector('#cct-profit-reset');
        if (resetBtn) resetBtn.disabled = profitRecords.length === 0;
    }

    function hashText(text) {
        let hash = 0;
        for (let i = 0; i < text.length; i++) {
            hash = ((hash << 5) - hash + text.charCodeAt(i)) | 0;
        }
        return String(hash);
    }

    function t() {
        return isDark ? THEME.dark : THEME.light;
    }

    function classifyOutcome(text) {
        const clean = normalizeText(text);
        if (!clean) return null;

        if (/\b(?:jail\s*)?bust(?:ed|s|ing)?\b/i.test(clean)) return null;

        for (const rule of OUTCOME_RULES) {
            if (rule.re.test(clean)) return { type: rule.type, text: clean };
        }
        return null;
    }

    function isDuplicateOutcome(outcome) {
        const now = Date.now();
        const signature = `${outcome.type}:${hashText(outcome.text)}`;
        return lastEvent.signature === signature && now - Number(lastEvent.time || 0) < OUTCOME_DEDUPE_MS;
    }

    function applyOutcomeFromText(text) {
        const outcome = classifyOutcome(text);
        if (!outcome || isDuplicateOutcome(outcome)) return;

        const oldChain = chain;

        if (outcome.type === 'critical') {
            chain = 0;
        } else if (outcome.type === 'fail') {
            chain = Math.floor(chain / 2);
        } else if (outcome.type === 'success') {
            chain += 1;
        }

        chain = clampChain(chain);
        const reasonMap = { critical: 'Detected critical fail message', fail: 'Detected fail message', success: 'Detected success message' };
        if (commitChainAlways('text', oldChain, outcome.text, reasonMap[outcome.type] || 'Detected outcome message')) {
            resetResultCounterTracking();
        }
        saveLastEvent({
            signature: `${outcome.type}:${hashText(outcome.text)}`,
            time: Date.now(),
            type: outcome.type,
        });
    }

    function chainColor(n) {
        const th = t();
        if (n < 30) return th.chainLow;
        if (n < 60) return th.chainMid;
        return th.chainHigh;
    }

    function statusText(n) {
        if (n === 0) return 'No active chain';
        if (n < 10) return 'Building...';
        if (n < 30) return 'On a roll';
        if (n < 60) return 'Hot streak';
        return 'Unstoppable';
    }

    function findCrimesApp() {
        return document.querySelector('.crimes-app') || document.querySelector('[class*="crimes-app"]') || document.querySelector('main');
    }

    function findWidgetAnchor(root) {
        return root.querySelector('[class*="heading" i]') ||
            root.querySelector('[class*="appHeader" i]') ||
            root.querySelector('h1,h2,h3,h4') ||
            root;
    }

    function isExcludedNativeBadgeContext(el) {
        if (!el || !el.closest) return true;
        if (el.closest('#cct-root')) return true;
        if (el.closest('#header, #top-header, .header, .top-header, #sidebar, .sidebar, #nav, nav')) return true;
        if (el.closest('[class*="header-wrapper" i], [class*="top-banner" i], [class*="menu-items" i]')) return true;
        if (el.closest('[class*="point" i][class*="value" i], [class*="user-info" i]')) return true;
        return false;
    }

    function scoreNativeBadgeCandidate(el, labelEl) {
        let score = 0;
        const cls = String(el.className || '');
        if (/chain|value|count|badge/i.test(cls)) score += 8;
        if (labelEl && el.parentElement && el.parentElement === labelEl.parentElement) score += 6;
        if (labelEl && (el.previousElementSibling === labelEl || el.nextElementSibling === labelEl)) score += 10;
        if (labelEl && labelEl.contains(el)) score += 4;
        try {
            const labelRect = labelEl.getBoundingClientRect();
            const elRect = el.getBoundingClientRect();
            const dist = Math.abs(elRect.left - labelRect.left) + Math.abs(elRect.top - labelRect.top);
            if (dist < 80) score += 5;
            else if (dist < 160) score += 2;
            else score -= 4;
        } catch (_) {}
        return score;
    }

    function findNativeChainBadge() {
        if (
            cachedNativeChainValueEl &&
            cachedNativeChainValueEl.isConnected &&
            !isExcludedNativeBadgeContext(cachedNativeChainValueEl)
        ) {
            const text = (cachedNativeChainValueEl.textContent || '').trim();
            if (/^\d{1,4}$/.test(text)) {
                return { element: cachedNativeChainValueEl, value: parseInt(text, 10) };
            }
        }
        cachedNativeChainValueEl = null;

        const scope =
            document.querySelector('.crimes-app') ||
            document.querySelector('[class*="crimes-app"]') ||
            document.querySelector('#mainContainer') ||
            document.body;

        const walker = document.createTreeWalker(scope, NodeFilter.SHOW_TEXT);
        let labelNode = null;
        let node;
        while ((node = walker.nextNode())) {
            const txt = node.nodeValue;
            if (!txt || !/crime\s*chain/i.test(txt)) continue;
            if (!node.parentElement || isExcludedNativeBadgeContext(node.parentElement)) continue;
            // Exact-ish label text, not a long paragraph that merely mentions it
            if (txt.trim().length > 24) continue;
            labelNode = node;
            break;
        }
        if (!labelNode) return null;
        const labelEl = labelNode.parentElement;
        if (!labelEl) return null;

        let container = labelEl;
        let best = null;
        let bestScore = -Infinity;
        for (let depth = 0; depth < 4 && container; depth += 1) {
            if (isExcludedNativeBadgeContext(container) && container !== labelEl) break;

            const candidates = Array.from(container.querySelectorAll('*')).filter((el) => {
                if (isExcludedNativeBadgeContext(el)) return false;
                if (el.children.length > 0) return false;
                return /^\d{1,4}$/.test((el.textContent || '').trim());
            });

            for (const el of candidates) {
                const score = scoreNativeBadgeCandidate(el, labelEl) - depth;
                if (score > bestScore) {
                    bestScore = score;
                    best = el;
                }
            }
            container = container.parentElement;
        }

        if (!best || bestScore < 4) return null;

        cachedNativeChainValueEl = best;
        return { element: best, value: parseInt(best.textContent.trim(), 10) };
    }

    function syncFromNativeBadge() {
        const badge = findNativeChainBadge();
        if (!badge) return false;
        if (!Number.isFinite(badge.value) || badge.value < 0) return false;

        const current = Number.isFinite(chain) ? chain : 0;

        if (badge.value === CHAIN_CAP_DISPLAY && current > 0 && current !== CHAIN_CAP_DISPLAY) {
            logDiagnostic('native-badge-rejected', {
                reason: 'value equals display cap while current chain differs',
                badgeValue: badge.value,
                currentChain: current,
            });
            cachedNativeChainValueEl = null;
            return false;
        }

        const delta = Math.abs(badge.value - current);
        if (!Number.isFinite(delta) || (delta > MAX_REASONABLE_COUNTER_DELTA && badge.value !== 0)) {
            logDiagnostic('native-badge-rejected', {
                reason: 'implausible jump from current chain',
                badgeValue: badge.value,
                currentChain: current,
                delta,
            });
            cachedNativeChainValueEl = null;
            return false;
        }

        pendingCriticalConfirm = null;
        pendingResultCountReseed = null;
        const oldChain = chain;
        chain = clampChain(badge.value);
        commitChainIfChanged('native', oldChain, null, `Torn's own chain badge read ${badge.value}`);
        return true;
    }

    function parseResultCount(value) {
        const n = parseInt(String(value || '').replace(/,/g, ''), 10);
        return Number.isFinite(n) ? n : null;
    }

    function describeElement(el) {
        if (!el) return null;
        const parts = [];
        let current = el;
        for (let i = 0; i < 4 && current && current.nodeType === Node.ELEMENT_NODE; i++) {
            let part = current.tagName.toLowerCase();
            if (current.id) part += `#${current.id}`;
            if (current.className && typeof current.className === 'string') {
                part += `.${current.className.trim().replace(/\s+/g, '.').slice(0, 120)}`;
            }
            parts.unshift(part);
            current = current.parentElement;
        }
        return {
            path: parts.join(' > '),
            text: normalizeText(el.textContent).slice(0, 250),
            className: String(el.className || '').slice(0, 250),
        };
    }

    function summarizeMutations(mutations) {
        if (!mutations) return null;
        const summary = {
            count: mutations.length,
            childList: 0,
            characterData: 0,
            attributes: 0,
            addedNodes: [],
            targets: [],
        };
        for (const mutation of mutations) {
            summary[mutation.type] = (summary[mutation.type] || 0) + 1;
            if (summary.targets.length < 6) summary.targets.push(describeElement(mutation.target));
            for (const node of Array.from(mutation.addedNodes || [])) {
                if (summary.addedNodes.length >= 6) break;
                const el = node.nodeType === Node.ELEMENT_NODE ? node : node.parentElement;
                summary.addedNodes.push(describeElement(el));
            }
        }
        return summary;
    }

    function readResultCounts() {
        const root = findCrimesApp();
        if (!root) return null;

        const countsRoot = root.querySelector('[class*="resultCounts" i]');
        if (!countsRoot) return null;

        const successEl = countsRoot.querySelector('[class*="successes" i] span, [class*="successes" i]');
        const failEl = countsRoot.querySelector('[class*="fails" i] span, [class*="fails" i]');
        const criticalEl = countsRoot.querySelector('[class*="criticalFails" i] span, [class*="criticalFails" i], [class*="critical-fails" i] span, [class*="critical-fails" i]');

        const successes = parseResultCount(successEl && successEl.textContent);
        const fails = parseResultCount(failEl && failEl.textContent);
        const criticalFails = parseResultCount(criticalEl && criticalEl.textContent);

        if (successes === null || fails === null || criticalFails === null) return null;
        return {
            successes,
            fails,
            criticalFails,
            debug: {
                countsRoot: describeElement(countsRoot),
                successEl: describeElement(successEl),
                failEl: describeElement(failEl),
                criticalEl: describeElement(criticalEl),
            },
        };
    }

    function buildCountsReason({ dSuccess, dFail, criticalConfirmedReset }) {
        if (criticalConfirmedReset) return 'Critical fail confirmed (2 consecutive reads)';
        if (dSuccess === 1 && dFail === 0) return '';

        const parts = [];
        if (dSuccess > 0) parts.push(`+${dSuccess} success${dSuccess === 1 ? '' : 'es'}`);
        if (dFail > 0) parts.push(`${dFail} fail${dFail === 1 ? '' : 's'}`);
        return parts.length ? parts.join(', ') : 'Counter change';
    }

    function applyResultCountDeltaFallback(context = {}) {
        const current = readResultCounts();
        if (!current) return false;

        if (!lastResultCounts) {
            lastResultCounts = current;
            confirmedCriticalFails = current.criticalFails;
            pendingResultCountReseed = null;
            return true;
        }

        const wasTrackingRealCounts = lastResultCounts.successes > 0 || lastResultCounts.fails > 0 || lastResultCounts.criticalFails > 0;
        const isBlankFrame = current.successes === 0 && current.fails === 0 && current.criticalFails === 0;
        if (wasTrackingRealCounts && isBlankFrame) return true;

        const dSuccess = current.successes - lastResultCounts.successes;
        const dFail = current.fails - lastResultCounts.fails;
        const criticalDelta = current.criticalFails - confirmedCriticalFails;
        const isImplausiblePositiveJump =
            dSuccess > MAX_REASONABLE_COUNTER_DELTA ||
            dFail > MAX_REASONABLE_COUNTER_DELTA;

        if (isImplausiblePositiveJump) {
            logDiagnostic('implausible-counter-jump', {
                context: {
                    source: context.source || 'unknown',
                    mutations: summarizeMutations(context.mutations),
                },
                previous: lastResultCounts,
                current,
                dSuccess,
                dFail,
            });
            lastResultCounts = current;
            confirmedCriticalFails = current.criticalFails;
            pendingCriticalConfirm = null;
            pendingResultCountReseed = null;
            return true;
        }

        if ((dSuccess < 0 || dFail < 0) && criticalDelta <= 0) {
            const sameReseedCandidate = pendingResultCountReseed &&
                pendingResultCountReseed.successes === current.successes &&
                pendingResultCountReseed.fails === current.fails &&
                pendingResultCountReseed.criticalFails === current.criticalFails;

            if (sameReseedCandidate) {
                lastResultCounts = current;
                confirmedCriticalFails = current.criticalFails;
                pendingCriticalConfirm = null;
                pendingResultCountReseed = null;
            } else {
                pendingResultCountReseed = {
                    successes: current.successes,
                    fails: current.fails,
                    criticalFails: current.criticalFails,
                    detectedAt: Date.now(),
                };
            }
            return true;
        }

        const canApplyResultDeltas = dSuccess >= 0 && dFail >= 0;
        if (canApplyResultDeltas) {
            lastResultCounts = current;
            pendingResultCountReseed = null;
        }

        const oldChain = chain;
        let criticalConfirmedReset = false;

        if (criticalDelta < 0) {
            confirmedCriticalFails = current.criticalFails;
            pendingCriticalConfirm = null;
            pendingResultCountReseed = null;
        } else if (criticalDelta > 0) {
            if (pendingCriticalConfirm && pendingCriticalConfirm.criticalFails === current.criticalFails) {
                chain = 0;
                criticalConfirmedReset = true;
                logDiagnostic('critical-counter-reset-confirmed', {
                    context: {
                        source: context.source || 'unknown',
                        route: currentCrimesRoute(),
                        mutations: summarizeMutations(context.mutations),
                    },
                    previous: lastResultCounts,
                    current,
                    criticalDelta,
                    pendingCriticalConfirm,
                });
                lastResultCounts = current;
                confirmedCriticalFails = current.criticalFails;
                pendingCriticalConfirm = null;
                pendingResultCountReseed = null;
            } else {
                pendingCriticalConfirm = { detectedAt: Date.now(), criticalFails: current.criticalFails };
                logDiagnostic('critical-counter-reset-pending', {
                    context: {
                        source: context.source || 'unknown',
                        route: currentCrimesRoute(),
                        mutations: summarizeMutations(context.mutations),
                    },
                    previous: lastResultCounts,
                    current,
                    criticalDelta,
                    pendingCriticalConfirm,
                });
            }
        } else {
            pendingCriticalConfirm = null;
        }

        if (canApplyResultDeltas) {
            if (dFail > 0) chain = Math.floor(chain / Math.pow(2, dFail));
            if (dSuccess > 0) chain += dSuccess;
        }

        chain = clampChain(chain);
        const reason = buildCountsReason({ dSuccess, dFail, criticalConfirmedReset });
        if (commitChainIfChanged('counts', oldChain, { dSuccess, dFail, criticalDelta, current }, reason)) {
            saveLastEvent({
                signature: `counts:${current.successes}:${current.fails}:${current.criticalFails}`,
                time: Date.now(),
                type: 'counts',
            });
        }
        return true;
    }

    function injectCSS() {
        if (document.querySelector('#cct-global-styles')) return;
        const style = document.createElement('style');
