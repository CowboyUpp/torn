                flex-wrap: wrap;
            }
            #cct-log-sync-hint {
                display: block;
                margin-top: 6px;
                font-size: 10px;
                opacity: 0.55;
                white-space: normal;
                line-height: 1.4;
            }
            .cct-manual-label-row {
                display: flex;
                align-items: center;
            }
            .cct-info-icon {
                position: relative;
                display: inline-block;
                margin-left: 3px;
                font-size: 10px;
                font-weight: 400;
                text-transform: none;
                letter-spacing: normal;
                cursor: help;
                outline: none;
            }
            .cct-info-glyph {
                opacity: 0.55;
            }
            .cct-info-icon:hover .cct-info-glyph,
            .cct-info-icon:focus .cct-info-glyph,
            .cct-info-icon.cct-info-open .cct-info-glyph {
                opacity: 1;
            }
            .cct-info-icon .cct-tooltip {
                display: none;
                position: absolute;
                bottom: calc(100% + 7px);
                left: 50%;
                transform: translateX(-50%);
                z-index: 10001;
                width: 190px;
                padding: 8px 10px;
                /* Fixed, fully-opaque surface deliberately independent of the
                   dark/light theme vars — guarantees readable contrast either way
                   instead of inheriting a color that can wash out against the
                   popover background. */
                background-color: #0a0a0a;
                opacity: 1;
                color: #ffffff;
                font-size: 11px;
                font-weight: 500;
                line-height: 1.45;
                white-space: normal;
                text-transform: none;
                letter-spacing: normal;
                border-radius: 5px;
            }
            .cct-info-icon:hover .cct-tooltip,
            .cct-info-icon:focus .cct-tooltip,
            .cct-info-icon.cct-info-open .cct-tooltip {
                display: block;
            }
            #cct-log-details {
                margin-top: 2px;
                border-top: 1px solid rgba(128,128,128,0.25);
                padding-top: 8px;
            }
            #cct-log-details summary {
                cursor: pointer;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 0.02em;
                opacity: 0.75;
                outline: none;
                user-select: none;
            }
            #cct-log-details summary:hover { opacity: 1; }
            #cct-log-list {
                list-style: none;
                margin: 8px 0 0;
                padding: 0;
                max-height: 150px;
                overflow-y: auto;
                display: flex;
                flex-direction: column;
                gap: 5px;
                white-space: nowrap;
            }
