// ==UserScript==
// @name         Bustr+
// @namespace    https://greasyfork.org/users/cowboyup
// @version      1.3.3
// @description  Safer Torn jail-busting helper with custom user/log key setup, bust budget estimate, hardness scores, filtering, sorting, and confirmation skipping. Now with full Script Hub integration and Total Busts display fetched from Torn personalstats.
// @author       cowboyup
// @license      MIT
// @match        https://www.torn.com/*
// @run-at       document-end
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_deleteValue
// @grant        GM_openInTab
// @grant        GM_xmlhttpRequest
// @connect      api.torn.com
// @connect      www.torn.com
// @downloadURL  https://update.greasyfork.org/scripts/586532/Bustr%2B.user.js
// @updateURL    https://update.greasyfork.org/scripts/586532/Bustr%2B.meta.js
// ==/UserScript==

(function () {
  'use strict';

  const SCRIPT = 'Bustr+';
  const VERSION = '1.3.3';
  const STORAGE_PREFIX = 'bustrPlusSafe.';
  const API_KEY_TITLE = 'BUSTRPlusLogs';
  const API_KEY_PERMISSION = 'User / Log';
  const API_KEY_URL = 'https://www.torn.com/preferences.php#tab=api?step=addNewKey&title=BUSTRPlusLogs&user=log';
  const BUST_LOG_ID = 5360;
  const HUB_ID = 'bustr-plus';
  const CACHE_TTL_TOTAL = 5 * 60 * 1000; // 5 minutes

  const DEFAULT_SETTINGS = {
    enabled: true,
    refreshSeconds: 60,
    freshBustScore: 128,
    decayDivisorHours: 10,
    decayWindowHours: 72,
    customPenaltyThreshold: 0,
    hardnessLimit: 460,
    hideHardTargets: true,
    sortByHardness: true,
    showHardness: true,
    skipBustConfirm: true,
    theme: 'dark',
    redLimit: 0,
    greenLimit: 3,
    manualTotalBusts: '' // NEW: Manual fallback
  };

  let state = {
    settings: { ...DEFAULT_SETTINGS },
    apiKey: '',
    timestamps: [],
    penaltyScore: 0,
    penaltyThreshold: 0,
    availableBusts: null,
    totalBusts: null,
    lastFetchMs: 0,
    lastLocalBustMs: 0,
    lastLocalBustSignature: '',
    lastBustActionClickMs: 0,
    lastBustActionHref: '',
    loadBustDataPromise: null,
    navStatsPending: false,
    hardnessRendering: false,
    hardnessRenderTimer: null,
    refreshTimerId: null,
    returnToJailTimerId: null,
    observerStarted: false,
    hardnessObserverStarted: false,
    bustConfirmSkipperStarted: false,
    pathWatcherStarted: false,
    hubPresent: false,
  };

  const store = {
    get(key, fallback) {
      const fullKey = STORAGE_PREFIX + key;
      try {
        if (typeof GM_getValue === 'function') return GM_getValue(fullKey, fallback);
      } catch (err) {}
      try {
        const raw = localStorage.getItem(fullKey);
        return raw == null ? fallback : JSON.parse(raw);
      } catch (err) {
        return fallback;
      }
    },
    set(key, value) {
      const fullKey = STORAGE_PREFIX + key;
      try {
        if (typeof GM_setValue === 'function') {
          GM_setValue(fullKey, value);
          return;
        }
      } catch (err) {}
      localStorage.setItem(fullKey, JSON.stringify(value));
    },
    del(key) {
      const fullKey = STORAGE_PREFIX + key;
      try {
        if (typeof GM_deleteValue === 'function') GM_deleteValue(fullKey);
      } catch (err) {}
      localStorage.removeItem(fullKey);
    },
  };

  function loadState() {
    state.settings = { ...DEFAULT_SETTINGS, ...store.get('settings', {}) };
    state.apiKey = store.get('apiKey', '');
    const savedStats = store.get('stats', {});
    state = { ...state, ...savedStats, settings: state.settings, apiKey: state.apiKey };
  }

  function saveSettings() {
    store.set('settings', state.settings);
  }

  function saveStats() {
    store.set('stats', {
      timestamps: state.timestamps,
      penaltyScore: state.penaltyScore,
      penaltyThreshold: state.penaltyThreshold,
      availableBusts: state.availableBusts,
      lastFetchMs: state.lastFetchMs,
    });
  }

  function setApiKey(apiKey) {
    state.apiKey = apiKey.trim();
    store.set('apiKey', state.apiKey);
  }

  function deleteApiKey() {
    state.apiKey = '';
    store.del('apiKey');
  }

  // =========================================================================
  // TOTAL BUSTS VIA GM (With Manual Fallback)
  // =========================================================================
  function getCachedTotalBusts() {
    // If user set a manual value, always use it
    if (state.settings.manualTotalBusts) {
      return parseInt(state.settings.manualTotalBusts.replace(/,/g, ''), 10) || null;
    }
    const raw = store.get('totalBusts', null);
    if (!raw || typeof raw !== 'object' || raw.count === null || !raw.ts) return null;
    if (Date.now() - raw.ts < CACHE_TTL_TOTAL) {
      return raw.count;
    }
    return null;
  }

  function saveTotalBusts(count) {
    store.set('totalBusts', { count, ts: Date.now() });
    state.totalBusts = count;
  }

  async function fetchTotalBustsViaAPI() {
    if (!state.apiKey) return null;

    try {
      // Since Dec 2024 Torn personalstats is category based.
      // Jail is the category containing peoplebusted.
      const url = `https://api.torn.com/user/?selections=personalstats&cat=jail&key=${encodeURIComponent(state.apiKey)}`;
      const response = await fetch(url, {
        method: 'GET',
        credentials: 'omit',
        cache: 'no-store',
      });

      const data = await response.json();

      if (data?.error) {
        const code = Number(data.error.code);
        if (code === 16) {
          console.info('[Bustr+] API key has no personalstats access; using authenticated Personal Stats fallback.');
        } else {
          console.warn('[Bustr+] Could not fetch total busts from personalstats API:', data.error.error || data.error);
        }
        return null;
      }

      const stats = data?.personalstats;
      const count = Number(
        stats?.peoplebusted ??
        stats?.people_busted ??
        stats?.peopleBusted
      );

      if (Number.isFinite(count) && count >= 0) {
        console.info('[Bustr+] Total busts from API:', count);
        return Math.floor(count);
      }

      console.warn('[Bustr+] Personalstats API returned no peoplebusted value.');
    } catch (error) {
      console.warn('[Bustr+] Personalstats API request failed:', error);
    }

    return null;
  }

  function fetchTotalBustsViaPersonalStatsPage() {
    return new Promise((resolve) => {
      const gmRequest =
        typeof GM_xmlhttpRequest === 'function'
          ? GM_xmlhttpRequest
          : (typeof GM !== 'undefined' && typeof GM.xmlHttpRequest === 'function'
              ? GM.xmlHttpRequest
              : null);

      if (!gmRequest) {
        console.warn('[Bustr+] No GM XHR available for authenticated Personal Stats fallback.');
        resolve(null);
        return;
      }

      const url = 'https://www.torn.com/personalstats.php?stats=useractivity&from=1%20month';

      try {
        gmRequest({
          method: 'GET',
          url,
          anonymous: false,
          credentials: true,
          timeout: 15000,

          onload: (response) => {
            try {
              if (response.status && response.status >= 400) {
                console.warn('[Bustr+] Personal Stats fallback HTTP status:', response.status);
                resolve(null);
                return;
              }

              const html = String(response.responseText || '');

              // Torn's Personal Stats page contains the statistic as visible
              // text/HTML. Keep parsing deliberately broad enough to survive
              // minor markup changes, but require the exact statistic label.
              const patterns = [
                /People\s*busted[\s\S]{0,1200}?(?:data-value|value|title)?[^0-9]{0,80}([\d,]+)/i,
                /People\s*busted[^0-9]{0,250}([\d,]+)/i,
                /peoplebusted[^0-9]{0,250}([\d,]+)/i,
              ];

              let count = null;

              for (const pattern of patterns) {
                const match = html.match(pattern);
                if (!match) continue;

                const candidate = Number(String(match[1]).replace(/,/g, ''));
                if (Number.isFinite(candidate) && candidate >= 0) {
                  count = Math.floor(candidate);
                  break;
                }
              }

              if (count != null) {
                console.info('[Bustr+] Total busts from authenticated Personal Stats:', count);
                resolve(count);
                return;
              }

              // Some Torn markup stores the stat in JSON embedded in the page.
              const jsonPatterns = [
                /"peoplebusted"\s*:\s*(\d+)/i,
                /"people_busted"\s*:\s*(\d+)/i,
              ];

              for (const pattern of jsonPatterns) {
                const match = html.match(pattern);
                if (!match) continue;

                const candidate = Number(match[1]);
                if (Number.isFinite(candidate) && candidate >= 0) {
                  console.info('[Bustr+] Total busts from embedded Personal Stats data:', candidate);
                  resolve(Math.floor(candidate));
                  return;
                }
              }

              console.warn('[Bustr+] Could not find People busted in authenticated Personal Stats page.');
              resolve(null);
            } catch (error) {
              console.warn('[Bustr+] Error parsing authenticated Personal Stats:', error);
              resolve(null);
            }
          },

          onerror: (error) => {
            console.warn('[Bustr+] Authenticated Personal Stats request failed:', error);
            resolve(null);
          },

          ontimeout: () => {
            console.warn('[Bustr+] Authenticated Personal Stats request timed out.');
            resolve(null);
          },
        });
      } catch (error) {
        console.warn('[Bustr+] Could not start authenticated Personal Stats request:', error);
        resolve(null);
      }
    });
  }

  async function fetchTotalBusts() {
    // 1. Preferred: API personalstats/Jail category.
    const apiCount = await fetchTotalBustsViaAPI();
    if (apiCount != null) {
      saveTotalBusts(apiCount);
      return apiCount;
    }

    // 2. Fallback: authenticated Torn Personal Stats page.
    const pageCount = await fetchTotalBustsViaPersonalStatsPage();
    if (pageCount != null) {
      saveTotalBusts(pageCount);
      return pageCount;
    }

    // 3. Existing cache/manual fallback remains handled by caller.
    return getCachedTotalBusts();
  }

  async function loadTotalBusts(force = false) {
    if (state.settings.manualTotalBusts) {
      state.totalBusts = parseInt(state.settings.manualTotalBusts.replace(/,/g, ''), 10) || null;
      return state.totalBusts;
    }

    if (!force) {
      const cached = getCachedTotalBusts();
      if (cached !== null) {
        state.totalBusts = cached;
        return cached;
      }
    }

    return fetchTotalBustsViaAPI();
  }

  // =========================================================================
  // HUB INTEGRATION
  // =========================================================================
  function isHubPresent() {
    return !!document.getElementById('tsh-sidebar-row');
  }

  function getStatusText() {
    if (!state.apiKey) {
      return 'No API key set — paste a User / Log key below';
    }
    const avail = state.availableBusts == null ? '?' : Math.max(0, state.availableBusts);
    const total = state.totalBusts != null ? state.totalBusts.toLocaleString() : '?';
    return `Busts: ${avail}/${total} | score ${state.penaltyScore}/${state.penaltyThreshold || '?'}`;
  }

  function registerWithHub() {
    state.hubPresent = isHubPresent();

    document.dispatchEvent(new CustomEvent('torn-script-hub:register', {
      detail: {
        id: HUB_ID,
        name: 'BUSTR+',
        version: VERSION,
        order: 200,
        open: () => {
          document.dispatchEvent(new CustomEvent('torn-script-hub:open', {
            detail: { scriptId: HUB_ID }
          }));
          if (isJailPage()) {
            Promise.all([loadBustData(false), loadTotalBusts(false)]).then(() => renderAll());
          }
        },
        close: () => {
          state.settings.enabled = false;
          saveSettings();
          cleanupModifications();
          if (state.refreshTimerId) {
            clearInterval(state.refreshTimerId);
            state.refreshTimerId = null;
          }
        },
        status: getStatusText,
        prefs: {
          fields: [
            { key: 'apiKey', type: 'password', label: 'Custom API key', default: '', placeholder: '16 character Torn custom key', hint: 'Required to fetch your bust log (for available busts). Total busts are fetched securely via your browser session, so a safe "User / Log" key is perfect!' },
            { key: 'generateKey', type: 'button', label: 'Generate User / Log key', hint: 'Opens Torn API key page pre-filled for User / Log only', onClick: () => openUrl(API_KEY_URL) },
            { key: 'enabled', type: 'toggle', label: 'Active', default: true, hint: 'Turn Bustr+ on or off' },
            { key: 'skipBustConfirm', type: 'toggle', label: 'Skip bust confirm', default: true, hint: 'Automatically confirm bust actions' },
            { key: 'hideHardTargets', type: 'toggle', label: 'Hide hard targets', default: true, hint: 'Completely hide targets above the hardness ceiling' },
            { key: 'sortByHardness', type: 'toggle', label: 'Sort easiest first', default: true, hint: 'Sort jail list by hardness score ascending' },
            { key: 'showHardness', type: 'toggle', label: 'Show hardness scores', default: true, hint: 'Display the hardness score column on the jail list' },
            { key: 'hardnessLimit', type: 'number', label: 'Hardness ceiling', default: 460, min: 0, hint: 'Maximum jail target score shown as safe. Lower is stricter.' },
            { key: 'customPenaltyThreshold', type: 'number', label: 'Manual penalty cap', default: 0, min: 0, hint: 'Optional manual cap for bust budget. Leave 0 to auto-estimate from history.' },
            { key: 'refreshSeconds', type: 'number', label: 'Refresh seconds', default: 60, min: 15, hint: 'How often to check user/log for new busts. 60 is calm and API-friendly.' },
            { key: 'decayDivisorHours', type: 'number', label: 'Decay rate (hrs)', default: 10, min: 1, hint: 'How quickly old busts cool off. Smaller = faster forgiveness.' },
            { key: 'decayWindowHours', type: 'number', label: 'Decay window (hrs)', default: 72, min: 1, hint: 'How far back to look when estimating bust fatigue.' },
            { key: 'greenLimit', type: 'number', label: 'Green at busts', default: 3, min: 0, hint: 'When the jail menu counter turns green.' },
            { key: 'redLimit', type: 'number', label: 'Red at busts', default: 0, min: 0, hint: 'When the jail menu counter turns red.' },
            { key: 'manualTotalBusts', type: 'text', label: 'Total Busts (Manual)', default: '', placeholder: 'e.g., 8857', hint: 'Optional: If background fetching fails, enter your total busts here and it will be used permanently.' },
          ],
          values: {
            enabled: state.settings.enabled,
            skipBustConfirm: state.settings.skipBustConfirm,
            hideHardTargets: state.settings.hideHardTargets,
            sortByHardness: state.settings.sortByHardness,
            showHardness: state.settings.showHardness,
            hardnessLimit: state.settings.hardnessLimit,
            customPenaltyThreshold: state.settings.customPenaltyThreshold,
            refreshSeconds: state.settings.refreshSeconds,
            decayDivisorHours: state.settings.decayDivisorHours,
            decayWindowHours: state.settings.decayWindowHours,
            greenLimit: state.settings.greenLimit,
            redLimit: state.settings.redLimit,
            apiKey: state.apiKey || '',
            manualTotalBusts: state.settings.manualTotalBusts || '',
          },
          onSave: (values) => {
            const wasEnabled = state.settings.enabled;
            let keyPromise = null;

            state.settings.enabled = !!values.enabled;
            state.settings.skipBustConfirm = !!values.skipBustConfirm;
            state.settings.hideHardTargets = !!values.hideHardTargets;
            state.settings.sortByHardness = !!values.sortByHardness;
            state.settings.showHardness = values.showHardness !== false;
            state.settings.hardnessLimit = Math.max(0, Number(values.hardnessLimit) || 0);
            state.settings.customPenaltyThreshold = Math.max(0, Number(values.customPenaltyThreshold) || 0);
            state.settings.refreshSeconds = Math.max(15, Number(values.refreshSeconds) || 60);
            state.settings.decayDivisorHours = Math.max(1, Number(values.decayDivisorHours) || 10);
            state.settings.decayWindowHours = Math.max(1, Number(values.decayWindowHours) || 72);
            state.settings.greenLimit = Math.max(0, Number(values.greenLimit) || 0);
            state.settings.redLimit = Math.max(0, Number(values.redLimit) || 0);
            state.settings.manualTotalBusts = String(values.manualTotalBusts || '').trim();

            if (typeof values.apiKey === 'string') {
              const key = values.apiKey.trim();
              if (key && /^[A-Za-z0-9]{16}$/.test(key) && key !== state.apiKey) {
                setApiKey(key);
                keyPromise = Promise.all([loadBustData(true), loadTotalBusts(true)]).then(() => renderAll());
              }
            }

            saveSettings();
            recalcStats();
            saveStats();

            // If manual total busts was set, update state immediately
            if (state.settings.manualTotalBusts) {
              state.totalBusts = parseInt(state.settings.manualTotalBusts.replace(/,/g, ''), 10) || null;
            }

            if (!wasEnabled && state.settings.enabled) {
              keyPromise = loadBustData(false).then(() => {
                renderAll();
                startRefreshTimer();
                scanExistingBustSuccesses();
              });
            } else if (wasEnabled && !state.settings.enabled) {
              if (state.refreshTimerId) {
                clearInterval(state.refreshTimerId);
                state.refreshTimerId = null;
              }
              cleanupModifications();
            } else if (state.settings.enabled) {
              renderAll();
              startRefreshTimer();
            }

            return keyPromise;
          }
        }
      }
    }));
  }

  function cleanupModifications() {
    document.querySelectorAll('.bustr-plus-nav, .bustr-plus-pill').forEach(el => el.remove());
    document.body.classList.remove('bustr-plus-green', 'bustr-plus-orange', 'bustr-plus-red');
    document.querySelectorAll('.bustr-plus-hardness-col').forEach(el => el.remove());
    document.querySelectorAll('.bustr-plus-hardness-wrap').forEach(el => el.remove());
    document.querySelectorAll('.bustr-plus-hard-row, .bustr-plus-hidden-hard').forEach(row => {
      row.classList.remove('bustr-plus-hard-row', 'bustr-plus-hidden-hard');
      row.style.order = '';
    });
    document.querySelectorAll("a[href*='breakout']").forEach(link => unmarkQuickBustLink(link));
    removeToggleButton();
    removeSettingsPanel();
  }

