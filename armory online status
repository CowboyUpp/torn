// ==UserScript==
// @name         Torn: Armory Loaned Status Dots
// @namespace    torn.bundle.armory
// @version      1.2
// @description  Adds green/yellow/gray online status dots to faction members in the Armory "Loaned" section. Bundled with HoF & Mug Ping.
// @author       You
// @match        *://www.torn.com/*
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_addStyle
// ==/UserScript==

(function() {
    'use strict';

    // ==========================================
    // 1. SCRIPT HUB REGISTRATION
    // ==========================================
    window.dispatchEvent(new CustomEvent('torn-script-hub:register', {
        detail: {
            id: 'armory-loaned-status',
            name: 'Armory Loaned Status',
            version: '1.2',
            author: 'You',
            description: 'Adds online/away/offline status dots to faction members in the Armory Loaned section.',
            icon: '🟢',
            settings: true // Indicates this script has settings (API key)
        }
    }));

    // ==========================================
    // 2. SHARED API KEY & SETTINGS MANAGEMENT
    // ==========================================
    const STORAGE_KEYS = {
        BUNDLE_KEY: 'torn_api_bundle_key',
        CACHE: 'torn_faction_members_cache'
    };

    const CACHE_TTL = 120000; // 2 minutes in milliseconds

    function getApiKey() {
        return GM_getValue(STORAGE_KEYS.BUNDLE_KEY, '');
    }

    function setApiKey(key) {
        GM_setValue(STORAGE_KEYS.BUNDLE_KEY, key.trim());
        // Clear cache when key changes to force fresh data
        GM_setValue(STORAGE_KEYS.CACHE, null); 
    }

    GM_registerMenuCommand('⚙️ Set / Reset Bundled API Key', () => {
        const currentKey = getApiKey();
        const newKey = prompt('Enter your Bundled Torn API Key (requires "faction -> members" permission):\n\nLeave blank to cancel.', currentKey);
        if (newKey !== null) {
            if (newKey.trim().length === 16) {
                setApiKey(newKey);
                alert('API Key updated! Refreshing page to apply changes.');
                location.reload();
            } else if (newKey.trim() !== '') {
                alert('Invalid key format. Torn API keys are exactly 16 characters long.');
            }
        }
    });

    // ==========================================
    // 3. CSS INJECTION (Desktop & PDA Optimized)
    // ==========================================
    GM_addStyle(`
        .bundle-status-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            margin-right: 6px;
            vertical-align: middle;
            flex-shrink: 0;
            transition: opacity 0.2s ease;
        }
        .bundle-status-dot:hover {
            opacity: 0.7;
        }
        .bundle-status-dot.online {
            background-color: #00a800;
            box-shadow: 0 0 4px rgba(0, 168, 0, 0.6);
        }
        .bundle-status-dot.idle {
            background-color: #ffb200;
            box-shadow: 0 0 4px rgba(255, 178, 0, 0.6);
        }
        .bundle-status-dot.offline {
            background-color: #888888;
        }
        /* PDA / Mobile specific tweaks */
        @media screen and (max-width: 768px) {
            .bundle-status-dot {
                width: 8px;
                height: 8px;
                margin-right: 5px;
            }
        }
    `);

    // ==========================================
    // 4. CORE LOGIC & API FETCHING
    // ==========================================
    async function fetchFactionMembers() {
        const apiKey = getApiKey();
        if (!apiKey) {
            console.warn('[Armory Status] No bundled API key found. Use the Tampermonkey menu to set it.');
            return null;
        }

        const now = Date.now();
        const cached = GM_getValue(STORAGE_KEYS.CACHE, null);

        // Return cached data if it's still fresh
        if (cached && (now - cached.timestamp < CACHE_TTL)) {
            return cached.data;
        }

        try {
            const response = await fetch(`https://api.torn.com/faction/?selections=members&key=${apiKey}`);
            const data = await response.json();

            if (data.error) {
                console.error('[Armory Status] API Error:', data.error);
                if (data.error.code === 2) {
                    alert('[Armory Status] Invalid API key. Please update it via the Tampermonkey menu.');
                } else if (data.error.code === 6 || data.error.code === 16) {
                    alert('[Armory Status] API key lacks "faction -> members" permission. Please generate a new custom key.');
                }
                return null;
            }

            const membersMap = {};
            if (data.members) {
                for (const [xid, member] of Object.entries(data.members)) {
                    // Map Torn's status to our CSS classes
                    const status = member.last_action?.status || 'Offline';
                    membersMap[xid] = status.toLowerCase(); // "online", "idle", "offline"
                }
            }

            // Save to shared cache
            GM_setValue(STORAGE_KEYS.CACHE, { timestamp: now, data: membersMap });
            return membersMap;

        } catch (e) {
            console.error('[Armory Status] Network error fetching faction data:', e);
            return null;
        }
    }

    // ==========================================
    // 5. DOM MANIPULATION & OBSERVER
    // ==========================================
    function injectDots() {
        // Target both Desktop and PDA structures for the loaned section
        const loanedLinks = document.querySelectorAll('.loaned a[href*="XID="], .loaned-item a[href*="XID="]');
        if (loanedLinks.length === 0) return;

        fetchFactionMembers().then(membersMap => {
            if (!membersMap) return;

            loanedLinks.forEach(link => {
                if (link.dataset.bundleStatusProcessed) return;

                const href = link.getAttribute('href');
                const match = href.match(/XID=(\d+)/);
                if (!match) return;

                const xid = match[1];
                const statusClass = membersMap[xid] || 'offline';

                const dot = document.createElement('span');
                dot.className = `bundle-status-dot ${statusClass}`;
                dot.title = `Status: ${statusClass.charAt(0).toUpperCase() + statusClass.slice(1)}`;

                // Insert right in front of the name
                link.insertBefore(dot, link.firstChild);
                link.dataset.bundleStatusProcessed = 'true';
            });
        });
    }

    // Only run on Faction pages to save resources
    if (location.href.includes('factions.php')) {
        // Initial run with a slight delay to let Torn's AJAX load the tab
        setTimeout(injectDots, 800);

        // Observe DOM for tab switches (Armoury tab, pagination, etc.)
        const observer = new MutationObserver((mutations) => {
            let shouldRun = false;
            for (const mutation of mutations) {
                if (mutation.addedNodes.length) {
                    for (const node of mutation.addedNodes) {
                        if (node.nodeType === 1 && (node.classList?.contains('loaned') || node.querySelector?.('.loaned'))) {
                            shouldRun = true;
                            break;
                        }
                    }
                }
                if (shouldRun) break;
            }
            if (shouldRun) {
                // Small debounce to prevent multiple rapid fires
                clearTimeout(window.armoryStatusDebounce);
                window.armoryStatusDebounce = setTimeout(injectDots, 300);
            }
        });

        observer.observe(document.body, { childList: true, subtree: true });
    }

})();
