// ==UserScript==
// @name         Torn: Faction Upgrade Change Notifier
// @namespace    https://github.com/CowboyUpp/torn
// @version      4.7.0
// @description  Notifies (toast + OS notification) when your faction's upgrades change. DOM mode reads button.wai-upgrade-btn aria-labels on the Upgrades tab - no special permission needed. Settings toggle sits next to BUSTR+ in the faction toolbar.
// @author       Selbaer (cowboyup)
// @match        https://www.torn.com/factions.php*
// @grant        GM_xmlhttpRequest
// @grant        GM_setValue
// @grant        GM_getValue
// @grant        GM_registerMenuCommand
// @grant        GM_notification
// @connect      api.torn.com
// @run-at       document-idle
// ==/UserScript==

(function () {
  'use strict';

  const VERSION = '4.7.0';

  // ---------- Predefined defaults ----------
  const DEFAULTS = {
    MODE: 'dom',            // 'dom' (no API access needed) or 'api' (needs Faction API Access)
    API_KEY: '',
    NOTIFY_DESKTOP: true,
    THEME: 'dark',
  };

  const NS = 'ffu_';

  const store = {
    get(key, fallback) {
      const v = GM_getValue(NS + key, undefined);
      return v === undefined ? fallback : v;
    },
    set(key, val) {
      GM_setValue(NS + key, val);
    },
  };

  function getConfig() {
    return {
      mode: store.get('mode', DEFAULTS.MODE),
      apiKey: store.get('apiKey', DEFAULTS.API_KEY),
      notifyDesktop: store.get('notifyDesktop', DEFAULTS.NOTIFY_DESKTOP),
      theme: store.get('theme', DEFAULTS.THEME),
    };
  }

  // ============================================================
  // MODE 1: API-based (needs "Access Faction API" permission)
  // ============================================================

  function fetchUpgradesFromApi() {
    return new Promise((resolve, reject) => {
      const { apiKey } = getConfig();
      if (!apiKey) {
        reject(new Error('No API key set.'));
        return;
      }
      GM_xmlhttpRequest({
        method: 'GET',
        url: `https://api.torn.com/faction/?selections=upgrades&key=${encodeURIComponent(apiKey)}`,
        onload: (res) => {
          try {
            const data = JSON.parse(res.responseText);
            if (data.error) {
              reject(new Error(`Torn API error ${data.error.code}: ${data.error.error}`));
              return;
            }
            resolve(data);
          } catch (e) {
            reject(new Error('Failed to parse API response: ' + e.message));
          }
        },
        onerror: () => reject(new Error('Network error contacting Torn API.')),
        ontimeout: () => reject(new Error('Torn API request timed out.')),
        timeout: 15000,
      });
    });
  }

  function flattenTree(dataBlock) {
    const out = {};
    if (!dataBlock) return out;
    for (const [id, up] of Object.entries(dataBlock)) {
      out[id] = { name: up.name, branch: up.branch, level: up.level, unlocked: up.unlocked };
    }
    return out;
  }

  function diffApiSnapshots(prev, curr) {
    const changes = [];
    if (prev && prev.state !== curr.state) {
      changes.push(`Faction tree switched from ${prev.state} to ${curr.state}.`);
    }
    for (const treeKey of ['peace', 'war']) {
      const prevTree = flattenTree(prev ? prev[treeKey] : null);
      const currTree = flattenTree(curr[treeKey]);
      for (const [id, upNow] of Object.entries(currTree)) {
        const upBefore = prevTree[id];
        if (!upBefore) {
          if (prev && upNow.level > 0) {
            changes.push(`[${treeKey}] ${upNow.name} (${upNow.branch}) unlocked at level ${upNow.level}.`);
          }
          continue;
        }
        if (upBefore.level !== upNow.level) {
          if (upBefore.level === 0 && upNow.level > 0) {
            changes.push(`[${treeKey}] ${upNow.name} (${upNow.branch}) unlocked at level ${upNow.level}.`);
          } else if (upNow.level > upBefore.level) {
            changes.push(`[${treeKey}] ${upNow.name} (${upNow.branch}) leveled up: ${upBefore.level} -> ${upNow.level}.`);
          } else if (upNow.level < upBefore.level) {
            changes.push(`[${treeKey}] ${upNow.name} (${upNow.branch}) leveled down: ${upBefore.level} -> ${upNow.level}.`);
          }
        }
      }
    }
    return changes;
  }

  async function checkViaApi(manual, statusCb) {
    const curr = await fetchUpgradesFromApi();
    const prev = store.get('apiSnapshot', null);

    if (!prev) {
      store.set('apiSnapshot', curr);
      const msg = 'Baseline snapshot saved (API mode).';
      if (manual) toast(msg, 'info');
      if (statusCb) statusCb(msg);
      return;
    }

    const changes = diffApiSnapshots(prev, curr);
    store.set('apiSnapshot', curr);

    if (changes.length > 0) {
      toast(changes.join('\n'), 'success');
      osNotify('Torn Faction Upgrade Change', changes.join(' | '));
      if (statusCb) statusCb(`${changes.length} change(s) found (${new Date().toLocaleTimeString()}).`);
    } else {
      if (manual) toast('No changes since last check.', 'info');
      if (statusCb) statusCb(`No changes (${new Date().toLocaleTimeString()}).`);
    }
  }

  // ============================================================
  // MODE 2: DOM-scrape (no API access needed)
  //
  // Each individual upgrade is a <button class="wai-upgrade-btn"
  // i-data="i_XXX_YYY_26_26" aria-label="Name LEVEL. Description.
  // Challenge: ... Total respect: N. "> — only the currently open
  // branch's buttons exist in the DOM at a time, so we merge each
  // scan into the saved snapshot incrementally rather than treating
  // a scan as the complete picture. Only reads what's on-screen,
  // per Torn's scripting rules.
  // ============================================================

  const ARIA_LABEL_RE = /^(.*?)\s+(\d+)\.\s+(.*?)\s*Total respect:\s*([\d,]+)\.?\s*$/;

  function parseUpgradeButton(btn) {
    const id = btn.getAttribute('i-data');
    const label = btn.getAttribute('aria-label') || '';
    if (!id || !label) return null;

    const m = label.match(ARIA_LABEL_RE);
    if (!m) {
      // Unexpected format - keep the raw label so we can still diff on it,
      // just without pretty name/level/cost breakdown.
      return { id, raw: label, name: null, level: null, cost: null };
    }
    const [, name, level, desc, cost] = m;
    return { id, raw: label, name: name.trim(), level: parseInt(level, 10), desc: desc.trim(), cost: cost.replace(/,/g, '') };
  }

  function scanUpgradeButtons() {
    const buttons = document.querySelectorAll('button.wai-upgrade-btn[i-data]');
    const out = {};
    buttons.forEach((btn) => {
      const parsed = parseUpgradeButton(btn);
      if (parsed) out[parsed.id] = parsed;
    });
    return out;
  }

  // ---- Branch-icon row (Core section) ----
  // <button class="branch-icon" i-data="i_604_417_80_80">
  //   <span class="branch-factor"><span class="factor"><span class="x-factor">x </span>8</span></span>
  // </button>
  // No friendly name is exposed by Torn's markup here (data-title is empty),
  // so names are user-assigned once via the panel and remembered from then on.

  function parseBranchIcon(btn) {
    const id = btn.getAttribute('i-data');
    if (!id) return null;
    const factorEl = btn.querySelector('.factor');
    const text = factorEl ? factorEl.textContent.trim() : '';
    const m = text.match(/(\d+)/);
    const level = m ? parseInt(m[1], 10) : null;
    return { id, level, raw: text };
  }

  function scanBranchIcons() {
    const buttons = document.querySelectorAll('button.branch-icon[i-data]');
    const out = {};
    buttons.forEach((btn) => {
      const parsed = parseBranchIcon(btn);
      if (parsed) out[parsed.id] = parsed;
    });
    return out;
  }

  function getBranchNameMap() {
    return store.get('branchNameMap', {}) || {};
  }

  function branchLabel(id) {
    const map = getBranchNameMap();
    return map[id] || `Branch icon (${id})`;
  }

  function saveBranchName(id, name) {
    const map = getBranchNameMap();
    if (map[id] === name) return;
    map[id] = name;
    store.set('branchNameMap', map);
  }

  // Auto-capture the friendly branch name from Torn's own hover tooltip
  // (visible in-game as e.g. "Steadfast Branch"), instead of asking the
  // user to type it in. A generation token + proximity check prevent a
  // slow-to-fade tooltip from a previously-hovered icon being wrongly
  // attributed to whichever icon is hovered next.
  let hoverGeneration = 0;

  function watchForBranchTooltip(id, anchorRect) {
    const myGeneration = ++hoverGeneration;
    let attempts = 0;

    const timer = setInterval(() => {
      attempts++;
      if (myGeneration !== hoverGeneration) {
        clearInterval(timer); // mouse moved to a different icon - abandon this watch
        return;
      }

      const candidates = document.querySelectorAll('body *');
      for (const el of candidates) {
        if (el.children.length > 0) continue;
        const text = (el.textContent || '').trim();
        const m = text.match(/^(.+?)\s+Branch$/);
        if (!m || el.offsetParent === null) continue;

        const r = el.getBoundingClientRect();
        const dx = Math.max(anchorRect.left - r.right, r.left - anchorRect.right, 0);
        const dy = Math.max(anchorRect.top - r.bottom, r.top - anchorRect.bottom, 0);
        // Tooltip should be reasonably close to the icon that triggered it.
        if (dx > 150 || dy > 150) continue;

        if (myGeneration !== hoverGeneration) { clearInterval(timer); return; }
        saveBranchName(id, m[1].trim());
        clearInterval(timer);
        if (panelApi && panelApi.refreshBranchNames) panelApi.refreshBranchNames();
        return;
      }

      if (attempts >= 10) clearInterval(timer);
    }, 100);
  }

  function attachBranchIconHoverCapture() {
    let activeWatchId = null;
    document.addEventListener('mouseover', (e) => {
      const btn = e.target.closest && e.target.closest('button.branch-icon[i-data]');
      if (!btn) return;
      const id = btn.getAttribute('i-data');
      if (!id) return;
      const map = getBranchNameMap();
      if (map[id]) return; // already known, no need to re-watch
      if (id === activeWatchId) return; // mouseover re-fired for a child element within the same icon - ignore
      activeWatchId = id;
      watchForBranchTooltip(id, btn.getBoundingClientRect());
    });
    document.addEventListener('mouseout', (e) => {
      const btn = e.target.closest && e.target.closest('button.branch-icon[i-data]');
      if (!btn) return;
      // Only clear activeWatchId once the mouse has actually left the button
      // (not just moved between its internal child elements).
      if (btn.contains(e.relatedTarget)) return;
      if (btn.getAttribute('i-data') === activeWatchId) activeWatchId = null;
    });
  }

  let domScanTimer = null;
  let domObserver = null;

  function scheduleDomScan(delay = 700) {
    if (domScanTimer) clearTimeout(domScanTimer);
    domScanTimer = setTimeout(() => runDomScan(false, null), delay);
  }

  function runDomScan(manual = false, statusCb = null) {
    const currentReads = scanUpgradeButtons();
    const currentBranchReads = scanBranchIcons();
    const seenCount = Object.keys(currentReads).length;
    const seenBranchCount = Object.keys(currentBranchReads).length;

    if (seenCount === 0 && seenBranchCount === 0) {
      if (manual && statusCb) {
        statusCb('No upgrade buttons found. Open Faction > Upgrades and select a branch.');
      }
      return;
    }

    const snapshot = store.get('domSnapshot', {}) || {};
    const branchSnapshot = store.get('domBranchSnapshot', {}) || {};
    const changes = [];

    for (const [id, curr] of Object.entries(currentReads)) {
      const prev = snapshot[id];
      if (!prev) {
        // First time seeing this specific upgrade node - establish baseline only.
        continue;
      }
      if (curr.raw !== prev.raw) {
        if (curr.level !== null && prev.level !== null && curr.level !== prev.level) {
          changes.push(`${curr.name}: level ${prev.level} -> ${curr.level} (now ${Number(curr.cost).toLocaleString()} respect).`);
        } else {
          changes.push(`${curr.name || id} changed.`);
        }
      }
    }

    for (const [id, curr] of Object.entries(currentBranchReads)) {
      const prev = branchSnapshot[id];
      if (!prev) continue; // baseline only on first sighting
      if (curr.level !== null && prev.level !== null && curr.level !== prev.level) {
        changes.push(`${branchLabel(id)}: x${prev.level} -> x${curr.level}.`);
      }
    }

    // Merge current readings into the persisted snapshots (don't drop
    // entries for branches not currently on screen).
    const merged = Object.assign({}, snapshot, currentReads);
    store.set('domSnapshot', merged);
    const mergedBranch = Object.assign({}, branchSnapshot, currentBranchReads);
    store.set('domBranchSnapshot', mergedBranch);

    const totalKnown = Object.keys(merged).length;

    if (changes.length > 0) {
      const msg = changes.slice(0, 8).join('\n');
      toast(msg, 'success');
      osNotify('Torn Faction Upgrade Change', changes.join(' | '));
      if (statusCb) statusCb(`${changes.length} change(s) found (${new Date().toLocaleTimeString()}).`);
    } else if (manual) {
      toast(`No changes in this branch. (${seenCount} upgrade(s) read, ${totalKnown} tracked total.)`, 'info');
      if (statusCb) statusCb(`No changes. ${seenCount} read here, ${totalKnown} tracked total.`);
    } else if (statusCb) {
      statusCb(`Baseline updated. ${seenCount} read here, ${totalKnown} tracked total.`);
    }
  }

  function startDomWatcher() {
    if (domObserver) return;
    domObserver = new MutationObserver(() => scheduleDomScan());
    domObserver.observe(document.body, { childList: true, subtree: true });
    scheduleDomScan(1200);
  }

  // ============================================================
  // Shared UI (styles, toast, OS notification, settings panel)
  // ============================================================

  function ensureStyles() {
    if (document.getElementById('ffu-style')) return;
    const style = document.createElement('style');
    style.id = 'ffu-style';
    style.textContent = `
      #ffu-panel, #ffu-toast-container {
        --ffu-bg: #1c1c1c;
        --ffu-bg-header: #262626;
        --ffu-fg: #eee;
        --ffu-border: #3a3a3a;
        --ffu-muted: #999;
        --ffu-hint: #777;
        --ffu-input-bg: #111;
      }
      #ffu-panel.ffu-light, #ffu-toast-container.ffu-light {
        --ffu-bg: #f7f7f7;
        --ffu-bg-header: #ececec;
        --ffu-fg: #242424;
        --ffu-border: #c9c9c9;
        --ffu-muted: #666;
        --ffu-hint: #777;
        --ffu-input-bg: #fff;
      }

      #ffu-toast-container {
        position: fixed; bottom: 16px; right: 16px; z-index: 999999;
        display: flex; flex-direction: column; gap: 8px;
      }
      .ffu-toast {
        background: var(--ffu-bg, #1c1c1c); color: var(--ffu-fg, #eee); border-left: 4px solid #4caf50;
        padding: 10px 14px; border-radius: 4px; font-size: 13px; line-height: 1.4;
        box-shadow: 0 2px 8px rgba(0,0,0,0.4); max-width: 360px;
        opacity: 0; transform: translateY(10px); transition: opacity .25s ease, transform .25s ease;
        white-space: pre-wrap;
      }
      .ffu-toast.ffu-show { opacity: 1; transform: translateY(0); }
      .ffu-toast.ffu-info { border-left-color: #2196f3; }
      .ffu-toast.ffu-error { border-left-color: #f44336; }
      .ffu-toast b { display: block; margin-bottom: 4px; }

      #ffu-fab {
        position: absolute;
        top: 12px;
        right: 18px; /* overwritten dynamically once BUSTR+'s width is known */
        height: 28px; min-height: 28px;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 4px; border: 0; background: transparent; color: #eee;
        padding: 0 8px; font-size: 15px; cursor: pointer; z-index: 99998;
