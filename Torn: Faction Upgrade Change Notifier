    document.head.appendChild(style);
  }

  function toast(message, type = 'success') {
    ensureStyles();
    let container = document.getElementById('ffu-toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'ffu-toast-container';
      document.body.appendChild(container);
    }
    container.classList.toggle('ffu-light', getConfig().theme === 'light');
    const el = document.createElement('div');
    el.className = `ffu-toast ffu-${type}`;
    el.innerHTML = `<b>Faction Upgrade Notifier</b>${message.replace(/</g, '&lt;')}`;
    container.appendChild(el);
    requestAnimationFrame(() => el.classList.add('ffu-show'));
    setTimeout(() => {
      el.classList.remove('ffu-show');
      setTimeout(() => el.remove(), 300);
    }, 10000);
  }

  function osNotify(title, body) {
    if (!getConfig().notifyDesktop) return;
    try {
      GM_notification({ title, text: body, timeout: 12000 });
    } catch (e) {
      // unsupported in this context
    }
  }

  function positionFabNearBustr(fab) {
    const bustrBtn = document.getElementById('bustr-plus-toggle');
    if (!bustrBtn) {
      fab.classList.add('ffu-fab-fallback');
      return;
    }
    fab.classList.remove('ffu-fab-fallback');
    const gap = 4;
    // BUSTR+'s own CSS: position:absolute; right:18px; top:12px.
    const rightOffset = 18 + bustrBtn.offsetWidth + gap;
    fab.style.right = `${rightOffset}px`;
    fab.style.top = '12px';
  }

  function buildPanel() {
    ensureStyles();

    const fab = document.createElement('button');
    fab.id = 'ffu-fab';
    fab.type = 'button';
    fab.title = 'Faction Upgrade Notifier settings';
    fab.textContent = '⚙';

    document.body.appendChild(fab);
    positionFabNearBustr(fab);
    // Bustr+ remounts its own toggle at 1s/3s after load; re-measure at the
    // same marks in case its width/position wasn't settled on first read.
    setTimeout(() => positionFabNearBustr(fab), 1000);
    setTimeout(() => positionFabNearBustr(fab), 3000);

    const panel = document.createElement('div');
    panel.id = 'ffu-panel';
    panel.innerHTML = `
      <header>
        Faction Upgrade Notifier
        <span class="ffu-header-actions">
          <span class="ffu-theme-toggle" id="ffu-theme-toggle" title="Toggle light/dark">☾</span>
          <span class="ffu-close" title="Close">✕</span>
        </span>
      </header>
      <div class="ffu-body">
        <div>
          <label for="ffu-mode">Detection mode</label>
          <select id="ffu-mode">
            <option value="dom">DOM scrape (no permission needed)</option>
            <option value="api">Torn API (needs Faction API Access)</option>
          </select>
          <div class="ffu-hint" id="ffu-mode-hint"></div>
        </div>

        <div class="ffu-dom-fields" id="ffu-dom-fields">
          <div class="ffu-hint">Click through each branch on the Upgrades tab; coverage builds up as you browse. Only reads what's currently on screen.</div>
          <div class="ffu-row">
            <button id="ffu-dom-rescan" type="button">Rescan Now</button>
            <button id="ffu-dom-reset" type="button">Reset Baseline</button>
          </div>
          <div id="ffu-branch-names"></div>
        </div>

        <div class="ffu-api-fields" id="ffu-api-fields">
          <div>
            <label for="ffu-apikey">Torn API key</label>
            <div class="ffu-key-row">
              <input type="text" id="ffu-apikey" disabled placeholder="Faction API access on request" />
            </div>
            <div class="ffu-hint">Ask a faction leader to grant "Access Faction API" on your position to enable this mode.</div>
          </div>
          <div class="ffu-row">
            <button id="ffu-api-check" type="button">Check Now</button>
            <button id="ffu-api-reset" type="button">Reset Baseline</button>
          </div>
        </div>

        <div class="ffu-checkbox-row">
          <input type="checkbox" id="ffu-desktop-notify" />
          <label for="ffu-desktop-notify" style="margin:0;">Also show OS notification</label>
        </div>

        <button id="ffu-save" class="ffu-primary" type="button">Save</button>

        <div class="ffu-status" id="ffu-status">Not checked yet.</div>
        <div class="ffu-version">Version ${VERSION}</div>
      </div>
    `;
    document.body.appendChild(panel);

    const els = {
      mode: panel.querySelector('#ffu-mode'),
      modeHint: panel.querySelector('#ffu-mode-hint'),
      domFields: panel.querySelector('#ffu-dom-fields'),
      apiFields: panel.querySelector('#ffu-api-fields'),
      domRescan: panel.querySelector('#ffu-dom-rescan'),
      domReset: panel.querySelector('#ffu-dom-reset'),
      branchNames: panel.querySelector('#ffu-branch-names'),
      apikey: panel.querySelector('#ffu-apikey'),
      toggleKey: null,
      apiCheck: panel.querySelector('#ffu-api-check'),
      apiReset: panel.querySelector('#ffu-api-reset'),
      desktopNotify: panel.querySelector('#ffu-desktop-notify'),
      save: panel.querySelector('#ffu-save'),
      status: panel.querySelector('#ffu-status'),
      close: panel.querySelector('.ffu-close'),
      themeToggle: panel.querySelector('#ffu-theme-toggle'),
    };

    const MODE_HINTS = {
      dom: 'Reads upgrade buttons only while you have that branch open — no elevated key permission required.',
      api: 'Polls the Torn API in the background. Requires the key\'s faction position to have "Access Faction API" enabled.',
    };

    function applyModeVisibility(mode) {
      els.domFields.classList.toggle('ffu-active', mode === 'dom');
      els.apiFields.classList.toggle('ffu-active', mode === 'api');
      els.modeHint.textContent = MODE_HINTS[mode] || '';
    }

    function applyTheme(theme) {
      const isLight = theme === 'light';
      panel.classList.toggle('ffu-light', isLight);
      els.themeToggle.textContent = isLight ? '☀' : '☾';
      els.themeToggle.title = isLight ? 'Switch to dark theme' : 'Switch to light theme';
      const toastContainer = document.getElementById('ffu-toast-container');
      if (toastContainer) toastContainer.classList.toggle('ffu-light', isLight);
    }

    function renderBranchNames() {
      const branchSnapshot = store.get('domBranchSnapshot', {}) || {};
      const nameMap = getBranchNameMap();
      const ids = Object.keys(branchSnapshot);

      if (ids.length === 0) {
        els.branchNames.innerHTML = '<div class="ffu-hint">No Core branch icons read yet.</div>';
        return;
      }

      els.branchNames.innerHTML = '<div class="ffu-hint" style="margin-top:4px;">Detected branch names (hover each icon in-game to auto-fill):</div>' +
        ids.map((id) => {
          const info = branchSnapshot[id];
          const name = nameMap[id] || '(hover this icon in-game to detect)';
          return `<div class="ffu-row" style="margin-top:4px; justify-content: space-between;">
            <span>${name}</span>
            <span class="ffu-hint">x${info.level ?? '?'}</span>
          </div>`;
        }).join('');
    }

    function loadIntoForm() {
      const cfg = getConfig();
      els.mode.value = cfg.mode;
      els.apikey.value = cfg.apiKey;
      els.desktopNotify.checked = !!cfg.notifyDesktop;
      applyModeVisibility(cfg.mode);
      applyTheme(cfg.theme);
      renderBranchNames();
    }

    function setStatus(text) {
      els.status.textContent = text;
    }

    fab.addEventListener('click', () => {
      loadIntoForm();
      panel.classList.toggle('ffu-open');
    });
    els.close.addEventListener('click', () => panel.classList.remove('ffu-open'));

    els.mode.addEventListener('change', () => applyModeVisibility(els.mode.value));

    els.themeToggle.addEventListener('click', () => {
      const next = getConfig().theme === 'light' ? 'dark' : 'light';
      store.set('theme', next);
      applyTheme(next);
    });

    els.save.addEventListener('click', () => {
      store.set('mode', els.mode.value);
      store.set('apiKey', els.apikey.value.trim());
      store.set('notifyDesktop', els.desktopNotify.checked);
      toast('Settings saved.', 'info');
      setStatus('Settings saved.');
      activateMode();
    });

    els.domRescan.addEventListener('click', () => {
      runDomScan(true, setStatus);
      renderBranchNames();
    });
    els.domReset.addEventListener('click', () => {
      store.set('domSnapshot', {});
      store.set('domBranchSnapshot', {});
      store.set('branchNameMap', {});
      setStatus('Snapshot and detected names cleared. Browse branches again to rebuild.');
      toast('Snapshot cleared.', 'info');
      renderBranchNames();
    });

    els.apiCheck.addEventListener('click', async () => {
      setStatus('Checking...');
      try {
        await checkViaApi(true, setStatus);
      } catch (err) {
        setStatus(`Error: ${err.message}`);
        toast(err.message, 'error');
      }
    });
    els.apiReset.addEventListener('click', () => {
      store.set('apiSnapshot', null);
      setStatus('API snapshot cleared. Next check establishes a new baseline.');
      toast('Snapshot cleared.', 'info');
    });

    loadIntoForm();
    return { setStatus, refreshBranchNames: renderBranchNames };
  }

  // ---------- Mode activation ----------

  let panelApi = null;
  let apiPollTimer = null;
  const API_POLL_MINUTES = 10;

  function activateMode() {
    const { mode } = getConfig();

    if (apiPollTimer) {
      clearInterval(apiPollTimer);
      apiPollTimer = null;
    }
    if (domObserver) {
      domObserver.disconnect();
      domObserver = null;
    }

    if (mode === 'dom') {
      startDomWatcher();
    } else {
      checkViaApi(false, panelApi && panelApi.setStatus).catch((err) => {
        console.warn('[FactionUpgradeNotifier]', err.message);
      });
      apiPollTimer = setInterval(() => {
        checkViaApi(false, panelApi && panelApi.setStatus).catch((err) => {
          console.warn('[FactionUpgradeNotifier]', err.message);
        });
      }, API_POLL_MINUTES * 60 * 1000);
    }
  }

  // ---------- Boot ----------

  function init() {
    panelApi = buildPanel();
    attachBranchIconHoverCapture();

    GM_registerMenuCommand('Open Faction Upgrade Notifier panel', () => {
      document.getElementById('ffu-panel').classList.add('ffu-open');
    });

    activateMode();
  }

  init();
})();
