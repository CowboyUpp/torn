    function isDarkTheme() {
        if (settings.theme === 'dark') return true;
        if (settings.theme === 'light') return false;
        return !!(document.body && (
            document.body.classList.contains('dark-mode') ||
            document.documentElement.classList.contains('dark-mode') ||
            document.body.dataset.theme === 'dark'
        ));
    }

    function buildLedgerPanel(propertyId, opts) {
        opts = opts || {};
        const data = ledger[propertyId] || { total: 0, entries: [], name: '' };
        const live = data.live || propertyMeta[propertyId] || null;
        const st = computeStats(data);
        const limit = Math.max(1, Number(settings.entriesShown) || 15);
        const entries = (data.entries || []).slice(0, limit);
        const dark = isDarkTheme() ? ' dark' : '';
        const openClass = opts.startOpen ? ' open' : '';
        const displayName = data.name || (live && live.name) || ('Property #' + propertyId);

