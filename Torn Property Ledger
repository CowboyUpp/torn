    function exportCsv() {
        const headers = [
            'property_id', 'property_name', 'log_id', 'timestamp', 'date_iso',
            'income', 'days', 'cost_per_day', 'running_total',
            'tenant_id', 'tenant_name', 'type', 'type_label', 'log_title', 'category'
        ];
        const lines = [headers.join(',')];
        const esc = function (v) {
            const s = String(v ?? '');
            if (/[",\n]/.test(s)) return '"' + s.replace(/"/g, '""') + '"';
            return s;
        };
        Object.keys(ledger).forEach(function (pid) {
            const b = ledger[pid];
            (b.entries || []).forEach(function (e) {
                const iso = e.ts ? new Date(e.ts * 1000).toISOString() : '';
                lines.push([
                    pid, b.name || e.propertyName || '', e.id, e.ts, iso,
                    e.rent, e.days,
                    e.costPerDay != null ? Math.round(e.costPerDay * 100) / 100 : '',
                    e.runningTotal, e.renter, e.renterName, e.type, typeLabel(e.type), e.title, e.category
                ].map(esc).join(','));
            });
        });
        const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'torn-rental-ledger-' + new Date().toISOString().slice(0, 10) + '.csv';
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(function () { URL.revokeObjectURL(url); }, 2000);
    }

    function renderAllLedgers() {
        ensureStyles();
        document.querySelectorAll('.trl-ledger, #trl-portfolio').forEach(function (el) { el.remove(); });
        if (settings.showPortfolio) {
            const port = buildPortfolioPanel();
            const mount = document.getElementById('trl-chrome') ||
                document.querySelector('#properties-page-wrap .content-title') ||
                document.querySelector('.content-title');
            if (mount) mount.insertAdjacentElement('afterend', port);
            else document.body.prepend(port);
        }
        if (settings.showOnDetail && isPropertyDetailView()) {
            const pid = currentPropertyId();
            if (pid) injectDetailLedger(pid);
        }
        if (settings.showOnList && isYourPropertiesView()) {
            findPropertyRows().forEach(function (row) {
                if (row.el.querySelector('.trl-ledger')) return;
                const panel = buildLedgerPanel(row.propertyId, { startOpen: false });
                const anchor = row.el.querySelector('.title, .property-name, .info, h5, .header') || row.el;
                if (anchor.parentElement && anchor !== row.el) anchor.insertAdjacentElement('afterend', panel);
                else row.el.appendChild(panel);
            });
        }
    }

    function injectDetailLedger(propertyId) {
        if (document.querySelector('.trl-ledger[data-property-id="' + propertyId + '"]')) return;
        const panel = buildLedgerPanel(propertyId, { startOpen: true });
        const host = document.getElementById('trl-portfolio') ||
            document.getElementById('trl-chrome') ||
            document.querySelector('#properties-page-wrap .content-title') ||
            document.querySelector('.content-title') ||
            document.querySelector('.properties-page-wrap') ||
            document.body;
        host.insertAdjacentElement('afterend', panel);
    }

    let chromeEl = null;
    function ensureChrome() {
        ensureStyles();

        // Hub installed: never show property-page chrome / setup UI
        if (hubPresent()) {
            if (chromeEl && chromeEl.parentNode) chromeEl.remove();
            chromeEl = null;
            const stray = document.getElementById('trl-chrome');
            if (stray) stray.remove();
            return null;
        }

        if (chromeEl && document.contains(chromeEl)) {
            updateChromeStatus();
            return chromeEl;
        }
        chromeEl = document.createElement('div');
        chromeEl.id = 'trl-chrome';
        chromeEl.className = isDarkTheme() ? 'dark' : '';

        chromeEl.innerHTML =
            '<strong>Rental Ledger</strong>' +
            '<span class="trl-status"></span>' +
            '<button type="button" data-act="sync">Sync</button>' +
            '<button type="button" data-act="full">Full sync</button>' +
            '<button type="button" data-act="csv">CSV</button>' +
            '<button type="button" data-act="settings">Settings</button>' +
            '<div class="trl-settings" id="trl-settings">' +
            '<label>Custom API key <input type="password" id="trl-apikey" placeholder="16+ character Torn custom key" autocomplete="off" /></label>' +
            '<p class="trl-meta" style="margin:4px 0 8px">' +
            '<a class="trl-link" href="' + API_PREFS_URL + '" target="_blank" rel="noopener">Generate User / Log key</a>' +
            ' — opens Torn pre-filled for RentalLedger (User → Log + Properties). Create, then paste below.</p>' +
            '<label>Entries shown per property <input type="number" id="trl-entries" min="3" max="100" /></label>' +
            '<label><input type="checkbox" id="trl-autosync" /> Auto-sync when opening properties</label>' +
            '<label><input type="checkbox" id="trl-list" /> Show ledger on property list</label>' +
            '<label><input type="checkbox" id="trl-detail" /> Show ledger on property detail</label>' +
            '<label><input type="checkbox" id="trl-portfolio" /> Show portfolio summary</label>' +
            '<label><input type="checkbox" id="trl-raw" /> Show raw log data column</label>' +
            '<div style="margin-top:6px"><button type="button" data-act="save">Save</button></div>' +
            '<p class="trl-meta" style="margin-top:8px">Log types 5937 (new lease) + 5943 (extension). Data stays in your browser.</p>' +
            '</div>';

        chromeEl.addEventListener('click', function (ev) {
            const btn = ev.target.closest('[data-act]');
            if (!btn) return;
            const act = btn.getAttribute('data-act');
            if (act === 'sync') syncLogs(false);
            if (act === 'full') syncLogs(true);
            if (act === 'csv') exportCsv();
            if (act === 'settings') {
                chromeEl.querySelector('.trl-settings').classList.toggle('open');
                fillSettingsForm();
            }
            if (act === 'save') {
                const key = (chromeEl.querySelector('#trl-apikey').value || '').trim();
                if (key) settings.apiKey = key.slice(0, 64);
                const n = Number(chromeEl.querySelector('#trl-entries').value);
                if (Number.isFinite(n)) settings.entriesShown = Math.max(3, Math.min(100, Math.round(n)));
                settings.autoSync = !!chromeEl.querySelector('#trl-autosync').checked;
                settings.showOnList = !!chromeEl.querySelector('#trl-list').checked;
                settings.showOnDetail = !!chromeEl.querySelector('#trl-detail').checked;
                settings.showPortfolio = !!chromeEl.querySelector('#trl-portfolio').checked;
                settings.showRawData = !!chromeEl.querySelector('#trl-raw').checked;
                saveSettings();
                chromeEl.querySelector('.trl-settings').classList.remove('open');
                renderAllLedgers();
                if (settings.autoSync && settings.apiKey) syncLogs(false);
            }
        });

        const mount = document.querySelector('#properties-page-wrap .content-title') ||
            document.querySelector('.content-title') ||
            document.querySelector('.properties-page-wrap') ||
            document.querySelector('#mainContainer');
        if (mount) mount.insertAdjacentElement('afterend', chromeEl);
        else document.body.prepend(chromeEl);
        fillSettingsForm();
        updateChromeStatus();
        return chromeEl;
    }

    function fillSettingsForm() {
        if (!chromeEl || hubPresent()) return;
        const keyInput = chromeEl.querySelector('#trl-apikey');
        if (keyInput && document.activeElement !== keyInput) keyInput.value = settings.apiKey || '';
        const ent = chromeEl.querySelector('#trl-entries');
        if (ent) ent.value = settings.entriesShown;
        const map = {
            '#trl-autosync': 'autoSync', '#trl-list': 'showOnList',
            '#trl-detail': 'showOnDetail', '#trl-portfolio': 'showPortfolio', '#trl-raw': 'showRawData'
        };
        Object.keys(map).forEach(function (sel) {
            const el = chromeEl.querySelector(sel);
            if (el) el.checked = !!settings[map[sel]];
        });
    }

    function updateChromeStatus() {
        if (!chromeEl) return;
        chromeEl.classList.toggle('dark', isDarkTheme());
        const st = chromeEl.querySelector('.trl-status');
        if (!st) return;
        if (syncing) {
            st.textContent = 'Syncing… (' + lastSyncPages + ' pages, +' + lastSyncNew + ')';
            return;
        }
        if (lastError) {
            st.innerHTML = '<span class="trl-err">' + escapeHtml(lastError) + '</span>';
            return;
        }
        const port = portfolioStats();
        const when = lastSyncTs ? fmtDate(lastSyncTs) : 'never';
        st.textContent = port.properties + ' props · ' + port.events + ' events · ' +
            fmtMoney(port.total) + ' · sync ' + when;
    }

    function registerWithHub() {
        const registration = {
            id: HUB_ID,
            name: HUB_NAME,
            version: VERSION,
            order: 320,
            open: function () {
                if (!/properties\.php/i.test(location.pathname)) {
                    location.href = 'https://www.torn.com/properties.php#/p=yourProperties';
                    return;
                }
                ensureChrome(); // keeps page clean under Hub
                const el = document.getElementById('trl-portfolio') || document.querySelector('.trl-ledger');
                if (el) el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            },
            close: function () {},
            status: function () {
                const port = portfolioStats();
                if (!port.properties) return 'No rental history yet';
                return port.properties + ' props · ' + fmtMoney(port.total);
            },
            prefs: {
                fields: [
                    {
                        key: 'apiKey', type: 'password', label: 'Custom API key',
                        default: '', placeholder: '16+ character Torn custom key',
                        hint: 'User / Log (+ Properties). Use Generate below to pre-fill Torn’s key creator.'
                    },
                    {
                        key: 'generateKey', type: 'button',
                        label: 'Generate User / Log key',
                        url: API_PREFS_URL,
                        hint: 'Opens Torn API key page pre-filled for RentalLedger (User → Log + Properties). Create the key, then paste it above.'
                    },
                    {
                        key: 'syncNow', type: 'button', label: 'Sync rental logs now',
                        hint: 'Pull latest lease/extension events from your activity log',
                        onClick: function () { syncLogs(false); }
                    },
                    {
                        key: 'fullSync', type: 'button', label: 'Full history sync',
                        hint: 'Walk farther back through activity log pages',
                        onClick: function () { syncLogs(true); }
                    },
                    {
                        key: 'entriesShown', type: 'number', label: 'Entries shown per property',
                        default: 15, min: 3, max: 100
                    },
                    { key: 'autoSync', type: 'toggle', label: 'Auto-sync on properties page', default: true },
                    { key: 'showOnList', type: 'toggle', label: 'Show ledger on property list', default: true },
                    { key: 'showOnDetail', type: 'toggle', label: 'Show ledger on property detail', default: true },
                    { key: 'showPortfolio', type: 'toggle', label: 'Show portfolio summary', default: true },
                    { key: 'showRawData', type: 'toggle', label: 'Show raw log data column', default: false }
                ],
                values: {
                    apiKey: settings.apiKey || '',
                    entriesShown: settings.entriesShown,
                    autoSync: settings.autoSync,
                    showOnList: settings.showOnList,
                    showOnDetail: settings.showOnDetail,
                    showPortfolio: settings.showPortfolio,
                    showRawData: settings.showRawData
                },
                onSave: function (values) {
                    if (!values || typeof values !== 'object') return;
                    if (typeof values.apiKey === 'string') {
                        const t = values.apiKey.trim();
                        if (t) settings.apiKey = t.slice(0, 64);
                        else if (!settings.apiKey) settings.apiKey = '';
                    }
                    if (values.entriesShown != null && values.entriesShown !== '') {
                        const n = Number(values.entriesShown);
                        if (Number.isFinite(n)) settings.entriesShown = Math.max(3, Math.min(100, Math.round(n)));
                    }
                    ['autoSync', 'showOnList', 'showOnDetail', 'showPortfolio', 'showRawData'].forEach(function (k) {
                        if (typeof values[k] === 'boolean') settings[k] = values[k];
                    });
                    saveSettings();
                    try {
                        values.apiKey = settings.apiKey || '';
                        values.entriesShown = settings.entriesShown;
                        values.autoSync = settings.autoSync;
                        values.showOnList = settings.showOnList;
                        values.showOnDetail = settings.showOnDetail;
                        values.showPortfolio = settings.showPortfolio;
                        values.showRawData = settings.showRawData;
                    } catch (_) {}
                    renderAllLedgers();
                    if (settings.autoSync && settings.apiKey) syncLogs(false);
                }
            }
        };
        document.dispatchEvent(new CustomEvent('torn-script-hub:register', { detail: registration }));
        (window[QUEUE_PROPERTY] = window[QUEUE_PROPERTY] || []).push(registration);
    }

    let bootTimer = null;
    function scheduleBoot() {
        clearTimeout(bootTimer);
        bootTimer = setTimeout(boot, 400);
    }
    function boot() {
        if (!/properties\.php/i.test(location.pathname)) return;
        ensureStyles();
        ensureChrome(); // removes chrome when Hub is present
        renderAllLedgers();
        if (settings.autoSync && settings.apiKey) syncLogs(false);
    }

    window.addEventListener('hashchange', scheduleBoot);
    const mo = new MutationObserver(function () {
        if (hubPresent()) {
            // Strip any chrome that slipped in
            const stray = document.getElementById('trl-chrome');
            if (stray) stray.remove();
            if (settings.showOnList && isYourPropertiesView()) {
                const rows = findPropertyRows();
                if (rows.some(function (r) { return !r.el.querySelector('.trl-ledger'); })) renderAllLedgers();
            }
            return;
        }
        if (!document.getElementById('trl-chrome')) scheduleBoot();
        else if (settings.showOnList && isYourPropertiesView()) {
            const rows = findPropertyRows();
            if (rows.some(function (r) { return !r.el.querySelector('.trl-ledger'); })) renderAllLedgers();
        }
    });
    mo.observe(document.documentElement, { childList: true, subtree: true });

    registerWithHub();
    document.addEventListener('torn-script-hub:ready', registerWithHub);

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', scheduleBoot);
    else scheduleBoot();

    setInterval(function () {
        if (!/properties\.php/i.test(location.pathname)) return;
        updateChromeStatus();
    }, POLL_MS);

    console.log('[TRL] Torn Rental Ledger ' + VERSION + ' loaded (hub=' + hubPresent() + ')');
})();
