            '<span>First: <b>' + fmtDateShort(st.firstTs) + '</b></span>' +
            '<span>Last: <b>' + fmtDateShort(st.lastTs) + '</b></span>' +
            '</div>' : '';

        if (!entries.length) {
            body.innerHTML = liveHtml + '<div class="trl-empty">No recorded leases yet for this property. ' +
                (hubPresent()
