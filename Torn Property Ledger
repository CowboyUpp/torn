            '<span>High / Low: <b>' + fmtMoney(st.highRent) + '</b> / <b>' + fmtMoney(st.lowRent) + '</b></span>' +
            '<span>Avg days: <b>' + (st.avgDays ? st.avgDays.toFixed(1) : '—') + '</b></span>' +
            '<span>Total days leased: <b>' + fmtNum(st.totalDays) + '</b></span>' +
            '<span>Avg $/day: <b>' + (st.avgPerDay ? fmtMoney(Math.round(st.avgPerDay)) : '—') + '</b></span>' +
