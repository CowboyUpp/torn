                    : 'Generate a User / Log key and Sync to pull activity log history (5937 new lease, 5943 extension).') +
                '</div>';
        } else {
            const showRaw = !!settings.showRawData;
            const rows = entries.map(function (e) {
                const perDay = e.costPerDay != null
                    ? fmtMoney(Math.round(e.costPerDay))
                    : (e.days > 0 ? fmtMoney(Math.round(e.rent / e.days)) : '—');
                return '<tr>' +
                    '<td>' + fmtDate(e.ts) + '</td>' +
                    '<td class="trl-rent">' + fmtMoney(e.rent) + '</td>' +
                    '<td>' + (e.days ? e.days + 'd' : '—') + '</td>' +
                    '<td>' + perDay + '</td>' +
                    '<td>' + tenantLink(e.renter, e.renterName) + '</td>' +
                    '<td class="trl-hide-sm">' + (e.renter ? escapeHtml(e.renter) : '—') + '</td>' +
                    '<td>' + escapeHtml(typeLabel(e.type)) + '</td>' +
                    '<td class="trl-hide-sm">' + escapeHtml(e.title || '') + '</td>' +
                    '<td class="trl-run">' + fmtMoney(e.runningTotal) + '</td>' +
                    '<td class="trl-hide-sm">' + escapeHtml(e.propertyName || data.name || '') + '</td>' +
                    '<td class="trl-hide-sm">' + escapeHtml(String(e.id)) + '</td>' +
                    (showRaw ? '<td class="trl-raw trl-hide-sm" title="' + escapeHtml(JSON.stringify(e.raw || {})) + '">' +
                        escapeHtml(JSON.stringify(e.raw || {})) + '</td>' : '') +
                    '</tr>';
            }).join('');
            body.innerHTML = liveHtml + statsHtml +
                '<table class="trl-table"><thead><tr>' +
                '<th>When</th><th>Income</th><th>Days</th><th>$/day</th><th>Tenant</th>' +
                '<th class="trl-hide-sm">Tenant ID</th><th>Type</th><th class="trl-hide-sm">Log title</th>' +
                '<th>Running total</th><th class="trl-hide-sm">Property name</th><th class="trl-hide-sm">Log ID</th>' +
                (showRaw ? '<th class="trl-hide-sm">Raw data</th>' : '') +
                '</tr></thead><tbody>' + rows + '</tbody></table>' +
                (st.count > limit
                    ? '<div class="trl-meta" style="margin-top:6px">Showing ' + limit + ' of ' + st.count +
                      '. Raise “Entries shown” in ' + (hubPresent() ? 'Script Hub settings' : 'settings') + ' for more.</div>'
                    : '');
        }
        wrap.appendChild(head);
        wrap.appendChild(body);
        return wrap;
    }

