(function () {
    'use strict';

    const VERSION = '1.2.2';
    // v1.2.2 — Pre-filled custom API key URL like other Hub scripts
    // (preferences.php#tab=api?step=addNewKey&title=RentalLedger&user=log&user=properties).
    // v1.2.1 — When Hub is present: hide ALL property-page chrome (no Sync/Settings bar).
    // Dynamic hub detection; Hub prefs only for key + sync. Clearer API key setup link.
    // v1.2.0 — Hub-first settings: when Script Hub is present, all prefs live in Hub only
    // (no in-page settings panel). API prefs button → preferences.php#tab=api.
    // v1.1.0 — Expanded columns/stats, portfolio, CSV, live status.
    // v1.0.0 — Initial log-based ledger (5937 / 5943).

    const STORE_PREFIX = 'trl_';
    const LOG_TYPES = '5937,5943';
    const LOG_PAGE_SIZE = 100;
    const MAX_PAGES_PER_SYNC = 40;
    const POLL_MS = 2500;
    const HUB_ID = 'torn-rental-ledger';
    const HUB_NAME = 'Torn Rental Ledger';
    const QUEUE_PROPERTY = '__tornScriptHubQueue';
    const API_PREFS_URL = 'https://www.torn.com/preferences.php#tab=api?step=addNewKey&title=RentalLedger&user=log&user=properties';
    // Same pattern as Bustr+ / Crime Chain / Travel Inventory — opens Torn key creator pre-filled.


    function isHubPresent() {
        try {
            const q = window[QUEUE_PROPERTY];
            if (q && q.__tshPatched) return true;
        } catch (_) {}
        // Fallback: registry event already fired / Hub dashboard exists
        try {
            if (document.getElementById('tsh-sidebar-row') || document.getElementById('tsh-dashboard')) return true;
        } catch (_) {}
        return false;
    }
    // Live check — never cache at load (Hub may patch before or after this script)
    function hubPresent() { return isHubPresent(); }

    const DEFAULT_SETTINGS = {
        apiKey: '',
        autoSync: true,
        entriesShown: 15,
        theme: 'auto',
        showOnList: true,
        showOnDetail: true,
        showPortfolio: true,
        showRawData: false
    };

    const STORE = {
        get(key, fallback) {
            try {
                if (typeof GM_getValue === 'function') {
                    const v = GM_getValue(STORE_PREFIX + key, undefined);
                    if (v !== undefined) return v;
                }
            } catch (_) {}
            try {
                const raw = localStorage.getItem(STORE_PREFIX + key);
                if (raw !== null) return JSON.parse(raw);
            } catch (_) {}
            return fallback;
        },
        set(key, value) {
            try {
                if (typeof GM_setValue === 'function') GM_setValue(STORE_PREFIX + key, value);
            } catch (_) {}
            try {
                localStorage.setItem(STORE_PREFIX + key, JSON.stringify(value));
            } catch (_) {}
        }
    };

    let settings = Object.assign({}, DEFAULT_SETTINGS, STORE.get('settings', {}));
    let ledger = STORE.get('ledger', {}) || {};
    let lastSyncTs = STORE.get('lastSyncTs', 0) || 0;
    let propertyMeta = STORE.get('propertyMeta', {}) || {};
    let syncing = false;
    let lastError = '';
    let lastSyncPages = 0;
    let lastSyncNew = 0;

    function saveSettings() { STORE.set('settings', settings); }
    function saveLedger() {
        STORE.set('ledger', ledger);
        STORE.set('lastSyncTs', lastSyncTs);
        STORE.set('propertyMeta', propertyMeta);
    }

    function fmtMoney(n) {
        const x = Math.round(Number(n) || 0);
        return '$' + x.toLocaleString('en-US');
    }
    function fmtNum(n) {
        if (n == null || n === '' || Number.isNaN(Number(n))) return '—';
        return Number(n).toLocaleString('en-US');
    }
    function fmtDate(ts) {
        if (!ts) return '—';
        const d = new Date(ts * 1000);
        return d.toLocaleString(undefined, {
            year: 'numeric', month: 'short', day: 'numeric',
            hour: '2-digit', minute: '2-digit'
        });
    }
    function fmtDateShort(ts) {
        if (!ts) return '—';
        const d = new Date(ts * 1000);
        return d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
    }
    function typeLabel(logType) {
        if (Number(logType) === 5943) return 'Extension';
        if (Number(logType) === 5937) return 'New lease';
        return 'Rental';
    }
    function escapeHtml(s) {
        return String(s ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }
    function tenantLink(id, name) {
        if (!id) return escapeHtml(name || '—');
        const label = name ? escapeHtml(name) : ('#' + id);
        return '<a class="t-blue h" href="/profiles.php?XID=' + encodeURIComponent(id) + '" target="_blank" rel="noopener">' + label + '</a>';
    }

    function computeStats(bucket) {
        const entries = bucket.entries || [];
        const rents = entries.map((e) => Number(e.rent) || 0);
        const days = entries.map((e) => Number(e.days) || 0).filter((d) => d > 0);
        const perDay = entries
            .map((e) => (e.days > 0 ? e.rent / e.days : null))
            .filter((x) => x != null && Number.isFinite(x));
        const tenants = new Set();
        let newCount = 0;
        let extCount = 0;
        entries.forEach((e) => {
            if (e.renter) tenants.add(String(e.renter));
            if (Number(e.type) === 5937) newCount++;
            else if (Number(e.type) === 5943) extCount++;
        });
        const sortedTs = entries.map((e) => e.ts).filter(Boolean).sort((a, b) => a - b);
        return {
            count: entries.length,
            total: rents.reduce((s, n) => s + n, 0),
            avgRent: rents.length ? rents.reduce((s, n) => s + n, 0) / rents.length : 0,
            highRent: rents.length ? Math.max(...rents) : 0,
            lowRent: rents.length ? Math.min(...rents) : 0,
            totalDays: days.reduce((s, n) => s + n, 0),
            avgDays: days.length ? days.reduce((s, n) => s + n, 0) / days.length : 0,
            avgPerDay: perDay.length ? perDay.reduce((s, n) => s + n, 0) / perDay.length : 0,
            uniqueTenants: tenants.size,
            newLeases: newCount,
            extensions: extCount,
            firstTs: sortedTs[0] || 0,
            lastTs: sortedTs[sortedTs.length - 1] || 0
        };
    }

    function portfolioStats() {
        const ids = Object.keys(ledger);
        let total = 0, events = 0, totalDays = 0;
        const tenants = new Set();
        ids.forEach((id) => {
            const st = computeStats(ledger[id] || {});
            total += st.total;
            events += st.count;
            totalDays += st.totalDays;
            (ledger[id].entries || []).forEach((e) => {
                if (e.renter) tenants.add(String(e.renter));
            });
        });
        return { properties: ids.length, total, events, uniqueTenants: tenants.size, totalDays };
    }

    function apiGet(path) {
        return new Promise((resolve, reject) => {
            const key = (settings.apiKey || '').trim();
            if (!key || key.length < 16) {
                reject(new Error(hubPresent()
                    ? 'Custom API key required — set it in Script Hub → Settings → Torn Rental Ledger (Generate User / Log key).'
                    : 'Custom API key required (Settings → Generate User / Log key).'));
                return;
            }
            const url = 'https://api.torn.com' + path + (path.includes('?') ? '&' : '?') + 'key=' + encodeURIComponent(key) + '&comment=TornRentalLedger';
            const doXhr = typeof GM_xmlhttpRequest === 'function' ? GM_xmlhttpRequest : null;
            if (doXhr) {
                doXhr({
                    method: 'GET',
                    url,
                    onload: (res) => {
                        try {
                            const data = JSON.parse(res.responseText);
                            if (data.error) reject(new Error(data.error.error || JSON.stringify(data.error)));
                            else resolve(data);
                        } catch (e) { reject(e); }
                    },
                    onerror: (e) => reject(e || new Error('Network error'))
                });
            } else {
                fetch(url).then((r) => r.json()).then((data) => {
                    if (data.error) reject(new Error(data.error.error || JSON.stringify(data.error)));
                    else resolve(data);
                }).catch(reject);
            }
        });
    }

    function pickFirst(obj, keys) {
        for (const k of keys) {
            if (obj[k] != null && obj[k] !== '') return obj[k];
        }
        return null;
    }

    async function syncLogs(full = false) {
        if (syncing) return;
        syncing = true;
        lastError = '';
        lastSyncPages = 0;
        lastSyncNew = 0;
        updateChromeStatus();
        try {
            let pages = 0;
            let newestTs = lastSyncTs;
            let toParam = null;
            while (pages < MAX_PAGES_PER_SYNC) {
                let path = '/user/?selections=log&log=' + LOG_TYPES;
                if (toParam) path += '&to=' + toParam;
                const data = await apiGet(path);
                const logs = data.log || {};
                const ids = Object.keys(logs);
                if (!ids.length) break;
                let pageMinTs = Infinity;
                for (const id of ids) {
                    const entry = logs[id];
                    const ts = Number(entry.timestamp) || 0;
                    if (ts > newestTs) newestTs = ts;
                    if (ts < pageMinTs) pageMinTs = ts;
                    const d = entry.data || {};
                    const propId = String(pickFirst(d, ['property_id', 'property', 'propertyId', 'id']) ?? '');
                    if (!propId) continue;
                    const rent = Number(pickFirst(d, ['rent', 'cost', 'money', 'amount', 'price']) ?? 0) || 0;
                    const days = Number(pickFirst(d, ['days', 'rental_period', 'period', 'duration']) ?? 0) || 0;
                    const renter = String(pickFirst(d, ['renter', 'renter_id', 'user', 'user_id', 'player_id', 'tenant']) ?? '');
                    const renterName = pickFirst(d, ['renter_name', 'name', 'playername', 'player_name', 'username', 'tenant_name']) || '';
                    const propName = pickFirst(d, ['property_name', 'propertyname', 'property_type', 'type_name']) || '';
                    if (!ledger[propId]) ledger[propId] = { total: 0, entries: [], name: propName || '' };
                    const bucket = ledger[propId];
                    if (bucket.entries.some((e) => e.id === id)) continue;
                    const costPerDay = days > 0 ? rent / days : null;
                    bucket.entries.push({
                        id, ts, rent, days, costPerDay, renter, renterName,
                        type: entry.log,
                        title: entry.title || typeLabel(entry.log),
                        category: entry.category || '',
                        propertyName: propName,
                        raw: d
                    });
                    lastSyncNew++;
                    if (propName && !bucket.name) bucket.name = propName;
                }
                pages++;
                lastSyncPages = pages;
                if (!full && lastSyncTs > 0 && pageMinTs <= lastSyncTs) break;
                toParam = pageMinTs - 1;
                if (ids.length < LOG_PAGE_SIZE) break;
            }
            for (const pid of Object.keys(ledger)) {
                ledger[pid].entries.sort((a, b) => b.ts - a.ts);
                const chrono = [...ledger[pid].entries].sort((a, b) => a.ts - b.ts);
                let run = 0;
                const runMap = {};
                chrono.forEach((e) => { run += Number(e.rent) || 0; runMap[e.id] = run; });
                ledger[pid].entries.forEach((e) => { e.runningTotal = runMap[e.id] || 0; });
                ledger[pid].total = run;
            }
            lastSyncTs = Math.max(lastSyncTs, newestTs);
            saveLedger();
            await enrichFromProperties();
        } catch (e) {
            lastError = (e && e.message) ? e.message : String(e);
            console.warn('[TRL]', lastError);
        } finally {
            syncing = false;
            updateChromeStatus();
            renderAllLedgers();
        }
    }

    async function enrichFromProperties() {
        try {
            let props = {};
            try {
                const data = await apiGet('/user/?selections=properties');
                props = data.properties || {};
            } catch (_) {
                try {
                    const data = await apiGet('/v2/user/properties?filters=ownedByUser');
                    if (Array.isArray(data.properties)) {
                        data.properties.forEach((p) => { if (p && p.id != null) props[p.id] = p; });
                    } else {
                        props = data.properties || data || {};
                    }
                } catch (__) {}
            }
            for (const [id, p] of Object.entries(props)) {
                const pid = String(id);
                const propertyObj = p.property || p;
                const name = (propertyObj && propertyObj.name) || p.name ||
                    (propertyObj && propertyObj.property && propertyObj.property.name) || '';
                const status = p.status || propertyObj.status || '';
                const costPerDay = Number(p.cost_per_day ?? propertyObj.cost_per_day ?? p.costPerDay ?? 0) || 0;
                const period = Number(p.rental_period ?? propertyObj.rental_period ?? 0) || 0;
                const remaining = Number(p.rental_period_remaining ?? propertyObj.rental_period_remaining ?? 0) || 0;
                const happy = Number(p.happy ?? propertyObj.happy ?? (propertyObj.upgrades && propertyObj.upgrades.happy) ?? 0) || 0;
                const upkeep = Number(p.upkeep ?? propertyObj.upkeep ?? p.cost ?? 0) || 0;
                const typeName = (propertyObj && propertyObj.name) || (p.property && p.property.name) || name || '';
                let renterId = '', renterName = '';
                const rented = p.rented || p.rented_by || propertyObj.rented_by;
                if (rented) {
                    if (typeof rented === 'object') {
                        renterId = String(rented.id || rented.user_id || rented.player_id || '');
                        renterName = rented.name || rented.playername || '';
                    } else renterId = String(rented);
                }
                const usedBy = p.used_by || propertyObj.used_by;
                if (!renterId && Array.isArray(usedBy) && usedBy.length) {
                    const u = usedBy[0];
                    renterId = String(u.id || u.user_id || '');
                    renterName = u.name || '';
                }
                propertyMeta[pid] = {
                    status, costPerDay, period, remaining, renterId, renterName,
                    happy, upkeep, typeName, name: name || typeName, rawStatus: status
                };
                if (!ledger[pid]) ledger[pid] = { total: 0, entries: [], name: name || typeName };
                else if (name || typeName) ledger[pid].name = name || typeName || ledger[pid].name;
                ledger[pid].live = propertyMeta[pid];
            }
            saveLedger();
        } catch (e) {
            console.warn('[TRL] enrichFromProperties', e);
        }
    }

    function getHashParams() {
        const h = location.hash || '';
        const out = {};
        h.replace(/([^=&#]+)=([^&#]*)/g, (_, k, v) => {
            out[decodeURIComponent(k)] = decodeURIComponent(v);
            return '';
        });
        return out;
    }
    function isYourPropertiesView() {
        const h = location.hash || '';
        return !h || h.includes('p=yourProperties') || h === '#' || h === '#/';
    }
    function isPropertyDetailView() {
        const p = getHashParams();
        return !!(p.ID || p.id);
    }
    function currentPropertyId() {
        const p = getHashParams();
        return p.ID || p.id || null;
    }

    function findPropertyRows() {
        const results = [];
        const seen = new Set();
        const candidates = document.querySelectorAll([
            'ul.properties-list > li', 'ul.your-properties > li', '.properties-list > li',
            '[class*="property"][data-id]', '.property-info-wrap',
            '.properties-page-wrap li[id]', 'li[id^="property"]', '.cont-gray[id]'
        ].join(','));
        candidates.forEach((el) => {
            if (el.closest('.trl-ledger') || el.closest('#trl-chrome') || el.closest('#trl-portfolio')) return;
            let id = el.getAttribute('data-id') || el.getAttribute('data-property-id') ||
                (el.id && el.id.replace(/\D/g, '')) || null;
            if (!id) {
                const a = el.querySelector('a[href*="ID="], a[href*="p=options"]');
                if (a) {
                    const m = (a.getAttribute('href') || '').match(/ID=(\d+)/i);
                    if (m) id = m[1];
                }
            }
            if (!id) {
                const a = el.querySelector('a[href*="#"]');
                if (a) {
                    const m = (a.getAttribute('href') || '').match(/ID=(\d+)/i);
                    if (m) id = m[1];
                }
            }
            if (!id || seen.has(id)) return;
            seen.add(id);
            results.push({ el, propertyId: String(id) });
        });
        if (!results.length) {
            document.querySelectorAll('a[href*="ID="]').forEach((a) => {
                const m = (a.getAttribute('href') || '').match(/ID=(\d+)/i);
                if (!m) return;
                const id = m[1];
                if (seen.has(id)) return;
                const row = a.closest('li, .property, .cont-gray, tr, .info-cont') || a.parentElement;
                if (!row || row.closest('.trl-ledger') || row.closest('#trl-chrome')) return;
                seen.add(id);
                results.push({ el: row, propertyId: String(id) });
            });
        }
        return results;
    }

