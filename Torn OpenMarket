    }

    // =========================================================================
    // BONUS SORTING FEATURE
    // =========================================================================
    const sortState = { active: false, ascending: true, sortTimeout: null };

    function extractMaxBonusFromTile(tile) {
        const bonusContainer = tile.querySelector('.openmarket-bonuses');
        if (!bonusContainer) return -1;
        let maxBonus = -1;
        bonusContainer.querySelectorAll('div').forEach(div => {
            const match = div.textContent.match(/(\d+(?:\.\d+)?)\s*%?/);
            if (match) { const val = parseFloat(match[1]); if (val > maxBonus) maxBonus = val; }
        });
        return maxBonus;
    }

    function applyBonusSort() {
        const root = document.querySelector('#item-market-root');
        if (!root) return;

        const firstTile = root.querySelector('[class*="itemTile___"]');
        if (!firstTile) return;

        const listItem = firstTile.parentElement;
        const container = listItem?.parentElement;
        if (!container) return;

        const display = getComputedStyle(container).display;
        if (display !== 'grid' && display !== 'flex') {
            container.style.display = 'grid';
        }

        const listItems = Array.from(container.children).filter(el => el.tagName === 'LI' && el.querySelector('[class*="itemTile___"]'));
        const itemOrders = listItems.map(li => {
            const tile = li.querySelector('[class*="itemTile___"]');
            const bonus = tile ? extractMaxBonusFromTile(tile) : -1;
            return { li, bonus };
        });

        if (sortState.active) {
            itemOrders.sort((a, b) => {
                if (a.bonus === -1 && b.bonus === -1) return 0;
                if (a.bonus === -1) return 1;
                if (b.bonus === -1) return -1;
                return sortState.ascending ? a.bonus - b.bonus : b.bonus - a.bonus;
            });
        }

        itemOrders.forEach((item, index) => {
            item.li.style.order = sortState.active ? index : '';
        });
    }

    function resetBonusSort() {
        sortState.active = false;
        clearTimeout(sortState.sortTimeout);
        const listItems = document.querySelectorAll('#item-market-root [class*="itemTile___"]');
        listItems.forEach(tile => {
            if (tile.parentElement && tile.parentElement.tagName === 'LI') {
                tile.parentElement.style.order = '';
            }
        });
    }

    // =========================================================================
    // NATIVE DROPDOWN INTEGRATION
    // =========================================================================
    let dropdownObserver = null;

    function injectIntoSortDropdown() {
        if (!CONFIG.enableItemMarket) return;

        const dropdownMenus = document.querySelectorAll('[role="listbox"]');
        for (const menu of dropdownMenus) {
            const text = menu.textContent.toLowerCase();
            if (!text.includes('price') && !text.includes('quality') && !text.includes('damage') && !text.includes('accuracy')) {
                continue;
            }

            if (menu.querySelector('[data-om-bonus-injected]')) continue;

            const items = Array.from(menu.children);
            const isPDA = !items[0].textContent.toLowerCase().includes('sort by');
            const prefix = isPDA ? '' : 'Sort by: ';

            const createBonusItem = (text, direction) => {
                const item = document.createElement('li');
                item.tabIndex = 0;
                item.setAttribute('role', 'option');
                item.id = `option-om-bonus-${direction}`;
                item.dataset.testid = `option-om-bonus-${direction}`;
                item.dataset.omBonusInjected = 'true';
                item.className = 'item t-overflow';
                item.style.cursor = 'pointer';
                item.textContent = `${prefix}${text}`;

                const handleInteraction = (e) => {
                    e.preventDefault();
                    e.stopPropagation();

                    sortState.active = true;
                    sortState.ascending = direction === 'asc';
                    applyBonusSort();

                    const allTogglers = document.querySelectorAll('button[data-testid="dropdown-toggler"]');
                    const toggler = Array.from(allTogglers).find(btn =>
                        btn.textContent.includes('Sort by') || /ascending|descending/i.test(btn.textContent)
                    ) || allTogglers[0];

                    if (toggler) {
                        toggler.textContent = `${prefix}Bonus ${direction === 'asc' ? 'ascending' : 'descending'}`;

                        // FIXED: Synchronously close the dropdown if it's open, avoiding blur() race conditions
                        // that cause React to close it and then the delayed click reopens it.
                        if (toggler.getAttribute('aria-expanded') === 'true') {
                            toggler.click();
                        }
                    }
                };

                item.addEventListener('click', handleInteraction);
                return item;
            };

            const ascItem = createBonusItem('Bonus ascending', 'asc');
            const descItem = createBonusItem('Bonus descending', 'desc');

            menu.appendChild(ascItem);
            menu.appendChild(descItem);
            break;
        }
    }

    function monitorDropdown() {
        if (dropdownObserver) dropdownObserver.disconnect();

        dropdownObserver = new MutationObserver(() => {
            const openDropdown = document.querySelector('button[aria-expanded="true"]');
            const hasOpenMenu = document.querySelector('[role="listbox"]');

            if (openDropdown || hasOpenMenu) {
                setTimeout(() => {
                    injectIntoSortDropdown();
                }, 100);
            }
        });

        dropdownObserver.observe(document.body, {
            childList: true,
            subtree: true,
            attributes: true,
            attributeFilter: ['aria-expanded']
        });
    }

    function initDropdownIntegration() {
        monitorDropdown();
    }

