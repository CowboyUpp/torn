                onSave: (values) => {
                    CONFIG.enableItemMarket = !!values.enableItemMarket;
                    CONFIG.enableAuctionHouse = !!values.enableAuctionHouse;
                    CONFIG.enableBazaar = !!values.enableBazaar;
                    CONFIG.enableDisplayCase = !!values.enableDisplayCase;
                    CONFIG.showDisplayCaseBonuses = !!values.showDisplayCaseBonuses;
                    CONFIG.enableInventory = !!values.enableInventory;
                    CONFIG.debug = !!values.debug;
                    activateHandlerForCurrentUrl();
                }
            }
        };

        document.dispatchEvent(new CustomEvent('torn-script-hub:register', { detail }));
        if (typeof window !== 'undefined') {
            const q = window.__tornScriptHubQueue || (window.__tornScriptHubQueue = []);
            q.push(detail);
        }
    }

    document.addEventListener('torn-script-hub:ready', registerWithHub, { once: true });
