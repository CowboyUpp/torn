    function detectPageType(href) {
        if (href.includes('sid=ItemMarket')) return 'itemMarket';
        if (href.includes('amarket.php')) return 'auctionHouse';
        if (href.includes('bazaar.php')) return 'bazaar';
        if (href.includes('displaycase.php')) return 'displayCase';
        if (href.includes('item.php')) return 'inventory';
        return null;
    }
    function teardownCurrentHandler() {
        if (!currentHandler) return;
        if (typeof currentHandler.teardown === 'function') currentHandler.teardown();
        else ['observer', 'outerObserver', 'innerObserver'].forEach(key => { if (currentHandler[key]) { currentHandler[key].disconnect(); currentHandler[key] = null; } });
        if (currentHandler.pendingTimeoutId) { clearTimeout(currentHandler.pendingTimeoutId); currentHandler.pendingTimeoutId = null; }

        resetBonusSort();
    }
    function activateHandlerForCurrentUrl() {
        const type = detectPageType(window.location.href);
        const handlers = { itemMarket, auctionHouse, bazaar, displayCase, inventory };
        const enabledMap = { itemMarket: CONFIG.enableItemMarket, auctionHouse: CONFIG.enableAuctionHouse, bazaar: CONFIG.enableBazaar, displayCase: CONFIG.enableDisplayCase, inventory: CONFIG.enableInventory };
        if (!type || !enabledMap[type]) { teardownCurrentHandler(); currentHandler = null; return; }
        const nextHandler = handlers[type];
        if (currentHandler === nextHandler) {
            nextHandler.processAll();
            return;
        }
        teardownCurrentHandler(); currentHandler = nextHandler; nextHandler.init();
    }
    function setupRouteWatcher() {
        const originalPushState = history.pushState;
        const originalReplaceState = history.replaceState;
        history.pushState = function (...args) { const result = originalPushState.apply(this, args); window.dispatchEvent(new Event('openmarket-locationchange')); return result; };
        history.replaceState = function (...args) { const result = originalReplaceState.apply(this, args); window.dispatchEvent(new Event('openmarket-locationchange')); return result; };
        ['popstate', 'hashchange', 'openmarket-locationchange'].forEach(evt => { window.addEventListener(evt, () => activateHandlerForCurrentUrl()); });
    }

    function interceptFetchAndXHR() {
        let lastNativeSortKey = null;

        const checkAndResetSort = (url) => {
            const checkStr = (url || '') + ' ' + (window.location.href || '');
            if (checkStr.includes('sortField') || checkStr.includes('sortOrder')) {
                const fieldMatch = checkStr.match(/sortField=([^&\s]*)/);
                const orderMatch = checkStr.match(/sortOrder=([^&\s]*)/);
                const key = (fieldMatch ? fieldMatch[1] : '') + '|' + (orderMatch ? orderMatch[1] : '');

                if (key && key !== lastNativeSortKey) {
                    lastNativeSortKey = key;
                    if (sortState.active) {
                        resetBonusSort();
                    }
                }
            }
        };

        const originalFetch = window.fetch;
        window.fetch = async (...args) => {
            const response = await originalFetch(...args);
            const url = args[0] instanceof Request ? args[0].url : String(args[0]);

            checkAndResetSort(url);

            if (url.includes('sid=iMarket')) {
                response.clone().json().then(data => {
                    if (!data?.items?.length) return;
                    const existingIds = new Set(itemMarket.cache.map(i => i.listingID));
                    const newItems = data.items.filter(item => !existingIds.has(item.listingID));
                    if (newItems.length > 0) { itemMarket.pushCache(newItems); if (isPageActive()) itemMarket.processAll(); }
                }).catch(err => {
                    if (!fetchParseWarned) {
                        console.warn('[OpenMarket] Fetch blocked. Falling back to DOM reading.');
                        fetchParseWarned = true;
                    }
                });
            }
            return response;
        };

        const originalXHROpen = XMLHttpRequest.prototype.open;
        XMLHttpRequest.prototype.open = function(method, url) {
            if (typeof url === 'string' && url.includes('sid=iMarket')) {
                this.addEventListener('load', function() {
                    checkAndResetSort(url);
                    try {
                        const data = JSON.parse(this.responseText);
                        if (data?.items?.length) {
                            const existingIds = new Set(itemMarket.cache.map(i => i.listingID));
                            const newItems = data.items.filter(item => !existingIds.has(item.listingID));
                            if (newItems.length > 0) { itemMarket.pushCache(newItems); if (isPageActive()) itemMarket.processAll(); }
                        }
                    } catch(e) {}
                });
            }
            return originalXHROpen.apply(this, arguments);
        };
    }

