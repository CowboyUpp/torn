                    enableAuctionHouse: CONFIG.enableAuctionHouse,
                    enableBazaar: CONFIG.enableBazaar,
                    enableDisplayCase: CONFIG.enableDisplayCase,
                    showDisplayCaseBonuses: CONFIG.showDisplayCaseBonuses,
                    enableInventory: CONFIG.enableInventory,
                    debug: CONFIG.debug
