    const HUB_ID = 'torn-openmarket';
    const HUB_NAME = 'OpenMarket';
    const HUB_VERSION = '1.6.14';
    const HUB_ICON = '';

    function registerWithHub() {
        const detail = {
            id: HUB_ID,
            name: HUB_NAME,
            version: HUB_VERSION,
            icon: HUB_ICON,
            order: 200,
            open: () => { console.log('[OpenMarket] Running in the background on market pages.'); },
            prefs: {
                fields: [
                    { key: 'enableItemMarket', type: 'toggle', label: 'Item Market', default: true },
                    { key: 'enableAuctionHouse', type: 'toggle', label: 'Auction House', default: true },
