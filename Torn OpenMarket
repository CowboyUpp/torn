        668: 46, 669: 46, 670: 49, 671: 49, 672: 49, 673: 49, 674: 49, 675: 40, 676: 52, 677: 52,
        678: 52, 679: 52, 680: 55, 681: 55, 682: 55, 683: 55, 684: 55, 848: 32, 1164: 38, 1165: 50,
        1166: 50, 1167: 50, 1168: 50, 1174: 39, 1307: 53, 1308: 53, 1309: 53, 1310: 53, 1311: 53,
        1355: 48, 1356: 48, 1357: 48, 1358: 48, 1359: 48
    };

    const BASE_STATS_MAP = Object.keys({
        ...BASE_DAMAGE_VALUES,
        ...BASE_ACCURACY_VALUES,
        ...BASE_ARMOUR_VALUES
    }).reduce((map, id) => {
        map[id] = {
            baseDamage: BASE_DAMAGE_VALUES[id] ?? 0,
            baseAccuracy: BASE_ACCURACY_VALUES[id] ?? 0,
            baseArmour: BASE_ARMOUR_VALUES[id] ?? 0
        };
        return map;
    }, {});

    // Bonuses with a fixed effect and no varying number (e.g. sledgehammer, tranquilizer
    // gun, handbag). Add new ones here as needed.
    const FIXED_BONUSES = ['Smash', 'Sleep', 'Storage'];

    const NUMBER_REGEX = /(\d+(?:\.\d+)?)/;

    const processedElements = new WeakMap();
    const processedBonusOverlays = new WeakMap();
    let darkMode = false;
    let currentHandler = null;
    let fetchParseWarned = false;

    // =========================================================================
    // HELPERS
    // =========================================================================
    function debugWarn(...args) {
        if (CONFIG.debug) console.warn('[OpenMarket]', ...args);
    }

    function checkDarkMode() {
        darkMode = document.body.classList.contains('dark-mode');
    }

    function getTierColour(percent) {
        const colours = darkMode ? COLOURS.tiers.dark : COLOURS.tiers.light;
        if (percent <= 25) return colours[0];
        if (percent <= 50) return colours[1];
        if (percent <= 75) return colours[2];
        return colours[3];
    }

    function qs(selector, parent = document) {
        try {
            return parent.querySelector(selector);
        } catch (e) {
            return null;
        }
    }

    function qsa(selector, parent = document) {
        try {
            return Array.from(parent.querySelectorAll(selector));
        } catch (e) {
            return null;
        }
    }

    function create(tag, attrs = {}, children = []) {
        const el = document.createElement(tag);
        Object.entries(attrs).forEach(([key, value]) => {
            if (key === 'style' && typeof value === 'object') {
                Object.assign(el.style, value);
            } else if (key === 'dataset' && typeof value === 'object') {
                Object.entries(value).forEach(([k, v]) => el.dataset[k] = v);
            } else {
                el[key] = value;
            }
        });
        children.forEach(child => {
            if (typeof child === 'string') {
                el.appendChild(document.createTextNode(child));
            } else if (child) {
                el.appendChild(child);
            }
        });
        return el;
    }

    // Shared by displayCase.extractVisibleStats and inventory.extractInventoryStats:
    // both scan icon-like elements and build one lowercase string of class/aria/title
    // attributes to sniff for "damage"/"accuracy"/"armour" keywords.
    function getIconIndicators(icon) {
        return [
            icon.className,
            icon.getAttribute('aria-label'),
            icon.getAttribute('title'),
            icon.getAttribute('data-title')
        ].filter(Boolean).join(' ').toLowerCase();
    }

    function computeItemKey(itemID, stats, bonuses) {
        const bonusPart = (bonuses || []).map(b => `${b.title}:${b.value}`).join(',');
        return `${itemID}|${stats.damage}|${stats.accuracy}|${stats.armour}|${bonusPart}`;
    }

    function isProcessed(el, key) {
        return processedElements.get(el) === key;
    }

    function markProcessed(el, key) {
        processedElements.set(el, key);
    }

    function getQualityColour(value, maxRange) {
        const percent = (value / maxRange) * 100;
        return getTierColour(percent);
    }

    function getBonusColour() {
        return darkMode ? COLOURS.bonus.dark : COLOURS.bonus.light;
    }

    function extractStats(el, selectors) {
        let damage = 0, accuracy = 0, armour = 0;

        const container = qs(selectors.statsContainer, el);
        if (!container) return { damage, accuracy, armour };

        qsa(selectors.statEntry, container).forEach(entry => {
            const valueEl = qs(selectors.statValue, entry);
            const iconEl = qs(selectors.statIcon, entry);
            const val = parseFloat(valueEl?.textContent) || 0;

            const typeEl = selectors.statTypeElement === 'value' ? valueEl : iconEl;
            let typeText = '';
            if (selectors.statTypeAttribute === 'className') {
                typeText = (typeEl?.className || '').toLowerCase();
            } else {
                typeText = (typeEl?.getAttribute(selectors.statTypeAttribute) || '').toLowerCase();
            }

            if (typeText.includes('damage')) damage = val;
            else if (typeText.includes('accuracy')) accuracy = val;
            else if (typeText.includes('armor') || typeText.includes('defence')) armour = val;
            else debugWarn('Unrecognized stat type on entry:', typeText || '(empty)');
        });

        return { damage, accuracy, armour };
    }

    function extractBonusesFromDOM(el, selectors) {
        const bonuses = [];

        qsa(selectors.bonusIcons, el).forEach(icon => {
            const titleAttr = icon.getAttribute(selectors.bonusTitleAttr) || '';
            const descAttr = icon.getAttribute(selectors.bonusDescAttr) || '';
            if (!titleAttr && !descAttr) return;

            const tmp = create('div');
            tmp.innerHTML = titleAttr;
            const title = qs('b', tmp)?.textContent || tmp.textContent || '';
            const descText = tmp.textContent.replace(title, '').trim() || descAttr;

            const valueMatch = descText.match(NUMBER_REGEX);
            const value = valueMatch ? parseFloat(valueMatch[1]) : null;

            if (title) {
                bonuses.push({ title, value, description: descText });
            }
        });

        return bonuses;
    }

    // FIX (1.4.2): markProcessed(el, key) is now called before the calcQuality()
    // early-return, not just at the end of the function. Previously, an element
    // whose itemID isn't in BASE_STATS_MAP (calcQuality returns null) skipped
    // markProcessed entirely, so every DOM mutation on that tile re-ran
    // computeItemKey/calcQuality from scratch indefinitely instead of being
    // recognised as already handled. The itemID/stats/bonuses for a given element
    // don't change without a new content key anyway (isProcessed() already
    // re-opens the gate if they do), so marking it processed here is safe and
    // just avoids redundant recomputation on unrecognised items.
    function processItem(el, data) {
        const { itemID, stats, bonuses, selectors } = data;

        const key = computeItemKey(itemID, stats, bonuses);
        if (isProcessed(el, key)) return;

        const quality = calcQuality(itemID, stats.damage, stats.accuracy, stats.armour);
        if (quality === null) {
            markProcessed(el, key);
            return;
        }

        const maxRange = stats.armour > 0 ? 100 : 300;
        const numericQuality = parseFloat(quality);
        if (numericQuality < -10 || numericQuality > maxRange + 10) {
            debugWarn('Implausible quality', numericQuality, 'for item', itemID, '- skipping badge.');
            markProcessed(el, key);
            return;
        }

        const imageWrapper = qs(selectors.imageWrapper, el);
        if (imageWrapper) {
            const existingQualityBox = qs('.openmarket-quality-box', imageWrapper);
            if (existingQualityBox) existingQualityBox.remove();

            insertQualityBox(imageWrapper, quality, maxRange);
        }

        // Display Case has no title element to anchor to — see insertBonusOverlay().
        const titleEl = selectors.title ? qs(selectors.title, el) : null;
        if (titleEl) {
            const existing = qs('.openmarket-bonuses', el);
            if (existing) existing.remove();

            const bonusContainer = create('div', {
                className: 'openmarket-bonuses',
                style: { lineHeight: '1.3' }
            });

            bonuses.forEach(bonus => {
                bonusContainer.appendChild(createBonusEl(bonus));
            });

            if (bonusContainer.children.length > 0) {
                if (data.insertBefore) {
                    titleEl.insertBefore(bonusContainer, data.insertBefore);
                } else {
                    titleEl.appendChild(bonusContainer);
                }
            }

            (data.hideElements || []).forEach(hideEl => {
                if (hideEl) hideEl.style.display = 'none';
            });
        }

        markProcessed(el, key);
    }

    function getQualityBoxBg() {
        return darkMode ? COLOURS.qualityBoxBg.dark : COLOURS.qualityBoxBg.light;
    }

    function calcQuality(itemID, damage, accuracy, armour) {
        const base = BASE_STATS_MAP[itemID];
        if (!base) return null;

        if (armour && armour !== 0) {
            return ((armour - base.baseArmour) * 20).toFixed(1);
        }
        return (((damage - base.baseDamage) + (accuracy - base.baseAccuracy)) * 10).toFixed(1);
    }

    function getUnitFromDescription(description, value) {
        if (!description || value === undefined || value === null) return '';
        const escapedValue = String(value).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        const pattern = new RegExp(escapedValue + '\\s*%');
        if (pattern.test(description)) return '%';
        return '';
    }

    function createBonusEl(bonus) {
        const name = bonus.title || '';
        const value = bonus.value;
        const description = bonus.description || '';

        if (FIXED_BONUSES.includes(name)) {
            return create('div', {
                textContent: name,
                style: { color: getBonusColour() }
            });
        }

        let text = name;

        if (value !== undefined && value !== null) {
            const unit = getUnitFromDescription(description, value);
            text = `${name}: ${value}${unit}`;
        }

        return create('div', {
            textContent: text,
            style: { color: getBonusColour() }
        });
    }

    function insertQualityBox(container, value, maxRange) {
        if (!container) return;

        const clamped = Math.min(Math.max(parseFloat(value), 0), maxRange);
        const colour = getQualityColour(clamped, maxRange);

        const span = create('span', {
            className: 'label-value t-overflow',
            textContent: `Q ${clamped.toFixed(1)}%`
        });

        const box = create('div', {
            className: 'openmarket-quality-box',
            style: {
                position: 'absolute',
                top: '2px',
                left: '2px',
                padding: '1px 3px',
                borderRadius: '3px',
                fontSize: '11px',
                fontWeight: 'bold',
                zIndex: '2',
                background: getQualityBoxBg(),
                color: colour
            }
        }, [span]);

        const style = window.getComputedStyle(container);
        if (style.position === 'static') {
            container.style.position = 'relative';
        }

        container.appendChild(box);
    }

    // Display Case tiles have no title/text element to anchor bonus text to, so
    // bonuses render as a second overlay pill (bottom-anchored) instead of the
    // normal block-flow list used elsewhere.
    function insertBonusOverlay(container, bonuses) {
        if (!container || !bonuses || bonuses.length === 0) return;

        const existing = qs('.openmarket-bonus-box', container);
        if (existing) existing.remove();

        const text = bonuses
            .map(b => {
                if (FIXED_BONUSES.includes(b.title)) return b.title;
                const unit = getUnitFromDescription(b.description, b.value);
                return b.value != null ? `${b.title}: ${b.value}${unit}` : b.title;
            })
            .join(' · ');

        if (!text) return;

        const span = create('span', {
            className: 'label-value t-overflow',
            textContent: text,
            title: text
        });

        const box = create('div', {
            className: 'openmarket-bonus-box',
            style: {
                position: 'absolute',
                bottom: '2px',
                left: '2px',
                right: '2px',
                padding: '1px 3px',
                borderRadius: '3px',
                fontSize: '10px',
                fontWeight: 'bold',
                zIndex: '2',
                overflow: 'hidden',
                textOverflow: 'ellipsis',
                whiteSpace: 'nowrap',
                background: getQualityBoxBg(),
                color: getBonusColour()
            }
        }, [span]);

        const style = window.getComputedStyle(container);
        if (style.position === 'static') {
            container.style.position = 'relative';
        }

        container.appendChild(box);
    }

    function isPageActive() {
        return !document.hidden && document.hasFocus();
    }

    function setupActiveListeners() {
        const onActivate = () => {
            if (currentHandler) {
                currentHandler.processAll();
            }
        };

        document.addEventListener('visibilitychange', onActivate);
        window.addEventListener('focus', onActivate);
    }

    function waitForRoot(selector, callback, attemptsLeft = 10, onTimeoutId = null) {
        const root = qs(selector);
        if (root) {
            callback(root);
            return;
        }
        if (attemptsLeft <= 0) {
            debugWarn('Could not find root element for selector', selector, '- page structure may have changed, or navigation did not lead to a supported page.');
            return;
        }
        const timeoutId = setTimeout(() => waitForRoot(selector, callback, attemptsLeft - 1, onTimeoutId), 300);
        if (onTimeoutId) onTimeoutId(timeoutId);
    }

    // =========================================================================
    // ITEM MARKET
    // =========================================================================
    const itemMarket = {
        // New item data arrives via an intercepted fetch response (see
        // interceptFetch()) and is cached here since the market redraws on scroll.
        // Per Torn admin: caching is fine as long as it isn't persisted or reused
        // for anything else — see interceptFetch(). Any changes here should keep
        // that compliant.
        cache: [],
        selectors: SELECTORS.itemMarket,
        observer: null,
        pendingTimeoutId: null,

        pushCache(newItems) {
            this.cache.push(...newItems);
            if (this.cache.length > MAX_CACHE_ITEMS) {
                this.cache.splice(0, this.cache.length - MAX_CACHE_ITEMS);
            }
        },

        resetCache() {
            this.cache = [];
        },

        matchToCache(el) {
            const price = parseInt(qs(this.selectors.price, el)?.textContent.replace(/[^\d]/g, ''), 10) || 0;
            const stats = extractStats(el, this.selectors);

            const candidates = this.cache.filter(item => {
                if (item.armor && item.armor > 0) {
                    return item.minPrice === price && item.armor === stats.armour;
                }
                return item.minPrice === price && item.damage === stats.damage && item.accuracy === stats.accuracy;
            });

            if (candidates.length === 0) return null;

            if (candidates.length > 1) {
                debugWarn('Ambiguous cache match (', candidates.length, 'candidates) at price', price, '- skipping tile to avoid a wrong match.');
                return null;
            }

            return candidates[0];
        },

        processAll() {
            if (!isPageActive()) return;
            if (this.cache.length === 0) return;

            qsa(this.selectors.tile).forEach(el => {
                const cached = this.matchToCache(el);
                if (!cached) return;

                processItem(el, {
                    itemID: cached.itemID,
                    stats: {
                        damage: cached.damage || 0,
                        accuracy: cached.accuracy || 0,
                        armour: cached.armor || 0
                    },
                    bonuses: cached.bonuses || [],
                    selectors: this.selectors
                });
            });
        },

        init() {
            const self = this;
            waitForRoot(this.selectors.root, (root) => {
                self.pendingTimeoutId = null;
                const observer = new MutationObserver(() => {
                    self.processAll();
                    if (sortState.active) applyBonusSort();
                });

                observer.observe(root, { childList: true, subtree: true });
                self.observer = observer;
                self.processAll();
            }, 10, (timeoutId) => { self.pendingTimeoutId = timeoutId; });
        }
    };

    // =========================================================================
    // AUCTION HOUSE
    // =========================================================================
    const auctionHouse = {
        selectors: SELECTORS.auctionHouse,
        observer: null,
        pendingTimeoutId: null,

        processAll() {
            if (!isPageActive()) return;

            const visibleTab = qs(this.selectors.visibleTab);
            if (!visibleTab) return;

            qsa(this.selectors.tile, visibleTab).forEach(el => {
                const hoverEl = qs(this.selectors.itemHover, el);

                const itemID = hoverEl?.getAttribute('item');
                if (!itemID || !BASE_STATS_MAP[itemID]) return;

                const stats = extractStats(el, this.selectors);
                if (stats.damage === 0 && stats.accuracy === 0 && stats.armour === 0) return;

                const titleEl = qs(this.selectors.title, el);
                const rarityLine = qs(this.selectors.rarityLine, titleEl);

                processItem(el, {
                    itemID,
                    stats,
                    bonuses: extractBonusesFromDOM(el, this.selectors),
                    selectors: this.selectors,
                    hideElements: [rarityLine]
                });
            });
        },

        init() {
            const self = this;
            waitForRoot(this.selectors.root, (root) => {
                self.pendingTimeoutId = null;
                const observer = new MutationObserver(() => {
                    self.processAll();
                });

                observer.observe(root, { childList: true, subtree: true });
                self.observer = observer;

                self.processAll();
            }, 10, (timeoutId) => { self.pendingTimeoutId = timeoutId; });
        }
    };

    // =========================================================================
    // BAZAAR
    // =========================================================================
    const bazaar = {
        selectors: SELECTORS.bazaar,
        outerObserver: null,
        innerObserver: null,
        pendingTimeoutId: null,

        processAll() {
            if (!isPageActive()) return;

            qsa(this.selectors.tile).forEach(el => {
                const img = qs(this.selectors.image, el);
                if (!img) return;

                const match = img.src.match(/\/images\/items\/(\d+)\//);
                if (!match) return;

                const itemID = match[1];
                if (!BASE_STATS_MAP[itemID]) return;

                const stats = extractStats(el, this.selectors);
                if (stats.damage === 0 && stats.accuracy === 0 && stats.armour === 0) return;

                const titleEl = qs(this.selectors.title, el);
                const stockEl = qs(this.selectors.stockElement, titleEl);

                processItem(el, {
                    itemID,
                    stats,
                    bonuses: extractBonusesFromDOM(el, this.selectors),
                    selectors: this.selectors,
                    insertBefore: stockEl,
                    hideElements: [stockEl]
                });
            });
        },

        init() {
            const self = this;
            waitForRoot(this.selectors.root, (root) => {
                self.pendingTimeoutId = null;
                const outerObserver = new MutationObserver((_, obs) => {
                    const container = qs(self.selectors.itemsContainer, root);
                    if (!container) return;

                    const innerObserver = new MutationObserver(() => {
                        self.processAll();
                    });

                    innerObserver.observe(container, { childList: true, subtree: true });
                    self.innerObserver = innerObserver;
                    self.processAll();

                    obs.disconnect();
                });

                outerObserver.observe(root, { childList: true, subtree: true });
                self.outerObserver = outerObserver;
            }, 10, (timeoutId) => { self.pendingTimeoutId = timeoutId; });
        }
    };

    // =========================================================================
    // DISPLAY CASE
    // Stats/bonuses live in the aria-label of .view-info.wai-btn inside each
    // .item-hover, lazy-loaded by Torn (loaded="0" -> "1"), so attribute changes
    // are watched alongside childList.
    // =========================================================================
    const displayCase = {
        selectors: {
            tile: '.b-item-wrap',
            imageWrapper: '.item-plate'
            // No 'title' — Display Case has no text anchor for bonuses; see
            // insertBonusOverlay().
        },

        // Damage/accuracy/armour are visible on the tile surface before the
        // lazy-loaded aria-label populates, so this extracts from the DOM directly
        // to get the quality badge showing immediately.
        extractVisibleStats(el, itemID) {
            const base = BASE_STATS_MAP[itemID];
            if (!base) return { damage: 0, accuracy: 0, armour: 0 };

            let damage = 0, accuracy = 0, armour = 0;

            const icons = el.querySelectorAll('i, svg, [class*="icon"], [class*="stat"]');
            icons.forEach(icon => {
                // FIX (1.4.2): extracted to the shared getIconIndicators() helper —
                // this exact block was duplicated verbatim in
                // inventory.extractInventoryStats.
                const indicators = getIconIndicators(icon);

                if (!indicators.includes('damage') && !indicators.includes('accuracy') &&
                    !indicators.includes('armor') && !indicators.includes('armour')) {
                    return;
                }

                let valueEl = icon.nextElementSibling;
                if (!valueEl || isNaN(parseFloat(valueEl.textContent))) {
                    valueEl = icon.parentElement?.querySelector('span, div, b, strong, [class*="value"]');
                }
                if (!valueEl || isNaN(parseFloat(valueEl.textContent))) {
                    valueEl = icon.parentElement?.nextElementSibling;
                }

                const val = parseFloat(valueEl?.textContent) || 0;
                if (val <= 0) return;

                if (indicators.includes('damage')) damage = val;
                else if (indicators.includes('accuracy')) accuracy = val;
                else if (indicators.includes('armor') || indicators.includes('armour')) armour = val;
            });

            if (damage === 0 && accuracy === 0 && armour === 0) {
                const fallback = extractStats(el, {
                    statsContainer: '[class*="infoBonuses"], [class*="properties"], .item-hover',
                    statEntry: '[class*="container"], [class*="property"], [class*="entry"], span, div',
                    statValue: 'span, div, [class*="value"]',
                    statIcon: 'i, svg, [class*="icon"]',
                    statTypeElement: 'icon',
                    statTypeAttribute: 'className'
                });
                damage = fallback.damage;
                accuracy = fallback.accuracy;
                armour = fallback.armour;
            }

            if (damage === 0 && accuracy === 0 && armour === 0) {
                const numbers = [];
                const walker = document.createTreeWalker(el, NodeFilter.SHOW_TEXT, null, false);
                let node;
                while (node = walker.nextNode()) {
                    const text = node.textContent.trim();
                    if (/^\d+(?:\.\d+)?$/.test(text)) {
                        const val = parseFloat(text);
                        if (val > 0 && val < 500) numbers.push(val);
                    }
                }
                const unique = [...new Set(numbers)];

                if (base.baseArmour > 0 && unique.length >= 1) {
                    const closest = unique.reduce((best, n) =>
                        Math.abs(n - base.baseArmour) < Math.abs(best - base.baseArmour) ? n : best
                    );
                    if (Math.abs(closest - base.baseArmour) < 50) armour = closest;
                } else if (unique.length >= 2) {
                    const scored = unique.map(n => ({
                        value: n,
                        dDiff: base.baseDamage > 0 ? Math.abs(n - base.baseDamage) : Infinity,
                        aDiff: base.baseAccuracy > 0 ? Math.abs(n - base.baseAccuracy) : Infinity
                    }));
                    const dBest = scored.filter(s => s.dDiff < 100).sort((a, b) => a.dDiff - b.dDiff)[0];
                    if (dBest) {
                        damage = dBest.value;
                        const remaining = scored.filter(s => s.value !== dBest.value);
                        const aBest = remaining.filter(s => s.aDiff < 100).sort((a, b) => a.aDiff - b.aDiff)[0];
                        if (aBest) accuracy = aBest.value;
                    }
                }
            }

            return { damage, accuracy, armour };
        },
        observer: null,
        pollTimer: null,

        parseAriaLabel(label) {
            const text = String(label || '').replace(/\n/g, ' ').trim();
            const result = { damage: 0, accuracy: 0, armour: 0, bonuses: [] };

            const damageMatch = text.match(/Damage:\s*(\d+(?:\.\d+)?)/i);
            if (damageMatch) result.damage = parseFloat(damageMatch[1]);

            const accuracyMatch = text.match(/Accuracy:\s*(\d+(?:\.\d+)?)/i);
            if (accuracyMatch) result.accuracy = parseFloat(accuracyMatch[1]);

            const armourMatch = text.match(/Armou?r:\s*(\d+(?:\.\d+)?)/i);
            if (armourMatch) result.armour = parseFloat(armourMatch[1]);

            const parts = text.split(/\.(?=\s|$)/);
            for (const part of parts) {
                const trimmed = part.trim();
                if (!trimmed) continue;
                if (/^Details:/i.test(trimmed)) continue;
                if (/^Amount:/i.test(trimmed)) continue;
                if (/^Rarity progress:/i.test(trimmed)) continue;
                if (/^Damage:/i.test(trimmed)) continue;
                if (/^Accuracy:/i.test(trimmed)) continue;
                if (/^Armou?r:/i.test(trimmed)) continue;

                const bonusMatch = trimmed.match(/^([^:]+):\s*(.+)$/);
                if (bonusMatch) {
                    const title = bonusMatch[1].trim();
                    const description = bonusMatch[2].trim();
                    const valueMatch = description.match(/(\d+(?:\.\d+)?)/);
                    const value = valueMatch ? parseFloat(valueMatch[1]) : null;
                    result.bonuses.push({ title, value, description });
                }
            }

            return result;
        },

        processAll() {
            if (!isPageActive()) return;

            const root = qs('#displayCaseRoot') || document.body;
            qsa(this.selectors.tile, root).forEach(el => {
                const hoverEl = qs('.item-hover', el);
                if (!hoverEl) return;

                const itemID = hoverEl.getAttribute('itemid');
                if (!itemID || !BASE_STATS_MAP[itemID]) return;

                const viewBtn = qs('.view-info.wai-btn', hoverEl);
                const ariaLabel = viewBtn?.getAttribute('aria-label');

                let stats, bonuses;

                if (ariaLabel) {
                    const parsed = this.parseAriaLabel(ariaLabel);
                    stats = { damage: parsed.damage, accuracy: parsed.accuracy, armour: parsed.armour };
                    bonuses = parsed.bonuses;
                } else {
                    stats = this.extractVisibleStats(el, itemID);
                    bonuses = [];
                }

                const hasStats = stats.damage > 0 || stats.accuracy > 0 || stats.armour > 0;
                if (!hasStats) return;

                processItem(el, {
                    itemID,
                    stats,
                    bonuses: bonuses || [],
                    selectors: this.selectors
                });

                // Tracked separately from processItem()'s own isProcessed() gate —
                // must only touch the DOM when bonus content actually changes, or
                // the childList mutation retriggers this handler's own observer.
                if (CONFIG.showDisplayCaseBonuses && bonuses && bonuses.length > 0) {
                    const bonusKey = computeItemKey(itemID, stats, bonuses);
                    if (processedBonusOverlays.get(el) !== bonusKey) {
                        const imageWrapper = qs(this.selectors.imageWrapper, el);
                        insertBonusOverlay(imageWrapper, bonuses);
                        processedBonusOverlays.set(el, bonusKey);
                    }
                }
            });
        },

        init() {
            const self = this;
            const root = qs('#displayCaseRoot') || document.body;

            const observer = new MutationObserver((mutations) => {
                const relevant = mutations.some(m =>
                    m.type === 'childList' ||
                    (m.type === 'attributes' && (m.attributeName === 'aria-label' || m.attributeName === 'loaded'))
                );
                if (relevant) self.processAll();
            });

            observer.observe(root, {
                childList: true,
                subtree: true,
                attributes: true,
                attributeFilter: ['aria-label', 'loaded', 'class']
            });
            self.observer = observer;

            // Triggers Torn's lazy data load (staggered, to avoid flooding the server).
            setTimeout(() => {
                qsa(self.selectors.tile, root).forEach((el, i) => {
                    const hoverEl = qs('.item-hover', el);
                    if (!hoverEl) return;
                    const viewBtn = qs('.view-info.wai-btn', hoverEl);
                    if (viewBtn && !viewBtn.getAttribute('aria-label')) {
                        setTimeout(() => {
                            el.dispatchEvent(new MouseEvent('mouseenter', { bubbles: true }));
                        }, i * 80);
                    }
                });
            }, 500);

            // Fallback poll for lazy-loaded data.
            let polls = 0;
            const maxPolls = 30;
            self.pollTimer = setInterval(() => {
                self.processAll();
                polls++;
                if (polls >= maxPolls) {
                    clearInterval(self.pollTimer);
                    self.pollTimer = null;
                }
            }, 1000);

            self.processAll();
        },

        teardown() {
            if (this.observer) { this.observer.disconnect(); this.observer = null; }
            if (this.pollTimer) { clearInterval(this.pollTimer); this.pollTimer = null; }
        }
    };

    // =========================================================================
    // INVENTORY (item.php)
    // Shows quality % and bonus lines (e.g. Poison / Toxin on blowguns) on
    // owned weapon and armour rows without opening the detail panel.
    // =========================================================================
    const inventory = {
        selectors: SELECTORS.inventory,
        observer: null,
        pendingTimeoutId: null,

        getItemId(el) {
            const attr = el.getAttribute('data-item') || el.getAttribute('itemid') || el.getAttribute('data-itemid');
            if (attr && /^\d+$/.test(attr)) return attr;

            const hover = qs('.item-hover, [itemid]', el);
            if (hover) {
                const id = hover.getAttribute('itemid') || hover.getAttribute('data-item');
                if (id && /^\d+$/.test(id)) return id;
            }

            const img = qs(this.selectors.image, el) || qs('img', el);
            if (img && img.src) {
                const m = img.src.match(/\/images\/items\/(\d+)\//);
                if (m) return m[1];
            }
            return null;
        },

        // FIX (1.4.8): returns { weaponBonuses, modBonuses } instead of a single
        // filtered list. 1.4.6 dropped mod bonuses (attached scopes/lasers/grips)
        // entirely to avoid row-overlap; that also meant a weapon with a mod equipped
        // showed no indication of it anywhere. Mods are now collected separately and
        // shown only via the "" tooltip (see processAll), never inline, so they still
        // don't risk overlapping adjacent columns, but aren't silently dropped either.
        // Structural detection is unchanged: mod bonuses are grouped inside an
        // <li ... data-attachments-itemid="...">, carrying the attached mod's own item
        // ID — confirmed via live DOM. The weapon's own bonus sits in a plain <li>
        // with no such attribute.
        extractInventoryBonuses(el) {
            const weaponBonuses = [];
            const modBonuses = [];
            const seenWeapon = new Set();
            const seenMod = new Set();

            const pushBonus = (target, seen, title, value, description) => {
                if (title && !seen.has(title.toLowerCase())) {
                    seen.add(title.toLowerCase());
                    target.push({ title, value, description });
                }
            };

            // data-bonus-attachment-* icons (same as bazaar)
            qsa(this.selectors.bonusIcons, el).forEach(icon => {
                const isMod = !!icon.closest('li[data-attachments-itemid]');

                let titleAttr = icon.getAttribute(this.selectors.bonusTitleAttr) || '';
                let descAttr = icon.getAttribute(this.selectors.bonusDescAttr) || '';

                // Fallbacks used on inventory rows
                if (!titleAttr) titleAttr = icon.getAttribute('title') || icon.getAttribute('aria-label') || '';
                if (!descAttr) descAttr = icon.getAttribute('data-title') || '';

                if (!titleAttr && !descAttr) return;

                const tmp = create('div');
                tmp.innerHTML = titleAttr;
                const title = qs('b', tmp)?.textContent || tmp.textContent?.split(/[:<\n]/)[0]?.trim() || '';
                const descText = (tmp.textContent || '').replace(title, '').trim() || descAttr;

                const valueMatch = descText.match(NUMBER_REGEX) || titleAttr.match(NUMBER_REGEX);
                const value = valueMatch ? parseFloat(valueMatch[1]) : null;

                if (isMod) {
                    pushBonus(modBonuses, seenMod, title, value, descText || titleAttr);
                } else {
                    pushBonus(weaponBonuses, seenWeapon, title, value, descText || titleAttr);
                }
            });

            // title= on span wrappers around bonus icons
            qsa('.iconsbonuses span[title], [class*="iconsbonuses"] span[title]', el).forEach(span => {
                const isMod = !!span.closest('li[data-attachments-itemid]');

                const titleAttr = span.getAttribute('title') || '';
                if (!titleAttr) return;
                const tmp = create('div');
                tmp.innerHTML = titleAttr;
                const title = qs('b', tmp)?.textContent || tmp.textContent?.split(/[:<\n]/)[0]?.trim() || '';
                const descText = (tmp.textContent || '').replace(title, '').trim();
                const valueMatch = (descText || titleAttr).match(NUMBER_REGEX);
                const value = valueMatch ? parseFloat(valueMatch[1]) : null;

                if (isMod) {
                    pushBonus(modBonuses, seenMod, title, value, descText || titleAttr);
                } else {
                    pushBonus(weaponBonuses, seenWeapon, title, value, descText || titleAttr);
                }
            });

            return { weaponBonuses, modBonuses };
        },

        extractInventoryStats(el, itemID) {
            // Prefer structured extractStats when containers exist
            let stats = extractStats(el, this.selectors);
            if (stats.damage || stats.accuracy || stats.armour) return stats;

            let damage = 0, accuracy = 0, armour = 0;

            // Icon-class / aria based (same approach as displayCase)
            qsa('i, svg, [class*="icon"]', el).forEach(icon => {
                // FIX (1.4.2): extracted to the shared getIconIndicators() helper —
                // this exact block was duplicated verbatim in
                // displayCase.extractVisibleStats.
                const indicators = getIconIndicators(icon);

                if (!indicators.includes('damage') && !indicators.includes('accuracy') &&
                    !indicators.includes('armor') && !indicators.includes('armour') &&
                    !indicators.includes('defence') && !indicators.includes('defense')) {
                    return;
                }

                let valueEl = icon.nextElementSibling;
                if (!valueEl || isNaN(parseFloat(valueEl.textContent))) {
                    valueEl = icon.parentElement?.querySelector('span, div, b, strong, [class*="value"]');
                }
                if (!valueEl || isNaN(parseFloat(valueEl.textContent))) {
                    valueEl = icon.parentElement?.nextElementSibling;
                }
                // Inventory often puts the number in a sibling span after the icon wrap
                if (!valueEl || isNaN(parseFloat(valueEl.textContent))) {
                    const wrap = icon.closest('li, span, div, [class*="bonus"], [class*="stat"]');
                    const numSpan = wrap && [...wrap.querySelectorAll('span, b, strong')].find(s =>
                        /^\d+(?:\.\d+)?$/.test((s.textContent || '').trim())
                    );
                    if (numSpan) valueEl = numSpan;
                }
                const val = parseFloat(valueEl?.textContent) || 0;
                if (val <= 0) return;

                if (indicators.includes('damage')) damage = val;
                else if (indicators.includes('accuracy')) accuracy = val;
                else if (indicators.includes('armor') || indicators.includes('armour') ||
                         indicators.includes('defence') || indicators.includes('defense')) armour = val;
            });

            // Text fallback: "Damage: 17.15" / "Accuracy: 42.30" in expanded or compact rows
            if (!damage && !accuracy && !armour) {
                const blob = el.textContent || '';
                const dmgM = blob.match(/Damage\s*:?\s*([\d.]+)/i);
                const accM = blob.match(/Accuracy\s*:?\s*([\d.]+)/i);
                const armM = blob.match(/(?:Armor|Armour|Defence|Defense)\s*:?\s*([\d.]+)/i);
                if (dmgM) damage = parseFloat(dmgM[1]) || 0;
                if (accM) accuracy = parseFloat(accM[1]) || 0;
                if (armM) armour = parseFloat(armM[1]) || 0;
            }

            // Last resort: inventory list often shows two floats in order (dmg then acc)
            // for weapons that have no icon class markers we recognised.
            if (!damage && !accuracy && !armour && BASE_STATS_MAP[itemID]) {
                const base = BASE_STATS_MAP[itemID];
                if (base.baseArmour > 0) {
                    // armour piece — look for a single plausible armour number
                    const nums = [...(el.textContent || '').matchAll(/\b(\d{1,2}(?:\.\d+)?)\b/g)]
                        .map(m => parseFloat(m[1]))
                        .filter(n => n >= 5 && n <= 80);
                    if (nums.length) armour = nums[0];
                } else {
                    // weapon: find two numbers near the expected base ranges
                    const nums = [...(el.textContent || '').matchAll(/\b(\d{1,3}(?:\.\d+)?)\b/g)]
                        .map(m => parseFloat(m[1]));
                    // Prefer numbers close to base±10
                    const dmgCands = nums.filter(n => Math.abs(n - base.baseDamage) <= 12);
                    const accCands = nums.filter(n => Math.abs(n - base.baseAccuracy) <= 12);
                    if (dmgCands.length) damage = dmgCands[0];
                    if (accCands.length) {
                        // avoid reusing the same number for both
                        accuracy = accCands.find(n => n !== damage) || accCands[0];
                    }
                }
            }

            return { damage, accuracy, armour };
        },

        processAll() {
            if (!isPageActive()) return;

            qsa(this.selectors.tile).forEach(el => {
                // Skip non-visible / category headers
                if (el.offsetParent === null && el.getClientRects().length === 0) return;

                const itemID = this.getItemId(el);
                if (!itemID || !BASE_STATS_MAP[itemID]) return;

                const stats = this.extractInventoryStats(el, itemID);
                if (stats.damage === 0 && stats.accuracy === 0 && stats.armour === 0) return;

                const { weaponBonuses, modBonuses } = this.extractInventoryBonuses(el);
                const allBonuses = [...weaponBonuses, ...modBonuses];

                const key = computeItemKey(itemID, stats, allBonuses);
                if (isProcessed(el, key)) return;

                // Resolve image + title anchors (inventory markup varies by category)
                let imageWrapper = qs('.img-wrap, .thumbnail-wrap, .item-plate, [class*="img-wrap"]', el) ||
                    qs(this.selectors.imageWrapper, el) ||
                    qs('img', el)?.parentElement ||
                    el;

                let titleEl = qs('.name-wrap, .title-wrap .name, .name-wrap .name, .title-wrap .t-overflow', el) ||
                    qs(this.selectors.title, el);

                // Mark via processItem gate only (no DOM from it — inventory layout differs)
                processItem(el, {
                    itemID,
                    stats,
                    bonuses: allBonuses,
                    selectors: {
                        imageWrapper: null,
                        title: null
                    }
                });

                const quality = calcQuality(itemID, stats.damage, stats.accuracy, stats.armour);
                const maxRange = stats.armour > 0 ? 100 : 300;
                const numericQuality = quality !== null ? parseFloat(quality) : null;
                const qualityOk = numericQuality !== null &&
                    numericQuality >= -10 && numericQuality <= maxRange + 10;

                // Inventory rows are list layout — put quality as an inline "column"
                // next to the name (and keep a small badge on the icon when possible).
                if (titleEl) {
                    const existingMeta = qs('.openmarket-inventory-meta', el);
                    if (existingMeta) existingMeta.remove();
                    const existingBonuses = qs('.openmarket-bonuses', el);
                    if (existingBonuses) existingBonuses.remove();

                    const meta = create('span', {
                        className: 'openmarket-inventory-meta',
                        style: {
                            display: 'inline-flex',
                            alignItems: 'center',
                            flexWrap: 'wrap',
                            gap: '4px 8px',
                            marginLeft: '8px',
                            verticalAlign: 'middle',
                            fontSize: '11px',
                            lineHeight: '1.3',
                            fontWeight: 'bold'
                        }
                    });

                    if (qualityOk) {
                        const qColour = getQualityColour(Math.min(Math.max(numericQuality, 0), maxRange), maxRange);
                        meta.appendChild(create('span', {
                            className: 'openmarket-inventory-quality',
                            textContent: `Q ${numericQuality.toFixed(1)}%`,
                            style: {
                                color: qColour,
                                padding: '0 4px',
                                borderRadius: '3px',
                                background: getQualityBoxBg()
                            }
                        }));
                    }

                    if (weaponBonuses.length > 0) {
                        // FIX (1.4.5): earlier attempts (1.4.3/1.4.4) tried to fit the
                        // full bonus text inline next to the item name on Torn's
                        // fixed-height (30px) single-line compact inventory row, where
                        // title-wrap and cont-wrap (price/accuracy/etc.) are fixed-
                        // width columns sharing that one line — there's no vertical
                        // wrapping happening, so text truncation alone didn't stop the
                        // overlap: even truncated text can be wider than the room
                        // actually available. 1.4.5 dropped inline bonus text entirely
                        // and showed only a "ⓘ" icon as a result.
                        //
                        // FIX (1.4.6): mod bonuses (attached scopes/lasers/grips etc.)
                        // are excluded from this inline text, keeping only the
                        // weapon's own intrinsic bonuses. In the common case this
                        // leaves just one short bonus (e.g. "Puncture: 28%"), which
                        // fits inline without issue. The single-line truncation CSS
                        // (.openmarket-inventory-bonuses) stays as a safety net for
                        // the less common weapon with several of its own bonuses.
                        //
                        // FIX (1.4.8): mods are no longer discarded — see
                        // extractInventoryBonuses(). They're surfaced separately below,
                        // via the "ⓘ" tooltip only, never inline.
                        const weaponBonusText = weaponBonuses
                            .map(b => {
                                if (FIXED_BONUSES.includes(b.title)) return b.title;
                                const unit = getUnitFromDescription(b.description, b.value);
                                return b.value != null ? `${b.title}: ${b.value}${unit}` : b.title;
                            })
                            .join(' · ');

                        const bonusContainer = create('span', {
                            className: 'openmarket-bonuses openmarket-inventory-bonuses',
                            title: weaponBonusText,
                            style: {
                                display: 'inline',
                                color: getBonusColour()
                            }
                        });
                        weaponBonuses.forEach((bonus, i) => {
                            if (i > 0) {
                                bonusContainer.appendChild(document.createTextNode(' · '));
                            }
                            bonusContainer.appendChild(createBonusEl(bonus));
                        });
                        meta.appendChild(bonusContainer);
                    }

                    if (modBonuses.length > 0) {
                        // FIX (1.4.8): mods (e.g. 100mW Laser, Tactical Brake) are
                        // shown only here — as a hover tooltip on this icon — never
                        // inline, since even one or two mod names/values tend to be
                        // too wide for the fixed-width column (per 1.4.5's root-cause
                        // finding). Tooltip text is mod-only, so it never repeats what
                        // weaponBonuses already shows inline above.
                        const modBonusText = modBonuses
                            .map(b => {
                                if (FIXED_BONUSES.includes(b.title)) return b.title;
                                const unit = getUnitFromDescription(b.description, b.value);
                                return b.value != null ? `${b.title}: ${b.value}${unit}` : b.title;
                            })
                            .join(' · ');

                        const infoIcon = create('span', {
                            textContent: '',
                            title: modBonusText,
                            style: {
                                marginLeft: '3px',
                                cursor: 'help',
                                opacity: '0.75',
                                fontSize: '11px'
                            }
                        });
                        // FIX (1.4.7): plain hover-tooltip affordance only, no click
                        // listener — nothing here can intercept the row's own tap.
                        meta.appendChild(infoIcon);
                    }

                    if (meta.childNodes.length > 0) {
                        titleEl.appendChild(meta);
                    }
                }

                // Also try a compact badge on the thumbnail when we found a real image wrap
                if (qualityOk && imageWrapper && imageWrapper !== el) {
                    const existingQualityBox = qs('.openmarket-quality-box', imageWrapper);
                    if (existingQualityBox) existingQualityBox.remove();
                    insertQualityBox(imageWrapper, quality, maxRange);
                }
            });
        },

        init() {
            const self = this;
            const root = qs('.items-wrap') || qs('#mainContainer') || document.body;

            const observer = new MutationObserver(() => {
                self.processAll();
            });
            observer.observe(root, { childList: true, subtree: true });
            self.observer = observer;

            // Inventory categories lazy-load rows; poll briefly after init
            let polls = 0;
            self.pollTimer = setInterval(() => {
                self.processAll();
                polls++;
                if (polls >= 20) {
                    clearInterval(self.pollTimer);
                    self.pollTimer = null;
                }
            }, 500);

            self.processAll();
        },

        teardown() {
            if (this.observer) { this.observer.disconnect(); this.observer = null; }
            if (this.pollTimer) { clearInterval(this.pollTimer); this.pollTimer = null; }
        }
    };

    // =========================================================================
    // SPA NAVIGATION HANDLING
    // =========================================================================
    function detectPageType(href) {
        if (href.includes('sid=ItemMarket')) return 'itemMarket';
        if (href.includes('amarket.php')) return 'auctionHouse';
        if (href.includes('bazaar.php')) return 'bazaar';
        if (href.includes('displaycase.php')) return 'displayCase';
        if (href.includes('item.php')) return 'inventory';
        return null;
    }

    function teardownCurrentHandler() {
        if (!currentHandler) return;
        if (typeof currentHandler.teardown === 'function') {
            currentHandler.teardown();
        } else {
            ['observer', 'outerObserver', 'innerObserver'].forEach(key => {
                if (currentHandler[key]) {
                    currentHandler[key].disconnect();
                    currentHandler[key] = null;
                }
            });
        }
        if (currentHandler.pendingTimeoutId) {
            clearTimeout(currentHandler.pendingTimeoutId);
            currentHandler.pendingTimeoutId = null;
        }
    }

    function activateHandlerForCurrentUrl() {
        const type = detectPageType(window.location.href);
        const handlers = { itemMarket, auctionHouse, bazaar, displayCase, inventory };
        const enabledMap = {
            itemMarket: CONFIG.enableItemMarket,
            auctionHouse: CONFIG.enableAuctionHouse,
            bazaar: CONFIG.enableBazaar,
            displayCase: CONFIG.enableDisplayCase,
            inventory: CONFIG.enableInventory
        };

        if (!type || !enabledMap[type]) {
            teardownCurrentHandler();
            currentHandler = null;
            return;
        }

        const nextHandler = handlers[type];

        if (currentHandler === nextHandler) {
            if (type === 'itemMarket') itemMarket.resetCache();
            nextHandler.processAll();
            return;
        }

        teardownCurrentHandler();
        currentHandler = nextHandler;
        nextHandler.init();
    }

    function setupRouteWatcher() {
        const originalPushState = history.pushState;
        const originalReplaceState = history.replaceState;

        history.pushState = function (...args) {
            const result = originalPushState.apply(this, args);
            window.dispatchEvent(new Event('openmarket-locationchange'));
            return result;
        };
        history.replaceState = function (...args) {
            const result = originalReplaceState.apply(this, args);
            window.dispatchEvent(new Event('openmarket-locationchange'));
            return result;
        };

        ['popstate', 'hashchange', 'openmarket-locationchange'].forEach(evt => {
            window.addEventListener(evt, () => activateHandlerForCurrentUrl());
        });
    }

    // =========================================================================
    // FETCH REQUEST INTERCEPTION
    // =========================================================================
    function interceptFetch() {
        const originalFetch = window.fetch;

        window.fetch = async (...args) => {
            const response = await originalFetch(...args);

            const url = args[0] instanceof Request ? args[0].url : String(args[0]);

            if (url.includes('sid=iMarket')) {
                response.clone().json().then(data => {
                    if (!data?.items?.length) return;

                    const existingIds = new Set(itemMarket.cache.map(i => i.listingID));
                    const newItems = data.items.filter(item => !existingIds.has(item.listingID));

                    if (newItems.length > 0) {
                        itemMarket.pushCache(newItems);
                        if (isPageActive()) itemMarket.processAll();
                    }
                }).catch(err => {
                    if (!fetchParseWarned) {
                        console.warn('[OpenMarket] Failed to parse Item Market response — quality/bonus overlays may stop updating.', err);
                        fetchParseWarned = true;
                    }
                });
            }

            return response;
        };
    }

