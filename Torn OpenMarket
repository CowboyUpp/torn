    const BASE_ACCURACY_VALUES = { 1: 55, 2: 57, 3: 52, 4: 62, 5: 45, 6: 55, 7: 60, 8: 52, 9: 58, 10: 23, 11: 52, 12: 53, 13: 52, 14: 56, 15: 54, 16: 58, 17: 51, 18: 49, 19: 38, 20: 36, 21: 30, 22: 63, 23: 65, 24: 51, 25: 51, 26: 52, 27: 47, 28: 55, 29: 47, 30: 45, 31: 41, 63: 28, 76: 24, 98: 24, 99: 57, 100: 24, 108: 43, 109: 39, 110: 52, 111: 51, 146: 49, 147: 15, 170: 24, 173: 55, 174: 56, 175: 54, 177: 53, 189: 54, 217: 49, 218: 63, 219: 55, 223: 52, 224: 52, 225: 62, 227: 48, 228: 48, 230: 22, 231: 46, 232: 50, 233: 55, 234: 52, 235: 59, 236: 55, 237: 56, 238: 52, 240: 25, 241: 57, 243: 57, 244: 39, 245: 55, 247: 55, 248: 53, 249: 47, 250: 53, 251: 51, 252: 62, 253: 41, 254: 52, 255: 39, 289: 54, 290: 54, 291: 54, 292: 54, 346: 63, 359: 50, 360: 57, 382: 62, 387: 63, 388: 45, 391: 65, 393: 54, 395: 60, 397: 28, 398: 50, 399: 57, 400: 35, 401: 33, 402: 60, 438: 42, 439: 43, 440: 63, 483: 52, 484: 41, 485: 54, 486: 45, 487: 43, 488: 41, 489: 48, 490: 24, 539: 55, 545: 38, 546: 47, 547: 46, 548: 45, 549: 36, 599: 48, 600: 41, 604: 45, 605: 48, 612: 52, 613: 63, 614: 62, 615: 52, 632: 48, 790: 29, 792: 57, 805: 55, 830: 45, 831: 53, 832: 54, 837: 36, 838: 60, 839: 45, 844: 45, 845: 53, 846: 52, 850: 50, 871: 59, 874: 57, 1053: 65, 1055: 49, 1056: 47, 1152: 42, 1153: 44, 1154: 40, 1155: 45, 1156: 36, 1157: 49, 1158: 39, 1159: 56, 1173: 67, 1231: 59, 1255: 52, 1257: 59, 1296: 58 };
    const BASE_ARMOUR_VALUES = { 32: 20, 33: 32, 34: 34, 49: 31, 50: 36, 176: 23, 178: 30, 332: 38, 333: 40, 334: 42, 348: 10, 538: 25, 640: 32, 641: 34, 642: 30, 643: 30, 644: 34, 645: 30, 646: 24, 647: 20, 648: 20, 649: 20, 650: 20, 651: 38, 652: 38, 653: 38, 654: 38, 655: 35, 656: 45, 657: 45, 658: 45, 659: 45, 660: 44, 661: 44, 662: 44, 663: 44, 664: 44, 665: 46, 666: 46, 667: 46, 668: 46, 669: 46, 670: 49, 671: 49, 672: 49, 673: 49, 674: 49, 675: 40, 676: 52, 677: 52, 678: 52, 679: 52, 680: 55, 681: 55, 682: 55, 683: 55, 684: 55, 848: 32, 1164: 38, 1165: 50, 1166: 50, 1167: 50, 1168: 50, 1174: 39, 1307: 53, 1308: 53, 1309: 53, 1310: 53, 1311: 53, 1355: 48, 1356: 48, 1357: 48, 1358: 48, 1359: 48 };

    const BASE_STATS_MAP = Object.keys({ ...BASE_DAMAGE_VALUES, ...BASE_ACCURACY_VALUES, ...BASE_ARMOUR_VALUES }).reduce((map, id) => {
        map[id] = { baseDamage: BASE_DAMAGE_VALUES[id] ?? 0, baseAccuracy: BASE_ACCURACY_VALUES[id] ?? 0, baseArmour: BASE_ARMOUR_VALUES[id] ?? 0 };
        return map;
    }, {});

    const FIXED_BONUSES = ['Smash', 'Sleep', 'Storage'];
    const NUMBER_REGEX = /(\d+(?:\.\d+)?)/;
    const processedElements = new WeakMap();
    const processedBonusOverlays = new WeakMap();
    let darkMode = false;
    let currentHandler = null;
    let fetchParseWarned = false;

    function debugWarn(...args) { if (CONFIG.debug) console.warn('[OpenMarket]', ...args); }
    function checkDarkMode() { darkMode = document.body.classList.contains('dark-mode'); }
    function getTierColour(percent) { const c = darkMode ? COLOURS.tiers.dark : COLOURS.tiers.light; if (percent <= 25) return c[0]; if (percent <= 50) return c[1]; if (percent <= 75) return c[2]; return c[3]; }
    function qs(selector, parent = document) { try { return parent.querySelector(selector); } catch (e) { return null; } }
    function qsa(selector, parent = document) { try { return Array.from(parent.querySelectorAll(selector)); } catch (e) { return null; } }
    function create(tag, attrs = {}, children = []) {
        const el = document.createElement(tag);
        Object.entries(attrs).forEach(([key, value]) => {
            if (key === 'style' && typeof value === 'object') Object.assign(el.style, value);
            else if (key === 'dataset' && typeof value === 'object') Object.entries(value).forEach(([k, v]) => el.dataset[k] = v);
            else el[key] = value;
        });
        children.forEach(child => { if (typeof child === 'string') el.appendChild(document.createTextNode(child)); else if (child) el.appendChild(child); });
        return el;
    }
    function getIconIndicators(icon) { return [icon.className, icon.getAttribute('aria-label'), icon.getAttribute('title'), icon.getAttribute('data-title')].filter(Boolean).join(' ').toLowerCase(); }
    function computeItemKey(itemID, stats, bonuses) { return `${itemID}|${stats.damage}|${stats.accuracy}|${stats.armour}|${(bonuses || []).map(b => `${b.title}:${b.value}`).join(',')}`; }
    function isProcessed(el, key) { return processedElements.get(el) === key; }
    function markProcessed(el, key) { processedElements.set(el, key); }
    function getQualityColour(value, maxRange) { return getTierColour((value / maxRange) * 100); }
    function getBonusColour() { return darkMode ? COLOURS.bonus.dark : COLOURS.bonus.light; }

    function extractStats(el, selectors) {
        let damage = 0, accuracy = 0, armour = 0;
        const container = qs(selectors.statsContainer, el);
        if (!container) return { damage, accuracy, armour };
        qsa(selectors.statEntry, container).forEach(entry => {
            const valueEl = qs(selectors.statValue, entry);
            const iconEl = qs(selectors.statIcon, entry);
            const val = parseFloat(valueEl?.textContent) || 0;
            const typeEl = selectors.statTypeElement === 'value' ? valueEl : iconEl;
            let typeText = selectors.statTypeAttribute === 'className' ? (typeEl?.className || '').toLowerCase() : (typeEl?.getAttribute(selectors.statTypeAttribute) || '').toLowerCase();
            if (typeText.includes('damage')) damage = val;
            else if (typeText.includes('accuracy')) accuracy = val;
            else if (typeText.includes('armor') || typeText.includes('defence')) armour = val;
        });
        return { damage, accuracy, armour };
    }

    function extractBonusesFromDOM(el, selectors) {
        const bonuses = [];
        qsa(selectors.bonusIcons, el).forEach(icon => {
            const titleAttr = icon.getAttribute(selectors.bonusTitleAttr) || '';
            const descAttr = icon.getAttribute(selectors.bonusDescAttr) || '';
            if (!titleAttr && !descAttr) return;
            const tmp = create('div'); tmp.innerHTML = titleAttr;
            const title = qs('b', tmp)?.textContent || tmp.textContent || '';
            const descText = tmp.textContent.replace(title, '').trim() || descAttr;
            const valueMatch = descText.match(NUMBER_REGEX);
            if (title) bonuses.push({ title, value: valueMatch ? parseFloat(valueMatch[1]) : null, description: descText });
        });
        return bonuses;
    }

    function processItem(el, data) {
        const { itemID, stats, bonuses, selectors } = data;
        const key = computeItemKey(itemID, stats, bonuses);
        if (isProcessed(el, key)) return;
        const quality = calcQuality(itemID, stats.damage, stats.accuracy, stats.armour);
        if (quality === null) { markProcessed(el, key); return; }
        const maxRange = stats.armour > 0 ? 100 : 300;
        const numericQuality = parseFloat(quality);
        if (numericQuality < -10 || numericQuality > maxRange + 10) { markProcessed(el, key); return; }

        const imageWrapper = qs(selectors.imageWrapper, el);
        if (imageWrapper) {
            const existingQualityBox = qs('.openmarket-quality-box', imageWrapper);
            if (existingQualityBox) existingQualityBox.remove();
            insertQualityBox(imageWrapper, quality, maxRange);
        }

        const titleEl = selectors.title ? qs(selectors.title, el) : null;
        if (titleEl) {
            const existing = qs('.openmarket-bonuses', el);
            if (existing) existing.remove();
            const bonusContainer = create('div', { className: 'openmarket-bonuses', style: { lineHeight: '1.3' } });
            bonuses.forEach(bonus => bonusContainer.appendChild(createBonusEl(bonus)));
            if (bonusContainer.children.length > 0) {
                if (data.insertBefore) titleEl.insertBefore(bonusContainer, data.insertBefore);
                else titleEl.appendChild(bonusContainer);
            }
            (data.hideElements || []).forEach(hideEl => { if (hideEl) hideEl.style.display = 'none'; });
        }
        markProcessed(el, key);
    }

    function getQualityBoxBg() { return darkMode ? COLOURS.qualityBoxBg.dark : COLOURS.qualityBoxBg.light; }
    function calcQuality(itemID, damage, accuracy, armour) {
        const base = BASE_STATS_MAP[itemID];
        if (!base) return null;
        if (armour && armour !== 0) return ((armour - base.baseArmour) * 20).toFixed(1);
        return (((damage - base.baseDamage) + (accuracy - base.baseAccuracy)) * 10).toFixed(1);
    }
    function getUnitFromDescription(description, value) {
        if (!description || value === undefined || value === null) return '';
        const escapedValue = String(value).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        if (new RegExp(escapedValue + '\\s*%').test(description)) return '%';
        return '';
    }
    function createBonusEl(bonus) {
        if (FIXED_BONUSES.includes(bonus.title)) return create('div', { textContent: bonus.title, style: { color: getBonusColour() } });
        let text = bonus.title;
        if (bonus.value !== undefined && bonus.value !== null) text = `${bonus.title}: ${bonus.value}${getUnitFromDescription(bonus.description, bonus.value)}`;
        return create('div', { textContent: text, style: { color: getBonusColour() } });
    }
    function insertQualityBox(container, value, maxRange) {
        if (!container) return;
        const clamped = Math.min(Math.max(parseFloat(value), 0), maxRange);
        const span = create('span', { className: 'label-value t-overflow', textContent: `Q ${clamped.toFixed(1)}%` });
        const box = create('div', { className: 'openmarket-quality-box', style: { position: 'absolute', top: '2px', left: '2px', padding: '1px 3px', borderRadius: '3px', fontSize: '11px', fontWeight: 'bold', zIndex: '2', background: getQualityBoxBg(), color: getQualityColour(clamped, maxRange) } }, [span]);
        if (window.getComputedStyle(container).position === 'static') container.style.position = 'relative';
        container.appendChild(box);
    }
    function insertBonusOverlay(container, bonuses) {
        if (!container || !bonuses || bonuses.length === 0) return;
        const existing = qs('.openmarket-bonus-box', container);
        if (existing) existing.remove();
        const text = bonuses.map(b => FIXED_BONUSES.includes(b.title) ? b.title : (b.value != null ? `${b.title}: ${b.value}${getUnitFromDescription(b.description, b.value)}` : b.title)).join(' · ');
        if (!text) return;
        const span = create('span', { className: 'label-value t-overflow', textContent: text, title: text });
        const box = create('div', { className: 'openmarket-bonus-box', style: { position: 'absolute', bottom: '2px', left: '2px', right: '2px', padding: '1px 3px', borderRadius: '3px', fontSize: '10px', fontWeight: 'bold', zIndex: '2', overflow: 'hidden', textOverflow: 'ellipsis', whiteSpace: 'nowrap', background: getQualityBoxBg(), color: getBonusColour() } }, [span]);
        if (window.getComputedStyle(container).position === 'static') container.style.position = 'relative';
        container.appendChild(box);
    }
    function isPageActive() { return !document.hidden && document.hasFocus(); }
    function setupActiveListeners() {
        const onActivate = () => { if (currentHandler) currentHandler.processAll(); };
        document.addEventListener('visibilitychange', onActivate);
        window.addEventListener('focus', onActivate);
    }
    function waitForRoot(selector, callback, attemptsLeft = 10, onTimeoutId = null) {
        const root = qs(selector);
        if (root) { callback(root); return; }
        if (attemptsLeft <= 0) return;
        const timeoutId = setTimeout(() => waitForRoot(selector, callback, attemptsLeft - 1, onTimeoutId), 300);
        if (onTimeoutId) onTimeoutId(timeoutId);
    }

    const itemMarket = {
        cache: [], selectors: SELECTORS.itemMarket, observer: null, pendingTimeoutId: null,
        pushCache(newItems) { this.cache.push(...newItems); if (this.cache.length > MAX_CACHE_ITEMS) this.cache.splice(0, this.cache.length - MAX_CACHE_ITEMS); },
        resetCache() { this.cache = []; },
        matchToCache(el) {
            const price = parseInt(qs(this.selectors.price, el)?.textContent.replace(/[^\d]/g, ''), 10) || 0;
            const stats = extractStats(el, this.selectors);
            const candidates = this.cache.filter(item => (item.armor && item.armor > 0) ? (item.minPrice === price && item.armor === stats.armour) : (item.minPrice === price && item.damage === stats.damage && item.accuracy === stats.accuracy));
            if (candidates.length === 0) return null;
            if (candidates.length > 1) return null;
            return candidates[0];
        },
        processAll() {
            if (!isPageActive()) return;

            if (this.cache.length === 0) {
                if (CONFIG.debug) console.log('[OpenMarket] Fetch cache empty, falling back to DOM reading for Item Market.');
                qsa(this.selectors.tile).forEach(el => {
                    const img = el.querySelector('img');
                    if (!img) return;
                    const match = img.src.match(/\/images\/items\/(\d+)\//);
                    if (!match) return;
                    const itemID = parseInt(match[1], 10);
                    if (!BASE_STATS_MAP[itemID]) return;

                    const stats = extractStats(el, this.selectors);
                    if (stats.damage === 0 && stats.accuracy === 0 && stats.armour === 0) {
                        if (BASE_STATS_MAP[itemID].baseArmour === 0) return;
                    }

                    processItem(el, {
                        itemID: itemID,
                        stats: stats,
                        bonuses: extractBonusesFromDOM(el, this.selectors),
                        selectors: this.selectors
                    });
                });
                return;
            }

            qsa(this.selectors.tile).forEach(el => {
                const cached = this.matchToCache(el);
                if (!cached) return;
                processItem(el, {
                    itemID: cached.itemID,
                    stats: { damage: cached.damage || 0, accuracy: cached.accuracy || 0, armour: cached.armor || 0 },
                    bonuses: cached.bonuses || [],
                    selectors: this.selectors
                });
            });
        },
        init() {
            const self = this;
            waitForRoot(this.selectors.root, (root) => {
                self.pendingTimeoutId = null;
                const observer = new MutationObserver(() => {
                    self.processAll();
                    if (sortState.active) {
                        clearTimeout(sortState.sortTimeout);
                        sortState.sortTimeout = setTimeout(applyBonusSort, 100);
                    }
                });
                observer.observe(root, { childList: true, subtree: true });
                self.observer = observer;
                self.processAll();
            }, 10, (timeoutId) => { self.pendingTimeoutId = timeoutId; });
        }
    };

    const auctionHouse = {
        selectors: SELECTORS.auctionHouse, observer: null, pendingTimeoutId: null,
        processAll() {
            if (!isPageActive()) return;
            const visibleTab = qs(this.selectors.visibleTab);
            if (!visibleTab) return;
            qsa(this.selectors.tile, visibleTab).forEach(el => {
                const hoverEl = qs(this.selectors.itemHover, el);
                const itemID = hoverEl?.getAttribute('item');
                if (!itemID || !BASE_STATS_MAP[itemID]) return;
                const stats = extractStats(el, this.selectors);
                if (stats.damage === 0 && stats.accuracy === 0 && stats.armour === 0) return;
                processItem(el, { itemID, stats, bonuses: extractBonusesFromDOM(el, this.selectors), selectors: this.selectors, hideElements: [qs(this.selectors.rarityLine, qs(this.selectors.title, el))] });
            });
        },
        init() {
