// ==UserScript==
// @name         Mobster & Cyclist Alert
// @namespace    https://greasyfork.org/users/cowboyup
// @version      1.8.1
// @description  Acoustical + green highlight alerts for Torn pickpocketing targets, filterable by gender, status and build. Standalone or Script Hub.
// @author       cowboyup
// @match        https://www.torn.com/page.php?sid=crimes*
// @match        https://www.torn.com/loader.php?sid=crimes*
// @icon         https://www.google.com/s2/favicons?sz=64&domain=torn.com
// @grant        none
// @license      MIT
// @downloadURL https://update.greasyfork.org/scripts/591579/Mobster%20%20Cyclist%20Alert.user.js
// @updateURL https://update.greasyfork.org/scripts/591579/Mobster%20%20Cyclist%20Alert.meta.js
// ==/UserScript==

(function () {
    'use strict';

    const HUB_ID = 'mobster-cyclist-alert';
    const SCRIPT_NAME = 'Mobster & Cyclist Alert';
    const SCRIPT_VERSION = '1.8.1';
    const QUEUE_PROPERTY = '__tornScriptHubQueue';

    // Status icon values as Torn reports them (crimeInfo.status.icon) -> display label.
    const STATUS_LABELS = {
        walking: 'Walking',
        running: 'Running',
        phone: 'On Phone',
        music: 'Listening to music',
        distracted: 'Distracted',
        stumbling: 'Stumbling',
        loitering: 'Loitering',
        begging: 'Begging',
        soliciting: 'Soliciting',
        cycling: 'Cycling'
    };

    // id: kept stable so saved settings carry over (legacy = the original five targets).
    // title: as Torn reports it, lowercase. gender: set when the name already says it.
    // statuses: the statuses seen for that target in Torn's payload.
    const TARGET_DEFS = [
        { id: 'businessman', title: 'businessman', label: 'Businessman', gender: 'male', statuses: ['walking', 'phone'] },
        { id: 'businesswoman', title: 'businesswoman', label: 'Businesswoman', gender: 'female', statuses: ['walking', 'phone'] },
        { id: 'classyLadyWalking', title: 'classy lady', label: 'Classy Lady', gender: 'female', statuses: ['walking', 'phone'], legacy: true, defaultBeeps: 2, defaultStatuses: ['walking'] },
        { id: 'cyclist', title: 'cyclist', label: 'Cyclist', statuses: ['cycling'], legacy: true, defaultBeeps: 1 },
        { id: 'drunkMan', title: 'drunk man', label: 'Drunk Man', gender: 'male', statuses: ['distracted', 'stumbling'] },
        { id: 'drunkWoman', title: 'drunk woman', label: 'Drunk Woman', gender: 'female', statuses: ['distracted', 'stumbling'] },
        { id: 'elderlyMan', title: 'elderly man', label: 'Elderly Man', gender: 'male', statuses: ['walking'] },
        { id: 'elderlyWoman', title: 'elderly woman', label: 'Elderly Woman', gender: 'female', statuses: ['walking'] },
        { id: 'gangMember', title: 'gang member', label: 'Gang Member', statuses: ['loitering'] },
        { id: 'homelessPerson', title: 'homeless person', label: 'Homeless Person', statuses: ['loitering', 'begging'] },
        { id: 'jogger', title: 'jogger', label: 'Jogger', statuses: ['walking', 'running'], statusLabels: { running: 'Jogging' } },
        { id: 'junkie', title: 'junkie', label: 'Junkie', statuses: ['loitering', 'stumbling'] },
        { id: 'laborer', title: 'laborer', label: 'Laborer', statuses: ['walking', 'phone', 'distracted'] },
        { id: 'mobster', title: 'mobster', label: 'Mobster', statuses: ['walking'], legacy: true, defaultBeeps: 3 },
        { id: 'policeOfficerRunning', title: 'police officer', label: 'Police Officer', statuses: ['walking', 'running'], legacy: true, defaultBeeps: 4, defaultStatuses: ['running'] },
        { id: 'postalWorkerWalking', title: 'postal worker', label: 'Postal Worker', statuses: ['walking', 'distracted'], legacy: true, defaultBeeps: 1, defaultStatuses: ['walking'] },
        { id: 'richKid', title: 'rich kid', label: 'Rich Kid', statuses: ['walking', 'phone', 'music'] },
        { id: 'sexWorker', title: 'sex worker', label: 'Sex Worker', statuses: ['phone', 'distracted', 'soliciting'] },
        { id: 'student', title: 'student', label: 'Student', statuses: ['walking', 'running', 'phone', 'music'] },
        { id: 'thug', title: 'thug', label: 'Thug', statuses: ['walking', 'running', 'loitering'] },
        { id: 'youngMan', title: 'young man', label: 'Young Man', gender: 'male', statuses: ['walking', 'phone', 'music'] },
        { id: 'youngWoman', title: 'young woman', label: 'Young Woman', gender: 'female', statuses: ['walking', 'phone', 'music', 'distracted'] }
    ];

    const TARGETS = {};
    TARGET_DEFS.forEach(d => {
        TARGETS[d.id] = {
            titleMatch: d.title,
            label: d.label,
            fixedGender: d.gender || null,
            statuses: d.statuses,
            statusLabels: d.statusLabels || {},
            legacy: !!d.legacy,
            defaultBeeps: d.defaultBeeps || 1,
            defaultStatuses: d.defaultStatuses || []
        };
    });

    const TYPES = TARGET_DEFS.map(d => d.id);

    const REQUIRED_MUSCULAR = 'skinny';
    const GENDER_VALUES = ['any', 'female', 'male'];

    const DEFAULT_WAVEFORM = 'sine';
    const DEFAULT_VOLUME = 75;
    const BEEP_DURATION = 0.15;
    const BEEP_GAP = 0.12;
    const HIGHLIGHT_COLOR = '#00ff00';
    const HIGHLIGHT_RETRY_MS = 300;
    const HIGHLIGHT_RETRY_COUNT = 12;

    const STORAGE_KEY = (type, suffix) => `mca-${type}-${suffix}`;

    const lastAvailable = {};
    TYPES.forEach(t => { lastAvailable[t] = false; });

    // -------------------------------------------------------------------------
    // Hub detection
    // -------------------------------------------------------------------------
    function isHubPresent() {
        if (document.getElementById('tsh-sidebar-row')) return true;
        const q = window[QUEUE_PROPERTY];
        return !!(q && q.__tshPatched);
    }

    let hubPresent = isHubPresent();

    // -------------------------------------------------------------------------
    // Settings
    // -------------------------------------------------------------------------
    function loadSettings() {
        const settings = {};

        TYPES.forEach(type => {
            const t = TARGETS[type];
            const enabledRaw = localStorage.getItem(STORAGE_KEY(type, 'enabled'));
            const waveformRaw = localStorage.getItem(STORAGE_KEY(type, 'waveform'));
            const volumeRaw = localStorage.getItem(STORAGE_KEY(type, 'volume'));
            const beepsRaw = localStorage.getItem(STORAGE_KEY(type, 'beeps'));
            const genderRaw = localStorage.getItem(STORAGE_KEY(type, 'gender'));
            const skinnyRaw = localStorage.getItem(STORAGE_KEY(type, 'skinny'));
            const statusesRaw = localStorage.getItem(STORAGE_KEY(type, 'statuses'));

            let volume = volumeRaw !== null ? Number(volumeRaw) : DEFAULT_VOLUME;
            if (!Number.isFinite(volume)) volume = DEFAULT_VOLUME;
            volume = Math.max(1, Math.min(100, volume));

            let beeps = beepsRaw !== null ? Number(beepsRaw) : t.defaultBeeps;
            if (!Number.isFinite(beeps) || beeps < 1) beeps = t.defaultBeeps;
            beeps = Math.max(1, Math.min(10, beeps));

            let statuses = t.defaultStatuses.slice();
            if (statusesRaw !== null) {
                try {
                    const parsed = JSON.parse(statusesRaw);
                    if (Array.isArray(parsed)) statuses = parsed.filter(v => t.statuses.includes(v));
                } catch (err) { /* keep defaults */ }
            }

            settings[type] = {
                // new targets start off; the original five keep their old default
                enabled: enabledRaw !== null ? enabledRaw === 'true' : (t.legacy ? hubPresent : false),
                waveform: waveformRaw || DEFAULT_WAVEFORM,
                volume,
                beeps,
                gender: !t.fixedGender && GENDER_VALUES.includes(genderRaw) ? genderRaw : 'any',
                skinny: skinnyRaw !== null ? skinnyRaw === 'true' : true,
                statuses
            };
        });

        return settings;
    }

    const settings = loadSettings();

    function persistType(type) {
        const s = settings[type];
        localStorage.setItem(STORAGE_KEY(type, 'enabled'), String(!!s.enabled));
        localStorage.setItem(STORAGE_KEY(type, 'waveform'), s.waveform);
        localStorage.setItem(STORAGE_KEY(type, 'volume'), String(s.volume));
        localStorage.setItem(STORAGE_KEY(type, 'beeps'), String(s.beeps));
        localStorage.setItem(STORAGE_KEY(type, 'gender'), s.gender);
        localStorage.setItem(STORAGE_KEY(type, 'skinny'), String(!!s.skinny));
        localStorage.setItem(STORAGE_KEY(type, 'statuses'), JSON.stringify(s.statuses));
    }

    // -------------------------------------------------------------------------
    // Audio
    // -------------------------------------------------------------------------
    let audioCtx = null;

    function getAudioCtx() {
        if (!audioCtx) {
            const Ctx = window.AudioContext || window.webkitAudioContext;
            if (!Ctx) return null;
            audioCtx = new Ctx();
        }
        return audioCtx;
    }

    function unlockAudio() {
        const ctx = getAudioCtx();
        if (!ctx) return Promise.resolve(null);
        if (ctx.state === 'suspended') {
            return ctx.resume().then(() => ctx).catch(() => ctx);
        }
        return Promise.resolve(ctx);
    }

    ['pointerdown', 'keydown', 'touchstart'].forEach(evt => {
        document.addEventListener(evt, () => { unlockAudio(); }, { once: true, passive: true, capture: true });
    });

    function scheduleBeeps(ctx, count, waveform, volumePercent) {
        const peak = Math.max(0.0001, Math.min(1, (volumePercent || 0) / 100));
        const type = waveform || DEFAULT_WAVEFORM;
        for (let i = 0; i < count; i++) {
            const startTime = ctx.currentTime + i * (BEEP_DURATION + BEEP_GAP);
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = type;
            osc.frequency.value = 880;
            gain.gain.setValueAtTime(0.0001, startTime);
            gain.gain.exponentialRampToValueAtTime(peak, startTime + 0.01);
            gain.gain.exponentialRampToValueAtTime(0.0001, startTime + BEEP_DURATION);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(startTime);
            osc.stop(startTime + BEEP_DURATION + 0.02);
        }
    }

    function playAlert(type) {
        const s = settings[type];
        if (!s) return;
        const count = s.beeps || 1;
        unlockAudio().then(ctx => {
            if (!ctx) return;
            try {
                scheduleBeeps(ctx, count, s.waveform, s.volume);
            } catch (err) {
                console.log('[MCA] Beep failed', err);
            }
        });
    }

    // -------------------------------------------------------------------------
    // Crime detection
    // -------------------------------------------------------------------------
    function crimesListFromPayload(response) {
        const raw = response && response.DB && response.DB.crimesByType;
        if (!raw) return [];
        if (Array.isArray(raw)) return raw;
        if (typeof raw === 'object') return Object.values(raw);
        return [];
    }

    function crimeActivity(c) {
        const status = c && c.crimeInfo && c.crimeInfo.status;
        if (!status) return '';
        return String(status.icon || status.title || '').toLowerCase();
    }

    function crimeMuscular(c) {
        const m = c && c.crimeInfo && c.crimeInfo.muscular;
        return String(m || '').trim().toLowerCase();
    }

    function crimeGender(c) {
        const g = c && c.crimeInfo && c.crimeInfo.gender;
        return String(g || '').trim().toLowerCase();
    }

    function isAvailableFlag(c) {
        return c && (c.available === true || c.available === 1 || c.available === '1');
    }

    function titlesMatch(crimeTitle, targetTitle) {
        return String(crimeTitle || '').trim().toLowerCase() === String(targetTitle || '').trim().toLowerCase();
    }

    function isCrimeAvailable(crimes, type) {
        const target = TARGETS[type];
        if (!target) return false;
        const s = settings[type];

        for (let i = 0; i < crimes.length; i++) {
            const c = crimes[i];
            if (!c || !isAvailableFlag(c)) continue;
            if (!titlesMatch(c.title, target.titleMatch)) continue;

            if (s.skinny && crimeMuscular(c) !== REQUIRED_MUSCULAR) continue;
            if (!target.fixedGender && s.gender !== 'any' && crimeGender(c) !== s.gender) continue;
            if (s.statuses.length && !s.statuses.includes(crimeActivity(c))) continue;
            return true;
        }
        return false;
    }

    // -------------------------------------------------------------------------
    // Green highlight on available crime tiles
    // Matches unlocked .crime-option tiles by title. Retries briefly because
    // Torn's UI re-renders shortly after the crimesData response arrives.
    // -------------------------------------------------------------------------
    function applyHighlightOnce(titleMatch) {
        const needle = String(titleMatch || '').toLowerCase();
        if (!needle) return;
        document.querySelectorAll('.crime-option').forEach(tile => {
            if (tile.className.includes('locked')) return;
            if (!tile.textContent.toLowerCase().includes(needle)) return;
            tile.style.setProperty('background-color', HIGHLIGHT_COLOR, 'important');
        });
    }

    function highlightAvailable(type) {
        const titleMatch = TARGETS[type].titleMatch;
        let tries = 0;
        const timer = setInterval(() => {
            tries++;
            try {
                applyHighlightOnce(titleMatch);
            } catch (e) { /* ignore */ }
            if (tries >= HIGHLIGHT_RETRY_COUNT) clearInterval(timer);
        }, HIGHLIGHT_RETRY_MS);
    }

    function checkType(type, crimes) {
        const available = isCrimeAvailable(crimes, type);
        if (available && !lastAvailable[type] && settings[type] && settings[type].enabled) {
            playAlert(type);
            highlightAvailable(type);
        }
        lastAvailable[type] = available;
    }

    function handleCrimesPayload(response) {
        const crimes = crimesListFromPayload(response);
        if (!crimes.length) return;
        TYPES.forEach(type => checkType(type, crimes));
    }

    // -------------------------------------------------------------------------
    // Fetch intercept
    // -------------------------------------------------------------------------
    let watching = false;

    function interceptFetch(pathNeedles, onJson) {
        const needles = Array.isArray(pathNeedles) ? pathNeedles : [pathNeedles];
        const originalFetch = window.fetch;
        if (typeof originalFetch !== 'function') return;

        window.fetch = function () {
            const args = arguments;
            return originalFetch.apply(this, args).then(response => {
                try {
                    let url = '';
                    const arg0 = args[0];
                    if (typeof arg0 === 'string') url = arg0;
                    else if (arg0 && typeof arg0.url === 'string') url = arg0.url;
                    else url = String(arg0 || '');

                    if (needles.some(n => url.includes(n))) {
                        response.clone().json().then(data => {
                            try { onJson(data); } catch (e) {
                                console.log('[MCA] handler error', e);
                            }
                        }).catch(() => {});
                    }
                } catch (e) { /* ignore */ }
                return response;
            });
        };
    }

    function startWatching() {
        if (watching) return;
        watching = true;
        interceptFetch(['crimesData', 'sid=crimesData'], handleCrimesPayload);
    }

    // -------------------------------------------------------------------------
    // Standalone UI (when Hub is not present)
    // -------------------------------------------------------------------------
    const SETUP_OVERLAY_ID = 'mca-setup-overlay';
    const SETUP_STYLE_ID = 'mca-style';

