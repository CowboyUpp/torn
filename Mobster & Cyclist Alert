// ==UserScript==
// @name         Mobster & Cyclist Alert
// @namespace    https://greasyfork.org/users/cowboyup
// @version      1.5.8
// @description  Acoustical + green highlight alerts for skinny pickpocket targets (Mobster, Cyclist, Classy Lady walking, Police Officer running, Postal Worker walking). Standalone or Script Hub.
// @author       cowboyup
// @match        https://www.torn.com/page.php?sid=crimes*
// @match        https://www.torn.com/loader.php?sid=crimes*
// @icon         https://www.google.com/s2/favicons?sz=64&domain=torn.com
// @grant        none
// @license      MIT
// @downloadURL https://update.greasyfork.org/scripts/591579/Mobster%20%20Cyclist%20Alert.user.js
// @updateURL https://update.greasyfork.org/scripts/591579/Mobster%20%20Cyclist%20Alert.meta.js
// ==/UserScript==

(function () {
    'use strict';

    const HUB_ID = 'mobster-cyclist-alert';
    const SCRIPT_NAME = 'Mobster & Cyclist Alert';
    const SCRIPT_VERSION = '1.5.8';
    const QUEUE_PROPERTY = '__tornScriptHubQueue';

    const TARGETS = {
        classyLadyWalking: {
            titleMatch: 'classy lady',
            activity: 'walking',
            label: 'Classy Lady (Skinny + Walking)',
            defaultBeeps: 2
        },
        cyclist: {
            titleMatch: 'cyclist',
            activity: null,
            label: 'Cyclist (Skinny)',
            defaultBeeps: 1
        },
        mobster: {
            titleMatch: 'mobster',
            activity: null,
            label: 'Mobster (Skinny)',
            defaultBeeps: 3
        },
        policeOfficerRunning: {
            titleMatch: 'police officer',
            activity: 'running',
            label: 'Police Officer (Skinny + Running)',
            defaultBeeps: 4
        },
        postalWorkerWalking: {
            titleMatch: 'postal worker',
            activity: 'walking',
            label: 'Postal Worker (Skinny + Walking)',
            defaultBeeps: 1
        }
    };

    const TYPES = Object.keys(TARGETS).sort((a, b) =>
        TARGETS[a].label.localeCompare(TARGETS[b].label)
    );

    const REQUIRED_MUSCULAR = 'skinny';

    const DEFAULT_WAVEFORM = 'sine';
    const DEFAULT_VOLUME = 75;
    const BEEP_DURATION = 0.15;
    const BEEP_GAP = 0.12;
    const HIGHLIGHT_COLOR = '#00ff00';
    const HIGHLIGHT_RETRY_MS = 300;
    const HIGHLIGHT_RETRY_COUNT = 12;

    const STORAGE_KEY = (type, suffix) => `mca-${type}-${suffix}`;

    const lastAvailable = {};
    TYPES.forEach(t => { lastAvailable[t] = false; });

    // -------------------------------------------------------------------------
    // Hub detection
    // -------------------------------------------------------------------------
    function isHubPresent() {
        if (document.getElementById('tsh-sidebar-row')) return true;
        const q = window[QUEUE_PROPERTY];
        return !!(q && q.__tshPatched);
    }

    let hubPresent = isHubPresent();

    // -------------------------------------------------------------------------
    // Settings
    // -------------------------------------------------------------------------
    function loadSettings() {
        const settings = {};

        TYPES.forEach(type => {
            const enabledRaw = localStorage.getItem(STORAGE_KEY(type, 'enabled'));
            const waveformRaw = localStorage.getItem(STORAGE_KEY(type, 'waveform'));
            const volumeRaw = localStorage.getItem(STORAGE_KEY(type, 'volume'));
            const beepsRaw = localStorage.getItem(STORAGE_KEY(type, 'beeps'));

            let volume = volumeRaw !== null ? Number(volumeRaw) : DEFAULT_VOLUME;
            if (!Number.isFinite(volume)) volume = DEFAULT_VOLUME;
            volume = Math.max(1, Math.min(100, volume));

            let beeps = beepsRaw !== null ? Number(beepsRaw) : TARGETS[type].defaultBeeps;
            if (!Number.isFinite(beeps) || beeps < 1) beeps = TARGETS[type].defaultBeeps;
            beeps = Math.max(1, Math.min(10, beeps));

            settings[type] = {
                enabled: enabledRaw !== null ? enabledRaw === 'true' : hubPresent,
                waveform: waveformRaw || DEFAULT_WAVEFORM,
                volume,
                beeps
            };
        });

        return settings;
    }

    const settings = loadSettings();

    function persistType(type) {
        const s = settings[type];
        localStorage.setItem(STORAGE_KEY(type, 'enabled'), String(!!s.enabled));
        localStorage.setItem(STORAGE_KEY(type, 'waveform'), s.waveform);
        localStorage.setItem(STORAGE_KEY(type, 'volume'), String(s.volume));
        localStorage.setItem(STORAGE_KEY(type, 'beeps'), String(s.beeps));
    }

    // -------------------------------------------------------------------------
    // Audio
    // -------------------------------------------------------------------------
    let audioCtx = null;

    function getAudioCtx() {
        if (!audioCtx) {
            const Ctx = window.AudioContext || window.webkitAudioContext;
            if (!Ctx) return null;
            audioCtx = new Ctx();
        }
        return audioCtx;
    }

    function unlockAudio() {
        const ctx = getAudioCtx();
        if (!ctx) return Promise.resolve(null);
        if (ctx.state === 'suspended') {
            return ctx.resume().then(() => ctx).catch(() => ctx);
        }
        return Promise.resolve(ctx);
    }

    ['pointerdown', 'keydown', 'touchstart'].forEach(evt => {
        document.addEventListener(evt, () => { unlockAudio(); }, { once: true, passive: true, capture: true });
    });

    function scheduleBeeps(ctx, count, waveform, volumePercent) {
        const peak = Math.max(0.0001, Math.min(1, (volumePercent || 0) / 100));
        const type = waveform || DEFAULT_WAVEFORM;
        for (let i = 0; i < count; i++) {
            const startTime = ctx.currentTime + i * (BEEP_DURATION + BEEP_GAP);
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = type;
            osc.frequency.value = 880;
            gain.gain.setValueAtTime(0.0001, startTime);
            gain.gain.exponentialRampToValueAtTime(peak, startTime + 0.01);
            gain.gain.exponentialRampToValueAtTime(0.0001, startTime + BEEP_DURATION);
            osc.connect(gain);
            gain.connect(ctx.destination);
            osc.start(startTime);
            osc.stop(startTime + BEEP_DURATION + 0.02);
        }
    }

    function playAlert(type) {
        const s = settings[type];
        if (!s) return;
        const count = s.beeps || 1;
        unlockAudio().then(ctx => {
            if (!ctx) return;
            try {
                scheduleBeeps(ctx, count, s.waveform, s.volume);
            } catch (err) {
                console.log('[MCA] Beep failed', err);
            }
        });
    }

    // -------------------------------------------------------------------------
    // Crime detection
    // -------------------------------------------------------------------------
    function crimesListFromPayload(response) {
        const raw = response && response.DB && response.DB.crimesByType;
        if (!raw) return [];
        if (Array.isArray(raw)) return raw;
        if (typeof raw === 'object') return Object.values(raw);
        return [];
    }

    function crimeActivity(c) {
        const status = c && c.crimeInfo && c.crimeInfo.status;
        if (!status) return '';
        return String(status.icon || status.title || '').toLowerCase();
    }

    function crimeMuscular(c) {
        const m = c && c.crimeInfo && c.crimeInfo.muscular;
        return String(m || '').trim().toLowerCase();
    }

    function isAvailableFlag(c) {
        return c && (c.available === true || c.available === 1 || c.available === '1');
    }

    function titlesMatch(crimeTitle, targetTitle) {
        return String(crimeTitle || '').trim().toLowerCase() === String(targetTitle || '').trim().toLowerCase();
    }

    function isCrimeAvailable(crimes, type) {
        const target = TARGETS[type];
        if (!target) return false;

        for (let i = 0; i < crimes.length; i++) {
            const c = crimes[i];
            if (!c || !isAvailableFlag(c)) continue;
            if (!titlesMatch(c.title, target.titleMatch)) continue;

            if (crimeMuscular(c) !== REQUIRED_MUSCULAR) continue;

            if (target.activity) {
                if (crimeActivity(c).includes(target.activity)) return true;
            } else {
                return true;
            }
        }
        return false;
    }

    // -------------------------------------------------------------------------
    // Green highlight on available crime tiles
    // Matches unlocked .crime-option tiles by title. Retries briefly because
    // Torn's UI re-renders shortly after the crimesData response arrives.
    // -------------------------------------------------------------------------
    function applyHighlightOnce(titleMatch) {
        const needle = String(titleMatch || '').toLowerCase();
        if (!needle) return;
        document.querySelectorAll('.crime-option').forEach(tile => {
            if (tile.className.includes('locked')) return;
            if (!tile.textContent.toLowerCase().includes(needle)) return;
            tile.style.setProperty('background-color', HIGHLIGHT_COLOR, 'important');
        });
    }

    function highlightAvailable(type) {
        const titleMatch = TARGETS[type].titleMatch;
        let tries = 0;
        const timer = setInterval(() => {
            tries++;
            try {
                applyHighlightOnce(titleMatch);
            } catch (e) { /* ignore */ }
            if (tries >= HIGHLIGHT_RETRY_COUNT) clearInterval(timer);
        }, HIGHLIGHT_RETRY_MS);
    }

    function checkType(type, crimes) {
        const available = isCrimeAvailable(crimes, type);
        if (available && !lastAvailable[type] && settings[type] && settings[type].enabled) {
            playAlert(type);
            highlightAvailable(type);
        }
        lastAvailable[type] = available;
    }

    function handleCrimesPayload(response) {
        const crimes = crimesListFromPayload(response);
        if (!crimes.length) return;
        TYPES.forEach(type => checkType(type, crimes));
    }

    // -------------------------------------------------------------------------
    // Fetch intercept
    // -------------------------------------------------------------------------
    let watching = false;

    function interceptFetch(pathNeedles, onJson) {
        const needles = Array.isArray(pathNeedles) ? pathNeedles : [pathNeedles];
        const originalFetch = window.fetch;
        if (typeof originalFetch !== 'function') return;

        window.fetch = function () {
            const args = arguments;
            return originalFetch.apply(this, args).then(response => {
                try {
                    let url = '';
                    const arg0 = args[0];
                    if (typeof arg0 === 'string') url = arg0;
                    else if (arg0 && typeof arg0.url === 'string') url = arg0.url;
                    else url = String(arg0 || '');

                    if (needles.some(n => url.includes(n))) {
                        response.clone().json().then(data => {
                            try { onJson(data); } catch (e) {
                                console.log('[MCA] handler error', e);
                            }
                        }).catch(() => {});
                    }
                } catch (e) { /* ignore */ }
                return response;
            });
        };
    }

    function startWatching() {
        if (watching) return;
        watching = true;
        interceptFetch(['crimesData', 'sid=crimesData'], handleCrimesPayload);
    }

    // -------------------------------------------------------------------------
    // Standalone UI (when Hub is not present)
    // -------------------------------------------------------------------------
    function waitForElementToExist(selector) {
        return new Promise(resolve => {
            const el = document.querySelector(selector);
            if (el) return resolve(el);
            const obs = new MutationObserver(() => {
                const found = document.querySelector(selector);
                if (found) {
                    obs.disconnect();
                    resolve(found);
                }
            });
            obs.observe(document.documentElement, { childList: true, subtree: true });
        });
    }

    function updateButtonLabel(type) {
        const $ = window.jQuery || window.$;
        if (!$) return;
        const $btn = $('#' + type + '-toggle-btn');
        if (!$btn.length) return;
        $btn.text((settings[type].enabled ? 'Disable' : 'Enable') + ' ' + TARGETS[type].label);
        $btn.css('background-color', settings[type].enabled ? '#2e7d32' : '');
    }

    function toggleAlert(type) {
        settings[type].enabled = !settings[type].enabled;
        persistType(type);
        updateButtonLabel(type);
        unlockAudio().then(() => {
            if (settings[type].enabled) playAlert(type);
        });
    }

    function initStandaloneUI() {
        waitForElementToExist('.pickpocketing-root').then(() => {
            if (hubPresent) return;
            const $ = window.jQuery || window.$;
            if (!$) return;
            if (document.getElementById('crime-alert-div')) return;

            let html = '<div id="crime-alert-div" style="margin-bottom:10px;">';
            TYPES.forEach(type => {
                html += '<a id="' + type + '-toggle-btn" class="torn-btn btn-big" style="margin-right:5px;margin-bottom:5px;display:inline-block;"></a>';
            });
            html += '</div>';
            $('.pickpocketing-root').append(html);

            TYPES.forEach(type => {
                updateButtonLabel(type);
                $('#' + type + '-toggle-btn').on('click', () => toggleAlert(type));
            });
        });
    }

    function removeStandaloneUI() {
        const div = document.getElementById('crime-alert-div');
        if (div) div.remove();
    }

    // -------------------------------------------------------------------------
    // Script Hub prefs — lean: enable, beeps, tone, volume, test
    // -------------------------------------------------------------------------
    const WAVEFORM_OPTIONS = [
        { value: 'sine', label: 'Sine (soft)' },
        { value: 'triangle', label: 'Triangle' },
        { value: 'square', label: 'Square (harsh)' },
        { value: 'sawtooth', label: 'Sawtooth (buzzy)' }
    ];

    function buildPrefFields() {
        const fields = [];

        TYPES.forEach(type => {
            fields.push({
                key: type + 'Enabled',
                label: 'On/Off',
                type: 'toggle',
                default: settings[type].enabled
            });
            fields.push({
                key: type + 'Beeps',
                label: 'Beep count',
                type: 'number',
                min: 1,
                max: 10,
                step: 1,
                hint: 'Beeps when a matching skinny target is available (1–10)'
            });
            fields.push({
                key: type + 'Volume',
                label: 'Volume (%)',
                type: 'number',
                min: 1,
                max: 100,
                step: 5
            });
            fields.push({
                key: type + 'Waveform',
                label: 'Tone',
                type: 'select',
                options: WAVEFORM_OPTIONS,
                hint: 'System beep waveform'
            });
            fields.push({
                key: type + 'Test',
                label: 'Test',
                type: 'button',
                onClick: () => unlockAudio().then(() => playAlert(type))
            });
        });

        return fields;
    }

    function buildPrefSections() {
        return TYPES.map(type => ({
            title: TARGETS[type].label,
            keys: [
                type + 'Enabled',
                type + 'Beeps',
                type + 'Volume',
                type + 'Waveform',
                type + 'Test'
            ]
        }));
    }

    function buildPrefValues() {
        const values = {};
        TYPES.forEach(type => {
            values[type + 'Enabled'] = settings[type].enabled;
            values[type + 'Beeps'] = settings[type].beeps;
            values[type + 'Waveform'] = settings[type].waveform;
            values[type + 'Volume'] = settings[type].volume;
        });
        return values;
    }

    function applyPrefValues(values) {
        TYPES.forEach(type => {
            const wasEnabled = settings[type].enabled;
            const nowEnabled = !!values[type + 'Enabled'];

            settings[type].enabled = nowEnabled;
            settings[type].waveform = values[type + 'Waveform'] || DEFAULT_WAVEFORM;

            let beeps = Number(values[type + 'Beeps']);
            if (!Number.isFinite(beeps) || beeps < 1) beeps = TARGETS[type].defaultBeeps;
            settings[type].beeps = Math.max(1, Math.min(10, beeps));

            let vol = Number(values[type + 'Volume']);
            if (!Number.isFinite(vol) || vol <= 0) vol = DEFAULT_VOLUME;
            settings[type].volume = Math.max(1, Math.min(100, vol));

            persistType(type);

            if (nowEnabled && !wasEnabled) {
                unlockAudio().then(() => playAlert(type));
            }
        });
    }

    function registerWithHub() {
        const registration = {
            id: HUB_ID,
            name: SCRIPT_NAME,
            version: SCRIPT_VERSION,
            order: 200,
            open: () => {
                document.dispatchEvent(new CustomEvent('torn-script-hub:open', {
                    detail: { scriptId: HUB_ID }
                }));
            },
            status: () => '',
            prefs: {
                fields: buildPrefFields(),
                sections: buildPrefSections(),
                values: buildPrefValues(),
                onSave: values => applyPrefValues(values)
            }
        };

        (window[QUEUE_PROPERTY] = window[QUEUE_PROPERTY] || []).push(registration);
        document.dispatchEvent(new CustomEvent('torn-script-hub:register', { detail: registration }));
    }

    function adoptHubMode() {
        hubPresent = true;
        removeStandaloneUI();
        registerWithHub();
    }

    function watchForHub() {
        if (hubPresent) return;
        const poll = setInterval(() => {
            if (isHubPresent()) {
                clearInterval(poll);
                adoptHubMode();
            }
        }, 500);
        document.addEventListener('torn-script-hub:ready', () => {
            clearInterval(poll);
            if (!hubPresent) adoptHubMode();
        }, { once: true });
    }

    // -------------------------------------------------------------------------
    // Start
    // -------------------------------------------------------------------------
    startWatching();
    initStandaloneUI();
    registerWithHub();

    if (hubPresent) {
        adoptHubMode();
    } else {
        watchForHub();
    }

    console.log('[MCA] v' + SCRIPT_VERSION + ' started · hub=' + hubPresent + ' · skinny-only');
})();
