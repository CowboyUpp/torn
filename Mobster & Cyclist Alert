// ==UserScript==
// @name         Mobster & Cyclist Alert
// @namespace    https://greasyfork.org/users/cowboyup
// @version      1.0.0
// @description  Mobster & Cyclist Acoustical Alert — standalone, or managed by Torn Script Hub when installed
// @author       cowboyup
// @match        https://www.torn.com/page.php?sid=crimes
// @icon         https://www.google.com/s2/favicons?sz=64&domain=torn.com
// @grant        none
// @license      MIT
// @downloadURL  https://update.greasyfork.org/scripts/591579/Mobster%20%26%20Cyclist%20Alert.user.js
// @updateURL    https://update.greasyfork.org/scripts/591579/Mobster%20%26%20Cyclist%20Alert.meta.js
// ==/UserScript==

(function() {
    'use strict';

    const HUB_ID = 'mobster-cyclist-alert';
    const SCRIPT_NAME = 'Mobster & Cyclist Alert';
    const SCRIPT_VERSION = '1.0.0';
    const QUEUE_PROPERTY = '__tornScriptHubQueue';

    const STORAGE_KEYS = {
        mobster: 'mca-mobster-enabled',
        cyclist: 'mca-cyclist-enabled'
    };

    // Edge-triggered: only alert once per availability window, not on every poll
    const lastAvailable = {
        mobster: false,
        cyclist: false
    };

    // =========================================================================
    // HUB DETECTION
    // =========================================================================
    // Torn Script Hub runs at document-start on every torn.com page and, if
    // present, synchronously patches window.__tornScriptHubQueue (marking it
    // __tshPatched) before our document-idle script runs. That flag is a
    // reliable signal the Hub is installed and already initialized.
    function isHubPresent() {
        const q = window[QUEUE_PROPERTY];
        return !!(q && q.__tshPatched);
    }

    const hubPresent = isHubPresent();

    // =========================================================================
    // STATE — default depends on mode: on when the Hub manages it,
    // off (manual activation required) when running standalone.
    // A previously saved user preference always takes priority.
    // =========================================================================
    function loadState() {
        const modeDefault = hubPresent;
        const mobsterRaw = localStorage.getItem(STORAGE_KEYS.mobster);
        const cyclistRaw = localStorage.getItem(STORAGE_KEYS.cyclist);
        return {
            mobster: mobsterRaw !== null ? mobsterRaw === 'true' : modeDefault,
            cyclist: cyclistRaw !== null ? cyclistRaw === 'true' : modeDefault
        };
    }

    const state = loadState();

    function persist() {
        localStorage.setItem(STORAGE_KEYS.mobster, state.mobster);
        localStorage.setItem(STORAGE_KEYS.cyclist, state.cyclist);
    }

    // =========================================================================
    // SYSTEM BEEP (Web Audio API — no external audio file)
    // =========================================================================
    let audioCtx = null;
    const BEEP_DURATION = 0.15; // seconds
    const BEEP_GAP = 0.12;      // seconds between repeated beeps

    function getAudioCtx() {
        if (!audioCtx) {
            const Ctx = window.AudioContext || window.webkitAudioContext;
            if (!Ctx) return null;
            audioCtx = new Ctx();
        }
        if (audioCtx.state === 'suspended') {
            audioCtx.resume();
        }
        return audioCtx;
    }

    function beep(count) {
        const ctx = getAudioCtx();
        if (!ctx) return;
        for (let i = 0; i < count; i++) {
            const startTime = ctx.currentTime + i * (BEEP_DURATION + BEEP_GAP);
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'sine';
            osc.frequency.value = 880;
            gain.gain.setValueAtTime(0.0001, startTime);
            gain.gain.exponentialRampToValueAtTime(0.75, startTime + 0.01);
            gain.gain.exponentialRampToValueAtTime(0.0001, startTime + BEEP_DURATION);
            osc.connect(gain).connect(ctx.destination);
            osc.start(startTime);
            osc.stop(startTime + BEEP_DURATION + 0.02);
        }
    }

    // =========================================================================
    // CRIME DETECTION
    // =========================================================================
    function isCrimeAvailable(crimes, title) {
        for (let i = 0; i < crimes.length; i++) {
            if (crimes[i].title === title && crimes[i].available === true) {
                return true;
            }
        }
        return false;
    }

    function highlightAvailable() {
        /* Highlight all available crime icons (generic, unchanged from prior versions) */
        $('.CircularProgressbar').nextAll().each(function() {
            if ($(this).css('background-position-y') == '0px') {
                $(this).parent().parent().parent().parent().css("background-color", "#00ff00");
            }
        });
    }

    function checkType(type, title, crimes, beepCount) {
        const available = isCrimeAvailable(crimes, title);
        if (available && !lastAvailable[type] && state[type]) {
            beep(beepCount);
            highlightAvailable();
        }
        lastAvailable[type] = available;
    }

    function startWatching() {
        interceptFetch("torn.com", "/page.php?sid=crimesData", (response) => {
            const crimes = response.DB.crimesByType;
            checkType('cyclist', 'Cyclist', crimes, 1);
            checkType('mobster', 'Mobster', crimes, 3);
        });
    }

    // =========================================================================
    // STANDALONE MODE — on-page toggle buttons (Hub not installed)
    // =========================================================================
    function initStandaloneUI() {
        waitForElementToExist('.pickpocketing-root').then(() => {
            $('.pickpocketing-root').append(`
                <div id="crime-alert-div">
                    <a id="mobster-toggle-btn" class="torn-btn btn-big"></a>
                    &nbsp;
                    <a id="cyclist-toggle-btn" class="torn-btn btn-big"></a>
                    <br/><br/>
                </div>
            `);

            updateButtonLabel('mobster');
            updateButtonLabel('cyclist');

            $('#mobster-toggle-btn').click(() => toggleAlert('mobster'));
            $('#cyclist-toggle-btn').click(() => toggleAlert('cyclist'));

            startWatching();
        });
    }

    function toggleAlert(type) {
        state[type] = !state[type];
        persist();
        updateButtonLabel(type);

        if (state[type]) {
            // Test beep when enabled, using this type's pattern
            beep(type === 'mobster' ? 3 : 1);
        }
    }

    function updateButtonLabel(type) {
        const label = type === 'mobster' ? 'Mobster' : 'Cyclist';
        const $btn = $(`#${type}-toggle-btn`);
        $btn.text(`${state[type] ? 'Disable' : 'Enable'} ${label} Alert`);
        $btn.css('background-color', state[type] ? '#2e7d32' : '');
    }

    // =========================================================================
    // HUB MODE — no page UI, registers with Torn Script Hub for control
    // =========================================================================
    function registerWithHub() {
        const registration = {
            id: HUB_ID,
            name: SCRIPT_NAME,
            version: SCRIPT_VERSION,
            order: 200,
            open: () => {
                // No standalone UI of its own — jump straight to this script's
                // Settings panel in the Hub dashboard.
                document.dispatchEvent(new CustomEvent('torn-script-hub:open', {
                    detail: { scriptId: HUB_ID }
                }));
            },
            status: () => `Mobster: ${state.mobster ? 'On' : 'Off'} · Cyclist: ${state.cyclist ? 'On' : 'Off'}`,
            prefs: {
                fields: [
                    { key: 'mobster', label: 'Mobster Alert (3 beeps)', type: 'toggle', default: state.mobster },
                    { key: 'cyclist', label: 'Cyclist Alert (1 beep)', type: 'toggle', default: state.cyclist }
                ],
                values: {
                    mobster: state.mobster,
                    cyclist: state.cyclist
                },
                onSave: (values) => {
                    const turningOnMobster = !!values.mobster && !state.mobster;
                    const turningOnCyclist = !!values.cyclist && !state.cyclist;

                    state.mobster = !!values.mobster;
                    state.cyclist = !!values.cyclist;
                    persist();

                    // Test beep on enable, same pattern as the live alert
                    if (turningOnMobster) beep(3);
                    if (turningOnCyclist) beep(1);
                }
            }
        };

        (window[QUEUE_PROPERTY] = window[QUEUE_PROPERTY] || []).push(registration);
    }

    function initHubMode() {
        registerWithHub();
        waitForElementToExist('.pickpocketing-root').then(() => {
            startWatching();
        });
    }

    // =========================================================================
    // START
    // =========================================================================
    if (hubPresent) {
        initHubMode();
    } else {
        initStandaloneUI();
    }
})();

function interceptFetch(url, q, callback) {
	const originalFetch = window.fetch;

	window.fetch = function() {
		return new Promise((resolve, reject) => {
			return originalFetch.apply(this, arguments).then(function(data) {
					let dataurl = data.url.toString();
					if (dataurl.includes(url) && dataurl.includes(q)) {
						const clone = data.clone();
						if (clone) {
							clone.json().then((response) => callback(response, data.url))
								.catch((error) => {
									console.log("[MobsterCyclistAlert][InterceptFetch] Error with clone.json(). Most likely not JSON data.", error)
								})
						}
					}

					resolve(data);
				})
				.catch((error) => {
					console.log("[MobsterCyclistAlert][InterceptFetch] Error with fetch.", error)
				})
		});
	};
}

function waitForElementToExist(selector) {
    return new Promise(resolve => {
        if (document.querySelector(selector)) {
            return resolve(document.querySelector(selector));
        }

        const observer = new MutationObserver(() => {
            if (document.querySelector(selector)) {
                resolve(document.querySelector(selector));
                observer.disconnect();
            }
        });

        observer.observe(document.body, {
            subtree: true,
            childList: true,
        });
    });
}
