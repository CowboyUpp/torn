// ==UserScript==
// @name         Mobster & Cyclist Alert
// @namespace    microbes.torn.ring
// @version      0.4.0
// @description  Mobster & Cyclist Acoustical Alert
// @author       cowboyup
// @match        https://www.torn.com/page.php?sid=crimes
// @icon         https://www.google.com/s2/favicons?sz=64&domain=torn.com
// @grant        none
// @license      MIT
// @downloadURL https://update.greasyfork.org/
// @updateURL https://update.greasyfork.org/
// ==/UserScript==

(function() {
    'use strict';

    const STORAGE_KEYS = {
        mobster: 'mobsterAlertEnabled',
        cyclist: 'cyclistAlertEnabled'
    };

    const state = {
        mobster: localStorage.getItem(STORAGE_KEYS.mobster) === 'true',
        cyclist: localStorage.getItem(STORAGE_KEYS.cyclist) === 'true'
    };

    const SOUND_URL = 'https://audio.jukehost.co.uk/gxd2HB9RibSHhr13OiW6ROCaaRbD8103';
    const BEEP_GAP_MS = 400; // gap between repeated beeps (e.g. Mobster's triple-beep)

    waitForElementToExist('.pickpocketing-root').then(() => {
        $('.pickpocketing-root').append(`
            <div id="crime-alert-div">
                <a id="mobster-toggle-btn" class="torn-btn btn-big"></a>
                &nbsp;
                <a id="cyclist-toggle-btn" class="torn-btn btn-big"></a>
                <br/><br/>
            </div>
        `);

        updateButtonLabel('mobster');
        updateButtonLabel('cyclist');

        $('#mobster-toggle-btn').click(() => toggleAlert('mobster'));
        $('#cyclist-toggle-btn').click(() => toggleAlert('cyclist'));

        // Always listen; whether we actually alert depends on each toggle's state
        interceptFetch("torn.com", "/page.php?sid=crimesData", (response) => {
            const crimes = response.DB.crimesByType;

            if (state.cyclist && isCrimeAvailable(crimes, "Cyclist")) {
                playBeeps(1);
                highlightAvailable();
            }

            if (state.mobster && isCrimeAvailable(crimes, "Mobster")) {
                playBeeps(3);
                highlightAvailable();
            }
        });
    });

    function toggleAlert(type) {
        state[type] = !state[type];
        localStorage.setItem(STORAGE_KEYS[type], state[type]);
        updateButtonLabel(type);

        if (state[type]) {
            // Test sound when enabled, using this type's beep pattern
            playBeeps(type === 'mobster' ? 3 : 1);
        }
    }

    function updateButtonLabel(type) {
        const label = type === 'mobster' ? 'Mobster' : 'Cyclist';
        const $btn = $(`#${type}-toggle-btn`);
        $btn.text(`${state[type] ? 'Disable' : 'Enable'} ${label} Alert`);
        $btn.css('background-color', state[type] ? '#2e7d32' : '');
    }

    function playBeeps(count) {
        for (let i = 0; i < count; i++) {
            setTimeout(() => {
                new Audio(SOUND_URL).play();
            }, i * BEEP_GAP_MS);
        }
    }

    function highlightAvailable() {
        /* Highlight all available crime icons (generic, matches original behavior) */
        $('.CircularProgressbar').nextAll().each(function() {
            if ($(this).css('background-position-y') == '0px') {
                $(this).parent().parent().parent().parent().css("background-color", "#00ff00");
            }
        });
    }

    function isCrimeAvailable(crimes, title) {
        for (let i = 0; i < crimes.length; i++) {
            if (crimes[i].title === title && crimes[i].available === true) {
                return true;
            }
        }
        return false;
    }
})();

function interceptFetch(url, q, callback) {
	const originalFetch = window.fetch;

	window.fetch = function() {
		return new Promise((resolve, reject) => {
			return originalFetch.apply(this, arguments).then(function(data) {
					let dataurl = data.url.toString();
					if (dataurl.includes(url) && dataurl.includes(q)) {
						const clone = data.clone();
						if (clone) {
							clone.json().then((response) => callback(response, data.url))
								.catch((error) => {
									console.log("[LoadoutShare][InterceptFetch] Error with clone.json(). Most likely not JSON data.", error)
								})
						}
					}

					resolve(data);
				})
				.catch((error) => {
					console.log("[LoadoutShare][InterceptFetch] Error with fetch.", error)
				})
		});
	};
}

function waitForElementToExist(selector) {
    return new Promise(resolve => {
        if (document.querySelector(selector)) {
            return resolve(document.querySelector(selector));
        }

        const observer = new MutationObserver(() => {
            if (document.querySelector(selector)) {
                resolve(document.querySelector(selector));
                observer.disconnect();
            }
        });

        observer.observe(document.body, {
            subtree: true,
            childList: true,
        });
    });
}
