        (document.head || document.documentElement).appendChild(style);
    }

    function closeSetupMulti() {
        const p = document.getElementById('mca-multi-pop');
        if (p) {
            if (p._cleanup) p._cleanup();
            p.remove();
        }
    }

    // Checkbox list popover anchored under a button (used for the Status column).
    function openSetupMulti(anchor, options, getSel, onToggle) {
        closeSetupMulti();
        const pop = document.createElement('div');
        pop.id = 'mca-multi-pop';
        pop.className = 'mca-pop';
        const sel = new Set(getSel());
        options.forEach(opt => {
            const row = document.createElement('label');
            row.className = 'mca-pop-row';
            const text = document.createElement('span');
            text.textContent = opt.label;
            const cb = document.createElement('input');
            cb.type = 'checkbox';
            cb.checked = sel.has(opt.value);
            cb.addEventListener('change', () => onToggle(opt.value, cb.checked));
            row.append(text, cb);
            pop.appendChild(row);
        });
        (anchor.closest('.mca-overlay') || document.body).appendChild(pop);

        const r = anchor.getBoundingClientRect();
        const w = Math.max(190, r.width);
        const left = Math.min(Math.max(8, r.left), Math.max(8, window.innerWidth - w - 8));
        let top = r.bottom + 4;
        const h = pop.offsetHeight;
        if (top + h > window.innerHeight - 8) top = Math.max(8, r.top - h - 4);
        pop.style.minWidth = w + 'px';
        pop.style.left = left + 'px';
        pop.style.top = top + 'px';

        const onDown = e => {
            if (!pop.contains(e.target) && !anchor.contains(e.target)) closeSetupMulti();
        };
        const onKey = e => {
            if (e.key === 'Escape') {
                e.stopPropagation();
                closeSetupMulti();
            }
        };
        pop._cleanup = () => {
            document.removeEventListener('pointerdown', onDown, true);
            document.removeEventListener('keydown', onKey, true);
        };
        document.addEventListener('pointerdown', onDown, true);
        document.addEventListener('keydown', onKey, true);
    }

    function createSetupControl(field, values) {
        const commit = () => applyPrefValues(values);
        const wrap = document.createElement('div');
        wrap.className = 'mca-cell';
        let el = null;

        if (field.type === 'label') {
            el = document.createElement('span');
            el.className = 'mca-name';
            el.textContent = field.text || field.label || field.key;
        } else if (field.type === 'toggle') {
            el = document.createElement('button');
            el.type = 'button';
            const paint = () => {
                const on = !!values[field.key];
                el.textContent = on ? 'On' : 'Off';
                el.className = 'mca-toggle' + (on ? ' mca-on' : '');
                el.setAttribute('aria-pressed', on ? 'true' : 'false');
            };
            paint();
            el.addEventListener('click', () => {
                values[field.key] = !values[field.key];
                paint();
                commit();
            });
        } else if (field.type === 'check') {
            el = document.createElement('input');
            el.type = 'checkbox';
            el.className = 'mca-check';
            el.checked = !!values[field.key];
            if (field.hint) el.title = field.hint;
            el.addEventListener('change', () => {
                values[field.key] = el.checked;
                commit();
            });
        } else if (field.type === 'select') {
            el = document.createElement('select');
            el.className = 'mca-input';
            (field.options || []).forEach(opt => {
                const o = document.createElement('option');
                o.value = opt.value;
                o.textContent = opt.label;
                if (String(values[field.key]) === String(opt.value)) o.selected = true;
                el.appendChild(o);
            });
            if (field.hint) el.title = field.hint;
            if (field.disabled) el.disabled = true;
            el.addEventListener('change', () => {
                values[field.key] = el.value;
                commit();
            });
        } else if (field.type === 'multi') {
            el = document.createElement('button');
            el.type = 'button';
            el.className = 'mca-multi';
            const getSel = () => (Array.isArray(values[field.key]) ? values[field.key] : []);
            const paint = () => {
                const sel = getSel().filter(v => field.options.some(o => o.value === v));
                let text = field.emptyLabel || 'Any';
                if (sel.length === 1) {
                    const o = field.options.find(x => x.value === sel[0]);
                    text = o ? o.label : sel[0];
                } else if (sel.length > 1) {
                    text = sel.length + ' selected';
                }
                el.textContent = text + ' \u25BE';
                el.title = field.hint || '';
            };
            paint();
            el.addEventListener('click', () => {
                if (document.getElementById('mca-multi-pop')) { closeSetupMulti(); return; }
                openSetupMulti(el, field.options, getSel, (value, on) => {
                    const next = getSel().filter(v => v !== value);
                    if (on) next.push(value);
                    values[field.key] = next;
                    paint();
                    commit();
                });
            });
        } else if (field.type === 'number') {
            el = document.createElement('input');
            el.type = 'number';
            el.className = 'mca-input';
            if (field.min !== undefined) el.min = field.min;
            if (field.max !== undefined) el.max = field.max;
            if (field.step !== undefined) el.step = field.step;
            el.value = values[field.key];
            el.addEventListener('change', () => {
                let v = Number(el.value);
                if (!Number.isFinite(v)) { el.value = values[field.key]; return; }
                if (field.min !== undefined) v = Math.max(field.min, v);
                if (field.max !== undefined) v = Math.min(field.max, v);
                el.value = v;
                values[field.key] = v;
                commit();
            });
        } else if (field.type === 'button') {
            el = document.createElement('button');
            el.type = 'button';
            el.className = 'mca-btn';
            el.textContent = field.icon || field.label || field.key;
            el.title = field.hint || field.label || '';
            el.addEventListener('click', () => {
                if (typeof field.onClick === 'function') field.onClick();
            });
        }

        if (el) wrap.appendChild(el);
        return wrap;
    }

    // Shows a small arrow (and an edge fade) only while columns are hidden to the right.
    function attachScrollHint(wrap, outer, btn) {
        const atEnd = () => wrap.scrollLeft >= (wrap.scrollWidth - wrap.clientWidth) - 2;
        const update = () => {
            const overflow = (wrap.scrollWidth - wrap.clientWidth) > 2;
            const end = atEnd();
            btn.hidden = !overflow;
            outer.classList.toggle('mca-more', overflow && !end);
            btn.textContent = end ? '\u25C2' : '\u25B8';
            btn.title = end ? 'Scroll back left' : 'Scroll right for more settings';
            btn.setAttribute('aria-label', btn.title);
        };
        btn.addEventListener('click', () => {
            const max = wrap.scrollWidth - wrap.clientWidth;
            const left = atEnd() ? 0 : Math.min(max, wrap.scrollLeft + wrap.clientWidth * 0.8);
            if (typeof wrap.scrollTo === 'function') wrap.scrollTo({ left, behavior: 'smooth' });
            else wrap.scrollLeft = left;
        });
        wrap.addEventListener('scroll', update, { passive: true });
        if (typeof ResizeObserver === 'function') new ResizeObserver(update).observe(wrap);
        else window.addEventListener('resize', update);
        requestAnimationFrame(update);
    }

    // Same field / section definitions the Hub renders, drawn here without the Hub.
    function renderSetupTable(body) {
        const fields = buildPrefFields();
        const byKey = new Map(fields.map(f => [f.key, f]));
        const values = buildPrefValues();
        const section = buildPrefSections()[0];

        const sec = document.createElement('div');
        sec.className = 'mca-section';
        const head0 = document.createElement('div');
        head0.className = 'mca-section-head';
        const title = document.createElement('div');
        title.className = 'mca-section-title';
        title.textContent = section.title;
        const hint = document.createElement('button');
        hint.type = 'button';
        hint.className = 'mca-scroll-hint';
        hint.hidden = true;
        head0.append(title, hint);
        sec.appendChild(head0);

        const outer = document.createElement('div');
        outer.className = 'mca-table-outer';
        const wrap = document.createElement('div');
        wrap.className = 'mca-table-wrap';
        const table = document.createElement('div');
        table.className = 'mca-table';
        if (section.minWidth) table.style.minWidth = section.minWidth;

        const head = document.createElement('div');
        head.className = 'mca-row mca-head';
        head.style.gridTemplateColumns = section.widths;
        section.columns.forEach(c => {
            const cell = document.createElement('span');
            cell.textContent = c;
            head.appendChild(cell);
        });
        table.appendChild(head);

        section.rows.forEach(keys => {
            const row = document.createElement('div');
            row.className = 'mca-row';
            row.style.gridTemplateColumns = section.widths;
            keys.forEach(k => {
                const f = byKey.get(k);
                row.appendChild(f ? createSetupControl(f, values) : document.createElement('span'));
            });
            table.appendChild(row);
        });

        wrap.appendChild(table);
        outer.appendChild(wrap);
        sec.appendChild(outer);
        body.appendChild(sec);
        attachScrollHint(wrap, outer, hint);
    }

    function onSetupKeydown(e) {
        if (e.key !== 'Escape') return;
        if (e.target && e.target.tagName === 'SELECT') return;
        if (document.getElementById('mca-multi-pop')) return;
        closeSetupPopup();
    }

    function closeSetupPopup() {
        const overlay = document.getElementById(SETUP_OVERLAY_ID);
        closeSetupMulti();
        if (overlay) overlay.remove();
        document.removeEventListener('keydown', onSetupKeydown, true);
    }

    function openSetupPopup() {
        if (document.getElementById(SETUP_OVERLAY_ID)) return;
        installSetupStyles();
        unlockAudio();

        const overlay = document.createElement('div');
        overlay.id = SETUP_OVERLAY_ID;
        overlay.className = 'mca-overlay';

        const backdrop = document.createElement('div');
        backdrop.className = 'mca-backdrop';
        backdrop.addEventListener('click', closeSetupPopup);

        const panel = document.createElement('div');
        panel.className = 'mca-panel';

        const header = document.createElement('div');
        header.className = 'mca-header';
        const title = document.createElement('div');
        title.className = 'mca-title';
        title.textContent = SCRIPT_NAME;
        const ver = document.createElement('span');
        ver.className = 'mca-ver';
        ver.textContent = 'v' + SCRIPT_VERSION;
        title.appendChild(ver);
        const close = document.createElement('button');
        close.type = 'button';
        close.className = 'mca-close';
        close.setAttribute('aria-label', 'Close');
        close.textContent = '\u00D7';
        close.addEventListener('click', closeSetupPopup);
        header.append(title, close);

        const body = document.createElement('div');
        body.className = 'mca-body';
        renderSetupTable(body);

        const footer = document.createElement('div');
        footer.className = 'mca-footer';
        footer.textContent = 'Changes are saved automatically.';

        panel.append(header, body, footer);
        overlay.append(backdrop, panel);
        document.body.appendChild(overlay);
        document.addEventListener('keydown', onSetupKeydown, true);
    }

    // Torn is a single-page app: the pickpocketing view is created and destroyed as you
    // navigate, so the button is re-added whenever the view appears without it.
    let standaloneObserver = null;

    function ensureStandaloneButton() {
        if (hubPresent) return;
        const root = document.querySelector('.pickpocketing-root');
        if (!root) return;
        if (root.querySelector('#crime-alert-div')) return;

        const stale = document.getElementById('crime-alert-div');
        if (stale) stale.remove();

        const box = document.createElement('div');
        box.id = 'crime-alert-div';
        box.style.marginBottom = '10px';

        const btn = document.createElement('a');
        btn.id = 'mca-setup-btn';
        btn.className = 'torn-btn btn-big';
        btn.style.display = 'inline-block';
        btn.textContent = SCRIPT_NAME + ' Setup';
        btn.addEventListener('click', e => {
            e.preventDefault();
            openSetupPopup();
        });

        box.appendChild(btn);
        root.appendChild(box);
    }

    function initStandaloneUI() {
        if (standaloneObserver) return;
        let pending = false;
        const schedule = () => {
            if (pending) return;
            pending = true;
            requestAnimationFrame(() => {
                pending = false;
                ensureStandaloneButton();
            });
        };
        standaloneObserver = new MutationObserver(schedule);
        standaloneObserver.observe(document.documentElement, { childList: true, subtree: true });
        schedule();
    }

    function removeStandaloneUI() {
        if (standaloneObserver) {
            standaloneObserver.disconnect();
            standaloneObserver = null;
        }
        const div = document.getElementById('crime-alert-div');
        if (div) div.remove();
        closeSetupPopup();
    }

    // -------------------------------------------------------------------------
    // Script Hub prefs — one table: on, target, gender, status, skinny, beeps, volume, tone, test
    // -------------------------------------------------------------------------
    const WAVEFORM_OPTIONS = [
        { value: 'sine', label: 'Sine' },
        { value: 'triangle', label: 'Triangle' },
        { value: 'square', label: 'Square' },
        { value: 'sawtooth', label: 'Sawtooth' }
    ];

    const GENDER_OPTIONS = [
        { value: 'any', label: 'Any' },
        { value: 'female', label: 'Female' },
        { value: 'male', label: 'Male' }
    ];
    const PREF_COLUMNS = ['On', 'Target', 'Gender', 'Status', 'Skinny', 'Beeps', 'Vol %', 'Tone', ''];
    const PREF_WIDTHS = '44px 112px 74px minmax(100px,1fr) 44px 44px 48px minmax(76px,.6fr) 30px';
    const PREF_MIN_WIDTH = '604px';
    const PREF_ROW_KEYS = ['Enabled', 'Name', 'Gender', 'Status', 'Skinny', 'Beeps', 'Volume', 'Waveform', 'Test'];

    function statusOptions(type) {
        const t = TARGETS[type];
        const order = Object.keys(STATUS_LABELS);
        return t.statuses.slice()
            .sort((a, b) => order.indexOf(a) - order.indexOf(b))
            .map(v => ({ value: v, label: t.statusLabels[v] || STATUS_LABELS[v] || v }));
    }

    function buildPrefFields() {
        const fields = [];

        TYPES.forEach(type => {
            const t = TARGETS[type];
            fields.push({
                key: type + 'Enabled',
                label: 'On',
                type: 'toggle',
                default: settings[type].enabled
            });
            fields.push({
                key: type + 'Name',
                label: 'Target',
                type: 'label',
                text: t.label
            });
            fields.push({
                key: type + 'Gender',
                label: 'Gender',
                type: 'select',
                options: GENDER_OPTIONS,
                disabled: !!t.fixedGender,
                hint: t.fixedGender ? 'Gender is part of the name' : 'Any alerts for both genders'
            });
            fields.push({
                key: type + 'Status',
                label: 'Status',
                type: 'multi',
                options: statusOptions(type),
                emptyLabel: 'Any',
                hint: 'Tick the statuses to alert for; none ticked alerts for all'
            });
            fields.push({
                key: type + 'Skinny',
                label: 'Skinny',
                type: 'check',
                hint: 'Checked: only alert for skinny targets'
            });
            fields.push({
                key: type + 'Beeps',
                label: 'Beeps',
                type: 'number',
                min: 1,
                max: 10,
                step: 1
            });
            fields.push({
                key: type + 'Volume',
                label: 'Volume (%)',
                type: 'number',
                min: 1,
                max: 100,
                step: 5
            });
            fields.push({
                key: type + 'Waveform',
                label: 'Tone',
                type: 'select',
                options: WAVEFORM_OPTIONS
            });
            fields.push({
                key: type + 'Test',
                label: 'Test tone',
                type: 'button',
                icon: '\uD83D\uDD0A',
                onClick: () => unlockAudio().then(() => playAlert(type))
            });
        });

        return fields;
    }

    function buildPrefSections() {
        return [{
            title: 'Targets',
            table: true,
            columns: PREF_COLUMNS,
            widths: PREF_WIDTHS,
            minWidth: PREF_MIN_WIDTH,
            rows: TYPES.map(type => PREF_ROW_KEYS.map(k => type + k))
        }];
    }

    function buildPrefValues() {
        const values = {};
        TYPES.forEach(type => {
            const t = TARGETS[type];
            values[type + 'Enabled'] = settings[type].enabled;
            values[type + 'Gender'] = t.fixedGender || settings[type].gender;
            values[type + 'Status'] = settings[type].statuses.slice();
            values[type + 'Skinny'] = settings[type].skinny;
            values[type + 'Beeps'] = settings[type].beeps;
            values[type + 'Waveform'] = settings[type].waveform;
            values[type + 'Volume'] = settings[type].volume;
        });
        return values;
    }

    function applyPrefValues(values) {
        TYPES.forEach(type => {
            const t = TARGETS[type];
            const wasEnabled = settings[type].enabled;
            const nowEnabled = !!values[type + 'Enabled'];

            settings[type].enabled = nowEnabled;
            settings[type].waveform = values[type + 'Waveform'] || DEFAULT_WAVEFORM;
            settings[type].gender = !t.fixedGender && GENDER_VALUES.includes(values[type + 'Gender']) ? values[type + 'Gender'] : 'any';
            settings[type].skinny = !!values[type + 'Skinny'];
            settings[type].statuses = Array.isArray(values[type + 'Status'])
                ? values[type + 'Status'].filter(v => t.statuses.includes(v))
                : [];

            let beeps = Number(values[type + 'Beeps']);
            if (!Number.isFinite(beeps) || beeps < 1) beeps = t.defaultBeeps;
            settings[type].beeps = Math.max(1, Math.min(10, beeps));

            let vol = Number(values[type + 'Volume']);
            if (!Number.isFinite(vol) || vol <= 0) vol = DEFAULT_VOLUME;
            settings[type].volume = Math.max(1, Math.min(100, vol));

            persistType(type);

            if (nowEnabled && !wasEnabled) {
                unlockAudio().then(() => playAlert(type));
            }
        });
    }

    function registerWithHub() {
        const registration = {
            id: HUB_ID,
            name: SCRIPT_NAME,
            version: SCRIPT_VERSION,
            order: 200,
            open: () => {
                document.dispatchEvent(new CustomEvent('torn-script-hub:open', {
                    detail: { scriptId: HUB_ID }
                }));
            },
            status: () => '',
            prefs: {
                fields: buildPrefFields(),
                sections: buildPrefSections(),
                values: buildPrefValues(),
                onSave: values => applyPrefValues(values)
            }
        };

        (window[QUEUE_PROPERTY] = window[QUEUE_PROPERTY] || []).push(registration);
        document.dispatchEvent(new CustomEvent('torn-script-hub:register', { detail: registration }));
    }

    function adoptHubMode() {
        hubPresent = true;
        removeStandaloneUI();
        registerWithHub();
    }

    function watchForHub() {
        if (hubPresent) return;
        const poll = setInterval(() => {
            if (isHubPresent()) {
                clearInterval(poll);
                adoptHubMode();
            }
        }, 500);
        document.addEventListener('torn-script-hub:ready', () => {
            clearInterval(poll);
            if (!hubPresent) adoptHubMode();
        }, { once: true });
    }

    // -------------------------------------------------------------------------
    // Start
    // -------------------------------------------------------------------------
    startWatching();
    initStandaloneUI();
    registerWithHub();

    if (hubPresent) {
        adoptHubMode();
    } else {
        watchForHub();
    }

    console.log('[MCA] v' + SCRIPT_VERSION + ' started · hub=' + hubPresent);
})();
