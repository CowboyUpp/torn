    function buildTooltipHTML(targetName, confidence, marketPrice, isAllClear, data) {
        const hasItem = userInventory.has(data.recommended);
        const warningFlag = !hasItem ? `<span class="tbh-warning" title="Missing recommended item: ${data.recommended}">⚠️</span>` : '';
        
        let confidenceClass = 'tbh-bad';
        let advice = `⚠️ High fail risk. Case ${data.cases} times.`;
        if (confidence >= 80) { confidenceClass = 'tbh-value'; advice = '🟢 Very Safe. Max confidence.'; }
        else if (confidence >= 40) { confidenceClass = 'tbh-moderate'; advice = `🟡 Sweet Spot. Safe to burgle.`; }

        const allClearBadge = isAllClear ? '<span class="tbh-all-clear">ALL CLEAR</span>' : '';
        const notableLoot = data.notable ? data.notable.join(', ') : 'Unknown';

        return `
            <div class="tbh-stat-row"><span>Target:</span> <strong>${targetName} ${warningFlag} ${allClearBadge}</strong></div>
            <div class="tbh-stat-row"><span>Confidence:</span> <span class="${confidenceClass}">${confidence}%</span></div>
            <div class="tbh-stat-row" style="font-size:11px; opacity:0.8;"><span>Advice:</span> <span>${advice}</span></div>
            <div class="tbh-stat-row"><span>Unique:</span> <span style="font-size:11px;">${data.unique || 'Unknown'}</span></div>
            <div class="tbh-stat-row"><span>Est. Value:</span> <span class="tbh-value">$${(marketPrice || 0).toLocaleString()}</span></div>
            <div class="tbh-stat-row"><span>Rec. Item:</span> <span style="color: ${hasItem ? '#4caf50' : '#ff4444'}; font-size:11px;">${hasItem ? '✅ In Inventory' : '❌ Missing'}</span></div>
            <div class="tbh-stat-row" style="margin-top:8px; border-top:1px solid #444; padding-top:6px;"><span style="font-size:11px; opacity:0.7;">Notable Regulars:</span></div>
            <div style="font-size:11px; color:#ccc; line-height:1.4;">${notableLoot}</div>
        `;
    }

    // =========================================================================
    // HELPER FUNCTIONS (Stolen from 5k-install script)
    // =========================================================================
    function getTargetItems(virtualList) {
        if (!virtualList) return [];
        return Array.from(virtualList.querySelectorAll('div[class*="virtualItem"]'))
            .filter(item => !item.querySelector('[class*="propertyTypeSection"]'));
    }

    function getBurgledPlaces() {
        const stats = document.querySelectorAll("button[class*='statistic']");
        const burgled = new Set();
        stats.forEach(button => {
            const label = button.querySelector("span[class*='label']");
            if (label && label.textContent.trim().endsWith(" burgled")) {
                const target = label.textContent.trim().replace(" burgled", "");
                burgled.add(target);
                // Add known aliases to the set
                if (target === 'Advertising Agency') { burgled.add('Advertisement Agency'); burgled.add('Ad Agency'); }
                if (target === 'Cleaning Agency') burgled.add('Cleaning Firm');
                if (target === 'Funeral Directors') { burgled.add('Funeral Home'); burgled.add('Funeral Parlor'); }
                if (target === 'Recruitment Agency') { burgled.add('Recruit Agency'); burgled.add('Temp Agency'); }
                if (target === 'Self Storage Facility') burgled.add('Self Storage');
                if (target === 'Dockside Warehouse') burgled.add('Docklands');
                if (target === 'Farm Storage Unit') burgled.add('Farm Storage');
            }
        });
        return burgled;
    }

    // =========================================================================
    // DOM MANIPULATION & OBSERVER
    // =========================================================================
    function processScoutedTargets() {
        const virtualList = document.querySelector('div[class*="virtualList"]');
        if (!virtualList) return;

        const targetRows = getTargetItems(virtualList);
        const burgledPlaces = getBurgledPlaces();

        targetRows.forEach(row => {
            if (row.dataset.tbhProcessed) return;
            
            // 1. Robust Target Name Extraction (Desktop & Mobile)
            const mobileTitle = row.querySelector('[class*="titleAndProgress"] > [class*="title"]');
            let targetName = "";
            let nameNode = null;

            if (mobileTitle) {
                targetName = mobileTitle.textContent.trim();
                nameNode = mobileTitle;
            } else {
                const titleCard = row.querySelector('[class*="crimeOptionSection"][class*="flexGrow"]') || row.querySelector('[class*="crimeOptionSection"]');
                if (titleCard) {
                    const firstTextNode = [...titleCard.childNodes].find(n => n.nodeType === Node.TEXT_NODE && n.nodeValue.trim());
                    if (firstTextNode) {
                        targetName = firstTextNode.nodeValue.trim();
                        nameNode = firstTextNode;
                    }
                }
            }

            // Resolve aliases
            let data = TARGET_DATA[targetName];
            if (data && data.ref) data = TARGET_DATA[data.ref];

            if (!targetName || !data) {
                row.dataset.tbhProcessed = "true";
                return;
            }
            
            row.dataset.tbhProcessed = "true";

            // 2. Accurate Confidence Extraction
            let confidence = 0;
            const progressFill = row.querySelector('[class*="progressFill"]');
            if (progressFill) {
                const sizeProp = window.innerWidth <= 784 ? 'width' : 'height';
                const styleVal = progressFill.style[sizeProp] || progressFill.style.width || progressFill.style.height;
                confidence = parseInt(styleVal) || 0;
            }

            // 3. Status Checks
            const isAllClear = row.textContent.toLowerCase().includes('all clear');
            const burgledStatus = burgledPlaces.has(targetName) ? 'success' : 'none';

            // 4. Fetch Market Data & Inject Tooltip
            fetchItemMarketData(data.uniqueId).then(price => {
                const tooltipHTML = buildTooltipHTML(targetName, confidence, price, isAllClear, data);
                
                const wrapper = document.createElement('span');
                wrapper.className = 'tbh-tooltip-trigger';
                
                // Apply burgled status color
                if (burgledStatus === 'success') wrapper.style.color = 'var(--crimes-stats-successes-color, #4caf50)';
                
                wrapper.innerHTML = nameNode.nodeType === Node.TEXT_NODE ? targetName : (nameNode.innerHTML || targetName);
                
                const tooltip = document.createElement('span');
                tooltip.className = 'tbh-tooltip';
                tooltip.innerHTML = tooltipHTML;
                wrapper.appendChild(tooltip);
                
                if (nameNode.nodeType === Node.TEXT_NODE) {
                    nameNode.replaceWith(wrapper);
                } else {
                    nameNode.innerHTML = '';
                    nameNode.appendChild(wrapper);
                }
            });
        });
    }

    function attachVirtualListObserver() {
        const virtualList = document.querySelector('div[class*="virtualList"]');
        if (!virtualList) return;
        if (virtualListObserver) virtualListObserver.disconnect();

        virtualListObserver = new MutationObserver((mutations) => {
            let hasAdded = false;
            mutations.forEach(m => {
                m.addedNodes.forEach(n => {
                    if (n.nodeType === 1 && n.matches('div[class*="virtualItem"]') && !n.querySelector('[class*="propertyTypeSection"]')) {
                        hasAdded = true;
                    }
                });
            });

            if (hasAdded) {
                processScoutedTargets();
            }
        });
        virtualListObserver.observe(virtualList, observerConfig);
    }

    // =========================================================================
    // TORN TOOLS & API FETCH
    // =========================================================================
    function getMarketPriceFromTornTools(itemId) {
        try {
            const ttData = localStorage.getItem('torn_tools_data'); 
            if (ttData) {
                const parsed = JSON.parse(ttData);
                if (parsed.items && parsed.items[itemId]) {
                    return parsed.items[itemId].market_price || parsed.items[itemId].last_price;
                }
            }
        } catch (e) { /* Silent fail */ }
        return null;
    }

    async function fetchItemMarketData(itemId) {
        if (itemId === 0) return 0;
        const ttPrice = getMarketPriceFromTornTools(itemId);
        if (ttPrice) return ttPrice;

        return new Promise((resolve) => {
            GM_xmlhttpRequest({
                method: "GET",
                url: `${WORKER_URL}/api/v1/item/${itemId}`,
                onload: function(response) {
                    try {
                        const data = JSON.parse(response.responseText);
                        resolve(data.market?.last_price || data.market?.average_price || 0);
                    } catch (e) { resolve(0); }
                },
                onerror: () => resolve(0)
            });
        });
    }

    async function loadUserInventory() {
        if (!TORN_API_KEY) {
            console.log('[TBH] No API key provided. Inventory checking disabled.');
            return;
        }
        try {
            const res = await fetch(`https://api.torn.com/v2/user/?selections=inventory&key=${TORN_API_KEY}`);
            const data = await res.json();
            if (data.inventory) {
                userInventory = new Set(Object.values(data.inventory).map(i => i.name));
                console.log('[TBH] Inventory loaded:', userInventory.size, 'items');
            }
        } catch (e) { console.error("[TBH] Failed to load inventory", e); }
    }

